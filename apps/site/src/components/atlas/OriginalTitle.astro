---
import { languageById } from '../../lib/atlas/data.ts';

interface Props {
  text?: string | undefined;
  translit?: string | undefined;
  lang: string;
  /** 'hero' renders the script large; 'inline' sits inside running text. */
  size?: 'hero' | 'inline';
}

const { text, translit, lang, size = 'inline' } = Astro.props;
const language = languageById.get(lang);
if (!language) throw new Error(`OriginalTitle: unknown language "${lang}"`);
---

{
  size === 'hero' ? (
    <span class="hero-title">
      {text && (
        <span
          class={`original script-${language.script}`}
          lang={language.bcp47}
          dir={language.dir}
        >
          {text}
        </span>
      )}
      {translit && <span class="translit">{translit}</span>}
    </span>
  ) : (
    <span class="inline-title">
      {text && (
        <span class={`script-${language.script}`} lang={language.bcp47} dir={language.dir}>
          {text}
        </span>
      )}
      {text && translit && <span aria-hidden="true">·</span>}
      {translit && <i>{translit}</i>}
    </span>
  )
}

<style>
  .hero-title {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }

  .hero-title .original {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.6rem);
    line-height: 1.3;
    color: var(--color-ink);
  }

  .hero-title .translit {
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-ink-muted);
  }

  .inline-title {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .inline-title [aria-hidden] {
    color: var(--color-ink-faint);
  }

  /* Pahlavi has no usable webfont; transliteration carries it. */
  :global(.script-pahlavi) {
    font-style: italic;
  }
</style>
