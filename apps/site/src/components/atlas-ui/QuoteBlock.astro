---
/**
 * QuoteBlock — the atlas's signature affordance: a verbatim, paragraph-
 * anchored quotation with a deep link to the exact paragraph in the reader.
 * "No claim without a quote," made visible.
 */
import { quoteHref, type QuoteRef } from "../../lib/atlas-graph";
import { locusLabel } from "../../lib/corpus";

interface Props {
  work: string; // work slug (for the deep link)
  /** display title — ONLY when the quote comes from a work other than the
   *  page's subject. It is prepended to the locus, never a substitute for it. */
  workTitle?: string;
  /** an extra clause after the locus (the harvest's role/hint prose).
   *  Never replaces the locus — that was the bug this prop retires. */
  caption?: string;
  quote: QuoteRef;
}
const { work, workTitle, caption: extra, quote } = Astro.props;
const href = quoteHref(work, quote);
// The locus is the provenance and is never dropped: before this, a caller
// passing workTitle got its string INSTEAD of the chapter, so the ledger's
// headline evidence read "cited as authority ¶" — how, never where.
const locus = quote.chapter ? locusLabel(work, quote.chapter) : "locus not recovered";
const caption = [workTitle, locus, extra].filter(Boolean).join(" · ");
---

<figure class="quote-block">
  <blockquote>{quote.text}</blockquote>
  <figcaption>
    {
      href ? (
        <a href={href}>
          {caption}
          <span class="pmark">¶</span>
        </a>
      ) : (
        <span class="qb-lost">{caption}</span>
      )
    }
  </figcaption>
</figure>

<style>
  .quote-block {
    margin: var(--s-3) 0 var(--s-4);
  }
  blockquote {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
    padding: 0 0 0 var(--s-4);
    border-left: 1px solid var(--accent-soft);
  }
  figcaption {
    margin-top: var(--s-1);
    padding-left: var(--s-4);
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink-muted);
  }
  figcaption a {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color 150ms ease-out, border-color 150ms ease-out;
  }
  figcaption a:hover {
    color: var(--accent);
    border-color: var(--accent-soft);
  }
  /* no deep link exists for this quote — the caption is all the provenance
     there is, and italic says so rather than looking like a dead link */
  .qb-lost {
    font-style: italic;
  }
  .pmark {
    color: var(--accent);
    margin-left: 0.35em;
    font-size: 12px;
  }
</style>
