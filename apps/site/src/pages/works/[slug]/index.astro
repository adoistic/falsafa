---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { works, listChapters, readWorkIndex } from "../../../lib/corpus";

export const getStaticPaths = (() => {
  return works().map((w) => ({ params: { slug: w.slug }, props: { work: w } }));
}) satisfies GetStaticPaths;

const { work } = Astro.props;

// Atlas wiring: when the ontology harvest has mapped this work, the page
// carries its ontology section (entities by kind, citations, coverage) —
// data-driven, so newly harvested works pick it up on the next build.
import { workAtlas, workOntology, entityHasPage, fmt, plural as pl } from "../../../lib/atlas-graph";
import { bookLd, breadcrumbsLd } from "../../../lib/seo";
import { KINDS, type ChapterEntity } from "../../../lib/atlas-graph";
import Gathering from "../../../components/atlas-ui/Gathering.astro";
import RunningHead from "../../../components/atlas-ui/RunningHead.astro";
import {
  workCitationsFile,
  workCitedBy,
  citingWorkSlugs,
  citedWorkSlugs,
} from "../../../lib/atlas-citations";
const wAtlas = workAtlas(work.slug);
const kindPlural = (k: string) => KINDS.find((x) => x.kind === k)?.plural ?? k;

// The citation apparatus. /works/<slug>/citations/ is generated for a work
// with an outbound OR an inbound edge, so the leaf is linked on exactly that
// set — a dimmed leaf is honest, a leaf that 404s is not. Both sets come out
// of citations/index.json, so a clone with no atlas artifacts yields two
// empty sets, no leaf, and no build failure.
const hasCitationsPage = citingWorkSlugs().has(work.slug) || citedWorkSlugs().has(work.slug);
// The number the leaf prints is CITATIONS, because that is the word the leaf
// says: Clement names 561 sources and cites them 921 times, and a leaf
// reading "citations 561" would be the wrong number under the right label.
// For a work that cites nothing but is itself cited, it is the citations
// aimed at it — still citations, counted the other way round.
const citOut = workCitationsFile(work.slug)?.totals.citations ?? 0;
const citN = citOut > 0 ? citOut : (workCitedBy(work.slug)?.total ?? 0);
const citLeaf = hasCitationsPage
  ? {
      label: "citations",
      href: `/works/${work.slug}/citations/`,
      ...(citN > 0 ? { count: citN } : {}),
    }
  : { label: "citations", note: "none recorded" };

// The work's entities grouped by kind (deduped across chapters, by depth).
const wOnto = wAtlas ? workOntology(work.slug) : null;
const entitiesByKind = (() => {
  if (!wOnto) return [];
  const seen = new Map<string, ChapterEntity>();
  for (const list of Object.values(wOnto.chapters))
    for (const e of list) {
      const key = `${e.kind}/${e.slug}`;
      if (!seen.has(key)) seen.set(key, e);
    }
  return KINDS.map((k) => {
    const all = [...seen.values()]
      .filter((e) => e.kind === k.kind)
      .sort((a, b) => b.count - a.count || (a.name < b.name ? -1 : 1));
    return { ...k, items: all.slice(0, 10), total: all.length };
  }).filter((g) => g.items.length > 0);
})();
// One coverage string, printed twice — on the gathering's folio and on the
// atlas running head — so the page never quotes two different readings of
// the same harvest.
const coverageFolio = !wAtlas
  ? ""
  : wAtlas.windows_done >= wAtlas.windows_total
    ? "fully mapped"
    : `${fmt(wAtlas.windows_done)} of ${fmt(wAtlas.windows_total)} passages read`;
// The colophon that explains the mute names only appears when there ARE mute
// names: on a fully paged work it would be an apology for nothing.
const shownEntities: { kind: string; slug: string }[] =
  entitiesByKind.length > 0
    ? entitiesByKind.flatMap((g) => g.items)
    : (wAtlas?.top_entities ?? []);
const anyUnlinked = shownEntities.some((e) => !entityHasPage(e.kind, e.slug));
const idx = readWorkIndex(work.slug);
const chapters = listChapters(work.slug);
const workJsonLd = [
  bookLd({
    slug: work.slug, title: work.title, author: work.author,
    authorSlug: work.author_slug, language: work.language,
    description: work.description, publishedYear: work.published_year,
  }),
  breadcrumbsLd([
    { name: "Read", url: "https://falsafa.ai/works/" },
    { name: work.title, url: `https://falsafa.ai/works/${work.slug}/` },
  ]),
];

// Build the union of variant types across all chapters (for the picker).
const variantTypeSet = new Set<string>();
for (const c of chapters) {
  for (const v of c.variants) variantTypeSet.add(v.content_type);
}
const variantTypes = [...variantTypeSet];
const variantLabels: Record<string, string> = {
  translation: "English",
  transliteration: "Romanized",
  original: "Original",
};

// Single-chapter works (Cynewulf trilogy, the still-unsplit smṛtis, the
// Sundanese tattvas, Fichte) have no meaningful table of contents — the
// chapter IS the work. The work-detail page is redundant: just bounce
// the user straight to the chapter reader, honoring their localStorage
// variant preference (translation/transliteration/original) when present,
// else falling back to the chapter's default (English when available).
const isSingleChapter = chapters.length === 1;
const onlyChapter = chapters[0];
const onlyChapterDefaultVariant = onlyChapter?.variants.find((v) => v.file === onlyChapter.default_variant);
const onlyChapterDefaultType = onlyChapterDefaultVariant?.content_type ?? "translation";
const onlyChapterAvailable = onlyChapter?.variants.map((v) => v.content_type) ?? [];
const redirectTo = isSingleChapter && onlyChapter
  ? `/works/${work.slug}/${onlyChapter.chapter_slug}/${onlyChapterDefaultType}/`
  : null;
---

{isSingleChapter && redirectTo && onlyChapter ? (
  /* Redirect page: a single-chapter work has no work-detail surface worth
     rendering — the chapter IS the work. We bounce the user to the chapter
     reader, honoring their localStorage variant preference. The script
     fires synchronously during HTML parsing, before any paint, so the user
     never sees the chrome. <noscript> renders a plain link as fallback.

     SEO: a crawler that runs the script sees a redirect and reports the URL
     as "Page with redirect"; one that doesn't sees an empty page. Neither
     should compete with the chapter, so the canonical points at the chapter
     and the URL is dropped from the sitemap (astro.config.mjs). No noindex:
     it would fight the canonical, and the signal we want is consolidation
     onto the chapter, not suppression. */
  <Base
    title={work.title}
    description={work.description}
    ogImage={`/og/works/${work.slug}.png`}
    canonicalPath={redirectTo}
  >
    <script
      is:inline
      define:vars={{
        slug: work.slug,
        chapter: onlyChapter.chapter_slug,
        defaultType: onlyChapterDefaultType,
        available: onlyChapterAvailable,
        fallback: redirectTo,
      }}
    >
      (function () {
        // Carry the fragment through. Every stale #atlas link in the wild dies
        // silently today: the stub drops the hash, and 228 of the 312 works
        // that cite anything are single-chapter, so the reader page is the
        // only atlas surface they have.
        //
        // #atlas is the WORK page's section id; the reader's equivalent panel
        // is #chapter-atlas, and 370 of these 1,013 stubs lead to a page that
        // has one. Forwarding the hash verbatim would land the reader at the
        // top of the text with nothing selected, which is the same silence in
        // a different place, so the one work-page-only fragment is translated
        // and everything else — #p-… above all — passes through untouched.
        var frag = location.hash || "";
        if (frag === "#atlas") frag = "#chapter-atlas";
        try {
          var pref = localStorage.getItem("falsafa-variant-pref");
          var target = pref && available.indexOf(pref) >= 0 ? pref : defaultType;
          location.replace("/works/" + slug + "/" + chapter + "/" + target + "/" + frag);
        } catch (e) {
          location.replace(fallback + frag);
        }
      })();
    </script>
    <noscript>
      <div class="container">
        <p style="padding: 2rem 0;">
          <a href={redirectTo}>Read {work.title} →</a>
        </p>
      </div>
    </noscript>
  </Base>
) : (
<Base
  ogImage={`/og/works/${work.slug}.png`}
  title={work.title}
  description={work.description}
  jsonLd={workJsonLd}
>
  <div class="container">
    {idx?.cover_url && (
      <div class="cover">
        <img src={idx.cover_url} alt={`Cover for ${work.title}`} />
      </div>
    )}

    <header class="work-header">
      <p class="era">
        <a href={`/eras/${work.era_slug}/`}>{work.era}</a> · {work.language}
      </p>
      <h1>{work.title}</h1>
      <p class="author">
        <a href={`/authors/${work.author_slug}/`}>{work.author}</a>
      </p>
      {work.description && <p class="description">{work.description}</p>}
      <div class="meta-grid">
        <div>
          <dt>Chapters</dt>
          <dd>{work.total_logical_chapters}</dd>
        </div>
        <div>
          <dt>Variants</dt>
          <dd>{work.total_variant_entries}</dd>
        </div>
        <div>
          <dt>Genre</dt>
          <dd>{work.genre}</dd>
        </div>
        {work.difficulty && (
          <div>
            <dt>Difficulty</dt>
            <dd>{work.difficulty}</dd>
          </div>
        )}
      </div>
    </header>

    {/* The gathering stands for a work with EITHER surface. 110 of the 594
        works that have a citations page — Psalms, Genesis, Polybius — have
        never been read by the ontology harvest, so gating on wAtlas alone
        would leave their only atlas surface unreachable from their own
        contents page. The figures leaf is then shown, dimmed, and named. */}
    {(wAtlas || hasCitationsPage) && (
      <Gathering
        leaves={[
          { label: "contents", current: true },
          citLeaf,
          wAtlas
            ? { label: "figures & ideas", href: "#atlas", count: wAtlas.entity_rows }
            : { label: "figures & ideas", note: "not yet harvested" },
        ]}
        folio={coverageFolio}
      />
    )}

    <section class="chapters">
      <RunningHead title="chapters" folio={pl(chapters.length, "chapter")} />

      {variantTypes.length > 1 && (
        <nav class="variant-picker" data-work-slug={work.slug} aria-label="Reading variant">
          <span class="variant-picker-label">Read as</span>
          {variantTypes.map((vt) => (
            <button type="button" data-variant={vt} class="variant-pill" aria-pressed="false">
              {variantLabels[vt] ?? vt}
            </button>
          ))}
        </nav>
      )}

      <ol class="chapter-list">
        {
          chapters.map((c) => {
            const defaultVariant = c.variants.find((v) => v.file === c.default_variant);
            const defaultVariantType = defaultVariant?.content_type ?? "translation";
            const availableVariants = c.variants.map((v) => v.content_type).join(",");
            return (
              <li>
                <a
                  href={`/works/${work.slug}/${c.chapter_slug}/${defaultVariantType}/`}
                  data-chapter-slug={c.chapter_slug}
                  data-default-variant={defaultVariantType}
                  data-available-variants={availableVariants}
                >
                  <span class="num">{String(c.chapter_number).padStart(2, "0")}</span>
                  <span class="title">{c.chapter_title}</span>
                  <span class="layout">{c.layout}</span>
                </a>
              </li>
            );
          })
        }
      </ol>
    </section>

    {
      wAtlas && (
        <section class="in-atlas" id="atlas">
          <RunningHead title="in the atlas" folio={coverageFolio} />
          {entitiesByKind.length > 0 ? (
            <div class="ia-groups">
              {entitiesByKind.map((g) => (
                <div class="ia-group">
                  <h3 class="ia-kind">
                    {g.label}
                    <span class="ia-kind-count">
                      {g.total > g.items.length
                        ? `— ${fmt(g.items.length)} of ${fmt(g.total)}`
                        : `— ${fmt(g.total)}`}
                    </span>
                  </h3>
                  <p class="ia-run">
                    {g.items.map((e, i) => (
                      <>
                        {i > 0 && <span class="ia-sep"> · </span>}
                        {entityHasPage(e.kind, e.slug) ? (
                          <a href={`/atlas/${kindPlural(e.kind)}/${e.slug}/`}>
                            {e.name}
                          </a>
                        ) : (
                          <span class="ia-unlinked">{e.name}</span>
                        )}
                      </>
                    ))}
                  </p>
                </div>
              ))}
            </div>
          ) : (
            wAtlas.top_entities.length > 0 && (
              <p class="ia-run">
                {wAtlas.top_entities.map((t, i) => (
                  <>
                    {i > 0 && <span class="ia-sep"> · </span>}
                    {/* top_entities is ranked by mentions, so it routinely
                        surfaces entities below the paging threshold — link
                        only the ones that actually have a page. */}
                    {entityHasPage(t.kind, t.slug) ? (
                      <a href={`/atlas/${kindPlural(t.kind)}/${t.slug}/`}>{t.name}</a>
                    ) : (
                      <span class="ia-unlinked">{t.name}</span>
                    )}
                  </>
                ))}
              </p>
            )
          )}
          <p class="ia-note">
            {wAtlas.citations_out > 0 && (
              <>
                {hasCitationsPage ? (
                  <a href={`/works/${work.slug}/citations/`}>
                    {pl(wAtlas.citations_out, "citation")}
                  </a>
                ) : (
                  /* Both counts come from the same harvest, so all 482 works
                     with citations_out > 0 have a page; the mute branch is the
                     guard for an artifact pair that drifts apart. */
                  pl(wAtlas.citations_out, "citation")
                )}
                {" · "}
              </>
            )}
            {wAtlas.themes > 0 && (
              <>
                {pl(wAtlas.themes, "theme")}
                {" · "}
              </>
            )}
            {`${fmt(wAtlas.entity_rows)} entity mentions`}
            {" — every one anchored to a verbatim passage. "}
            <a href="/atlas/">The atlas</a>.
          </p>
          {anyUnlinked && (
            <p class="ia-note ia-fine">Names without a link are recorded but not yet paged.</p>
          )}
        </section>
      )
    }

    <script is:inline>
      // Read localStorage falsafa-variant-pref. If set, rewrite chapter links
      // to use that variant (when available for the chapter), and highlight
      // the matching pill in the picker.
      (function () {
        const pref = (() => {
          try { return localStorage.getItem("falsafa-variant-pref"); } catch { return null; }
        })();
        const picker = document.querySelector(".variant-picker");
        const buttons = picker ? picker.querySelectorAll("button[data-variant]") : [];

        function applyVariant(v) {
          // Rewrite every chapter link in the ToC to point at the chosen
          // variant (when that variant exists for the chapter), and update
          // pill state. Single-chapter works don't render this script —
          // they auto-redirect from the work URL.
          for (const a of document.querySelectorAll(".chapter-list a[data-chapter-slug]")) {
            const available = (a.getAttribute("data-available-variants") || "").split(",");
            const target = available.includes(v) ? v : a.getAttribute("data-default-variant");
            const slug = a.getAttribute("data-chapter-slug");
            const work = picker ? picker.getAttribute("data-work-slug") : a.getAttribute("href").split("/")[2];
            a.setAttribute("href", `/works/${work}/${slug}/${target}/`);
          }
          for (const b of buttons) {
            b.setAttribute("aria-pressed", b.getAttribute("data-variant") === v ? "true" : "false");
          }
        }

        if (pref) applyVariant(pref);

        for (const b of buttons) {
          b.addEventListener("click", function () {
            const v = b.getAttribute("data-variant");
            if (!v) return;
            try { localStorage.setItem("falsafa-variant-pref", v); } catch {}
            applyVariant(v);
          });
        }
      })();
    </script>
  </div>
</Base>
)}

<style>
  .container {
    max-width: 880px;
    margin: 0 auto;
    padding: var(--s-12) var(--s-8) var(--s-24);
  }

  .cover {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--rule);
    margin-bottom: var(--s-12);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-header {
    margin-bottom: var(--s-16);
  }

  .work-header .era {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin: 0 0 var(--s-3);
  }

  .work-header .era a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .work-header .era a:hover {
    border-bottom-color: currentColor;
  }

  .work-header h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-display);
    letter-spacing: -0.02em;
    margin: 0 0 var(--s-2);
  }

  .work-header .author {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-muted);
    font-size: var(--fs-h3);
    margin: 0 0 var(--s-6);
  }

  .work-header .author a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .work-header .author a:hover {
    color: var(--ink);
    border-bottom-color: var(--rule);
  }

  .work-header .description {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    margin: 0 0 var(--s-8);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--s-4);
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
  }

  .meta-grid dt {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin-bottom: var(--s-1);
  }

  .meta-grid dd {
    font-size: var(--fs-body);
    margin: 0;
    color: var(--ink);
  }

  .variant-picker {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0 0 var(--s-6);
    padding: var(--s-2);
    background: var(--rule);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .variant-picker-label {
    padding: 0 var(--s-2) 0 var(--s-3);
    color: var(--ink-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11px;
  }

  .variant-pill {
    padding: var(--s-1) var(--s-3);
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--ink-muted);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .variant-pill:hover {
    color: var(--ink);
  }

  .variant-pill[aria-pressed="true"] {
    background: var(--paper);
    color: var(--ink);
  }

  .chapter-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chapter-list li {
    border-bottom: 1px solid var(--rule);
  }

  .chapter-list a {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-4) 0;
    color: var(--ink);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .chapter-list a:hover {
    transform: translateX(var(--s-3));
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter-list a:hover {
      transform: none;
    }
  }

  .chapter-list .num {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-muted);
  }

  .chapter-list .title {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 500;
  }

  .chapter-list .layout {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
  }
  /* ── In the atlas ─────────────────────────────────────────────────── */
  .in-atlas {
    margin-top: var(--s-16);
  }
  .ia-groups {
    margin-bottom: var(--s-4);
  }
  .ia-group {
    margin-bottom: var(--s-4);
  }
  .ia-kind {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    font-variant: small-caps;
    text-transform: lowercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin: 0 0 var(--s-1);
  }
  .ia-kind-count {
    font-weight: 400;
    font-variant-numeric: oldstyle-nums;
    margin-left: 0.5em;
  }
  .ia-unlinked {
    color: var(--ink-muted);
  }
  .ia-run {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.9;
    margin: 0 0 var(--s-3);
    max-width: 70ch;
  }
  .ia-run a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color 150ms ease-out, border-color 150ms ease-out;
  }
  .ia-run a:hover {
    color: var(--accent);
    border-color: var(--accent-soft);
  }
  .ia-sep {
    color: var(--accent-soft);
  }
  .ia-note {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
    font-variant-numeric: oldstyle-nums;
  }
  .ia-note a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-soft);
  }
  .ia-fine {
    font-size: 15px;
    font-style: italic;
    margin-top: var(--s-2);
  }
</style>
