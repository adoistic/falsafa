---
import Base from "../layouts/Base.astro";
import ComingSoon from "../components/ComingSoon.astro";
---

<Base
  title="Listen"
  description="Falsafa as audio — poetic works set to song, prose read as audiobooks."
>
  <ComingSoon
    kicker="Listen"
    title="The corpus, out loud"
    blurb="Every work is being turned into something you can hear. Verse — the Rāmāyaṇa, the Mahābhārata, the Vedas, Homer, Virgil, Ghālib — is set to music as song. Prose is read as audiobook. And in the works that weave the two together, the poetry breaks out of the prose into song. English first; select works in the original language may follow."
    repo="https://github.com/adoistic/falsafa-audio"
    repoLabel="adoistic/falsafa-audio"
  />
</Base>
