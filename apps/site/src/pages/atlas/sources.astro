---
import AtlasPage from '../../layouts/AtlasPage.astro';
import { sources, transmissionsBySource } from '../../lib/atlas/data.ts';
import type { Source } from '../../lib/atlas/schema.ts';

const groups: [string, string, Source[]][] = [
  [
    'Primary sources',
    'Medieval witnesses: the catalogues, prefaces and histories through which the chains are known at all.',
    sources.filter((s) => s.kind === 'primary'),
  ],
  [
    'Books',
    'Monographs and critical editions.',
    sources.filter((s) => s.kind === 'book'),
  ],
  [
    'Articles',
    'Journal articles and book chapters.',
    sources.filter((s) => s.kind === 'article'),
  ],
  [
    'Reference works',
    'Encyclopedias and biographical dictionaries, used for dates and attributions.',
    sources.filter((s) => s.kind === 'reference'),
  ],
];

for (const [, , rows] of groups) {
  rows.sort((a, b) => a.author.localeCompare(b.author) || a.year - b.year);
}
---

<AtlasPage
  title="Sources"
  description="The bibliography behind the atlas. Every crossing cites at least one of these."
>
  <div class="wrap">
    <header class="head">
      <p class="tag tag-line">Sources</p>
      <h1>The evidence shelf</h1>
      <p class="lede">
        Every crossing in the atlas cites at least one work on this page. If a claim here is
        wrong, one of these books is where the correction will come from.
      </p>
    </header>

    {
      groups.map(([title, blurb, rows]) => (
        <section class="group">
          <h2>{title}</h2>
          <p class="blurb">{blurb}</p>
          <ul class="bib" role="list">
            {rows.map((s) => {
              const cited = transmissionsBySource(s.id).length;
              return (
                <li id={s.id}>
                  <p class="entry">
                    {s.author} ({s.year}). <cite>{s.title}</cite>.
                    {s.publisher && ` ${s.publisher}.`}
                    {s.url && (
                      <>
                        {' '}
                        <a class="link mono ext" href={s.url}>{new URL(s.url).hostname}</a>
                      </>
                    )}
                  </p>
                  {s.note && <p class="note">{s.note}</p>}
                  {cited > 0 && (
                    <p class="cited mono">
                      cited by {cited} {cited === 1 ? 'crossing' : 'crossings'}
                    </p>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</AtlasPage>

<style>
  .wrap {
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem;
  }

  .head h1 {
    font-size: var(--text-h1);
    margin: 1.1rem 0 0.8rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--color-ink-muted);
    max-width: 46ch;
  }

  .group {
    padding-block: 1.6rem;
  }

  .group h2 {
    font-size: var(--text-h2);
    margin: 0 0 0.3rem;
  }

  .blurb {
    color: var(--color-ink-muted);
    margin: 0 0 1.2rem;
  }

  .bib {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bib li {
    border-top: 1px solid var(--color-hairline);
    padding: 0.8rem 0.2rem;
    scroll-margin-top: 5rem;
  }

  .bib li:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .bib li:target {
    background: color-mix(in oklab, var(--color-gold-leaf) 14%, transparent);
  }

  .entry {
    margin: 0;
    font-size: 1.02rem;
  }

  .ext {
    font-size: 0.72rem;
  }

  .note {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .cited {
    margin: 0.35rem 0 0;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
</style>
