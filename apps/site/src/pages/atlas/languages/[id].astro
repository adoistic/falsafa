---
import AtlasPage from '../../../layouts/AtlasPage.astro';
import ConfidenceMark from '../../../components/atlas/ConfidenceMark.astro';
import {
  languages,
  languageById,
  personById,
  sourceLanguageOf,
  transmissionsByLanguage,
  workById,
  works,
} from '../../../lib/atlas/data.ts';
import { formatSpan } from '../../../lib/atlas/format.ts';
import type { Transmission } from '../../../lib/atlas/schema.ts';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { id: lang.id }, props: { lang } }));
}

const { lang } = Astro.props;
const { into, outOf } = transmissionsByLanguage(lang.id);
const composed = works.filter((w) => w.original.lang === lang.id);

function row(t: Transmission, direction: 'into' | 'outOf') {
  const work = workById.get(t.work)!;
  const from = sourceLanguageOf(t);
  const to = languageById.get(t.language)!;
  const names = t.people
    .filter((p) => ['translator', 'reviser', 'editor', 'commentator'].includes(p.role))
    .map((p) => personById.get(p.person)!.name);
  return { t, work, from, to, names, direction };
}

const sections = [
  { title: `Into ${lang.name}`, rows: into.map((t) => row(t, 'into')) },
  { title: `Out of ${lang.name}`, rows: outOf.map((t) => row(t, 'outOf')) },
].filter((s) => s.rows.length > 0);
---

<AtlasPage title={lang.name} description={lang.note}>
  <article class="wrap">
    <header class="head">
      <p class="tag tag-line rise">Language</p>
      <h1 class="rise rise-1">
        <span class="swatch" style={`--hue: ${lang.hue}`} aria-hidden="true"></span>
        {lang.name}
        {lang.endonym && lang.script !== 'latin' && (
          <span class={`endonym script-${lang.script}`} lang={lang.bcp47} dir={lang.dir}>
            {lang.endonym}
          </span>
        )}
      </h1>
      <p class="bio prose rise rise-2">{lang.note}</p>
      {
        composed.length > 0 && (
          <p class="composed rise rise-3">
            Composed in {lang.name}:{' '}
            {composed.map((w, i) => (
              <span>
                {i > 0 && ', '}
                <a class="link" href={`/atlas/works/${w.id}/`}>{w.title}</a>
              </span>
            ))}
          </p>
        )
      }
    </header>

    {
      sections.map(({ title, rows }) => (
        <section class="block">
          <p class="tag tag-line">{title}</p>
          <ul class="crossings" role="list">
            {rows.map(({ t, work, from, to, names }) => (
              <li>
                <span class="when mono">{formatSpan(t.date)}</span>
                <span class="what">
                  <a class="link" href={`/atlas/works/${work.id}/`}>{work.title}</a>
                  {', '}
                  <a class="link-quiet lang" href={`/atlas/languages/${from.id}/`}>{from.name}</a>{' '}
                  <span class="arrow" aria-hidden="true">→</span>{' '}
                  <a class="link-quiet lang" href={`/atlas/languages/${to.id}/`}>{to.name}</a>
                  {names.length > 0 && <span class="who"> · {names.join(', ')}</span>}
                </span>
                <span class="grade"><ConfidenceMark confidence={t.confidence} /></span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</AtlasPage>

<style>
  .wrap {
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0.5rem;
  }

  .head h1 {
    font-size: var(--text-h1);
    margin: 1.1rem 0 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .swatch {
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    background: var(--hue);
    flex: none;
  }

  .endonym {
    font-weight: 400;
    color: var(--color-ink-muted);
    font-size: 0.75em;
    unicode-bidi: isolate;
  }

  .bio {
    font-size: 1.14rem;
  }

  .composed {
    margin-top: 1rem;
    color: var(--color-ink-muted);
  }

  .block {
    padding-block: 1.6rem;
  }

  .crossings {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
  }

  .crossings li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 0.7rem 0.2rem;
    border-top: 1px solid var(--color-hairline);
    align-items: baseline;
  }

  .crossings li:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .when {
    font-size: 0.74rem;
    color: var(--color-ink-muted);
  }

  .arrow {
    color: var(--color-gold);
  }

  .lang:hover {
    color: var(--color-lapis);
  }

  .who {
    color: var(--color-ink-muted);
    font-style: italic;
    font-size: 0.95em;
  }

  @media (max-width: 640px) {
    .crossings li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
