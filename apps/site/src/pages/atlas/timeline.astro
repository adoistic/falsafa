---
import AtlasPage from '../../layouts/AtlasPage.astro';
import {
  languages,
  languageById,
  personById,
  transmissionsOf,
  works,
} from '../../lib/atlas/data.ts';
import { formatSpan, formatYear } from '../../lib/atlas/format.ts';

const lanes = [...works].sort((a, b) => a.composed.from - b.composed.from);

const MIN = -450;
const MAX = 1780;
const LABEL = 200;
const W = 1180;
const ROW = 40;
const TOP = 44;
const H = TOP + lanes.length * ROW + 30;

const x = (year: number) => LABEL + ((year - MIN) / (MAX - MIN)) * (W - LABEL - 24);

const gridYears = [-400, -200, 1, 200, 400, 600, 800, 1000, 1200, 1400, 1600];

interface Dot {
  cx: number;
  hue: string;
  label: string;
  origin: boolean;
}

const rows = lanes.map((work, i) => {
  const cy = TOP + i * ROW + ROW / 2;
  const original = languageById.get(work.original.lang)!;
  const ts = transmissionsOf(work.id);
  const dots: Dot[] = [
    {
      cx: x(work.composed.from),
      hue: original.hue,
      label: `${work.title}: composed in ${original.name}, ${formatSpan(work.composed)}`,
      origin: true,
    },
    ...ts.map((t) => {
      const lang = languageById.get(t.language)!;
      const who = t.people
        .filter((p) => ['translator', 'reviser', 'editor', 'commentator'].includes(p.role))
        .map((p) => personById.get(p.person)!.name)
        .join(', ');
      return {
        cx: x(t.date.from),
        hue: lang.hue,
        label: `${formatSpan(t.date)}: into ${lang.name}${who ? `, ${who}` : ''} [${t.confidence}]`,
        origin: false,
      };
    }),
  ];
  const last = Math.max(...dots.map((d) => d.cx));
  return { work, cy, dots, first: dots[0]!.cx, last };
});
---

<AtlasPage
  title="Timeline"
  description="Every crossing in the atlas on one axis, from the Aphorisms of Hippocrates to Ockley's English Hayy ibn Yaqzan."
>
  <div class="wrap">
    <header class="head">
      <p class="tag tag-line">Timeline</p>
      <h1>Twenty-one centuries of carrying</h1>
      <p class="lede">
        Each lane is one book. The hollow dot is its composition; every filled dot is a crossing
        into a new language, placed at its earliest defensible date. Hover any dot for a short
        label; every chain is written out in full on its work page, linked from the lane.
      </p>
    </header>

    <ul class="legend" aria-label="Language colors">
      {
        languages.map((lang) => (
          <li class="key">
            <span class="dot" style={`--hue: ${lang.hue}`} aria-hidden="true" />
            {lang.name}
          </li>
        ))
      }
    </ul>

    <div
      class="scroller"
      tabindex="0"
      role="region"
      aria-label="Timeline chart, horizontally scrollable"
    >
      <svg
        viewBox={`0 0 ${W} ${H}`}
        width={W}
        height={H}
        xmlns="http://www.w3.org/2000/svg"
        aria-label="Timeline of all transmission events. Each work's full chain is described on its own page, linked from the lane labels."
      >
        {
          gridYears.map((year) => (
            <g>
              <line
                x1={x(year)}
                x2={x(year)}
                y1={TOP - 18}
                y2={H - 18}
                stroke="var(--color-hairline)"
                stroke-width="1"
              />
              <text
                x={x(year)}
                y={TOP - 26}
                text-anchor="middle"
                class="axis"
              >
                {year === 1 ? '1 CE' : formatYear(year)}
              </text>
            </g>
          ))
        }
        {
          rows.map(({ work, cy, dots, first, last }) => (
            <g>
              <a href={`/atlas/works/${work.id}/`}>
                <text x={LABEL - 14} y={cy + 4} text-anchor="end" class="lane-label">
                  {work.title}
                </text>
              </a>
              <line x1={first} x2={last} y1={cy} y2={cy} class="lane-line" />
              {dots.map((d) =>
                d.origin ? (
                  <circle cx={d.cx} cy={cy} r="5.5" fill="var(--color-paper)" stroke={d.hue} stroke-width="2.5">
                    <title>{d.label}</title>
                  </circle>
                ) : (
                  <circle cx={d.cx} cy={cy} r="5" fill={d.hue}>
                    <title>{d.label}</title>
                  </circle>
                ),
              )}
            </g>
          ))
        }
      </svg>
    </div>

    <p class="caption">
      The empty stretch between 200 and 500 CE is real: late antiquity copied and commented far
      more than it translated. The traffic starts when empires begin paying for it.
    </p>
  </div>
</AtlasPage>

<style>
  .wrap {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem;
    max-width: 46rem;
  }

  .head h1 {
    font-size: var(--text-h1);
    margin: 1.1rem 0 0.8rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--color-ink-muted);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    padding-block: 0.6rem 1.2rem;
    list-style: none;
    margin: 0;
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .key .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--hue);
  }

  .scroller {
    overflow-x: auto;
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    background: var(--color-paper-raised);
    padding: 0.8rem 0.4rem;
  }

  svg {
    display: block;
  }

  svg :global(.axis) {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-ink-muted);
    letter-spacing: 0.06em;
  }

  svg :global(.lane-label) {
    font-family: var(--font-serif);
    font-size: 15px;
    fill: var(--color-ink);
  }

  svg :global(a:hover .lane-label) {
    fill: var(--color-lapis);
  }

  svg :global(.lane-line) {
    stroke: var(--color-hairline);
    stroke-width: 1.5;
  }

  .caption {
    margin-block: 1.2rem 2rem;
    font-style: italic;
    color: var(--color-ink-muted);
    max-width: 60ch;
  }
</style>
