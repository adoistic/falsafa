---
import AtlasPage from '../../../layouts/AtlasPage.astro';
import { languageById, people, transmissionsByPerson, worksByAuthor } from '../../../lib/atlas/data.ts';
import { lifeDates } from '../../../lib/atlas/format.ts';
import type { Person } from '../../../lib/atlas/schema.ts';

function sortKey(p: Person): number {
  if (p.born !== undefined) return p.born;
  if (p.died !== undefined) return p.died - 40;
  const carried = transmissionsByPerson(p.id);
  if (carried.length > 0) return carried[0]!.date.from - 40;
  return 2000;
}

const carryingRoles = ['translator', 'reviser', 'editor', 'commentator', 'scholar'];
const isAuthorOnly = (p: Person) =>
  p.roles.includes('author') && !p.roles.some((r) => carryingRoles.includes(r));
const isPatron = (p: Person) =>
  p.roles.every((r) => r === 'patron' || r === 'commissioner');

const authors = people.filter(isAuthorOnly).sort((a, b) => sortKey(a) - sortKey(b));
const patrons = people.filter((p) => !isAuthorOnly(p) && isPatron(p)).sort((a, b) => sortKey(a) - sortKey(b));
const carriers = people
  .filter((p) => !isAuthorOnly(p) && !isPatron(p))
  .sort((a, b) => sortKey(a) - sortKey(b));

const groups: [string, string, Person[]][] = [
  [
    'Carriers',
    'The translators, revisers, editors and scholars who moved the books. The working half of the atlas.',
    carriers,
  ],
  ['Authors', 'The people the books started with.', authors],
  [
    'Patrons',
    'The people who paid. Caliphs, viziers, kings and princes whose commissions set chains moving.',
    patrons,
  ],
];
---

<AtlasPage
  title="Carriers"
  description="Every named person in the atlas: the authors, translators, revisers, editors and patrons who carried the books."
>
  <div class="wrap">
    <header class="head">
      <p class="tag tag-line">Carriers</p>
      <h1>{people.length} people with names</h1>
      <p class="lede">
        Knowledge does not flow. Someone carries it. This is the register of everyone the atlas
        can name, in rough order of birth.
      </p>
    </header>

    {
      groups.map(([title, blurb, rows]) => (
        <section class="group">
          <h2>{title} <span class="count mono">{rows.length}</span></h2>
          <p class="blurb">{blurb}</p>
          <ul class="ledger" role="list">
            {rows.map((p) => {
              const carried = transmissionsByPerson(p.id).length;
              const wrote = worksByAuthor(p.id).length;
              return (
                <li>
                  <a class="row link-quiet" href={`/atlas/people/${p.id}/`}>
                    <span class="name">
                      {p.name}
                      {p.original && (
                        <span
                          class={`orig script-${languageById.get(p.original.lang)!.script}`}
                          lang={languageById.get(p.original.lang)!.bcp47}
                          dir={languageById.get(p.original.lang)!.dir}
                          aria-hidden="true"
                        >
                          {p.original.text}
                        </span>
                      )}
                    </span>
                    <span class="dates mono">{lifeDates(p.born, p.died, p.ca, p.fl)}</span>
                    <span class="note">{p.note.split('. ')[0]!.replace(/\.$/, '')}.</span>
                    <span class="tally mono">
                      {wrote > 0 && `${wrote} ${wrote === 1 ? 'work' : 'works'}`}
                      {wrote > 0 && carried > 0 && ' · '}
                      {carried > 0 && `${carried} ${carried === 1 ? 'crossing' : 'crossings'}`}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</AtlasPage>

<style>
  .wrap {
    max-width: 56rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem;
  }

  .head h1 {
    font-size: var(--text-h1);
    margin: 1.1rem 0 0.8rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--color-ink-muted);
    max-width: 44ch;
  }

  .group {
    padding-block: 1.8rem;
  }

  .group h2 {
    font-size: var(--text-h2);
    margin: 0 0 0.3rem;
  }

  .count {
    font-size: 0.8rem;
    color: var(--color-gold);
    vertical-align: super;
  }

  .blurb {
    color: var(--color-ink-muted);
    margin: 0 0 1.2rem;
    max-width: 52ch;
  }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ledger li {
    border-top: 1px solid var(--color-hairline);
  }

  .ledger li:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(11rem, 16rem) 1fr;
    grid-template-areas: 'name dates' 'note tally';
    gap: 0.15rem 1.5rem;
    padding: 0.85rem 0.4rem;
    align-items: baseline;
  }

  .row:hover .name {
    color: var(--color-lapis);
  }

  .name {
    grid-area: name;
    font-weight: 600;
    font-size: 1.12rem;
  }

  .orig {
    font-weight: 400;
    color: var(--color-ink-muted);
    margin-inline-start: 0.5rem;
    font-size: 0.95em;
    unicode-bidi: isolate;
  }

  .dates {
    grid-area: dates;
    font-size: 0.74rem;
    color: var(--color-ink-muted);
    justify-self: end;
    text-align: end;
  }

  .note {
    grid-area: note;
    font-size: 0.95rem;
    color: var(--color-ink-muted);
  }

  .tally {
    grid-area: tally;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--color-gold);
    justify-self: end;
    text-align: end;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      grid-template-areas: 'name' 'dates' 'note' 'tally';
    }
    .dates, .tally {
      justify-self: start;
      text-align: start;
    }
  }
</style>
