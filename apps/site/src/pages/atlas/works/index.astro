---
import AtlasPage from '../../../layouts/AtlasPage.astro';
import WorkCard from '../../../components/atlas/WorkCard.astro';
import { works } from '../../../lib/atlas/data.ts';

const sorted = [...works].sort((a, b) => a.composed.from - b.composed.from);
---

<AtlasPage
  title="Works"
  description="The books in the atlas, oldest first, each with its full transmission chain."
>
  <div class="wrap">
    <header class="head">
      <p class="tag tag-line">Works</p>
      <h1>{works.length} books, oldest first</h1>
      <p class="lede">
        Each entry traces one work from composition through every recorded crossing: translation,
        revision, adaptation, commentary, print.
      </p>
    </header>
    <div class="grid">
      {sorted.map((work) => <WorkCard work={work} />)}
    </div>
  </div>
</AtlasPage>

<style>
  .wrap {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem;
    max-width: 46rem;
  }

  .head h1 {
    font-size: var(--text-h1);
    margin: 1.1rem 0 0.8rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--color-ink-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.1rem;
    padding-block: 1.5rem 2rem;
  }
</style>
