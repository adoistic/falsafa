[
  {
    "id": "p-8a722e",
    "offset": 0,
    "text": "ἄμπνευμα σεμνὸν Ἀλφεοῦ,"
  },
  {
    "id": "p-0f2117",
    "offset": 25,
    "text": "κλεινᾶν Συρακοσσᾶν θάλος Ὀρτυγία,"
  },
  {
    "id": "p-44ab89",
    "offset": 60,
    "text": "δέμνιον Ἀρτέμιδος,"
  },
  {
    "id": "p-a747fd",
    "offset": 80,
    "text": "Δάλου κασιγνήτα, σέθεν ἁδυεπὴς"
  },
  {
    "id": "p-285260",
    "offset": 112,
    "text": "ὕμνος ὁρμᾶται θέμεν"
  },
  {
    "id": "p-3b1010",
    "offset": 133,
    "text": "αἶνον ἀελλοπόδων μέγαν ἵππων, Ζηνὸς Αἰτναίου χάριν·"
  },
  {
    "id": "p-d70d36",
    "offset": 186,
    "text": "ἅρμα δʼ ὀτρύνει Χρομίου Νεμέα θʼ ἔργμασιν νικαφόροις ἐγκώμιον ζεῦξαι μέλος."
  },
  {
    "id": "p-c4f875",
    "offset": 263,
    "text": "ἀρχαὶ δὲ βέβληνται θεῶν"
  },
  {
    "id": "p-46b2ef",
    "offset": 288,
    "text": "κείνου σὺν ἀνδρὸς δαιμονίαις ἀρεταῖς."
  },
  {
    "id": "p-f10485",
    "offset": 327,
    "text": "ἔστι δʼ ἐν εὐτυχίᾳ"
  },
  {
    "id": "p-f7cbfd",
    "offset": 347,
    "text": "πανδοξίας ἄκρον· μεγάλων δʼ ἀέθλων"
  },
  {
    "id": "p-0bce73",
    "offset": 383,
    "text": "Μοῖσα μεμνᾶσθαι φιλεῖ."
  },
  {
    "id": "p-baf554",
    "offset": 407,
    "text": "σπεῖρέ νυν ἀγλαΐαν τινὰ νάσῳ, τὰν Ὀλύμπου δεσπότας"
  },
  {
    "id": "p-0e90ab",
    "offset": 459,
    "text": "Ζεὺς ἔδωκεν Φερσεφόνᾳ, κατένευσέν τέ οἱ χαίταις, ἀριστεύοισαν εὐκάρπου χθονὸς"
  },
  {
    "id": "p-20df9a",
    "offset": 538,
    "text": "Σικελίαν πίειραν ὀρθώσειν κορυφαῖς πολίων ἀφνεαῖς."
  },
  {
    "id": "p-e2c8a9",
    "offset": 590,
    "text": "ὤπασε δὲ Κρονίων πολέμου μναστῆρά οἱ χαλκεντέος"
  },
  {
    "id": "p-3a41e2",
    "offset": 639,
    "text": "λαὸν ἵππαιχμον θαμὰ δὴ καὶ Ὀλυμπιάδων φύλλοις ἐλαιᾶν χρυσέοις"
  },
  {
    "id": "p-37f730",
    "offset": 702,
    "text": "μιχθέντα. πολλῶν ἐπέβαν καιρὸν οὐ ψεύδει βαλών."
  },
  {
    "id": "p-c155a3",
    "offset": 751,
    "text": "ἔσταν δʼ ἐπʼ αὐλείαις θύραις"
  },
  {
    "id": "p-148c4c",
    "offset": 781,
    "text": "ἀνδρὸς φιλοξείνου καλὰ μελπόμενος,"
  },
  {
    "id": "p-6889b8",
    "offset": 817,
    "text": "ἔνθα μοι ἁρμόδιον"
  },
  {
    "id": "p-0297b2",
    "offset": 836,
    "text": "δεῖπνον κεκόσμηται, θαμὰ δʼ ἀλλοδαπῶν"
  },
  {
    "id": "p-7699e9",
    "offset": 875,
    "text": "οὐκ ἀπείρατοι δόμοι"
  },
  {
    "id": "p-453a3f",
    "offset": 896,
    "text": "ἐντί· λέλογχε δὲ μεμφομένοις ἐσλοὺς ὕδωρ καπνῷ φέρειν"
  },
  {
    "id": "p-5ab1f0",
    "offset": 951,
    "text": "ἀντίον. τέχναι δʼ ἑτέρων ἕτεραι· χρὴ δʼ ἐν εὐθείαις ὁδοῖς στείχοντα μάρνασθαι φυᾷ."
  },
  {
    "id": "p-e9d6b4",
    "offset": 1035,
    "text": "πράσσει γὰρ ἔργῳ μὲν σθένος,"
  },
  {
    "id": "p-18d65a",
    "offset": 1065,
    "text": "βουλαῖσι δὲ φρήν, ἐσσόμενον προϊδεῖν"
  },
  {
    "id": "p-04c337",
    "offset": 1103,
    "text": "συγγενὲς οἷς ἕπεται."
  },
  {
    "id": "p-ff6812",
    "offset": 1125,
    "text": "Ἁγησιδάμου παῖ, σέο δʼ ἀμφὶ τρόπῳ"
  },
  {
    "id": "p-5df700",
    "offset": 1160,
    "text": "τῶν τε καὶ τῶν χρήσιες."
  },
  {
    "id": "p-c3421b",
    "offset": 1185,
    "text": "οὐκ ἔραμαι πολὺν ἐν μεγάρῳ πλοῦτον κατακρύψαις ἔχειν,"
  },
  {
    "id": "p-2106eb",
    "offset": 1240,
    "text": "ἀλλʼ ἐόντων εὖ τε παθεῖν καὶ ἀκοῦσαι φίλοις ἐξαρκέων. κοιναὶ γὰρ ἔρχοντʼ ἐλπίδες"
  },
  {
    "id": "p-27b7ac",
    "offset": 1322,
    "text": "πολυπόνων ἀνδρῶν. ἐγὼ δʼ Ἡρακλέος ἀντέχομαι προφρόνως,"
  },
  {
    "id": "p-d84d2a",
    "offset": 1378,
    "text": "ἐν κορυφαῖς ἀρετᾶν μεγάλαις ἀρχαῖον ὀτρύνων λόγον,"
  },
  {
    "id": "p-e4ef53",
    "offset": 1430,
    "text": "ὡς, ἐπεὶ σπλάγχνων ὕπο ματέρος αὐτίκα θαητὰν ἐς αἴγλαν παῖς Διὸς"
  },
  {
    "id": "p-256a0e",
    "offset": 1496,
    "text": "ὠδῖνα φεύγων διδύμῳ σὺν κασιγνήτῳ μόλεν,"
  },
  {
    "id": "p-1389cf",
    "offset": 1538,
    "text": "ὡς οὐ λαθὼν χρυσόθρονον"
  },
  {
    "id": "p-c6acbf",
    "offset": 1563,
    "text": "Ἥραν κροκωτὸν σπάργανον ἐγκατέβα·"
  },
  {
    "id": "p-89bc80",
    "offset": 1598,
    "text": "ἀλλὰ θεῶν βασιλ έα"
  },
  {
    "id": "p-4bc68e",
    "offset": 1618,
    "text": "σπερχθεῖσα θυμῷ πέμπε δράκοντας ἄφαρ."
  },
  {
    "id": "p-a16c5a",
    "offset": 1657,
    "text": "τοὶ μὲν οἰχθεισᾶν πυλᾶν"
  },
  {
    "id": "p-8ae420",
    "offset": 1682,
    "text": "ἐς θαλάμου μυχὸν εὐρὺν ἔβαν, τέκνοισιν ὠκείας γνάθους"
  },
  {
    "id": "p-c9d844",
    "offset": 1737,
    "text": "ἀμφελίξασθαι μεμαῶτες· ὁ δʼ ὀρθὸν μὲν ἄντεινεν κάρα, πειρᾶτο δὲ πρῶτον μάχας,"
  },
  {
    "id": "p-54c6d7",
    "offset": 1816,
    "text": "δισσαῖσι δοιοὺς αὐχένων"
  },
  {
    "id": "p-3d9531",
    "offset": 1841,
    "text": "μάρψαις ἀφύκτοις χερσὶν ἑαῖς ὄφιας·"
  },
  {
    "id": "p-d99fc7",
    "offset": 1878,
    "text": "ἀγχομένοις δὲ χρόνος"
  },
  {
    "id": "p-9b206c",
    "offset": 1900,
    "text": "ψυχὰς ἀπέπνευσεν μελέων ἀφάτων."
  },
  {
    "id": "p-ed2fc2",
    "offset": 1933,
    "text": "ἐκ δʼ ἄρʼ ἄτλατον δέος"
  },
  {
    "id": "p-6c3068",
    "offset": 1957,
    "text": "πλᾶξε γυναῖκας, ὅσαι τύχον Ἀλκμήνας ἀρήγοισαι λέχει·"
  },
  {
    "id": "p-67639b",
    "offset": 2011,
    "text": "καὶ γὰρ αὐτά, ποσσὶν ἄπεπλος ὀρούσαισʼ ἀπὸ στρωμνᾶς, ὅμως ἄμυνεν ὕβριν κνωδάλων."
  },
  {
    "id": "p-50ad0d",
    "offset": 2093,
    "text": "ταχὺ δὲ Καδμείων ἀγοὶ χαλκέοις ἀθρόοι σὺν ὅπλοις ἔδραμον·"
  },
  {
    "id": "p-8cdfbd",
    "offset": 2152,
    "text": "ἐν χερὶ δʼ Ἀμφιτρύων κολεοῦ γυμνὸν τινάσσων φάσγανον"
  },
  {
    "id": "p-bbe98d",
    "offset": 2206,
    "text": "ἵκετʼ, ὀξείαις ἀνίαισι τυπείς. τὸ γὰρ οἰκεῖον πιέζει πάνθʼ ὁμῶς·"
  },
  {
    "id": "p-72849d",
    "offset": 2272,
    "text": "εὐθὺς δʼ ἀπήμων κραδία κᾶδος ἀμφʼ ἀλλότριον."
  },
  {
    "id": "p-21688e",
    "offset": 2318,
    "text": "ἔστα δὲ θάμβει δυσφόρῳ"
  },
  {
    "id": "p-c1a87a",
    "offset": 2342,
    "text": "τερπνῷ τε μιχθείς. εἶδε γὰρ ἐκνόμιον"
  },
  {
    "id": "p-8a41f1",
    "offset": 2380,
    "text": "λῆμά τε καὶ δύναμιν"
  },
  {
    "id": "p-665689",
    "offset": 2401,
    "text": "υἱοῦ παλίγγλωσσον δέ οἱ ἀθάνατοι"
  },
  {
    "id": "p-8d2988",
    "offset": 2435,
    "text": "ἀγγέλων ῥῆσιν θέσαν."
  },
  {
    "id": "p-4d5123",
    "offset": 2457,
    "text": "γείτονα δʼ ἐκκάλεσεν Διὸς ὑψίστου προφάταν ἔξοχον,"
  },
  {
    "id": "p-92040a",
    "offset": 2509,
    "text": "ὀρθόμαντιν Τειρεσίαν· ὁ δέ οἱ φράζε καὶ παντὶ στρατῷ, ποίαις ὁμιλήσει τύχαις,"
  },
  {
    "id": "p-eac155",
    "offset": 2588,
    "text": "ὅσσους μὲν ἐν χέρσῳ κτανών,"
  },
  {
    "id": "p-9e80e6",
    "offset": 2617,
    "text": "ὅσσους δὲ πόντῳ θῆρας ἀϊδροδίκας·"
  },
  {
    "id": "p-c3b404",
    "offset": 2652,
    "text": "καί τινα σὺν πλαγίῳ"
  },
  {
    "id": "p-9b04b0",
    "offset": 2673,
    "text": "ἀνδρῶν κόρῳ στείχοντα τὸν ἐχθρότατον"
  },
  {
    "id": "p-58e2e1",
    "offset": 2711,
    "text": "φᾶσέ νιν δώσειν μόρῳ."
  },
  {
    "id": "p-2553e7",
    "offset": 2734,
    "text": "καὶ γὰρ ὅταν θεοὶ ἐν πεδίῳ Φλέγρας Γιγάντεσσιν μάχαν"
  },
  {
    "id": "p-4efd58",
    "offset": 2788,
    "text": "ἀντιάζωσιν, βελέων ὑπὸ ῥιπαῖσι κείνου φαιδίμαν γαίᾳ πεφύρσεσθαι κόμαν"
  },
  {
    "id": "p-877802",
    "offset": 2859,
    "text": "ἔνεπεν· αὐτὸν μὰν ἐν εἰράνᾳ καμάτων μεγάλων ἐν σχερῷ"
  },
  {
    "id": "p-2bb84c",
    "offset": 2913,
    "text": "ἁσυχίαν τὸν ἅπαντα χρόνον ποινὰν λαχόντʼ ἐξαίρετον"
  },
  {
    "id": "p-0b5d49",
    "offset": 2965,
    "text": "ὀλβίοις ἐν δώμασι, δεξάμενον θαλερὰν Ἥβαν ἄκοιτιν καὶ γάμον"
  },
  {
    "id": "p-0e8ad5",
    "offset": 3026,
    "text": "δαίσαντα, πὰρ Δὶ Κρονίδᾳ σεμνὸν αἰνήσειν νόμον."
  }
]