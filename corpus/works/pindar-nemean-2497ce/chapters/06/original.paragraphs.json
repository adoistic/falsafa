[
  {
    "id": "p-e47613",
    "offset": 0,
    "text": "ἓν ἀνδρῶν, ἓν θεῶν γένος· ἐκ μιᾶς δὲ πνέομεν"
  },
  {
    "id": "p-c497ae",
    "offset": 46,
    "text": "ματρὸς ἀμφότεροι· διείργει δὲ πᾶσα κεκριμένα"
  },
  {
    "id": "p-e6c59e",
    "offset": 92,
    "text": "δύναμις, ὡς τὸ μὲν οὐδέν, ὁ δὲ χάλκεος ἀσφαλὲς αἰὲν ἕδος"
  },
  {
    "id": "p-f65c76",
    "offset": 150,
    "text": "μένει οὐρανός. ἀλλά τι προσφέρομεν ἔμπαν ἢ μέγαν"
  },
  {
    "id": "p-1c5f39",
    "offset": 200,
    "text": "νόον ἤτοι φύσιν ἀθανάτοις,"
  },
  {
    "id": "p-a750a1",
    "offset": 228,
    "text": "καίπερ ἐφαμερίαν οὐκ εἰδότες οὐδὲ μετὰ νύκτας ἄμμε πότμος"
  },
  {
    "id": "p-af80b2",
    "offset": 287,
    "text": "οἵαν τινʼ ἔγραψε δραμεῖν ποτὶ στάθμαν."
  },
  {
    "id": "p-154d2a",
    "offset": 327,
    "text": "τεκμαίρει καί νυν Ἀλκιμίδας τὸ συγγενὲς ἰδεῖν"
  },
  {
    "id": "p-09f852",
    "offset": 374,
    "text": "ἄγχι καρποφόροις ἀρούραισιν, αἵτʼ ἀμειβόμεναι"
  },
  {
    "id": "p-5178d6",
    "offset": 421,
    "text": "τόκα μὲν ὦν βίον ἀνδράσιν ἐπηετανὸν πεδίων ἔδοσαν,"
  },
  {
    "id": "p-8890fc",
    "offset": 473,
    "text": "τόκα δʼ αὖτʼ ἀναπαυσάμεναι σθένος ἔμαρψαν. ἦλθέ τοι"
  },
  {
    "id": "p-3198f9",
    "offset": 526,
    "text": "Νεμέας ἐξ ἐρατῶν ἀέθλων"
  },
  {
    "id": "p-6ec498",
    "offset": 551,
    "text": "παῖς ἐναγώνιος, ὃς ταύταν μεθέπων Διόθεν αἶσαν νῦν πέφανται"
  },
  {
    "id": "p-c0ad70",
    "offset": 612,
    "text": "οὐκ ἄμμορος ἀμφὶ πάλᾳ κυναγέτας,"
  },
  {
    "id": "p-00acc7",
    "offset": 646,
    "text": "ἴχνεσιν ἐν Πραξιδάμαντος ἑὸν πόδα νέμων"
  },
  {
    "id": "p-22e514",
    "offset": 687,
    "text": "πατροπάτορος ὁμαιμίου."
  },
  {
    "id": "p-fc755a",
    "offset": 711,
    "text": "κεῖνος γὰρ Ὀλυμπιόνικος ἐὼν Αἰακίδαις"
  },
  {
    "id": "p-872b1a",
    "offset": 750,
    "text": "ἔρνεα πρῶτος ἔνεικεν ἀπʼ Ἀλφεοῦ,"
  },
  {
    "id": "p-db23d2",
    "offset": 784,
    "text": "καὶ πεντάκις Ἰσθμοῖ στεφανωσάμενος,"
  },
  {
    "id": "p-e2d23c",
    "offset": 821,
    "text": "νεμέᾳ δὲ τρίς,"
  },
  {
    "id": "p-6dbff5",
    "offset": 837,
    "text": "ἔπαυσε λάθαν"
  },
  {
    "id": "p-246712",
    "offset": 851,
    "text": "Σωκλείδα, ὃς ὑπέρτατος"
  },
  {
    "id": "p-06a83e",
    "offset": 875,
    "text": "Ἁγησιμάχῳ υἱέων γένετο."
  },
  {
    "id": "p-ea22f7",
    "offset": 900,
    "text": "ἐπεί οἱ τρεῖς ἀεθλοφόροι πρὸς ἄκρον ἀρετᾶς"
  },
  {
    "id": "p-dce52f",
    "offset": 944,
    "text": "ἦλθον, οἵτε πόνων ἐγεύσαντο. σὺν θεοῦ δὲ τύχᾳ"
  },
  {
    "id": "p-5273fc",
    "offset": 991,
    "text": "ἕτερον οὔ τινα οἶκον ἀπεφάνατο πυγμαχία πλεόνων"
  },
  {
    "id": "p-16ab08",
    "offset": 1040,
    "text": "ταμίαν στεφάνων μυχῷ Ἑλλάδος ἁπάσας. ἔλπομαι"
  },
  {
    "id": "p-161bac",
    "offset": 1086,
    "text": "μέγα εἰπὼν σκοποῦ ἄντα τυχεῖν"
  },
  {
    "id": "p-a96215",
    "offset": 1117,
    "text": "ὥτʼ ἀπὸ τόξου ἱείς· εὔθυνʼ ἐπὶ τοῦτον, ἄγε, Μοῖσα, οὖρον ἐπέων"
  },
  {
    "id": "p-e4caa2",
    "offset": 1181,
    "text": "εὐκλέα. παροιχομένων γὰρ ἀνέρων"
  },
  {
    "id": "p-091759",
    "offset": 1214,
    "text": "ἀοιδαὶ καὶ λόγοι τὰ καλά σφιν ἔργʼ ἐκόμισαν,"
  },
  {
    "id": "p-57d0f9",
    "offset": 1260,
    "text": "Βασσίδαισιν ἅ τʼ οὐ σπανίζει· παλαίφατος γενεά,"
  },
  {
    "id": "p-53538a",
    "offset": 1309,
    "text": "ἴδια ναυστολέοντες ἐπικώμια, Πιερίδων ἀρόταις"
  },
  {
    "id": "p-5d559e",
    "offset": 1356,
    "text": "δυνατοὶ παρέχειν πολὺν ὕμνον ἀγερώχων ἑργμάτων"
  },
  {
    "id": "p-48d187",
    "offset": 1404,
    "text": "ἕνεκεν. καὶ γὰρ ἐν ἀγαθέᾳ"
  },
  {
    "id": "p-9c212d",
    "offset": 1431,
    "text": "χεῖρας ἱμάντι δεθεὶς Πυθῶνι κράτησεν ἀπὸ ταύτας αἷμα πάτρας"
  },
  {
    "id": "p-8d8b99",
    "offset": 1492,
    "text": "χρυσαλακάτου ποτὲ Καλλίας ἁδὼν"
  },
  {
    "id": "p-93cb44",
    "offset": 1524,
    "text": "ἔρνεσι Λατοῦς, παρὰ Κασταλίᾳ τε Χαρίτων"
  },
  {
    "id": "p-87faf9",
    "offset": 1565,
    "text": "ἑσπέριος ὁμάδῳ φλέγεν·"
  },
  {
    "id": "p-e0b9e9",
    "offset": 1589,
    "text": "πόντου τε γέφυρʼ ἀκάμαντος ἐν ἀμφικτιόνων"
  },
  {
    "id": "p-3f36ac",
    "offset": 1632,
    "text": "ταυροφόνῳ τριετηρίδι Κρ εο ντίδαν"
  },
  {
    "id": "p-7f8cd8",
    "offset": 1667,
    "text": "τίμασε Ποσειδάνιον ἂν τέμενος·"
  },
  {
    "id": "p-449404",
    "offset": 1699,
    "text": "βοτάνα τέ νιν"
  },
  {
    "id": "p-115e0e",
    "offset": 1714,
    "text": "πόθʼ ἁ λέοντος"
  },
  {
    "id": "p-ea2491",
    "offset": 1730,
    "text": "νικάσαντʼ ἤρεφε δασκίοις"
  },
  {
    "id": "p-54ff37",
    "offset": 1756,
    "text": "Φλιοῦντος ὑπʼ ὠγυγίοις ὄρεσιν."
  },
  {
    "id": "p-b6939a",
    "offset": 1788,
    "text": "πλατεῖαι πάντοθεν λογίοισιν ἐντὶ πρόσοδοι"
  },
  {
    "id": "p-7e50eb",
    "offset": 1831,
    "text": "νᾶσον εὐκλέα τάνδε κοσμεῖν· ἐπεί σφιν Αἰακίδαι"
  },
  {
    "id": "p-9b2733",
    "offset": 1879,
    "text": "ἔπορον ἔξοχον αἶσαν ἀρετὰς ἀποδεικνύμενοι μεγάλας·"
  },
  {
    "id": "p-014e68",
    "offset": 1931,
    "text": "πέταται δʼ ἐπί τε χθόνα καὶ διὰ θαλάσσας τηλόθεν"
  },
  {
    "id": "p-415010",
    "offset": 1981,
    "text": "ὄνυμʼ αὐτῶν· καὶ ἐς Αἰθίοπας"
  },
  {
    "id": "p-971135",
    "offset": 2011,
    "text": "Μέμνονος οὐκ ἀπονοστήσαντος ἐπᾶλτο· βαρὺ δέ σφιν νεῖκος Ἀχιλεὺς"
  },
  {
    "id": "p-de6902",
    "offset": 2076,
    "text": "ἔμπεσε χαμαὶ καταβὰς ἀφʼ ἁρμάτων,"
  },
  {
    "id": "p-32caa7",
    "offset": 2111,
    "text": "φαεννᾶς υἱὸν εὖτʼ ἐνάριξεν Ἀόος ἀκμᾷ"
  },
  {
    "id": "p-878153",
    "offset": 2149,
    "text": "ἔγχεος ζακότοιο. καὶ ταύταν μὲν παλαιότεροι"
  },
  {
    "id": "p-977ba1",
    "offset": 2194,
    "text": "ὁδὸν ἀμαξιτὸν εὗρον· ἕπομαι δὲ καὶ αὐτὸς ἔχων μελέταν·"
  },
  {
    "id": "p-accf47",
    "offset": 2250,
    "text": "τὸ δὲ πὰρ ποδὶ ναὸς ἑλισσόμενον αἰεὶ κυμάτων"
  },
  {
    "id": "p-a990f7",
    "offset": 2296,
    "text": "λέγεται παντὶ μάλιστα δονεῖν"
  },
  {
    "id": "p-e05bb3",
    "offset": 2326,
    "text": "θυμόν. ἑκόντι δʼ ἐγὼ νώτῳ μεθέπων δίδυμον ἄχθος ἄγγελος ἔβαν,"
  },
  {
    "id": "p-3291c0",
    "offset": 2389,
    "text": "πέμπτον ἐπὶ εἴκοσι τοῦτο γαρύων"
  },
  {
    "id": "p-7e5a96",
    "offset": 2422,
    "text": "εὖχος ἀγώνων ἄπο, τοὺς ἐνέποισιν ἱερούς,"
  },
  {
    "id": "p-f5e683",
    "offset": 2464,
    "text": "Ἀλκιμίδα, τέ γʼ ἐπαρκέσαι"
  },
  {
    "id": "p-4d670f",
    "offset": 2491,
    "text": "κλειτᾷ γενεᾷ· δύο μὲν Κρονίου πὰρ τεμένει,"
  },
  {
    "id": "p-d3abab",
    "offset": 2535,
    "text": "παῖ, σέ τʼ ἐνόσφισε καὶ Πουλυτιμίδαν"
  },
  {
    "id": "p-c55fcb",
    "offset": 2573,
    "text": "κλᾶρος προπετὴς ἄνθεʼ Ὀλυμπιάδος."
  },
  {
    "id": "p-97d179",
    "offset": 2608,
    "text": "δελφῖνί κεν"
  },
  {
    "id": "p-264c85",
    "offset": 2621,
    "text": "τάχος διʼ ἅλμας"
  },
  {
    "id": "p-e597ad",
    "offset": 2638,
    "text": "ἴσον εἴποιμι Μελησίαν,"
  },
  {
    "id": "p-ebec16",
    "offset": 2662,
    "text": "χειρῶν τε καὶ ἰσχύος ἁνίοχον."
  }
]