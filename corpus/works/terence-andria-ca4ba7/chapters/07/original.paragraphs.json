[
  {
    "id": "p-d0a4bc",
    "offset": 0,
    "text": "(CHREMES. SIMO.)"
  },
  {
    "id": "p-0d2190",
    "offset": 18,
    "text": "CHREMES:\nSatis iam satis Simo spectata erga te amicitia est mea:"
  },
  {
    "id": "p-fbb6ba",
    "offset": 84,
    "text": "Satis pericli coepi adire: orandi iam finem face."
  },
  {
    "id": "p-c8f4cb",
    "offset": 135,
    "text": "Dum studeo obsequi tibi paene illusi vitam filiae."
  },
  {
    "id": "p-c21559",
    "offset": 187,
    "text": "SIMO:\nImmo enim nunc quum maxime abs te postulo atque oro Chreme"
  },
  {
    "id": "p-f27681",
    "offset": 253,
    "text": "Ut beneficium verbis initum dudum nunc re comprobes."
  },
  {
    "id": "p-eb3862",
    "offset": 307,
    "text": "CHREMES:\nVide quam iniquus sis prae studio. Dum id efficias quod cupis,"
  },
  {
    "id": "p-7fe331",
    "offset": 380,
    "text": "Neque modum benignitatis neque quid me ores cogitas:"
  },
  {
    "id": "p-15d604",
    "offset": 434,
    "text": "Nam si cogites, remittas iam me onerare iniuriis."
  },
  {
    "id": "p-5ca9f8",
    "offset": 485,
    "text": "SIMO:\nQuibus?"
  },
  {
    "id": "p-f033f5",
    "offset": 500,
    "text": "CHREMES:\nAh! rogitas? perpulisti me ut homini adolescentulo"
  },
  {
    "id": "p-189cc1",
    "offset": 561,
    "text": "In alio occupato amore, abhorrenti ab re uxoria,"
  },
  {
    "id": "p-e0fc2a",
    "offset": 611,
    "text": "Filiam darem in seditionem atque in incertas nuptias,"
  },
  {
    "id": "p-3dbef6",
    "offset": 666,
    "text": "Eius labore atque eius dolore gnato ut medicarer tuo."
  },
  {
    "id": "p-f9d6c5",
    "offset": 721,
    "text": "Impetrasti: incepi dum res tetulit: nunc non fert; feras."
  },
  {
    "id": "p-530695",
    "offset": 780,
    "text": "Illam hinc civem esse aiunt: puer est natus: nos missos face."
  },
  {
    "id": "p-73a835",
    "offset": 843,
    "text": "SIMO:"
  },
  {
    "id": "p-8684b2",
    "offset": 850,
    "text": "Per ego te deos oro ut ne illis animum inducas credere"
  },
  {
    "id": "p-d94a6c",
    "offset": 906,
    "text": "Quibus id maxime utile est illum esse quam deterrimum."
  },
  {
    "id": "p-1d1667",
    "offset": 962,
    "text": "Nuptiarum gratia haec sunt ficta atque incepta omnia."
  },
  {
    "id": "p-fd3275",
    "offset": 1017,
    "text": "Ubi ea causa quamobrem haec faciunt erit adempta his desinent."
  },
  {
    "id": "p-3e708d",
    "offset": 1081,
    "text": "CHREMES:\nErras: cum Davo egomet vidi iurgantem ancillam."
  },
  {
    "id": "p-9241ae",
    "offset": 1139,
    "text": "SIMO:\nScio."
  },
  {
    "id": "p-024104",
    "offset": 1152,
    "text": "CHREMES:\nAt"
  },
  {
    "id": "p-d7527d",
    "offset": 1165,
    "text": "Vero vultu; quum ibi me adesse neuter tum praesenserat."
  },
  {
    "id": "p-44ebf3",
    "offset": 1222,
    "text": "SIMO:\nCredo; et id facturas Davus dudum praedixit mihi:"
  },
  {
    "id": "p-cceba2",
    "offset": 1279,
    "text": "Et nescio qui tibi sum oblitus hodie ac volui dicere."
  },
  {
    "id": "p-ce511c",
    "offset": 1334,
    "text": "(DAVUS. CHREMES. SIMO. DROMO.)"
  },
  {
    "id": "p-7adfa4",
    "offset": 1366,
    "text": "DAVUS:\nAnimo nunc iam otioso esse impero—"
  },
  {
    "id": "p-e29142",
    "offset": 1409,
    "text": "CHREMES:\nHem Davum tibi."
  },
  {
    "id": "p-5687cc",
    "offset": 1435,
    "text": "SIMO:\nUnde egreditur?"
  },
  {
    "id": "p-3f6380",
    "offset": 1458,
    "text": "DAVUS:\nmeo praesidio atque hospitis."
  },
  {
    "id": "p-319303",
    "offset": 1496,
    "text": "SIMO:\nQuid illud mali est?"
  },
  {
    "id": "p-bbdf1e",
    "offset": 1524,
    "text": "DAVUS:\nEgo commodiorem hominem, adventum, tempus non vidi."
  },
  {
    "id": "p-82de63",
    "offset": 1584,
    "text": "SIMO:\nScelus,"
  },
  {
    "id": "p-4d3a09",
    "offset": 1599,
    "text": "Quem nam hic laudat?"
  },
  {
    "id": "p-6616f5",
    "offset": 1621,
    "text": "DAVUS:\nOmnis res est iam in vado."
  },
  {
    "id": "p-ac8535",
    "offset": 1656,
    "text": "SIMO:\nCesso alloqui?"
  },
  {
    "id": "p-fb0d88",
    "offset": 1678,
    "text": "DAVUS:"
  },
  {
    "id": "p-9d8e9d",
    "offset": 1686,
    "text": "Herus est: quid agam?"
  },
  {
    "id": "p-8d07ae",
    "offset": 1709,
    "text": "SIMO:\nO salve bone vir."
  },
  {
    "id": "p-a095c0",
    "offset": 1734,
    "text": "DAVUS:\nEhem Simo! o noster Chreme!"
  },
  {
    "id": "p-b09db8",
    "offset": 1770,
    "text": "Omnia apparata iam sunt intus."
  },
  {
    "id": "p-70da18",
    "offset": 1802,
    "text": "SIMO:\nCurasti probe."
  },
  {
    "id": "p-88cf1d",
    "offset": 1824,
    "text": "DAVUS:\nUbi voles arcesse."
  },
  {
    "id": "p-2694b6",
    "offset": 1851,
    "text": "SIMO:\nBene sane; id enimvero hinc nunc abest."
  },
  {
    "id": "p-e2e1ee",
    "offset": 1898,
    "text": "Etiam tu hoc respondes? quid istic tibi negoti est?"
  },
  {
    "id": "p-c78e96",
    "offset": 1951,
    "text": "DAVUS:\nMihine?"
  },
  {
    "id": "p-0e99e6",
    "offset": 1967,
    "text": "SIMO:\nIta."
  },
  {
    "id": "p-c78e96",
    "offset": 1979,
    "text": "DAVUS:\nMihine?"
  },
  {
    "id": "p-4a8b3f",
    "offset": 1995,
    "text": "SIMO:\nTibi ergo."
  },
  {
    "id": "p-ecba2e",
    "offset": 2013,
    "text": "DAVUS:\nModo introii."
  },
  {
    "id": "p-5f4264",
    "offset": 2035,
    "text": "SIMO:\nQuasi ego, quam dudum, rogem."
  },
  {
    "id": "p-fb0d88",
    "offset": 2072,
    "text": "DAVUS:"
  },
  {
    "id": "p-72fef5",
    "offset": 2080,
    "text": "Cum tuo gnato una."
  },
  {
    "id": "p-39c5cc",
    "offset": 2100,
    "text": "SIMO:\nAnne est intus Pamphilus? crucior miser."
  },
  {
    "id": "p-54c5fe",
    "offset": 2148,
    "text": "Eho, non tu dixti esse inter eos inimicitias, carnufex?"
  },
  {
    "id": "p-af8dfa",
    "offset": 2205,
    "text": "DAVUS:\nSunt."
  },
  {
    "id": "p-88d72e",
    "offset": 2219,
    "text": "SIMO:\nCur igitur hic est?"
  },
  {
    "id": "p-44843a",
    "offset": 2246,
    "text": "CHREMES:\nQuid illum census? cum illa litigat."
  },
  {
    "id": "p-5b0895",
    "offset": 2293,
    "text": "DAVUS:\nImmo vero indignum Chreme iam facinus faxo ex me audias."
  },
  {
    "id": "p-29fd2d",
    "offset": 2358,
    "text": "Nescio quis senex modo venit: ellum confidens, catus."
  },
  {
    "id": "p-2f6f03",
    "offset": 2413,
    "text": "Quum faciem videas videtur esse quantivis preti."
  },
  {
    "id": "p-7a18a2",
    "offset": 2463,
    "text": "Tristis severitas inest in vultu, atque in verbis fides."
  },
  {
    "id": "p-2ec675",
    "offset": 2521,
    "text": "SIMO:\nQuidnam apportas?"
  },
  {
    "id": "p-8a27bb",
    "offset": 2546,
    "text": "DAVUS:\nNihil equidem nisi quod illum audivi dicere."
  },
  {
    "id": "p-2ecdee",
    "offset": 2599,
    "text": "SIMO:\nQuid ait tandem?"
  },
  {
    "id": "p-c30fef",
    "offset": 2623,
    "text": "DAVUS:\nGlycerium se scire civem esse Atticam."
  },
  {
    "id": "p-2acbd5",
    "offset": 2670,
    "text": "SIMO:\nHem,"
  },
  {
    "id": "p-bf13a2",
    "offset": 2682,
    "text": "Dromo, Dromo."
  },
  {
    "id": "p-7f501b",
    "offset": 2697,
    "text": "DAVUS:\nQuid est?"
  },
  {
    "id": "p-752d23",
    "offset": 2715,
    "text": "SIMO:\nDromo."
  },
  {
    "id": "p-149c38",
    "offset": 2729,
    "text": "DAVUS:\nAudi."
  },
  {
    "id": "p-fa91ea",
    "offset": 2743,
    "text": "SIMO:\nVerbum si addideris. Dromo."
  },
  {
    "id": "p-fb0d88",
    "offset": 2778,
    "text": "DAVUS:"
  },
  {
    "id": "p-9755fb",
    "offset": 2786,
    "text": "Audi, obsecro."
  },
  {
    "id": "p-7a24e7",
    "offset": 2802,
    "text": "DROMO:\nQuid vis?"
  },
  {
    "id": "p-690dbb",
    "offset": 2820,
    "text": "SIMO:\nSublimem hunc intro rape, quantum potes."
  },
  {
    "id": "p-cb0bbb",
    "offset": 2868,
    "text": "DROMO:\nQuem?"
  },
  {
    "id": "p-97415a",
    "offset": 2882,
    "text": "SIMO:\nDavum."
  },
  {
    "id": "p-25ba41",
    "offset": 2896,
    "text": "DAVUS:\nQuamobrem?"
  },
  {
    "id": "p-8b5150",
    "offset": 2915,
    "text": "SIMO:\nQuia libet: rape, inquam."
  },
  {
    "id": "p-b324b4",
    "offset": 2948,
    "text": "DAVUS:\nQuid feci?"
  },
  {
    "id": "p-58c29b",
    "offset": 2967,
    "text": "SIMO:\nRape."
  },
  {
    "id": "p-857d97",
    "offset": 2980,
    "text": "DAVUS:\nSi quicquam invenies me mentitum, occidito."
  },
  {
    "id": "p-df74b3",
    "offset": 3032,
    "text": "SIMO:\nNihil audio."
  },
  {
    "id": "p-3dc931",
    "offset": 3052,
    "text": "Ego iam te commotum reddam."
  },
  {
    "id": "p-46ef0b",
    "offset": 3081,
    "text": "DAVUS:\nTamen etsi hoc verum est?"
  },
  {
    "id": "p-3efb5b",
    "offset": 3115,
    "text": "SIMO:\nTamen."
  },
  {
    "id": "p-05cd37",
    "offset": 3129,
    "text": "Cura asservandum vinctum: atque audin? quadrupedem constringito."
  },
  {
    "id": "p-a8db59",
    "offset": 3195,
    "text": "Age nunc iam: ego pol hodie, si vivo, tibi"
  },
  {
    "id": "p-ce35c9",
    "offset": 3239,
    "text": "Ostendam herum quid sit pericli fallere,"
  },
  {
    "id": "p-57265f",
    "offset": 3281,
    "text": "Et illi, patrem."
  },
  {
    "id": "p-d1aa88",
    "offset": 3299,
    "text": "CHREMES:\nAh, ne saevi tantopere."
  },
  {
    "id": "p-c3f089",
    "offset": 3333,
    "text": "SIMO:\nO Chreme,"
  },
  {
    "id": "p-ae3a5d",
    "offset": 3350,
    "text": "Pietatem gnati! nonne te miseret mei;"
  },
  {
    "id": "p-f7b04b",
    "offset": 3389,
    "text": "Tantum laborem capere ob talem filium?"
  },
  {
    "id": "p-412af3",
    "offset": 3429,
    "text": "Age Pamphile, exi Pamphile: ecquid te pudet?"
  },
  {
    "id": "p-ce9bbf",
    "offset": 3475,
    "text": "(PAMPHILUS. SIMO. CHREMES.)"
  },
  {
    "id": "p-6f1215",
    "offset": 3504,
    "text": "PAMPHILUS:\nQuis me vult? perii: pater est."
  },
  {
    "id": "p-dae618",
    "offset": 3548,
    "text": "SIMO:\nQuid ais, omnium—?"
  },
  {
    "id": "p-d377d0",
    "offset": 3574,
    "text": "CHREMES:\nAh,"
  },
  {
    "id": "p-484173",
    "offset": 3588,
    "text": "Rem potius ipsam dic, ac mitte male loqui."
  },
  {
    "id": "p-fbf981",
    "offset": 3632,
    "text": "SIMO:\nQuasi quicquam in hunc iam gravius dici possiet."
  },
  {
    "id": "p-8f3679",
    "offset": 3688,
    "text": "Ain tandem? civis Glycerium est?"
  },
  {
    "id": "p-837999",
    "offset": 3722,
    "text": "PAMPHILUS:\nIta praedicant."
  },
  {
    "id": "p-73a835",
    "offset": 3750,
    "text": "SIMO:"
  },
  {
    "id": "p-bd3f98",
    "offset": 3757,
    "text": "Ita praedicant! O ingentem confidentiam!"
  },
  {
    "id": "p-c15655",
    "offset": 3799,
    "text": "Num cogitat quid dicat? num facti piget?"
  },
  {
    "id": "p-0f434c",
    "offset": 3841,
    "text": "Num eius color pudoris signum usquam indicat?"
  },
  {
    "id": "p-2e4d38",
    "offset": 3888,
    "text": "Adeo impotenti esse animo ut praeter civium"
  },
  {
    "id": "p-e7b90c",
    "offset": 3933,
    "text": "Morem atque legem et sui voluntatem patris"
  },
  {
    "id": "p-ce3819",
    "offset": 3977,
    "text": "Tamen hanc habere studeat cum summo probro?"
  },
  {
    "id": "p-d7f5d3",
    "offset": 4022,
    "text": "PAMPHILUS:\nMe miserum!"
  },
  {
    "id": "p-6501be",
    "offset": 4046,
    "text": "SIMO:\nHem! modone id demum sensti Pamphile?"
  },
  {
    "id": "p-2c30e0",
    "offset": 4091,
    "text": "Olim istuc, olim, cum ita animum induxti tuum"
  },
  {
    "id": "p-7d5b5d",
    "offset": 4138,
    "text": "Quod cuperes aliquo pacto efficiendum tibi,"
  },
  {
    "id": "p-9f75bf",
    "offset": 4183,
    "text": "Eodem die istuc verbum vere in te accidit."
  },
  {
    "id": "p-717ebc",
    "offset": 4227,
    "text": "Sed quid ego? cur me excrucio? cur me macero"
  },
  {
    "id": "p-515eb2",
    "offset": 4273,
    "text": "Cur meam senectutem huius sollicito amentia? an"
  },
  {
    "id": "p-34a750",
    "offset": 4322,
    "text": "Ut pro huius peccatis ego supplicium sufferam?"
  },
  {
    "id": "p-482f72",
    "offset": 4370,
    "text": "Immo habeat; valeat; vivat cum illa."
  },
  {
    "id": "p-05c739",
    "offset": 4408,
    "text": "PAMPHILUS:\nMi pater."
  },
  {
    "id": "p-274d57",
    "offset": 4430,
    "text": "SIMO:\nQuid mi pater? quasi tu huius indigeas patris."
  },
  {
    "id": "p-91c6d0",
    "offset": 4484,
    "text": "Domus, uxor, liberi inventi invito patre:"
  },
  {
    "id": "p-baed9b",
    "offset": 4527,
    "text": "Adducti qui illam civem hinc dicant: viceris."
  },
  {
    "id": "p-a6fd1d",
    "offset": 4574,
    "text": "PAMPHILUS:\nPater licetne pauca?"
  },
  {
    "id": "p-118541",
    "offset": 4607,
    "text": "SIMO:\nQuid dices mihi?"
  },
  {
    "id": "p-46dc03",
    "offset": 4631,
    "text": "CHREMES:\nTamen Simo audi."
  },
  {
    "id": "p-b85a52",
    "offset": 4658,
    "text": "SIMO:\nEgo audiam? quid ego audiam"
  },
  {
    "id": "p-0779b0",
    "offset": 4693,
    "text": "Chreme?"
  },
  {
    "id": "p-c086c0",
    "offset": 4702,
    "text": "CHREMES:\nAt tandem dicat sine."
  },
  {
    "id": "p-d7dd96",
    "offset": 4734,
    "text": "SIMO:\nAge dicat; sino."
  },
  {
    "id": "p-8c1b5e",
    "offset": 4758,
    "text": "PAMPHILUS:"
  },
  {
    "id": "p-736ad0",
    "offset": 4770,
    "text": "Ego me amare hanc fateor: si id peccare est, fateor id quoque."
  },
  {
    "id": "p-8aefe9",
    "offset": 4834,
    "text": "Tibi pater me dedo: quidvis oneris impone; impera."
  },
  {
    "id": "p-aa86bd",
    "offset": 4886,
    "text": "Vis me uxorem ducere? hanc amittere? ut potero, feram."
  },
  {
    "id": "p-79fa4c",
    "offset": 4942,
    "text": "Hoc modo te obsecro, ut ne credas a me allegatum hunc senem."
  },
  {
    "id": "p-3f6f8c",
    "offset": 5004,
    "text": "Sine me expurgem atque illum huc coram adducam."
  },
  {
    "id": "p-a4f8f3",
    "offset": 5053,
    "text": "SIMO:\nAdducas!"
  },
  {
    "id": "p-91c1bc",
    "offset": 5069,
    "text": "PAMPHILUS:\nSine, pater."
  },
  {
    "id": "p-25952d",
    "offset": 5094,
    "text": "CHREMES:"
  },
  {
    "id": "p-c0b918",
    "offset": 5104,
    "text": "Aequum postulat: da veniam."
  },
  {
    "id": "p-0761ff",
    "offset": 5133,
    "text": "PAMPHILUS:\nSine te hoc exorem."
  },
  {
    "id": "p-dc4c72",
    "offset": 5165,
    "text": "SIMO:\nSino."
  },
  {
    "id": "p-362796",
    "offset": 5178,
    "text": "Quidvis cupio dum ne ab hoc me falli comperiar Chreme."
  },
  {
    "id": "p-003913",
    "offset": 5234,
    "text": "CHREMES:\nPro peccato magno paulum supplici satis est patri."
  },
  {
    "id": "p-fafd62",
    "offset": 5295,
    "text": "(CRITO. CHREMES. SIMO. PAMPHILUS.)"
  },
  {
    "id": "p-a5891e",
    "offset": 5331,
    "text": "CRITO:\nMitte orare: una harum quaevis causa me ut faciam monet;"
  },
  {
    "id": "p-35724f",
    "offset": 5396,
    "text": "Vel tu, vel quod verum est, vel quod ipsi cupio Glycerio."
  },
  {
    "id": "p-873ec6",
    "offset": 5455,
    "text": "CHREMES:\nAndrium ego Critonem video? certe is est."
  },
  {
    "id": "p-29c4b5",
    "offset": 5507,
    "text": "CRITO:\nSalvus sis, Chreme."
  },
  {
    "id": "p-e03e75",
    "offset": 5535,
    "text": "CHREMES:\nQuid tu Athenas insolens?"
  },
  {
    "id": "p-e5c7a3",
    "offset": 5571,
    "text": "CRITO:\nEvenit: sed hicine est Simo?"
  },
  {
    "id": "p-25952d",
    "offset": 5608,
    "text": "CHREMES:"
  },
  {
    "id": "p-9800cf",
    "offset": 5618,
    "text": "Hic."
  },
  {
    "id": "p-c900fb",
    "offset": 5624,
    "text": "SIMO:\nMen quaeris? eho tu Glycerium hinc civem esse ais?"
  },
  {
    "id": "p-473b11",
    "offset": 5682,
    "text": "CRITO:\nTu negas?"
  },
  {
    "id": "p-2aad26",
    "offset": 5700,
    "text": "SIMO:\nItane huc paratus advenis?"
  },
  {
    "id": "p-1c786e",
    "offset": 5734,
    "text": "CRITO:\nQua de re?"
  },
  {
    "id": "p-17f25a",
    "offset": 5753,
    "text": "SIMO:\nRogas?"
  },
  {
    "id": "p-2ede00",
    "offset": 5767,
    "text": "Tune impune haec facias? tune hic homines adolescentulos"
  },
  {
    "id": "p-815f22",
    "offset": 5825,
    "text": "Imperitos rerum, eductos libere, in fraudem illicis?"
  },
  {
    "id": "p-3f80fd",
    "offset": 5879,
    "text": "Sollicitando et pollicitando eorum animos lactas—?"
  },
  {
    "id": "p-211c79",
    "offset": 5931,
    "text": "CRITO:\nSanusne es?"
  },
  {
    "id": "p-73a835",
    "offset": 5951,
    "text": "SIMO:"
  },
  {
    "id": "p-c2c974",
    "offset": 5958,
    "text": "Ac meretricios amores nuptiis conglutinas?"
  },
  {
    "id": "p-e31cd2",
    "offset": 6002,
    "text": "PAMPHILUS:\nPerii! metuo ut substet hospes."
  },
  {
    "id": "p-8bdf07",
    "offset": 6046,
    "text": "CHREMES:\nSi Simo hunc noris satis,"
  },
  {
    "id": "p-1edd01",
    "offset": 6082,
    "text": "Non ita arbitrere: bonus est hic vir."
  },
  {
    "id": "p-b15a9e",
    "offset": 6121,
    "text": "SIMO:\nHic vir sit bonus?"
  },
  {
    "id": "p-83b8bc",
    "offset": 6147,
    "text": "Itane attemperate venit hodie in ipsis nuptiis,"
  },
  {
    "id": "p-f3a756",
    "offset": 6196,
    "text": "Ut veniret antehac nunquam? est vero huic credendum Chreme?"
  },
  {
    "id": "p-8c1b5e",
    "offset": 6257,
    "text": "PAMPHILUS:"
  },
  {
    "id": "p-0db484",
    "offset": 6269,
    "text": "Ni metuam patrem, habeo pro illa re illum quod moneam probe."
  },
  {
    "id": "p-83c977",
    "offset": 6331,
    "text": "SIMO:\nSycophanta."
  },
  {
    "id": "p-742c26",
    "offset": 6350,
    "text": "CRITO:\nHem!"
  },
  {
    "id": "p-dbf945",
    "offset": 6363,
    "text": "CHREMES:\nSic Crito est hic: mitte."
  },
  {
    "id": "p-ca2561",
    "offset": 6399,
    "text": "CRITO:\nVideat qui siet."
  },
  {
    "id": "p-4b12a3",
    "offset": 6424,
    "text": "Si mihi pergit quae volt dicere, ea quae non volt audiet."
  },
  {
    "id": "p-bcb3dd",
    "offset": 6483,
    "text": "Ego istaec moveo, aut curo? non tu tuum malum aequo animo feres?"
  },
  {
    "id": "p-1c6335",
    "offset": 6549,
    "text": "Nam ego quae dico vera an falsa audieris iam sciri potest."
  },
  {
    "id": "p-f45401",
    "offset": 6609,
    "text": "Atticus quidam olim navi fracta apud Andrum eiectus est,"
  },
  {
    "id": "p-442261",
    "offset": 6667,
    "text": "Et istaec una parva virgo: tum ille egens forte applicat"
  },
  {
    "id": "p-4ef4b9",
    "offset": 6725,
    "text": "Primum ad Chrysidis patrem se."
  },
  {
    "id": "p-274c8b",
    "offset": 6757,
    "text": "SIMO:\nFabulam inceptat."
  },
  {
    "id": "p-1fc3e8",
    "offset": 6782,
    "text": "CHREMES:\nSine."
  },
  {
    "id": "p-81fbc2",
    "offset": 6798,
    "text": "CRITO:\nItane vero obturbat?"
  },
  {
    "id": "p-9c75d3",
    "offset": 6827,
    "text": "CHREMES:\nPerge."
  },
  {
    "id": "p-f59e82",
    "offset": 6844,
    "text": "CRITO:\nTum is mihi cognatus fuit"
  },
  {
    "id": "p-a1a71c",
    "offset": 6878,
    "text": "Qui eum recepit. Ibi ego audivi ex illo sese esse Atticum."
  },
  {
    "id": "p-759b18",
    "offset": 6938,
    "text": "Is ibi mortuus est."
  },
  {
    "id": "p-6cbb41",
    "offset": 6959,
    "text": "CHREMES:\nEius nomen?"
  },
  {
    "id": "p-2ebf57",
    "offset": 6981,
    "text": "CRITO:\nNomen tam cito?"
  },
  {
    "id": "p-2fa983",
    "offset": 7005,
    "text": "PAMPHILUS:\nPhania."
  },
  {
    "id": "p-6d64b1",
    "offset": 7025,
    "text": "CHREMES:\nHem, perii."
  },
  {
    "id": "p-b60668",
    "offset": 7047,
    "text": "CRITO:\nVerum hercle opinor fuisse Phaniam: hoc certo scio"
  },
  {
    "id": "p-7a9db0",
    "offset": 7106,
    "text": "Rhamnusium se aiebat esse."
  },
  {
    "id": "p-e2e240",
    "offset": 7134,
    "text": "CHREMES:\nO Iupiter!"
  },
  {
    "id": "p-b47d16",
    "offset": 7155,
    "text": "CRITO:\nEadem haec Chreme"
  },
  {
    "id": "p-1044e8",
    "offset": 7181,
    "text": "Multi alii in Andro tum audivere."
  },
  {
    "id": "p-1ef678",
    "offset": 7216,
    "text": "CHREMES:\nUtinam id sit quod spero. Eho, dic mihi,"
  },
  {
    "id": "p-2fedf9",
    "offset": 7267,
    "text": "Quid eam tum? suamne esse aibat?"
  },
  {
    "id": "p-97d816",
    "offset": 7301,
    "text": "CRITO:\nNon."
  },
  {
    "id": "p-489a97",
    "offset": 7314,
    "text": "CHREMES:\nCuiam igitur?"
  },
  {
    "id": "p-098d4d",
    "offset": 7338,
    "text": "CRITO:\nFratris filiam."
  },
  {
    "id": "p-25952d",
    "offset": 7362,
    "text": "CHREMES:"
  },
  {
    "id": "p-fa36fb",
    "offset": 7372,
    "text": "Certe mea est."
  },
  {
    "id": "p-c0c3fb",
    "offset": 7388,
    "text": "CRITO:\nQuid ais?"
  },
  {
    "id": "p-d0fb94",
    "offset": 7406,
    "text": "SIMO:\nQuid tu ais?"
  },
  {
    "id": "p-144641",
    "offset": 7426,
    "text": "PAMPHILUS:\nArrige aures Pamphile."
  },
  {
    "id": "p-e9bc94",
    "offset": 7461,
    "text": "SIMO:\nQui credis?"
  },
  {
    "id": "p-9b1f71",
    "offset": 7480,
    "text": "CHREMES:\nPhania ille frater meus fuit."
  },
  {
    "id": "p-51e216",
    "offset": 7520,
    "text": "SIMO:\nNoram et scio."
  },
  {
    "id": "p-648605",
    "offset": 7542,
    "text": "CHREMES:\nIs hinc bellum fugiens, meque in Asiam persequens, proficiscitur."
  },
  {
    "id": "p-3ce554",
    "offset": 7618,
    "text": "Tum illam relinquere hic est veritus; postilla nunc primum audio"
  },
  {
    "id": "p-de08f0",
    "offset": 7684,
    "text": "Quid illo sit factum."
  },
  {
    "id": "p-59f991",
    "offset": 7707,
    "text": "PAMPHILUS:\nVix sum apud me, ita animus commotus est metu,"
  },
  {
    "id": "p-2bb471",
    "offset": 7766,
    "text": "Spe, gaudio, mirando hoc tanto tam repentino bono."
  },
  {
    "id": "p-881871",
    "offset": 7818,
    "text": "SIMO:\nNae istam multimodis tuam inveniri gaudeo."
  },
  {
    "id": "p-95dd83",
    "offset": 7868,
    "text": "PAMPHILUS:\nCredo pater."
  },
  {
    "id": "p-e21dfa",
    "offset": 7893,
    "text": "CHREMES:\nAt mihi unus scrupulus etiam restat qui me male habet."
  },
  {
    "id": "p-af14c9",
    "offset": 7958,
    "text": "PAMPHILUS:\nDignus es"
  },
  {
    "id": "p-b6195a",
    "offset": 7980,
    "text": "Cum tua religione odium: nodum in scirpo quaeris."
  },
  {
    "id": "p-07173f",
    "offset": 8031,
    "text": "CRITO:\nQuid istuc est?"
  },
  {
    "id": "p-f0e5c1",
    "offset": 8055,
    "text": "CHREMES:\nNomen non convenit."
  },
  {
    "id": "p-30ec97",
    "offset": 8085,
    "text": "CRITO:\nFuit hercle huic aliud parvae."
  },
  {
    "id": "p-e7a1ed",
    "offset": 8124,
    "text": "CHREMES:\nQuid Crito?"
  },
  {
    "id": "p-f94d8a",
    "offset": 8146,
    "text": "Numquid meministi?"
  },
  {
    "id": "p-051be6",
    "offset": 8166,
    "text": "CRITO:\nId quaero."
  },
  {
    "id": "p-d4dc8c",
    "offset": 8185,
    "text": "PAMPHILUS:\nEgone huius memoriam patiar meae"
  },
  {
    "id": "p-52b25c",
    "offset": 8230,
    "text": "Voluptati obstare, cum egomet possim in hac re medicari mihi?"
  },
  {
    "id": "p-6feb44",
    "offset": 8293,
    "text": "Non patiar. Heus Chreme quod quaeris, Pasibula est."
  },
  {
    "id": "p-c447dc",
    "offset": 8346,
    "text": "CRITO:\nIpsa est."
  },
  {
    "id": "p-acdaa8",
    "offset": 8364,
    "text": "CHREMES:\nEa est."
  },
  {
    "id": "p-b4ce17",
    "offset": 8382,
    "text": "PAMPHILUS:\nEx ipsa millies audivi."
  },
  {
    "id": "p-93d2e2",
    "offset": 8418,
    "text": "SIMO:\nOmnes nos gaudere hoc Chreme"
  },
  {
    "id": "p-55ce2c",
    "offset": 8454,
    "text": "Te credo credere."
  },
  {
    "id": "p-ce9bfd",
    "offset": 8473,
    "text": "CHREMES:\nIta me Di ament, credo."
  },
  {
    "id": "p-454576",
    "offset": 8507,
    "text": "PAMPHILUS:\nQuid restat, pater?"
  },
  {
    "id": "p-73a835",
    "offset": 8539,
    "text": "SIMO:"
  },
  {
    "id": "p-0446b9",
    "offset": 8546,
    "text": "Iam dudum res reduxit me ipsa in gratiam."
  },
  {
    "id": "p-19a39c",
    "offset": 8589,
    "text": "PAMPHILUS:\nO lepidum patrem!"
  },
  {
    "id": "p-fe3de0",
    "offset": 8619,
    "text": "De uxore, ita ut possedi, nihil mutat Chremes."
  },
  {
    "id": "p-fbb007",
    "offset": 8667,
    "text": "CHREMES:\nCausa optima est,"
  },
  {
    "id": "p-990b5d",
    "offset": 8695,
    "text": "Nisi quid pater ait aliud."
  },
  {
    "id": "p-1be882",
    "offset": 8723,
    "text": "PAMPHILUS:\nNempe."
  },
  {
    "id": "p-fc70c3",
    "offset": 8742,
    "text": "SIMO:\nId scilicet."
  },
  {
    "id": "p-dfb8a8",
    "offset": 8762,
    "text": "CHREMES:\nDos Pamphile est"
  },
  {
    "id": "p-38e3f6",
    "offset": 8789,
    "text": "Decem talenta."
  },
  {
    "id": "p-48d117",
    "offset": 8805,
    "text": "PAMPHILUS:\nAccipio."
  },
  {
    "id": "p-16fc51",
    "offset": 8826,
    "text": "CHREMES:\nPropero ad filiam. Eho mecum Crito:"
  },
  {
    "id": "p-d9937e",
    "offset": 8872,
    "text": "Nam illam me credo haud nosse."
  },
  {
    "id": "p-680739",
    "offset": 8904,
    "text": "SIMO:\nCur non illam huc transferri iubes?"
  },
  {
    "id": "p-8c1b5e",
    "offset": 8947,
    "text": "PAMPHILUS:"
  },
  {
    "id": "p-9bf2eb",
    "offset": 8959,
    "text": "Recte admones. Davo ego istuc dedam iam negoti."
  },
  {
    "id": "p-254873",
    "offset": 9008,
    "text": "SIMO:\nNon potest."
  },
  {
    "id": "p-0b520b",
    "offset": 9027,
    "text": "PAMPHILUS:\nQui non potest?"
  },
  {
    "id": "p-7a71d0",
    "offset": 9055,
    "text": "SIMO:\nQuia habet aliud magis ex sese et maius."
  },
  {
    "id": "p-5df170",
    "offset": 9103,
    "text": "PAMPHILUS:\nQuidnam?"
  },
  {
    "id": "p-14f998",
    "offset": 9124,
    "text": "SIMO:\nVinctus est."
  },
  {
    "id": "p-af8e04",
    "offset": 9144,
    "text": "PAMPHILUS:\nPater non recte vinctus est."
  },
  {
    "id": "p-e06d1e",
    "offset": 9185,
    "text": "SIMO:\nHaud ita iussi."
  },
  {
    "id": "p-f212db",
    "offset": 9208,
    "text": "PAMPHILUS:\nIube solvi obsecro."
  },
  {
    "id": "p-3cc3c8",
    "offset": 9240,
    "text": "SIMO:\nAge fiat."
  },
  {
    "id": "p-2f8cd8",
    "offset": 9257,
    "text": "PAMPHILUS:\nAt matura."
  },
  {
    "id": "p-817681",
    "offset": 9280,
    "text": "SIMO:\nEo intro."
  },
  {
    "id": "p-76bac5",
    "offset": 9297,
    "text": "PAMPHILUS:\nO faustum et felicem hunc diem!"
  },
  {
    "id": "p-524d02",
    "offset": 9341,
    "text": "(CHARINUS. PAMPHILUS.)"
  },
  {
    "id": "p-b39417",
    "offset": 9365,
    "text": "CHARINUS:\nProviso quid agat Pamphilus; atque eccum."
  },
  {
    "id": "p-7e1ecd",
    "offset": 9418,
    "text": "PAMPHILUS:\nAliquis forsan me putet"
  },
  {
    "id": "p-412d38",
    "offset": 9454,
    "text": "Non putare hoc verum: at mihi nunc sic esse hoc verum libet."
  },
  {
    "id": "p-d96432",
    "offset": 9516,
    "text": "Ego Deorum vitam propterea sempiternam esse arbitror"
  },
  {
    "id": "p-2a6e14",
    "offset": 9570,
    "text": "Quod voluptates eorum propriae sunt; nam mihi immortalitas"
  },
  {
    "id": "p-3c0d21",
    "offset": 9630,
    "text": "Parta est, si nulla aegritudo huic gaudio intercesserit."
  },
  {
    "id": "p-a1fe50",
    "offset": 9688,
    "text": "Sed quem ego mihi potissimum optem nunc cui haec narrem dari?"
  },
  {
    "id": "p-d4a7aa",
    "offset": 9751,
    "text": "CHARINUS:\nQuid illud gaudi est?"
  },
  {
    "id": "p-7789aa",
    "offset": 9784,
    "text": "PAMPHILUS:\nDavum video: nemo est quem mallem omnium;"
  },
  {
    "id": "p-6a46c4",
    "offset": 9838,
    "text": "Nam hunc scio mea solide solum gavisurum gaudia."
  },
  {
    "id": "p-95f559",
    "offset": 9888,
    "text": "(DAVUS. PAMPHILUS. CHARINUS.)"
  },
  {
    "id": "p-7b2a40",
    "offset": 9919,
    "text": "DAVUS:\nPamphilus ubinam hic est?"
  },
  {
    "id": "p-804baa",
    "offset": 9953,
    "text": "PAMPHILUS:\nDave."
  },
  {
    "id": "p-5e2a90",
    "offset": 9971,
    "text": "DAVUS:\nQuis homo est?"
  },
  {
    "id": "p-e487cb",
    "offset": 9994,
    "text": "PAMPHILUS:\nEgo sum."
  },
  {
    "id": "p-9dfbfc",
    "offset": 10015,
    "text": "DAVUS:\nO Pamphile."
  },
  {
    "id": "p-7bb428",
    "offset": 10035,
    "text": "PAMPHILUS:\nNescis quid mihi obtigerit."
  },
  {
    "id": "p-510cda",
    "offset": 10075,
    "text": "DAVUS:\nCerte; sed quid mihi obtigerit scio."
  },
  {
    "id": "p-574cba",
    "offset": 10120,
    "text": "PAMPHILUS:\nEt quidem ego."
  },
  {
    "id": "p-efcc0f",
    "offset": 10147,
    "text": "DAVUS:\nMore hominum evenit ut quod sim nactus mali"
  },
  {
    "id": "p-43da47",
    "offset": 10199,
    "text": "Prius rescisceres tu quam ego illud quod tibi evenit boni."
  },
  {
    "id": "p-8c1b5e",
    "offset": 10259,
    "text": "PAMPHILUS:"
  },
  {
    "id": "p-e6529d",
    "offset": 10271,
    "text": "Mea Glycerium suos parentes repperit."
  },
  {
    "id": "p-38af66",
    "offset": 10310,
    "text": "DAVUS:\nO factum bene!"
  },
  {
    "id": "p-5e634a",
    "offset": 10333,
    "text": "CHARINUS:\nHem!"
  },
  {
    "id": "p-02eaf7",
    "offset": 10349,
    "text": "PAMPHILUS:\nPater amicus summus nobis."
  },
  {
    "id": "p-c95f93",
    "offset": 10388,
    "text": "DAVUS:\nQuis?"
  },
  {
    "id": "p-3d9433",
    "offset": 10402,
    "text": "PAMPHILUS:\nChremes."
  },
  {
    "id": "p-5edfd4",
    "offset": 10423,
    "text": "DAVUS:\nNarras probe."
  },
  {
    "id": "p-c90e8a",
    "offset": 10445,
    "text": "PAMPHILUS:\nNec mora ulla est quin eam uxorem ducam."
  },
  {
    "id": "p-d309f4",
    "offset": 10498,
    "text": "CHARINUS:\nNum ille somniat"
  },
  {
    "id": "p-e042f0",
    "offset": 10526,
    "text": "Ea quae vigilans voluit?"
  },
  {
    "id": "p-397f0e",
    "offset": 10552,
    "text": "PAMPHILUS:\nTum de puero Dave?"
  },
  {
    "id": "p-928bf9",
    "offset": 10583,
    "text": "DAVUS:\nAh desine."
  },
  {
    "id": "p-a59a0d",
    "offset": 10602,
    "text": "Solus est quem diligunt Di."
  },
  {
    "id": "p-c9c6f4",
    "offset": 10631,
    "text": "CHARINUS:\nSalvus sum si haec vera sunt."
  },
  {
    "id": "p-1acddf",
    "offset": 10672,
    "text": "Colloquar."
  },
  {
    "id": "p-0f9834",
    "offset": 10684,
    "text": "PAMPHILUS:\nQuis homo est? O Charine in tempore ipso mihi advenis."
  },
  {
    "id": "p-a66f69",
    "offset": 10751,
    "text": "CHARINUS:\nBene factum."
  },
  {
    "id": "p-ee51dc",
    "offset": 10775,
    "text": "PAMPHILUS:\nAudistine?"
  },
  {
    "id": "p-1780f5",
    "offset": 10798,
    "text": "CHARINUS:\nOmnia: age me in tuis secundis respice."
  },
  {
    "id": "p-091ba7",
    "offset": 10849,
    "text": "Tuus est nunc Chremes: facturum quae voles scio esse omnia."
  },
  {
    "id": "p-b3b193",
    "offset": 10910,
    "text": "PAMPHILUS:\nMemini: atque adeo longum est nos illum expectare dum exeat."
  },
  {
    "id": "p-649241",
    "offset": 10983,
    "text": "Sequere hac me intus ad Glycerium nunc. Tu Dave abi domum:"
  },
  {
    "id": "p-2c9ab9",
    "offset": 11043,
    "text": "Propere arcesse hinc qui auferant eam. Quid stas? quid cessas?"
  },
  {
    "id": "p-5ae49c",
    "offset": 11107,
    "text": "DAVUS:\nEo."
  },
  {
    "id": "p-8af82f",
