[
  {
    "id": "p-84b6df",
    "offset": 0,
    "text": "Υἱὸς πανοῦργος ὑπήκοος πατρί,"
  },
  {
    "id": "p-1ee4de",
    "offset": 31,
    "text": "υἱὸς δὲ ἀνήκοος ἐν ἀπωλείᾳ."
  },
  {
    "id": "p-d53056",
    "offset": 60,
    "text": "ἀπὸ καρπῶν δικαιοσύνης φάγεται ἀγαθός,"
  },
  {
    "id": "p-b8e9da",
    "offset": 100,
    "text": "ψυχαὶ δὲ παρανόμων ὀλοῦνται ἄωροι."
  },
  {
    "id": "p-7dd979",
    "offset": 136,
    "text": "ὃς φυλάσσει τὸ ἑαυτοῦ στόμα τηρεῖ τὴν ἑαυτοῦ ψυχήν,"
  },
  {
    "id": "p-63de0a",
    "offset": 189,
    "text": "ὁ δὲ προπετὴς χείλεσιν πτοήσει ἑαυτόν."
  },
  {
    "id": "p-ef8d2e",
    "offset": 229,
    "text": "ἐν ἐπιθυμίαις ἐστιν πᾶς ἀεργός,"
  },
  {
    "id": "p-e8ba14",
    "offset": 262,
    "text": "χεῖρες δὲ ἀνδρείων ἐν ἐπιμελείᾳ."
  },
  {
    "id": "p-00d9b9",
    "offset": 296,
    "text": "λόγον ἄδικον μισεῖ δίκαιος,"
  },
  {
    "id": "p-185e60",
    "offset": 325,
    "text": "ἀσεβὴς δὲ αἰσχύνεται καὶ οὐχ ἕξει παρρησίαν."
  },
  {
    "id": "p-7dfe85",
    "offset": 371,
    "text": "εἰσὶν οἱ πλουτίζοντες ἑαυτοὺς μηδὲν ἔχοντες,"
  },
  {
    "id": "p-2c91eb",
    "offset": 417,
    "text": "καὶ εἰσὶν οἱ ταπεινοῦντες ἑαυτοὺς ἐν πολλῷ πλούτῳ."
  },
  {
    "id": "p-d06957",
    "offset": 469,
    "text": "λύτρον ἀνδρὸς ψυχῆς ὁ ἴδιος πλοῦτος,"
  },
  {
    "id": "p-746ca9",
    "offset": 507,
    "text": "πτωχὸς δὲ οὐχ ὑφίσταται ἀπειλήν."
  },
  {
    "id": "p-5f6b12",
    "offset": 541,
    "text": "φῶς δικαίοις διὰ παντός."
  },
  {
    "id": "p-4049a5",
    "offset": 567,
    "text": "φῶς δὲ ἀσεβῶν σβέννυται."
  },
  {
    "id": "p-538d59",
    "offset": 593,
    "text": "a ψυχαὶ δόλιαι πλανῶνται ἐν ἁμαρτίαις,"
  },
  {
    "id": "p-c2f5e3",
    "offset": 633,
    "text": "δίκαιοι δὲ οἰκτείρουσιν καὶ ἐλεῶσιν."
  },
  {
    "id": "p-445501",
    "offset": 671,
    "text": "κακὸς μεθʼ ὕβρεως πράσσει κακά,"
  },
  {
    "id": "p-3c01f1",
    "offset": 704,
    "text": "οἱ δὲ ἑαυτῶν ἐπιγνώμονες σοφοί."
  },
  {
    "id": "p-744932",
    "offset": 737,
    "text": "ὕπαρξις ἐπισπουδαζομένη μετὰ ἀνομίας ἐλάσσων γίνεται,"
  },
  {
    "id": "p-1c3181",
    "offset": 792,
    "text": "ὁ δὲ συνάγων ἑαυτῷ μετʼ εὐσεβείας πληθυνθήσεται·"
  },
  {
    "id": "p-3d5bc3",
    "offset": 842,
    "text": "δίκαιος οἰκτείρει καὶ κιχρᾷ."
  },
  {
    "id": "p-02d556",
    "offset": 872,
    "text": "κρείσσων ἐναρχομένοις βοηθῶν καρδίᾳ"
  },
  {
    "id": "p-aee0f9",
    "offset": 909,
    "text": "τοῦ ἐπαγγελλομένου καὶ εἰς ἐλπίδα ἄγοντος·"
  },
  {
    "id": "p-0d0305",
    "offset": 953,
    "text": "δένδρον γὰρ ζωῆς ἐπιθυμία ἀγαθή."
  },
  {
    "id": "p-e47065",
    "offset": 987,
    "text": "ὃς καταφρονεῖ πράγματος, καταφρονηθήσεται ὑπʼ αὐτοῦ·"
  },
  {
    "id": "p-20f2aa",
    "offset": 1041,
    "text": "ὁ δὲ φοβούμενος ἐντολήν, οὗτος ὑγιαίνει."
  },
  {
    "id": "p-988e74",
    "offset": 1083,
    "text": "a υἱῷ δολίῳ οὐδὲν ἔσται ἀγαθόν·"
  },
  {
    "id": "p-57ca5d",
    "offset": 1116,
    "text": "οἰκέτῃ δὲ σοφῷ εὔοδοι ἔσονται πράξεις,"
  },
  {
    "id": "p-90af20",
    "offset": 1156,
    "text": "καὶ κατευθυνθήσεται ἡ ὁδὸς αὐτοῦ."
  },
  {
    "id": "p-52f045",
    "offset": 1191,
    "text": "νόμος σοφοῦ πηγὴ ζωῆς,"
  },
  {
    "id": "p-02ac43",
    "offset": 1215,
    "text": "ὁ δὲ ἄνους ὑπὸ παγίδος θανεῖται."
  },
  {
    "id": "p-ee4141",
    "offset": 1249,
    "text": "σύνεσις ἀγαθὴ δίδωσιν χάριν,"
  },
  {
    "id": "p-c83f3e",
    "offset": 1279,
    "text": "τὸ δὲ γνῶναι νόμον διανοίας ἐστὶν ἀγαθῆς,"
  },
  {
    "id": "p-0c3f77",
    "offset": 1322,
    "text": "ὁδοὶ δὲ καταφρονούντων ἐν ἀπωλείᾳ."
  },
  {
    "id": "p-5be048",
    "offset": 1358,
    "text": "πᾶς πανοῦργος πράσσει μετὰ γνώσεως,"
  },
  {
    "id": "p-5c260b",
    "offset": 1395,
    "text": "ὁ δὲ ἄφρων ἐξεπέτασεν ἑαυτοῦ κακίαν."
  },
  {
    "id": "p-ea0263",
    "offset": 1433,
    "text": "βασιλεὺς θρασὺς ἐμπεσεῖται εἰς κακά,"
  },
  {
    "id": "p-bfcc6a",
    "offset": 1471,
    "text": "ἄγγελος δὲ σοφὸς ῥύσεται αὐτόν."
  },
  {
    "id": "p-3d9ab0",
    "offset": 1504,
    "text": "πενίαν καὶ ἀτιμίαν ἀφαιρεῖται παιδεία,"
  },
  {
    "id": "p-7a228e",
    "offset": 1544,
    "text": "ὁ δὲ φυλάσσων ἐλέγχους δοξασθήσεται."
  },
  {
    "id": "p-e1ba11",
    "offset": 1582,
    "text": "ἐπιθυμίαι εὐσεβῶν ἡδύνουσιν ψυχήν,"
  },
  {
    "id": "p-089702",
    "offset": 1618,
    "text": "ἔργα δὲ ἀσεβῶν μακρὰν ἀπὸ γνώσεως."
  },
  {
    "id": "p-a0afe0",
    "offset": 1654,
    "text": "συμπορευόμενος σοφοῖς σοφὸς ἔσῃ,"
  },
  {
    "id": "p-12ecd8",
    "offset": 1688,
    "text": "χομενος U+05D0A | βοηθων] βοηθειν U+05D0c.a (-θιν) A | αγαθη] om U+05D0* (hab U+05D0c.a) κακη\nA 13 a δουλιω U+05D0* (δολ. U+05D01? c.a) | εσταγαθον U+05D0* (εσται αγ. U+05D0c.a) | πραξις\nU+05D0*vid (-ξεις U+05D0c.a) 15 διδωσι A | απωλια U+05D0 16 εξεπετασε U+05D0 17 σοφος]\nπιστος U+05D0* (σοφ. U+05D0c.a) 18 παιδια U+05D0Α 19 ηδυνουσι U+05D0 20 συμπορευο-\nμενος 1⁰] pr ο U+05D0c.aA | εση] εσται U+05D0c.aA"
  },
  {
    "id": "p-9b81af",
    "offset": 2096,
    "text": "ὁ δὲ συμπορευόμενος ἄφροσι γνωσθήσεται."
  },
  {
    "id": "p-4409c3",
    "offset": 2137,
    "text": "ἁμαρτάνοντας καταδιώξεται κακά,"
  },
  {
    "id": "p-324767",
    "offset": 2170,
    "text": "τοὺς δὲ δικαίους καταλήμψεται ἀγαθά."
  },
  {
    "id": "p-789e5a",
    "offset": 2208,
    "text": "ἀγαθὸς ἀνὴρ κληρονομήσει υἱοὺς υἱῶν,"
  },
  {
    "id": "p-b28097",
    "offset": 2246,
    "text": "θησαυρίζεται δὲ δικαίοις πλοῦτος ἀσεβῶν."
  },
  {
    "id": "p-494623",
    "offset": 2288,
    "text": "δίκαιοι ποιήσουσιν ἐν πλούτῳ ἔτη πολλά,"
  },
  {
    "id": "p-3e9b3c",
    "offset": 2329,
    "text": "ἄδικοι δὲ ἀπολοῦνται συντόμως."
  },
  {
    "id": "p-4ca81f",
    "offset": 2361,
    "text": "ὃς φείδεται τῆς βακτηρίας, μισεῖ τὸν υἱὸν αὐτοῦ,"
  },
  {
    "id": "p-5005b5",
    "offset": 2411,
    "text": "ὁ δὲ ἀγαπῶν ἐπιμελῶς παιδεύει."
  },
  {
    "id": "p-fe0a34",
    "offset": 2443,
    "text": "δίκαιος ἔσθων ἐμπιπλᾷ τὴν ψυχὴν αὐτοῦ,"
  },
  {
    "id": "p-41dd76",
    "offset": 2483,
    "text": "ψυχαὶ δὲ ἀσεβῶν ἐνδεεῖς."
  }
]