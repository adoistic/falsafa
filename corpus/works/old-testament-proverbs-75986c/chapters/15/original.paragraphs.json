[
  {
    "id": "p-989ac8",
    "offset": 0,
    "text": "ὀργὴ ἀπόλλυσιν καὶ φρονίμους,"
  },
  {
    "id": "p-00bcee",
    "offset": 31,
    "text": "ἀπόκρισις δὲ ὑποπίπτουσα ἀποστρέφει θυμόν,"
  },
  {
    "id": "p-16ec4a",
    "offset": 75,
    "text": "λόγος δὲ λυπηρὸς ἐγείρει ὀργάς."
  },
  {
    "id": "p-eea238",
    "offset": 108,
    "text": "γλῶσσα σοφῶν καλὰ ἐπίσταται,"
  },
  {
    "id": "p-aac3e8",
    "offset": 138,
    "text": "στόμα δὲ ἀφρόνων ἀναγγελεῖ κακά."
  },
  {
    "id": "p-e501d2",
    "offset": 172,
    "text": "ἐν παντὶ τόπῳ ὀφθαλμοὶ Κυρίου·"
  },
  {
    "id": "p-09c57b",
    "offset": 204,
    "text": "σκοπεύουσιν κακούς τε καὶ ἀγαθούς."
  },
  {
    "id": "p-a3cccb",
    "offset": 240,
    "text": "ἴασις γλώσσης δένδρον ζωῆς,"
  },
  {
    "id": "p-365121",
    "offset": 269,
    "text": "ὁ δὲ συντηρῶν αὐτὴν πλησθήσεται πνεύματος."
  },
  {
    "id": "p-1c8d5e",
    "offset": 313,
    "text": "ἄφρων μυκτηρίζει παιδίαν πατρός,"
  },
  {
    "id": "p-34d28d",
    "offset": 347,
    "text": "ὁ δὲ φυλάσσων ἐντολὰς πανουργότερος."
  },
  {
    "id": "p-cbb036",
    "offset": 385,
    "text": "ἐν πλεοναζούσῃ δικαιοσύνῃ ἰσχὺς πολλή,"
  },
  {
    "id": "p-07f9df",
    "offset": 425,
    "text": "οἱ δὲ ἀσεβεῖς ὁλόριζοι ἐκ γῆς ἀπολοῦνται·"
  },
  {
    "id": "p-5c8a4f",
    "offset": 468,
    "text": "οἴκοις δικαίων ἰσχὺς πολλή,"
  },
  {
    "id": "p-0638e6",
    "offset": 497,
    "text": "καρποὶ δὲ ἀσεβῶν ἀπολοῦνται."
  },
  {
    "id": "p-2c350a",
    "offset": 527,
    "text": "χείλη σοφῶν δέδεται αἰσθήσει,"
  },
  {
    "id": "p-7eda54",
    "offset": 558,
    "text": "καρδίαι δὲ ἀφρόνων οὐκ ἀσφαλεῖς."
  },
  {
    "id": "p-89ba7b",
    "offset": 592,
    "text": "θυσίαι ἀσεβῶν βδέλυγμα Κυρίῳ,"
  },
  {
    "id": "p-f1e5a9",
    "offset": 623,
    "text": "εὐχαὶ δὲ κατευθυνόντων δεκταὶ παρʼ αὐτῷ."
  },
  {
    "id": "p-bd2b4e",
    "offset": 665,
    "text": "βδέλυγμα Κυρίῳ ὁδοὶ ἀσεβοῦς,"
  },
  {
    "id": "p-d5d908",
    "offset": 695,
    "text": "διώκοντας δὲ δικαιοσύνην ἀγαπᾷ."
  },
  {
    "id": "p-1619b9",
    "offset": 728,
    "text": "παιδεία ἀκάκου γνωρίζεται ὑπὸ τῶν παριόντων,"
  },
  {
    "id": "p-213347",
    "offset": 774,
    "text": "οἱ δὲ μισοῦντες ἐλέγχους τελευτῶσιν αἰσχρῶς."
  },
  {
    "id": "p-bb8f82",
    "offset": 820,
    "text": "ᾅδης καὶ ἀπώλεια φανερὰ παρὰ τῷ κυρίῳ,"
  },
  {
    "id": "p-d9c739",
    "offset": 860,
    "text": "πῶς οὐχὶ καὶ αἱ καρδίαι τῶν ἀνθρώπων;"
  },
  {
    "id": "p-ec0e33",
    "offset": 899,
    "text": "οὐκ ἀγαπήσει ἀπαίδευτος τοὺς ἐλέγχοντας αὐτόν,"
  },
  {
    "id": "p-1934a2",
    "offset": 947,
    "text": "μετὰ δὲ σοφῶν οὐχ ὁμιλήσει."
  },
  {
    "id": "p-73fe30",
    "offset": 976,
    "text": "καρδίας εὐφραινομένης πρόσωπον θάλλει,"
  },
  {
    "id": "p-57009c",
    "offset": 1016,
    "text": "ἐν δὲ λύπαις οὔσης σκυθρωπάζει."
  },
  {
    "id": "p-dfd806",
    "offset": 1049,
    "text": "καρδία ὀρθὴ ζητεῖ αἴσθησιν,"
  },
  {
    "id": "p-17b392",
    "offset": 1078,
    "text": "στόμα δὲ ἀπαιδεύτων γνώσεται κακά."
  },
  {
    "id": "p-1e3b0b",
    "offset": 1114,
    "text": "πάντα τὸν χρόνον οἱ ὀφθαλμοὶ τῶν κακῶν προσδέχονται κακά,"
  },
  {
    "id": "p-482154",
    "offset": 1173,
    "text": "οἱ δὲ ἀγαθοὶ ἡσυχάσουσιν διὰ παντός."
  },
  {
    "id": "p-fec6b5",
    "offset": 1211,
    "text": "κρείσσων μικρὰ μερὶς μετὰ φόβου Κυρίου"
  },
  {
    "id": "p-9f15e1",
    "offset": 1251,
    "text": "ἢ θησαυροὶ μεγάλοι μετὰ ἀφοβίας."
  },
  {
    "id": "p-b0248f",
    "offset": 1285,
    "text": "κρείσσων ξενισμὸς μετὰ λαχάνων πρὸς φιλίαν καὶ χάριν"
  },
  {
    "id": "p-7a922a",
    "offset": 1339,
    "text": "ἢ παράθεσις μόσχων μετὰ ἔχθρας."
  },
  {
    "id": "p-afb6c7",
    "offset": 1372,
    "text": "ἀνὴρ θυμώδης παρασκευάζει μάχας,"
  },
  {
    "id": "p-cf0686",
    "offset": 1406,
    "text": "μακρόθυμος δὲ καὶ τὴν μέλλουσαν καταπρᾳύνει·"
  },
  {
    "id": "p-6588c4",
    "offset": 1452,
    "text": "μακρόθυμος ἀνὴρ κατασβέσει κρίσεις,"
  },
  {
    "id": "p-49fb36",
    "offset": 1489,
    "text": "ὁ δὲ ἀσεβὴς ἐγείρει μᾶλλον."
  },
  {
    "id": "p-a90877",
    "offset": 1518,
    "text": "ὁδοὶ ἀεργῶν ἐστρωμέναι ἀκάνθαις,"
  },
  {
    "id": "p-eb106c",
    "offset": 1552,
    "text": "αἱ δὲ τῶν ἀνδρείων τετριμμέναι."
  },
  {
    "id": "p-a8f0b6",
    "offset": 1585,
    "text": "υἱὸς σοφὸς εὐφραίνει πατέρα,"
  },
  {
    "id": "p-2fd33f",
    "offset": 1615,
    "text": "υἱὸς δὲ ἄφρων μυκτηρίζει μητέρα αὐτοῦ."
  },
  {
    "id": "p-bcb58a",
    "offset": 1655,
    "text": "ἀνοήτου τρίβοι ἐνδεεῖς φρενῶν,"
  },
  {
    "id": "p-e08fc5",
    "offset": 1687,
    "text": "ἀνὴρ δὲ φρόνιμος κατευθύνων πορεύεται."
  },
  {
    "id": "p-d6a2bd",
    "offset": 1727,
    "text": "ὑπερτίθενται λογισμοὺς οἱ μὴ τιμῶντες συνέδρια,"
  },
  {
    "id": "p-f25ab5",
    "offset": 1776,
    "text": "ἐν δὲ καρδίαις βουλευομένων μένει βουλή."
  },
  {
    "id": "p-a56d7e",
    "offset": 1818,
    "text": "οὐ μὴ ὑπακούσῃ ὁ κακὸς αὐτῇ,"
  },
  {
    "id": "p-436faf",
    "offset": 1848,
    "text": "U+05D0A 13 ουσης BᵃᵇU+05D0] ουσαις B* ουσα A 14 απαιδευτων] ασεβων\nU+05D0* (απαιδ. U+05D0c.a) 15 ησυχαζουσιν A 17 om μετα 1⁰ A | μετα 2⁰] μετ A\n8 a κρισις U+05D0A 21 ανηρ δε φρονιμος] ο δε φρ. ανηρ U+05D0 22 υπερτι-\n??ονται U+05D0* (-θενται U+05D0c.a) | τιμωτες U+05D0* (-ντες U+05D0c.a) 23 ου] υ A* (pr ο\nAᵃ?ᵐᵍ) | κακος] ακακος U+05D0c.a"
  },
  {
    "id": "p-985809",
    "offset": 2188,
    "text": "οὐδὲ μὴ εἴπῃ καίριόν τι καὶ καλὸν τῷ κοινῷ."
  },
  {
    "id": "p-ce4834",
    "offset": 2233,
    "text": "ὁδοὶ ζωῆς διανοήματα συνετοῦ,"
  },
  {
    "id": "p-51e846",
    "offset": 2264,
    "text": "ἵνα ἐκκλίνας ἐκ τοῦ ᾅδου σωθῇ."
  },
  {
    "id": "p-a88b23",
    "offset": 2296,
    "text": "οἴκους ὑβριστῶν κατασπᾷ Κύριος,"
  },
  {
    "id": "p-997d6a",
    "offset": 2329,
    "text": "ἐστήρισεν δὲ ὅριον χήρας."
  },
  {
    "id": "p-97932e",
    "offset": 2356,
    "text": "βδέλυγμα Κυρίῳ λογισμὸς ἄδικος,"
  },
  {
    "id": "p-9a8303",
    "offset": 2389,
    "text": "ἁγνῶν δὲ ῥήσεις σεμναί."
  },
  {
    "id": "p-c9efa1",
    "offset": 2414,
    "text": "ἐξόλλυσιν ἑαυτὸν ὁ δωρολήμπτης,"
  },
  {
    "id": "p-8c2805",
    "offset": 2447,
    "text": "ὁ δὲ μισῶν δώρων λήμψεις σώζεται."
  },
  {
    "id": "p-6ee1d3",
    "offset": 2482,
    "text": "(6)ἐλεημοσύναις καὶ πίστεσιν ἀποκαθαίρονται ἁμαρτίαι,"
  },
  {
    "id": "p-89907b",
    "offset": 2537,
    "text": "τῷ δὲ φόβῳ Κυρίου ἐκκλίνει πᾶς ἀπὸ κακοῦ."
  },
  {
    "id": "p-a1fd52",
    "offset": 2580,
    "text": "καρδίαι δικαίων μελετῶσιν πίστεις,"
  },
  {
    "id": "p-0dc2a7",
    "offset": 2616,
    "text": "στόμα δὲ ἀσεβῶν ἀποκρίνεται κακά."
  },
  {
    "id": "p-faebe1",
    "offset": 2651,
    "text": "(7)δεκταὶ παρὰ Κυρίῳ ὁδοὶ ἀνθρώπων δικαίων,"
  },
  {
    "id": "p-f914a3",
    "offset": 2696,
    "text": "διὰ δὲ αὐτῶν καὶ οἱ ἐχθροὶ φίλοι γίνονται."
  },
  {
    "id": "p-4ae5a4",
    "offset": 2740,
    "text": "μακρὰν ἀπέχει ὁ θεὸς ἀπὸ ἀσεβῶν,"
  },
  {
    "id": "p-e3827b",
    "offset": 2774,
    "text": "εὐχαῖς δὲ δικαίων ἐπακούει."
  },
  {
    "id": "p-e04132",
    "offset": 2803,
    "text": "§(8)κρείσσων ὀλίγη λῆμψις μετὰ δικαιοσύνης"
  },
  {
    "id": "p-710ce7",
    "offset": 2847,
    "text": "ἢ πολλὰ γενήματα μετὰ ἀδικίας."
  }
]