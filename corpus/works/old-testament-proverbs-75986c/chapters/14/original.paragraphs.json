[
  {
    "id": "p-2870f9",
    "offset": 0,
    "text": "σοφαὶ γυναῖκες ᾠκοδόμησαν οἴκους,"
  },
  {
    "id": "p-c5d2e6",
    "offset": 35,
    "text": "ἡ δὲ ἄφρων κατέσκαψεν ταῖς χερσὶν αὐτῆς."
  },
  {
    "id": "p-c4b7c7",
    "offset": 77,
    "text": "ὁ πορευόμενος ὀρθῶς φοβεῖται τὸν κύριον,"
  },
  {
    "id": "p-9c075c",
    "offset": 119,
    "text": "ὁ δὲ σκολιάζων ταῖς ὁδοῖς αὐτοῦ ἀτιμασθήσεται."
  },
  {
    "id": "p-72e84b",
    "offset": 167,
    "text": "ἐκ στόματος ἀφρόνων βακτηρία ὕβρεως,"
  },
  {
    "id": "p-8cc87b",
    "offset": 205,
    "text": "χείλη δὲ σοφῶν φυλάσσει αὐτούς."
  },
  {
    "id": "p-f9ccfb",
    "offset": 238,
    "text": "οὗ μή εἰσιν βόες, φάτναι καθαραί·"
  },
  {
    "id": "p-5594fc",
    "offset": 273,
    "text": "οὗ δὲ πολλὰ γενήματα, φανερὰ βοὸς ἰσχύς."
  },
  {
    "id": "p-65fab3",
    "offset": 315,
    "text": "μάρτυς πιστὸς οὐ ψεύδεται,"
  },
  {
    "id": "p-85f437",
    "offset": 343,
    "text": "ἐκκαίει δὲ ψευδῆ μάρτυς ἄδικος."
  },
  {
    "id": "p-690c4b",
    "offset": 376,
    "text": "ζητήσεις σοφίαν παρὰ κακοῖς καὶ οὐχ εὑρήσεις,"
  },
  {
    "id": "p-fb8a8b",
    "offset": 423,
    "text": "αἴσθησις δὲ παρὰ φρονίμοις εὐχερής."
  },
  {
    "id": "p-858b7a",
    "offset": 460,
    "text": "πάντα ἐναντία ἀνδρὶ ἄφρονι,"
  },
  {
    "id": "p-341ecd",
    "offset": 489,
    "text": "ὅπλα δὲ αἰσθήσεως χείλη σοφά."
  },
  {
    "id": "p-66854e",
    "offset": 520,
    "text": "σοφία πανούργων ἐπιγνώσεται τὰς ὁδοὺς αὐτῶν,"
  },
  {
    "id": "p-4e4602",
    "offset": 566,
    "text": "ἄνοια δὲ ἀφρόνων ἐν πλάνῃ."
  },
  {
    "id": "p-5020ab",
    "offset": 594,
    "text": "οἰκίαι παρανόμων ὀφειλήσουσιν καθαρισμόν,"
  },
  {
    "id": "p-10a8b3",
    "offset": 637,
    "text": "οἰκίαι δὲ δικαίων δεκταί."
  },
  {
    "id": "p-ec2662",
    "offset": 664,
    "text": "καρδία ἀνδρὸς αἰσθητική, λυπηρὰ ψυχὴ αὐτοῦ·"
  },
  {
    "id": "p-dae4c7",
    "offset": 709,
    "text": "ὅταν δὲ εὐφραίνηται, οὐκ ἐπιμίγνυται ὕβρει."
  },
  {
    "id": "p-52d72d",
    "offset": 754,
    "text": "οἰκίαι ἀσεβῶν ἀφανισθήσονται,"
  },
  {
    "id": "p-c5907f",
    "offset": 785,
    "text": "σκηναὶ δὲ κατορθούντων στήσονται."
  },
  {
    "id": "p-4de990",
    "offset": 820,
    "text": "ἔστιν ὁδὸς ἣ δοκεῖ παρὰ ἀνθρώποις ὀρθὴ εἶναι,"
  },
  {
    "id": "p-dc4984",
    "offset": 867,
    "text": "τὰ δὲ τελευταῖα αὐτῆς ἔρχεται εἰς πυθμένα ᾅδου."
  },
  {
    "id": "p-17e37c",
    "offset": 916,
    "text": "ἐν εὐφροσύναις οὐ προσμίγνυται λύπη,"
  },
  {
    "id": "p-0bad35",
    "offset": 954,
    "text": "τελευταία δὲ χαρὰ εἰς πένθος ἔρχεται."
  },
  {
    "id": "p-7c3852",
    "offset": 993,
    "text": "τῶν ἑαυτοῦ ὁδῶν πλησθήσεται θρασυκάρδιος,"
  },
  {
    "id": "p-52f024",
    "offset": 1036,
    "text": "ἀπὸ δὲ τῶν διανοημάτων αὐτοῦ ἀνὴρ ἀγαθός."
  },
  {
    "id": "p-04747a",
    "offset": 1079,
    "text": "ἄκακος πιστεύει παντὶ λόγῳ,"
  },
  {
    "id": "p-5aa74a",
    "offset": 1108,
    "text": "πανοῦργος δὲ ἔρχεται εἰς μετάνοιαν."
  },
  {
    "id": "p-16b09d",
    "offset": 1145,
    "text": "σοφὸς φοβηθεὶς ἐξέκλινεν ἀπὸ κακοῦ,"
  },
  {
    "id": "p-8cbe52",
    "offset": 1182,
    "text": "ὁ δὲ ἄφρων ἑαυτῷ πεποιθὼς μίγνυται ἀνόμῳ."
  },
  {
    "id": "p-c4dc70",
    "offset": 1225,
    "text": "ὀξύθυμος πράσσει μετὰ ἀβουλίας,"
  },
  {
    "id": "p-38f160",
    "offset": 1258,
    "text": "ἀνὴρ δὲ φρόνιμος πολλὰ ὑποφέρει."
  },
  {
    "id": "p-16b0a6",
    "offset": 1292,
    "text": "μεριοῦνται ἄφρονες κακίαν,"
  },
  {
    "id": "p-14400b",
    "offset": 1320,
    "text": "οἱ δὲ πανοῦργοι κρατήσουσιν αἰσθήσεως."
  },
  {
    "id": "p-2a72ed",
    "offset": 1360,
    "text": "ὀλισθήσουσιν κακοὶ ἔναντι ἀγαθῶν,"
  },
  {
    "id": "p-62a0f9",
    "offset": 1395,
    "text": "καὶ ἀσεβεῖς θεραπεύσουσιν θύρας δικαίων."
  },
  {
    "id": "p-29fc58",
    "offset": 1437,
    "text": "φίλοι μισήσουσιν φίλους πτωχούς,"
  },
  {
    "id": "p-1aba87",
    "offset": 1471,
    "text": "φίλοι δὲ πλουσίων πολλοί."
  },
  {
    "id": "p-589919",
    "offset": 1498,
    "text": "ὁ ἀτιμάζων πένητας ἁμαρτάνει,"
  },
  {
    "id": "p-b30818",
    "offset": 1529,
    "text": "ἐλεῶν δὲ πτωχοὺς μακαριστός."
  },
  {
    "id": "p-0cac16",
    "offset": 1559,
    "text": "πλανώμενοι τεκταίνουσι κακά,"
  },
  {
    "id": "p-3d0869",
    "offset": 1589,
    "text": "ἔλεον δὲ καὶ ἀλήθειαν τεκταίνουσιν ἀγαθοί·"
  },
  {
    "id": "p-f23216",
    "offset": 1633,
    "text": "οὐκ ἐπίστανται ἔλεον καὶ πίστιν τέκτονες κακῶν,"
  },
  {
    "id": "p-335c37",
    "offset": 1682,
    "text": "ἐλεημοσύναι δὲ καὶ πίστεις παρὰ τέκτοσιν ἀγαθοῖς."
  },
  {
    "id": "p-fb9d19",
    "offset": 1733,
    "text": "ἐν παντὶ μεριμνῶντι ἔνεστιν περισσόν,"
  },
  {
    "id": "p-b60303",
    "offset": 1772,
    "text": "ὁ δὲ ἡδὺς καὶ ἀνάλγητος ἐν ἐνδείᾳ ἔσται."
  },
  {
    "id": "p-3f5eba",
    "offset": 1814,
    "text": "στέφανος σοφῶν πανοῦργος."
  },
  {
    "id": "p-fccc8a",
    "offset": 1841,
    "text": "ἡ δὲ διατριβὴ ἀφρόνων κακή."
  },
  {
    "id": "p-b154dd",
    "offset": 1870,
    "text": "ῥύσεται ἐκ κακῶν ψυχὴν μάρτυς πιστός,"
  },
  {
    "id": "p-955e7e",
    "offset": 1909,
    "text": "ἐκκαίει δὲ ψευδῆ δόλιος."
  },
  {
    "id": "p-32c0ff",
    "offset": 1935,
    "text": "ἐν φόβῳ Κυρίου ἐλπὶς ἰσχύος."
  },
  {
    "id": "p-1ac53d",
    "offset": 1965,
    "text": "τοῖς δὲ τέκνοις αὐτοῦ καταλείπει ἔρεισμα."
  },
  {
    "id": "p-25f9cc",
    "offset": 2008,
    "text": "πρόσταγμα Κυρίου πηγὴ ζωῆς,"
  },
  {
    "id": "p-2017bb",
    "offset": 2037,
    "text": "ποιεῖ δὲ ἐκκλίνειν ἐκ παγίδος θανάτου."
  },
  {
    "id": "p-3503ea",
    "offset": 2077,
    "text": "χαρας A 16 εαυτω] pr εν U+05D0* (om U+05D0c.a) 20 μισησωσιν A 21 μακα-\nριστος] μακαριος εστς A 22 τεκταινουσι] τεκτενουσιν A | πιστεις] πιστις\nU+05D0A 26 καταλειπει] καταλιψι U+05D0c.a | ερισμα B*U+05D0 A (ερεισμα Bᵃᵇ)"
  },
  {
    "id": "p-c0b4cc",
    "offset": 2297,
    "text": "ἐν πολλῷ ἔθνει δόξα βασιλέως."
  },
  {
    "id": "p-1a77cf",
    "offset": 2328,
    "text": "ἐν δὲ ἐκλείψει λαοῦ συντριβὴ δυνάστου."
  },
  {
    "id": "p-de97f5",
    "offset": 2368,
    "text": "μακρόθυμος ἀνὴρ πολὺς ἐν φρονήσει,"
  },
  {
    "id": "p-97cd7a",
    "offset": 2404,
    "text": "ὁ δὲ ὀλιγόψυχος ἰσχυρὸς ἄφρων."
  },
  {
    "id": "p-bf32b4",
    "offset": 2436,
    "text": "πρᾳύθυμος ἀνὴρ καρδίας ἰατρός,"
  },
  {
    "id": "p-800084",
    "offset": 2468,
    "text": "σὴς δὲ ὀστέων καρδία αἰσθητική."
  },
  {
    "id": "p-eefe6d",
    "offset": 2501,
    "text": "ὁ συκοφαντῶν πένητα παροξύνει τὸν ποιήσαντα αὐτόν,"
  },
  {
    "id": "p-cb1f7c",
    "offset": 2553,
    "text": "ὁ δὲ τιμῶν αὐτὸν ἐλεᾷ πτωχόν."
  },
  {
    "id": "p-57650e",
    "offset": 2584,
    "text": "ἐν κακίᾳ αὐτοῦ ἀπωσθήσεται ἀσεβής,"
  },
  {
    "id": "p-40adb2",
    "offset": 2620,
    "text": "ὁ δὲ πεποιθὼς τῇ ἑαυτοῦ ὁσιότητι δίκαιος."
  },
  {
    "id": "p-6d24dd",
    "offset": 2663,
    "text": "ἐν καρδίᾳ ἀγαθῇ ἀνδρὸς σοφία,"
  },
  {
    "id": "p-f0f002",
    "offset": 2694,
    "text": "ἐν δὲ καρδίᾳ ἀφρόνων οὐ διαγινώσκεται."
  },
  {
    "id": "p-92a202",
    "offset": 2734,
    "text": "δικαιοσύνη ὑψοῖ ἔθνος,"
  },
  {
    "id": "p-85a6e9",
    "offset": 2758,
    "text": "ἐλασσονοῦσι δὲ φυλὰς ἁμαρτίαι."
  },
  {
    "id": "p-cc4b9f",
    "offset": 2790,
    "text": "δεκτὸς βασιλεῖ ὑπηρέτης νοήμων,"
  },
  {
    "id": "p-56620f",
    "offset": 2823,
    "text": "τῇ δὲ ἑαυτοῦ εὐστροφίᾳ ἀφαιρεῖται ἀτιμίαν."
  }
]