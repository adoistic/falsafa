[
  {
    "id": "p-05177d",
    "offset": 0,
    "text": "Υἱὸς σοφὸς εὐφραίνει πατέρα,"
  },
  {
    "id": "p-f5456f",
    "offset": 30,
    "text": "υἱὸς δὲ ἄφρων λύπη τῇ μητρί"
  },
  {
    "id": "p-1a65cc",
    "offset": 59,
    "text": "οὐκ ὠφελήσουσιν θησαυροὶ ἀνόμους,"
  },
  {
    "id": "p-2df843",
    "offset": 94,
    "text": "δικαιοσύνη δὲ ῥύσεται ἐκ θανάτου."
  },
  {
    "id": "p-7c1934",
    "offset": 129,
    "text": "οὐ λιμοκτονήσει Κύριος ψυχὴν δικαίαν,"
  },
  {
    "id": "p-16d330",
    "offset": 168,
    "text": "ζωὴν δὲ ἀσεβῶν ἀνατρέψει."
  },
  {
    "id": "p-bb5968",
    "offset": 195,
    "text": "πενία ἄνδρα ταπεινοῖ,"
  },
  {
    "id": "p-365557",
    "offset": 218,
    "text": "χεῖρες δὲ ἀνδρείων πλουτίζουσιν."
  },
  {
    "id": "p-964f0d",
    "offset": 252,
    "text": "aυἱὸς πεπαιδευμένος σοφὸς ἔσται,"
  },
  {
    "id": "p-77d95e",
    "offset": 286,
    "text": "τῷ δὲ ἄφρονι διακόνῳ χρήσεται."
  },
  {
    "id": "p-efc2bb",
    "offset": 318,
    "text": "διεσώθη ἀπὸ καύματος υἱὸς νοήμων,"
  },
  {
    "id": "p-b7aaa7",
    "offset": 353,
    "text": "ἀνεμόφθορος δὲ γίνεται ἐν ἀμήτῳ υἱὸς παράνομος."
  },
  {
    "id": "p-5573f5",
    "offset": 402,
    "text": "εὐλογία Κυρίου ἐπὶ κεφαλὴν δικαίου,"
  },
  {
    "id": "p-463e7d",
    "offset": 439,
    "text": "στόμα δὲ ἀσεβῶν καλύψει πένθος ἄωρον."
  },
  {
    "id": "p-185503",
    "offset": 478,
    "text": "μνήμη δικαίων μετʼ ἐγκωμίων,"
  },
  {
    "id": "p-36b036",
    "offset": 508,
    "text": "ὄνομα δὲ ἀσεβοῦς σβέννυται."
  },
  {
    "id": "p-43419a",
    "offset": 537,
    "text": "σοφὸς καρδίᾳ δέξεται ἐντολάς,"
  },
  {
    "id": "p-119cab",
    "offset": 568,
    "text": "ὁ δὲ ἄστεγος χείλεσιν σκολιάζων ὑποσκελισθήσεται."
  },
  {
    "id": "p-708926",
    "offset": 619,
    "text": "ὃς πορεύεται ἁπλῶς, πορεύεται πεποιθώς·"
  },
  {
    "id": "p-7c951b",
    "offset": 660,
    "text": "ὁ δὲ διαστρέφων τὰς ὁδοὺς αὐτοῦ γνωσθήσεται."
  },
  {
    "id": "p-221be3",
    "offset": 706,
    "text": "ὁ ἐννεύων ὀφθαλμοῖς μετὰ δόλου συνάγει ἀνδράσι λύπας,"
  },
  {
    "id": "p-654669",
    "offset": 761,
    "text": "ὁ δὲ ἐλέγχων μετὰ παρρησίας εἰρηνοποιεῖ."
  },
  {
    "id": "p-9b95a8",
    "offset": 803,
    "text": "πηγὴ ζωῆς ἐν χειρὶ δικαίου,"
  },
  {
    "id": "p-b54984",
    "offset": 832,
    "text": "στόμα δὲ ἀσεβοῦς καλύψει ἀπώλεια."
  },
  {
    "id": "p-50ba8b",
    "offset": 867,
    "text": "μῖσος ἐγείρει νεῖκος,"
  },
  {
    "id": "p-9f07d2",
    "offset": 890,
    "text": "πάντας δὲ τοὺς μὴ φιλονεικοῦντας καλύπτει φιλία·"
  },
  {
    "id": "p-0acd03",
    "offset": 940,
    "text": "ῥάβδῳ τύπτει ἄνδρα ἀκάρδιον."
  },
  {
    "id": "p-cf5593",
    "offset": 970,
    "text": "σοφοὶ κρύψουσιν αἴσθησιν,"
  },
  {
    "id": "p-6fb5a0",
    "offset": 997,
    "text": "στόμα δὲ προπετοῦς ἐγγίζει συντριβῇ."
  },
  {
    "id": "p-fd3948",
    "offset": 1035,
    "text": "κτῆσις πλουσίων πόλις ὀχυρά,"
  },
  {
    "id": "p-60c6d7",
    "offset": 1065,
    "text": "συντριβὴ δὲ ἀσεβῶν πενία."
  },
  {
    "id": "p-ccb315",
    "offset": 1092,
    "text": "ἔργα δικαίων ζωὴν ποιεῖ,"
  },
  {
    "id": "p-01cd58",
    "offset": 1118,
    "text": "καρποὶ δὲ ἀσεβῶν ἁμαρτίας."
  },
  {
    "id": "p-cf3f42",
    "offset": 1146,
    "text": "ὁδοὺς δικαίας ζωῆς φυλάσσει παιδεία,"
  },
  {
    "id": "p-75f091",
    "offset": 1184,
    "text": "παιδεία δὲ ἀνεξέλεγκτος πλανᾶται."
  },
  {
    "id": "p-702b98",
    "offset": 1219,
    "text": "καλύπτουσιν ἔχθραν χείλη δίκαια,"
  },
  {
    "id": "p-df339c",
    "offset": 1253,
    "text": "οἱ δὲ ἐκφέροντες λοιδορίας ἀφρονέστατοί εἰσιν."
  },
  {
    "id": "p-052334",
    "offset": 1301,
    "text": "ἐκ πολυλογίας οὐκ ἐκφεύξῃ ἁμαρτίαν,"
  },
  {
    "id": "p-677f96",
    "offset": 1338,
    "text": "φειδόμενος δὲ χειλέων νοήμων ἔσῃ."
  },
  {
    "id": "p-770a16",
    "offset": 1373,
    "text": "ἄργυρος πεπυρωμένος γλῶσσα δικαίου,"
  },
  {
    "id": "p-c57118",
    "offset": 1410,
    "text": "καρδία δὲ ἀσεβοῦς ἐκλείψει."
  },
  {
    "id": "p-0a2064",
    "offset": 1439,
    "text": "χείλη δικαίων ἐπίσταται ὑψηλά,"
  },
  {
    "id": "p-d6df2a",
    "offset": 1471,
    "text": "οἱ δὲ ἄφρονες ἐν ἐνδείᾳ τελευτῶσιν."
  },
  {
    "id": "p-27e82e",
    "offset": 1508,
    "text": "1 απωλια B*ᵇU+05D0A (-λεια Bᵃ) 12 καλυψει A 13 ραβδω] pr ος εκ\nχειλεων (χιλ. U+05D0) προφερει σοφιαν U+05D0A | καρδιον U+05D0* (ακ. U+05D0¹) 15 κτι-\nτις U+05D0* (κτησις U+05D0c.a) κτησεις A 16 αμαρτιαι U+05D0* (-τιας U+05D0c.a) 17 om\nU+05D0κοιας U+05D0c.aA | παιδια bis U+05D0A | ανεξελεκτος B* (ανεξελεγκτ. Bᵃᵇ) 19 εκ-\nU+05D0ευξη αμαρτιαν] εκφευξεται αμαρτια A 20 πεπωρωμενος A 21 om\nν U+05D0* (hab U+05D0c.a) | τελευτησωσιν U+05D0* (τελευτωσιν U+05D0c.a)"
  },
  {
    "id": "p-da74c7",
    "offset": 1966,
    "text": "εὐλογία Κυρίου ἐπὶ κεφαλὴν δικαίου·"
  },
  {
    "id": "p-ebf0fb",
    "offset": 2003,
    "text": "αὕτη πλουτίζει, καὶ οὐ μὴ προστεθῇ αὐτῇ λύπη ἐν καρδίᾳ."
  },
  {
    "id": "p-2274bf",
    "offset": 2060,
    "text": "ἐν γέλωτι ἄφρων πράσσει κακά,"
  },
  {
    "id": "p-769272",
    "offset": 2091,
    "text": "ἡ δὲ σοφία ἀνδρὶ τίκτει φρόνησιν."
  },
  {
    "id": "p-95c831",
    "offset": 2126,
    "text": "ἐν ἀπωλείᾳ ἀσεβὴς περιφέρεται,"
  },
  {
    "id": "p-049e69",
    "offset": 2158,
    "text": "ἐπιθυμία δὲ δικαίου δεκτή."
  },
  {
    "id": "p-5e9371",
    "offset": 2186,
    "text": "παραπορευομένης καταιγίδος ἀφανίζεται ἀσεβής,"
  },
  {
    "id": "p-8a8453",
    "offset": 2233,
    "text": "δίκαιος δὲ ἐκκλίνας σώζεται εἰς τὸν αἰῶνα."
  },
  {
    "id": "p-6e52d2",
    "offset": 2277,
    "text": "ὥσπερ ὄμφαξ ὀδοῦσι βλαβερὸν καὶ καπνὸς ὄμμασιν,"
  },
  {
    "id": "p-afbbd6",
    "offset": 2326,
    "text": "οὕτως παρανομία τοῖς χρωμένοις αὐτὴν."
  },
  {
    "id": "p-f1fdcd",
    "offset": 2365,
    "text": "φόβος Κυρίου προστίθησιν ἡμέρας,"
  },
  {
    "id": "p-e2c780",
    "offset": 2399,
    "text": "ἔτη δὲ ἀσεβῶν ὀλιγωθήσεται."
  },
  {
    "id": "p-85e10f",
    "offset": 2428,
    "text": "ἐνχρονίζει δικαίοις εὐφροσύνη,"
  },
  {
    "id": "p-3247a4",
    "offset": 2460,
    "text": "ἐλπὶς δὲ ἀσεβῶν ἀπολεῖται."
  },
  {
    "id": "p-a47882",
    "offset": 2488,
    "text": "ὀχύρωμα ὁσίου φόβος Κυρίου,"
  },
  {
    "id": "p-8e3719",
    "offset": 2517,
    "text": "συντριβὴ δὲ τοῖς ἐργαζομένοις κακά."
  },
  {
    "id": "p-733dff",
    "offset": 2554,
    "text": "δίκαιος τὸν αἰῶνα οὐκ ἐνδώσει,"
  },
  {
    "id": "p-545ca0",
    "offset": 2586,
    "text": "ἀσεβεῖς δὲ οὐκ οἰκήσουσιν γῆν."
  },
  {
    "id": "p-7f0c87",
    "offset": 2618,
    "text": "στόμα δικαίου ἀποστάζει σοφίαν,"
  },
  {
    "id": "p-3a9838",
    "offset": 2651,
    "text": "γλῶσσα δὲ ἀδίκου ἐξολεῖται."
  },
  {
    "id": "p-8fa79f",
    "offset": 2680,
    "text": "χείλη ἀνδρῶν δικαίων ἀποστάζει χάριτας,"
  },
  {
    "id": "p-c12d2f",
    "offset": 2721,
    "text": "στόμα δὲ ἀσεβῶν ἀποστρέφεται."
  }
]