[
  {
    "id": "p-603320",
    "offset": 0,
    "text": "ὁ ἀγαπῶν παιδείαν ἀγαπᾷ αἴσθησιν,"
  },
  {
    "id": "p-caeaaf",
    "offset": 35,
    "text": "ὁ δὲ μισῶν ἐλέγχους ἄφρων."
  },
  {
    "id": "p-878852",
    "offset": 63,
    "text": "κρείσσων ὁ εὑρὼν χάριν παρὰ Κυρίῳ,"
  },
  {
    "id": "p-c2518a",
    "offset": 99,
    "text": "ἀνὴρ δὲ παράνομος παρασιωπηθήσεται."
  },
  {
    "id": "p-9e16bd",
    "offset": 136,
    "text": "οὐ κατορθώσει ἄνθρωπος ἐξ ἀνόμου,"
  },
  {
    "id": "p-8f0406",
    "offset": 171,
    "text": "αἱ δὲ ῥίζαι τῶν δικαίων οὐκ ἐξαρθήσονται."
  },
  {
    "id": "p-3039bd",
    "offset": 214,
    "text": "γυνὴ ἀνδρεία στέφανος τῷ ἀνδρὶ αὐτῆς·"
  },
  {
    "id": "p-deaf6a",
    "offset": 253,
    "text": "ὥσπερ δὲ ἐν ξύλῳ σκώληξ, οὕτως ἄνδρα ἀπόλλυσιν γυνὴ"
  },
  {
    "id": "p-deb436",
    "offset": 306,
    "text": "κακοποιός."
  },
  {
    "id": "p-dfeedb",
    "offset": 318,
    "text": "λογισμοὶ δικαίων κρίματα,"
  },
  {
    "id": "p-93d87b",
    "offset": 345,
    "text": "κυβερνῶσιν δὲ ἀσεβεῖς δόλους."
  },
  {
    "id": "p-d9931d",
    "offset": 376,
    "text": "λόγοι ἀσεβῶν δόλιοι,"
  },
  {
    "id": "p-a00798",
    "offset": 398,
    "text": "στόμα δὲ ὀρθῶν ῥύσεται αὐτούς."
  },
  {
    "id": "p-b07775",
    "offset": 430,
    "text": "οὗ ἐὰν στραφῇ, ἀσεβὴς ἀφανίζεται,"
  },
  {
    "id": "p-d4dbaf",
    "offset": 465,
    "text": "οἶκοι δὲ δικαίων παραμένουσιν."
  },
  {
    "id": "p-e972b8",
    "offset": 497,
    "text": "στόμα συνετοῦ ἐγκωμιάζεται ὑπὸ ἀνδρός,"
  },
  {
    "id": "p-0cd4bf",
    "offset": 537,
    "text": "νωθροκάρδιος δὲ μυκτηρίζεται."
  },
  {
    "id": "p-3afafc",
    "offset": 568,
    "text": "κρείσσων ἀνὴρ ἐν ἀτιμίᾳ δουλεύων ἑαυτῷ,"
  },
  {
    "id": "p-97154a",
    "offset": 609,
    "text": "ἢ τιμὴν ἑαυτῷ περιτιθεὶς καὶ προσδεόμενος ἄρτου."
  },
  {
    "id": "p-c0ac8e",
    "offset": 659,
    "text": "δίκαιος οἰκτείρει ψυχὰς κτηνῶν αὐτοῦ."
  },
  {
    "id": "p-543a4b",
    "offset": 698,
    "text": "τὰ δὲ σπλάγχνα τῶν ἀσεβῶν ἀνελεήμονα."
  },
  {
    "id": "p-29df9c",
    "offset": 737,
    "text": "ὁ ἐργαζόμενος τὴν ἑαυτοῦ γῆν ἐμπλησθήσεται ἄρτων."
  },
  {
    "id": "p-201e2c",
    "offset": 788,
    "text": "οἱ δὲ διώκοντες μάταια ἐνδεεῖς φρενῶν."
  },
  {
    "id": "p-f416fc",
    "offset": 828,
    "text": "a ὅς ἐστιν ἡδὺς ἐν οἴνων διατριβαῖς,"
  },
  {
    "id": "p-5fda04",
    "offset": 866,
    "text": "ἐν τοῖς ἑαυτοῦ ὀχυρώμασιν καταλείψει ἀτιμίαν."
  },
  {
    "id": "p-51fc2d",
    "offset": 913,
    "text": "ἐπιθυμίαι ἀσεβῶν κακαί,"
  },
  {
    "id": "p-9ca423",
    "offset": 938,
    "text": "αἱ δὲ ῥίζαι τῶν εὐσεβῶν ἐν ὀχυρώμασιν."
  },
  {
    "id": "p-0d7c9a",
    "offset": 978,
    "text": "δι᾿ ἁμαρτίαν χειλέων ἐμπίπτει εἰς παγίδας ἁμαρτωλός,"
  },
  {
    "id": "p-f82543",
    "offset": 1032,
    "text": "ἐκφεύγει δὲ ἐξ αὐτῶν δίκαιος."
  },
  {
    "id": "p-36640a",
    "offset": 1063,
    "text": "a ὁ βλέπων λεῖα ἐλεηθήσεται,"
  },
  {
    "id": "p-d1086e",
    "offset": 1093,
    "text": "ὁ δὲ συναντῶν ἐν πύλαις ἐκθλίψει ψυχάς."
  },
  {
    "id": "p-fa5c5c",
    "offset": 1134,
    "text": "ἀπὸ καρπῶν στόματος ψυχὴ ἀνδρὸς πλησθήσεται ἀγαθῶν,"
  },
  {
    "id": "p-8cf501",
    "offset": 1187,
    "text": "ἀνταπόδομα δὲ χειλέων αὐτοῦ δοθήσεται αὐτῷ."
  },
  {
    "id": "p-813ad9",
    "offset": 1232,
    "text": "ὁδοὶ ἀφρόνων ὀρθαὶ ἐνώπιον αὐτῶν,"
  },
  {
    "id": "p-475fce",
    "offset": 1267,
    "text": "εἰσακούει δὲ συμβουλίας σοφός."
  },
  {
    "id": "p-9f4408",
    "offset": 1299,
    "text": "ἄφρων αὐθημερὸν ἐξαγγέλλει ὀργὴν αὐτοῦ,"
  },
  {
    "id": "p-88ff27",
    "offset": 1340,
    "text": "κρύπτει δὲ τὴν ἑαυτοῦ ἀτιμίαν πανοῦργος."
  },
  {
    "id": "p-911dac",
    "offset": 1382,
    "text": "ἐπιδεικνυμένην πίστιν ἀπαγγέλλει δίκαιος,"
  },
  {
    "id": "p-20ab12",
    "offset": 1425,
    "text": "ὁ δὲ μάρτυς τῶν ἀδίκων δόλιος."
  },
  {
    "id": "p-713a7b",
    "offset": 1457,
    "text": "εἰσὶν οἳ λέγοντες τιτρώσκουσιν μάχαιραι,"
  },
  {
    "id": "p-f7e2b8",
    "offset": 1499,
    "text": "γλῶσσαι δὲ σοφῶν ἰῶνται."
  },
  {
    "id": "p-1fc847",
    "offset": 1525,
    "text": "χείλη ἀληθινὰ κατορθοῖ μαρτυρίαν,"
  },
  {
    "id": "p-a01150",
    "offset": 1560,
    "text": "μάρτυς δὲ ταχὺς γλῶσσαν ἔχει ἄδικον."
  },
  {
    "id": "p-daafe4",
    "offset": 1598,
    "text": "αρτων A 10 οικτειρει δικαιος A | αυτου] εαυτου U+05D0* (αυτ. U+05D0c.a) 11 εμ-\nπλησθησηται B 11a καταλιψω U+05D0* (-ψει U+05D0¹) | ατιμιαν BU+05D0c.aA] αμαρτιαν U+05D0*\n12 ευσεβων] ασεβων B 13 δι] δια U+05D0A | αμαρτιας A | αμαρτωλος] pr ο U+05D0*\n(om ο U+05D0c.a) | εκφευει U+05D0* (εκφευγ. U+05D0c.a) 14 καρπων] γαρπων A 16 εξ-\nαγγελει U+05D0 | πανουργος] pr ο U+05D0c.a 18 μαχαιραν A"
  },
  {
    "id": "p-1c7e59",
    "offset": 1986,
    "text": "δόλος ἐν καρδίᾳ τεκταινομένου κακά,"
  },
  {
    "id": "p-60f257",
    "offset": 2023,
    "text": "οἱ δὲ βουλόμενοι εἰρήνην εὐφρανθήσονται."
  },
  {
    "id": "p-5aea41",
    "offset": 2065,
    "text": "οὐκ ἀρέσει τῷ δικαίῳ οὐδὲν ἄδικον,"
  },
  {
    "id": "p-ce27ef",
    "offset": 2101,
    "text": "οἱ δὲ ἀσεβεῖς πλησθήσονται κακῶν."
  },
  {
    "id": "p-153110",
    "offset": 2136,
    "text": "βδέλυγμα Κυρίῳ χείλη ψευδῆ,"
  },
  {
    "id": "p-984f29",
    "offset": 2165,
    "text": "ὁ δὲ ποιῶν πίστεις δεκτὸς παρʼ αὐτῷ."
  },
  {
    "id": "p-db35c7",
    "offset": 2203,
    "text": "ἀνὴρ συνετὸς θρόνος αἰσθήσεως,"
  },
  {
    "id": "p-f1552d",
    "offset": 2235,
    "text": "καρδία δὲ ἀφρόνων συναντήσεται ἀραῖς."
  },
  {
    "id": "p-0e7e08",
    "offset": 2274,
    "text": "χεὶρ ἐκλεκτῶν κρατήσει εὐχερῶς,"
  },
  {
    "id": "p-b7f3f8",
    "offset": 2307,
    "text": "δόλιοι δὲ ἔσονται ἐν προνομῇ."
  },
  {
    "id": "p-0095ba",
    "offset": 2338,
    "text": "φοβερὸς λόγος καρδίαν ταράσσει ἀνδρὸς δικαίου,"
  },
  {
    "id": "p-16f8fd",
    "offset": 2386,
    "text": "ἀγγελία δὲ ἀγαθὴ εὐφραίνει αὐτόν."
  },
  {
    "id": "p-24d446",
    "offset": 2421,
    "text": "ἐπιγνώμων δίκαιος ἑαυτοῦ φίλος ἔσται,"
  },
  {
    "id": "p-07972d",
    "offset": 2460,
    "text": "ἁμαρτάνοντας δὲ καταδιώξεται κακά,"
  },
  {
    "id": "p-a141b6",
    "offset": 2496,
    "text": "ἡ δὲ ὁδὸς τῶν ἀσεβῶν πλανήσει αὐτούς."
  },
  {
    "id": "p-4f2633",
    "offset": 2535,
    "text": "οὐκ ἐπιτεύξεται δόλιος θήρας,"
  },
  {
    "id": "p-6b2ccf",
    "offset": 2566,
    "text": "κτῆμα δὲ τίμιον ἀνὴρ καθαρός."
  },
  {
    "id": "p-fc71b8",
    "offset": 2597,
    "text": "ἐν ὁδοῖς δικαιοσύνης ζωή,"
  },
  {
    "id": "p-36a820",
    "offset": 2624,
    "text": "ὁδοὶ δὲ μνησικάκων εἰς θάνατον."
  }
]