[
  {
    "id": "p-5f8336",
    "offset": 0,
    "text": "καρδία δὲ ἀνδρὸς λογιζέσθω δίκαια,"
  },
  {
    "id": "p-e1fa19",
    "offset": 36,
    "text": "ἵνα ὑπὸ τοῦ θεοῦ διορθωθῇ τὰ διαβήματα αὐτοῦ."
  },
  {
    "id": "p-6dc91f",
    "offset": 83,
    "text": "θεωρῶν ὀφθαλμὸς καλὰ εὐφραίνει καρδίαν,"
  },
  {
    "id": "p-ba1822",
    "offset": 124,
    "text": "φήμη δὲ ἀγαθὴ πιαίνει ὀστᾶ."
  },
  {
    "id": "p-86eda6",
    "offset": 153,
    "text": "ὃς ἀπωθεῖται παιδείαν μισεῖ ἑαυτόν,"
  },
  {
    "id": "p-cc2411",
    "offset": 190,
    "text": "ὁ δὲ τηρῶν ἐλέγχους ἀγαπᾷ ψυχὴν αὐτοῦ."
  },
  {
    "id": "p-6974f8",
    "offset": 230,
    "text": "φόβος θεοῦ παιδεία καὶ σοφία,"
  },
  {
    "id": "p-269fff",
    "offset": 261,
    "text": "καὶ ἀρχὴ δόξης ἀποκριθήσεται αὐτῇ."
  },
  {
    "id": "p-c629c7",
    "offset": 297,
    "text": "πάντα τὰ ἔργα τοῦ ταπεινοῦ φανερὰ παρὰ τῷ θεῷ,"
  },
  {
    "id": "p-6b85b2",
    "offset": 345,
    "text": "οἱ δὲ ἀσεβεῖς ἐν ἡμέρᾳ κακῇ ὀλοῦνται."
  },
  {
    "id": "p-98149d",
    "offset": 384,
    "text": "ἀκάθαρτος παρὰ θεῷ πᾶς ὑψηλοκάρδιος,"
  },
  {
    "id": "p-bca81d",
    "offset": 422,
    "text": "χειρὶ δὲ χεῖρας ἐμβαλὼν ἀδίκως οὐκ ἀθῳωθήσεται."
  },
  {
    "id": "p-1c5bdf",
    "offset": 471,
    "text": "ἀρχὴ ὁδοῦ ἀγαθῆς τὸ ποιεῖν τὰ δίκαια,"
  },
  {
    "id": "p-ecb832",
    "offset": 510,
    "text": "δεκτὰ δὲ παρὰ θεῷ μᾶλλον ἢ θύειν θυσίας."
  },
  {
    "id": "p-9c1e12",
    "offset": 552,
    "text": "ὁ ζητῶν τὸν κύριον εὑρήσει γνῶσιν μετὰ δικαιοσύνης,"
  },
  {
    "id": "p-cd12ea",
    "offset": 605,
    "text": "οἱ δὲ ὀρθῶς ζητοῦντες αὐτὸν εὑρήσουσιν εἰρήνην."
  },
  {
    "id": "p-8f9c2f",
    "offset": 654,
    "text": "πάντα τὰ ἔργα τοῦ κυρίου μετὰ δικαιοσύνης,"
  },
  {
    "id": "p-b22e63",
    "offset": 698,
    "text": "φυλάσσεται δὲ ὁ ἀσεβὴς εἰς ἡμέραν κακήν."
  },
  {
    "id": "p-9e6ccc",
    "offset": 740,
    "text": "μαντεῖον ἐπὶ χείλεσιν βασιλέως,"
  },
  {
    "id": "p-e9016c",
    "offset": 773,
    "text": "ἐν δὲ κρίσει οὐ μὴ πλανηθῇ τὸ στόμα αὐτοῦ."
  },
  {
    "id": "p-041cd5",
    "offset": 817,
    "text": "ῥοπὴ ζυγοῦ δικαιοσύνη παρὰ Κυρίῳ,"
  },
  {
    "id": "p-aa5af4",
    "offset": 852,
    "text": "τὰ δὲ ἔργα αὐτοῦ στάθμια δίκαια."
  },
  {
    "id": "p-c41665",
    "offset": 886,
    "text": "βδέλυγμα βασιλεῖ ὁ ποιῶν κακά,"
  },
  {
    "id": "p-7b3477",
    "offset": 918,
    "text": "μετὰ γὰρ δικαιοσύνης ἑτοιμάζεται θρόνος ἀρχῆς."
  },
  {
    "id": "p-7024ba",
    "offset": 966,
    "text": "δεκτὰ βασιλεῖ χείλη δίκαια,"
  },
  {
    "id": "p-461ba7",
    "offset": 995,
    "text": "λόγους δὲ ὀρθοὺς ἀγαπᾷ."
  },
  {
    "id": "p-2c3e67",
    "offset": 1020,
    "text": "θυμὸς βασιλέως ἄγγελος θανάτου,"
  },
  {
    "id": "p-7d4b9a",
    "offset": 1053,
    "text": "ἀνὴρ δὲ σοφὸς ἐξιλάσεται αὐτόν."
  },
  {
    "id": "p-71ce9a",
    "offset": 1086,
    "text": "ἐν φωτὶ ζωῆς υἱὸς βασιλέως,"
  },
  {
    "id": "p-1e1c25",
    "offset": 1115,
    "text": "οἱ δὲ προσδεκτοὶ αὐτῷ ὥσπερ νέφος ὄψιμον."
  },
  {
    "id": "p-ccb104",
    "offset": 1158,
    "text": "νοσσιαὶ σοφίας αἱρετώτεραι χρυσίου,"
  },
  {
    "id": "p-59182b",
    "offset": 1195,
    "text": "νοσσιαὶ δὲ φρονήσεως αἱρετώτεραι ὑπὲρ ἀργύριον"
  },
  {
    "id": "p-b465da",
    "offset": 1243,
    "text": "τρίβοι ζωῆς ἐκκλίνουσιν ἀπὸ κακῶν,"
  },
  {
    "id": "p-688c59",
    "offset": 1279,
    "text": "μῆκος δὲ βίου ὁδοὶ δικαιοσύνης."
  },
  {
    "id": "p-7b6fee",
    "offset": 1312,
    "text": "ὁ δεχόμενος παιδείαν ἐν ἀγαθοῖς ἔσται,"
  },
  {
    "id": "p-9909d4",
    "offset": 1352,
    "text": "ὁ δὲ φυλάσσων ἐλέγχους σοφισθήσεται."
  },
  {
    "id": "p-39025f",
    "offset": 1390,
    "text": "ὃς φυλάσσει τὰς ἑαυτοῦ ὁδοὺς τηρεῖ τὴν ἑαυτοῦ ψυχήν,"
  },
  {
    "id": "p-031da6",
    "offset": 1444,
    "text": "ἀγαπῶν δὲ ζωὴν αὐτοῦ φείσεται στόματος αὐτοῦ."
  },
  {
    "id": "p-6332e9",
    "offset": 1491,
    "text": "πρὸ συντριβῆς ἡγεῖται ὕβρις,"
  },
  {
    "id": "p-d85906",
    "offset": 1521,
    "text": "πρὸ δὲ πτώματος κακοφροσύνη."
  },
  {
    "id": "p-1bde79",
    "offset": 1551,
    "text": "κρείσσων πρᾳύθυμος μετὰ ταπεινώσεως"
  },
  {
    "id": "p-dea7a2",
    "offset": 1588,
    "text": "ἢ ὃς διαιρεῖται σκῦλα μετὰ ὑβριστῶν."
  },
  {
    "id": "p-c3ed4b",
    "offset": 1626,
    "text": "συνετὸς ἐν πράγμασιν εὑρειὴς ἀγαθῶν,"
  },
  {
    "id": "p-a3726e",
    "offset": 1664,
    "text": "πεποιθὼς δὲ ἐπὶ θεῷ μακαριστός."
  },
  {
    "id": "p-9be32a",
    "offset": 1697,
    "text": "τοὺς σοφοὺς καὶ συνετοὺς φαύλους καλοῦσιν,"
  },
  {
    "id": "p-e42edc",
    "offset": 1741,
    "text": "οἱ δὲ γλυκεῖς ἐν λόγῳ πλείονα ἀκούσονται."
  },
  {
    "id": "p-43efeb",
    "offset": 1784,
    "text": "10 κρισει] seq ras 2 litt in C 11 Κυριω] κυ A θω C 13 ορθους] αγαθους\nC | αγαπα periit in C 15 οψιμοι U+05D0* (-μον U+05D0c.a) 16 χρυσιω A 17 εκκι-\nνουσιν U+05D0 | παιδιαν AC | εν] επ U+05D0 | αυτου 1⁰] εαυτου C 19 πραυθυμος]\nπροθυμος A | ταπεινωσεως] ταπινοφροσυνης C | υβριστων] υβρεως A 20 θεω]\nκω AC 21 πλειονα] πλιον A πλειον C | ακουσονται] ακουοντ (U+05D0) A"
  },
  {
    "id": "p-d024a9",
    "offset": 2151,
    "text": "πηγὴ ζωῆς ἔννοια τοῖς κεκτημένοις,"
  },
  {
    "id": "p-f57d53",
    "offset": 2187,
    "text": "παιδεία δὲ ἀφρόνων κακή."
  },
  {
    "id": "p-f493a2",
    "offset": 2213,
    "text": "καρδία σοφοῦ νοήσει τὰ ἀπὸ τοῦ ἰδίου στόματος,"
  },
  {
    "id": "p-3a8792",
    "offset": 2261,
    "text": "ἐπὶ δὲ χείλεσιν φορέσει ἐπιγνωμοσύνην."
  },
  {
    "id": "p-be5ed0",
    "offset": 2301,
    "text": "κηρία μέλιτος λόγοι καλοί,"
  },
  {
    "id": "p-5814fc",
    "offset": 2329,
    "text": "γλύκασμα δὲ αὐτοῦ ἴασις ψυχῆς."
  },
  {
    "id": "p-7cc02d",
    "offset": 2361,
    "text": "εἰσὶν ὁδοὶ δοκοῦσαι εἶναι ὀρθαὶ ἀνδρί,"
  },
  {
    "id": "p-f1e9ef",
    "offset": 2401,
    "text": "τὰ μέντοι τελευταῖα αὐτῶν βλέπει εἰς πυθμένα ᾅδου."
  },
  {
    "id": "p-09f90a",
    "offset": 2453,
    "text": "ἀνὴρ ἐν πόνοις πονεῖ ἑαυτῷ"
  },
  {
    "id": "p-593a26",
    "offset": 2481,
    "text": "καὶ ἐκβιάζεται ἑαυτοῦ τὴν ἀπώλειαν·"
  },
  {
    "id": "p-65a027",
    "offset": 2518,
    "text": "ὁ μέντοι σκολιὸς ἐπὶ τῷ ἑαυτοῦ στόματι φορεῖ τὴν ἀπώλειαν."
  },
  {
    "id": "p-1756f6",
    "offset": 2578,
    "text": "ἀνὴρ ἄφρων ὀρύσσει ἑαυτῷ κακά,"
  },
  {
    "id": "p-422d14",
    "offset": 2610,
    "text": "ἐπὶ δὲ τῶν ἑαυτοῦ χειλέων θησαυρίζει πῦρ."
  },
  {
    "id": "p-cb6c20",
    "offset": 2653,
    "text": "ἀνὴρ σκολιὸς διαπέμπεται κακά,"
  },
  {
    "id": "p-8e913e",
    "offset": 2685,
    "text": "καὶ λαμπτῆρα δόλου πυρσεύσει κακοῖς, καὶ διαχωρίζει"
  },
  {
    "id": "p-b8073e",
    "offset": 2738,
    "text": "φίλους."
  },
  {
    "id": "p-319551",
    "offset": 2747,
    "text": "ἀνὴρ παράνομος ἀποπειρᾶται φίλων,"
  },
  {
    "id": "p-f41d95",
    "offset": 2782,
    "text": "καὶ ἀπάγει αὐτοὺς ὁδοὺς οὐκ ἀγαθάς."
  },
  {
    "id": "p-e1073c",
    "offset": 2819,
    "text": "στηρίζων δὲ ὀφθαλμοὺς αὐτοῦ διαλογίζεται διεστραμμένα,"
  },
  {
    "id": "p-cdcddf",
    "offset": 2875,
    "text": "ὁρίζει δὲ τοῖς χείλεσιν αὐτοῦ πάντα τὰ κακά,"
  },
  {
    "id": "p-658cdd",
    "offset": 2921,
    "text": "οὗτος κάμινός ἐστιν κακίας."
  },
  {
    "id": "p-58d09c",
    "offset": 2950,
    "text": "στέφανος καυχήσεως γῆρας,"
  },
  {
    "id": "p-94c680",
    "offset": 2977,
    "text": "ἐν δὲ ὁδοῖς δικαιοσύνης εὑρίσκεται."
  },
  {
    "id": "p-e3df6c",
    "offset": 3014,
    "text": "κρείσσων ἀνὴρ μακρόθυμος ἰσχυροῦ,"
  },
  {
    "id": "p-d22541",
    "offset": 3049,
    "text": "ὁ δὲ κρατῶν ὀργῆς κρείσσων καταλαμβανομένου πόλιν."
  },
  {
    "id": "p-446ef6",
    "offset": 3101,
    "text": "εἰς κόλπους ἐπέρχεται πάντα τοῖς ἀδίκοις,"
  },
  {
    "id": "p-ee2adb",
    "offset": 3144,
    "text": "παρὰ δὲ Κυρίου πάντα τὰ δίκαια."
  }
]