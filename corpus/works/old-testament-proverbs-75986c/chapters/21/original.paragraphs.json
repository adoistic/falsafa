[
  {
    "id": "p-34942d",
    "offset": 0,
    "text": "ὥσπερ ὁρμὴ ὕδατος, οὕτως καρδία βασιλέως ἐν χειρὶ θεοῦ·"
  },
  {
    "id": "p-3c00ba",
    "offset": 57,
    "text": "οὗ ἐὰν θέλων νεῦσαι, ἐκεῖ ἔκλινεν αὐτήν."
  },
  {
    "id": "p-f7e953",
    "offset": 99,
    "text": "πᾶς ἀνὴρ φαίνεται ἑαυτῷ δίκαιος,"
  },
  {
    "id": "p-63ecb4",
    "offset": 133,
    "text": "κατευθύνει δὲ καρδίας Κύριος."
  },
  {
    "id": "p-32a8f8",
    "offset": 164,
    "text": "ποιεῖν δίκαια καὶ ἀληθεύειν"
  },
  {
    "id": "p-85ffa3",
    "offset": 193,
    "text": "ἀρεστὰ παρὰ θεῷ μᾶλλον ἢ θυσιῶν αἷμα."
  },
  {
    "id": "p-016598",
    "offset": 232,
    "text": "μεγαλόφρων ἐφʼ ὕβρει θρασυκάρδιος·"
  },
  {
    "id": "p-a33dd4",
    "offset": 268,
    "text": "λαμπτὴρ δὲ ἀσεβῶν ἁμαρτία."
  },
  {
    "id": "p-4dc71c",
    "offset": 296,
    "text": "U+05D0 A | αρτων] αυτων U+05D0* (αρτ. U+05D0c.a) 18 τα διαβηματα] om τα A | δε] ε\ninst U+05D0? 19 αγιασαι] prius απαται U+05D0* 21 ος] pr η λυχνος A | ερευνα\nBᵃᵇU+05D0A | ταμεια Bᵃᵇ (ταμια BU+05D0*)] ταμιεια A 24 ταμεια Bᵃ(vid)ᵇ (ταμια\nB*U+05D0)] ταμιεια A pr τα U+05D0* (om τα U+05D0c.a) XXI 1 εαν] δ αν U+05D0A | νευση\nU+05D0c.aA | om εκει A 4 αμαρτιαι U+05D0c.aA"
  },
  {
    "id": "p-9a8c3a",
    "offset": 663,
    "text": "ὁ ἐνεργῶν θησαυρίσματα γλώσσῃ ψευδεῖ"
  },
  {
    "id": "p-b5d93f",
    "offset": 701,
    "text": "μάταια διώκει ἐπὶ παγίδας θανάτου."
  },
  {
    "id": "p-5ca0ef",
    "offset": 737,
    "text": "ὄλεθρος ἀσεβέσιν ἐπιξενωθήσεται,"
  },
  {
    "id": "p-f71e67",
    "offset": 771,
    "text": "οὐ γὰρ βούλονται πράσσειν τὰ δίκαια."
  },
  {
    "id": "p-8944c9",
    "offset": 809,
    "text": "πρὸς τοὺς σκολιοὺς σκολιὰς ὁδοὺς ἀποστέλλει ὁ θεός,"
  },
  {
    "id": "p-e570cd",
    "offset": 862,
    "text": "ἁγνὰ γὰρ καὶ ὀρθὰ τὰ ἔργα αὐτοῦ."
  },
  {
    "id": "p-b4c17e",
    "offset": 896,
    "text": "κρεῖσσον οἰκεῖν ἐπὶ γωνίας ὑπαίθρου"
  },
  {
    "id": "p-234bd4",
    "offset": 933,
    "text": "ἢ ἐν κεκονιαμένοις μετὰ ἀδικίας καὶ ἐν οἴκῳ κοινῷ."
  },
  {
    "id": "p-f7c56a",
    "offset": 985,
    "text": "ψυχὴ ἀσεβοῦς οὐκ ἐλεηθήσεται ὑπʼ οὐδενὸς τῶν ἀνθρώπων."
  },
  {
    "id": "p-537912",
    "offset": 1041,
    "text": "ζημιουμένου ἀκολάστου πανουργότερος γίνεται ὁ κακός,"
  },
  {
    "id": "p-00d656",
    "offset": 1095,
    "text": "συνίων δὲ σοφὸς δέξεται γνῶσιν."
  },
  {
    "id": "p-e9d076",
    "offset": 1128,
    "text": "συνίει δίκαιος καρδίας ἀσεβῶν"
  },
  {
    "id": "p-aeaf8c",
    "offset": 1159,
    "text": "καὶ φαυλίζει ἀσεβεῖς ἐν κακοῖς."
  },
  {
    "id": "p-98c788",
    "offset": 1192,
    "text": "ὃς φράσσει τὰ ὦτα τοῦ μὴ ἐπακοῦσαι ἀσθενοῦς,"
  },
  {
    "id": "p-3bc984",
    "offset": 1238,
    "text": "καὶ αὐτὸς ἐπικαλέσεται καὶ οὐκ ἔσται ὁ εἰσακούων."
  },
  {
    "id": "p-bf26c3",
    "offset": 1289,
    "text": "δόσις λάθριος ἀνατρέπει ὀργάς,"
  },
  {
    "id": "p-0b53e9",
    "offset": 1321,
    "text": "δώρων δὲ ὁ φειδόμενος θυμὸν ἐγείρει ἰσχυρόν."
  },
  {
    "id": "p-2ce9ca",
    "offset": 1367,
    "text": "εὐφροσύνη δικαίων ποιεῖ κρίμα,"
  },
  {
    "id": "p-6d461b",
    "offset": 1399,
    "text": "ὅσιος δὲ ἀκάθαρτος παρὰ κακούργοις."
  },
  {
    "id": "p-75982f",
    "offset": 1436,
    "text": "ἀνὴρ πλανώμενος ἐξ ὁδοῦ δικαιοσύνης"
  },
  {
    "id": "p-3f1c10",
    "offset": 1473,
    "text": "ἐν συναγωγῇ γιγάντων ἀναπαύσεται."
  },
  {
    "id": "p-01eccf",
    "offset": 1508,
    "text": "ἀνὴρ ἐνδεὴς ἀγαπᾷ εὐφροσύνην,"
  },
  {
    "id": "p-bfb0fe",
    "offset": 1539,
    "text": "φιλῶν οἶνον καὶ ἔλαιον εἰς πλοῦτον·"
  },
  {
    "id": "p-5b11c0",
    "offset": 1576,
    "text": "περικάθαρμα δὲ δικαίου ἄνομος."
  },
  {
    "id": "p-85bd51",
    "offset": 1608,
    "text": "κρεῖσσον οἰκεῖν ἐν τῇ ἐρήμῳ"
  },
  {
    "id": "p-b6c766",
    "offset": 1637,
    "text": "ἢ μετὰ γυναικὸς γλωσσώδους καὶ μαχίμου καὶ ὀργίλου."
  },
  {
    "id": "p-fd4a14",
    "offset": 1690,
    "text": "θησαυρὸς ἐπιθυμητὸς ἀναπαύσεται ἐπὶ στόματος σοφοῦ,"
  },
  {
    "id": "p-141fe3",
    "offset": 1743,
    "text": "ἄφρονες δὲ ἄνδρες καταπίονται αὐτόν."
  },
  {
    "id": "p-5d4548",
    "offset": 1781,
    "text": "ὁδὸς δικαιοσύνης καὶ ἐλεημοσύνης εὑρήσει ζωὴν καὶ δόξαν."
  },
  {
    "id": "p-32bdb1",
    "offset": 1839,
    "text": "πόλεις ὀχυρὰς ἐπέβη σοφὸς"
  },
  {
    "id": "p-d8c0f0",
    "offset": 1866,
    "text": "καὶ καθεῖλεν τὸ ὀχύρωμα ἐφʼ ᾧ ἐπεποίθεισαν οἱ ἀσεβεῖς."
  },
  {
    "id": "p-f1f781",
    "offset": 1922,
    "text": "ὃς φυλάσσει τὸ στόμα αὐτοῦ καὶ τὴν γλῶσσαν,"
  },
  {
    "id": "p-d17e2c",
    "offset": 1967,
    "text": "διατηρεῖ ἐκ θλίψεως τὴν ψυχὴν αὐτοῦ."
  },
  {
    "id": "p-374956",
    "offset": 2005,
    "text": "θρασὺς καὶ αὐθάδης καὶ ἀλαζὼν λοιμὸς καλεῖται,"
  },
  {
    "id": "p-8ce30f",
    "offset": 2053,
    "text": "ὃς δὲ μνησικακεῖ παράνομος."
  },
  {
    "id": "p-64774b",
    "offset": 2082,
    "text": "ἐπιθυμίαι ὀκνηρὸν ἀποκτείνουσιν,"
  },
  {
    "id": "p-9c11d7",
    "offset": 2116,
    "text": "οὐ γὰρ προαιροῦνται αἱ χεῖρες αὐτοῦ ποιεῖν τι."
  },
  {
    "id": "p-0afa04",
    "offset": 2164,
    "text": "ἀσεβὴς ἐπιθυμεῖ ὅλην τὴν ἡμέραν ἐπιθυμίας κακάς,"
  },
  {
    "id": "p-22b25b",
    "offset": 2214,
    "text": "ὁ δὲ δίκαιος ἐλεᾷ καὶ οἰκτείρει ἀφειδῶς."
  },
  {
    "id": "p-7e0f18",
    "offset": 2256,
    "text": "θυσίαι ἀσεβῶν βδέλυγμα Κυρίῳ,"
  },
  {
    "id": "p-9fc099",
    "offset": 2287,
    "text": "καὶ γὰρ παρανόμως προσφέρουσιν αὐτάς."
  },
  {
    "id": "p-8ac332",
    "offset": 2326,
    "text": "μάρτυς ψευδὴς ἀπολεῖται,"
  },
  {
    "id": "p-7908e2",
    "offset": 2352,
    "text": "ἀνὴρ δὲ ὑπήκοος φυλασσόμενος λαλήσει."
  },
  {
    "id": "p-cc6b11",
    "offset": 2391,
    "text": "ἀσεβὴς ἀνὴρ ἀναιδῶς ὑφίσταται προσώπῳ,"
  },
  {
    "id": "p-4971d6",
    "offset": 2431,
    "text": "ὁ δὲ εὐθὴς αὐτὸς συνίει τὰς ὁδοὺς αὐτοῦ."
  },
  {
    "id": "p-a7f3b2",
    "offset": 2473,
    "text": "οὐκ ἔστιν σοφία, οὐκ ἔστιν ἀνδρία,"
  },
  {
    "id": "p-306824",
    "offset": 2509,
    "text": "οὐκ ἔστιν βουλὴ πρὸς τὸν ἀσεβῆ."
  },
  {
    "id": "p-83efc3",
    "offset": 2542,
    "text": "ἵππος ἑτοιμάζεται εἰς ἡμέραν πολέμου,"
  },
  {
    "id": "p-57c81e",
    "offset": 2581,
    "text": "παρὰ δὲ Κυρίου ἡ βοήθεια."
  }
]