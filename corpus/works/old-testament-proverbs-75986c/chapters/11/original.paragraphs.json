[
  {
    "id": "p-85ce21",
    "offset": 0,
    "text": "ζυγοὶ δόλιοι βδέλυγμα ἐνώπιον Κυρίου,"
  },
  {
    "id": "p-b8f6aa",
    "offset": 39,
    "text": "στάθμιον δὲ δίκαιον δεκτὸν αὐτῷ."
  },
  {
    "id": "p-d871cf",
    "offset": 73,
    "text": "οὗ ἐὰν εἰσέλθῃ ὕβρις, ἐκεῖ καὶ ἀτιμία·"
  },
  {
    "id": "p-d6287c",
    "offset": 113,
    "text": "στόμα δὲ ταπεινῶν μελετᾷ σοφίαν."
  },
  {
    "id": "p-75d6ff",
    "offset": 147,
    "text": "ἀποθανὼν δίκαιος ἔλιπεν μετάμελον,"
  },
  {
    "id": "p-bf3675",
    "offset": 183,
    "text": "πρόχειρος δὲ γίνεται καὶ ἐπίχαρτος ἀσεβῶν ἀπώλεια."
  },
  {
    "id": "p-6334b4",
    "offset": 235,
    "text": "δικαιοσύνη ἀμώμους ὀρθοτομεῖ ὁδούς,"
  },
  {
    "id": "p-71171a",
    "offset": 272,
    "text": "ἀσέβεια δὲ περιπίπτει ἀδικίᾳ."
  },
  {
    "id": "p-28f0bd",
    "offset": 303,
    "text": "δικαιοσύνη ἀνδρῶν ὀρθῶν ῥύεται αὐτούς,"
  },
  {
    "id": "p-f79fe5",
    "offset": 343,
    "text": "τῇ δὲ ἀπωλείᾳ αὐτῶν ἁλίσκονται παράνομοι."
  },
  {
    "id": "p-2d9db3",
    "offset": 386,
    "text": "τελευτήσαντος ἀνδρὸς δικαίου οὐκ ὄλλυται ἐλπίς,"
  },
  {
    "id": "p-15087d",
    "offset": 435,
    "text": "τὸ δὲ καύχημα τῶν ἀσεβῶν ὄλλυται."
  },
  {
    "id": "p-906d2c",
    "offset": 470,
    "text": "δίκαιος ἐκ θήρας ἐκδύνει,"
  },
  {
    "id": "p-eac1bd",
    "offset": 497,
    "text": "ἀντʼ αὐτοῦ δὲ παραδίδοται ὁ ἀσεβής."
  },
  {
    "id": "p-e94973",
    "offset": 534,
    "text": "ἐν στόματι ἀσεβῶν παγὶς πολίταις,"
  },
  {
    "id": "p-d98666",
    "offset": 569,
    "text": "αἴσθησις δὲ δικαίων εὔοδος."
  },
  {
    "id": "p-9d8973",
    "offset": 598,
    "text": "ἐν ἀγαθοῖς δικαίων κατώρθωσεν πόλις,"
  },
  {
    "id": "p-1ef429",
    "offset": 636,
    "text": "στόμασιν δὲ ἀσεβῶν κατεσκάφη."
  },
  {
    "id": "p-438047",
    "offset": 667,
    "text": "μυκτηρίζει πολίτας ἐνδεὴς φρενῶν,"
  },
  {
    "id": "p-206d78",
    "offset": 702,
    "text": "ἀνὴρ δὲ φρόνιμος ἡσυχίαν ἄγει."
  },
  {
    "id": "p-b82cd6",
    "offset": 734,
    "text": "ἀνὴρ δίγλωσσος ἀποκαλύπτει βουλὰς ἐν συνεδρίῳ,"
  },
  {
    "id": "p-f89c67",
    "offset": 782,
    "text": "πιστὸς δὲ πνοῇ κρύπτει πράγματα."
  },
  {
    "id": "p-363030",
    "offset": 816,
    "text": "οἷς μὴ ὑπάρχει κυβέρνησις, πίπτουσιν ὥσπερ φύλλα,"
  },
  {
    "id": "p-9813b3",
    "offset": 867,
    "text": "σωτηρία δὲ ὑπάρχει ἐν πολλῇ βουλῇ."
  },
  {
    "id": "p-398f2c",
    "offset": 903,
    "text": "πονηρὸς κακοποιεῖ ὅταν συνμίξῃ δικαίῳ,"
  },
  {
    "id": "p-7c0326",
    "offset": 943,
    "text": "μισεῖ δὲ ἦχον ἀσφαλείας."
  },
  {
    "id": "p-e5135f",
    "offset": 969,
    "text": "γυνὴ εὐχάριστος ἐγείρει ἀνδρὶ δόξαν,"
  },
  {
    "id": "p-b070c9",
    "offset": 1007,
    "text": "θρόνος δὲ ἀτιμίας γυνὴ μισοῦσα δίκαια."
  },
  {
    "id": "p-da41a1",
    "offset": 1047,
    "text": "πλούτου ὀκνηροὶ ἐνδεεῖς γίνονται,"
  },
  {
    "id": "p-d9b657",
    "offset": 1082,
    "text": "οἱ δὲ ἀνδρεῖοι ἐρείδονται πλούτῳ."
  },
  {
    "id": "p-af3cd5",
    "offset": 1117,
    "text": "τῇ ψυχῇ αὐτοῦ ἀγαθὸν ποιεῖ ἀνὴρ ἐλεήμων,"
  },
  {
    "id": "p-2ccf9f",
    "offset": 1159,
    "text": "ἐξολλύει δὲ αὐτοῦ σῶμα ὁ ἀνελεήμων."
  },
  {
    "id": "p-91a3e3",
    "offset": 1196,
    "text": "ἀσεβὴς ποιεῖ ἔργα ἄδικα,"
  },
  {
    "id": "p-78e245",
    "offset": 1222,
    "text": "σπέρμα δὲ δικαίων μισθὸς ἀληθείας."
  },
  {
    "id": "p-8dafde",
    "offset": 1258,
    "text": "υἱὸς δίκαιος γεννᾶται εἰς ζωήν,"
  },
  {
    "id": "p-686bbc",
    "offset": 1291,
    "text": "διωγμὸς δὲ ἀσεβοῦς εἰς θάνατον."
  },
  {
    "id": "p-167015",
    "offset": 1324,
    "text": "βδέλυγμα Κυρίῳ διεστραμμέναι ὁδοί,"
  },
  {
    "id": "p-873e00",
    "offset": 1360,
    "text": "προσδεκτοὶ δὲ αὐτῷ πάντες ἄμωμοι ἐν ταῖς ὁδοῖς αὐτῶν."
  },
  {
    "id": "p-fd2ad0",
    "offset": 1415,
    "text": "[λια)] ασεβια U+05D0c.a αβουλεια A | om αυτων A U+05D0 εκδυνει] δυνει A 9 ασε-\nδων] αμαρτων U+05D0* (αμαρτωλων U+05D0c.a) | αισθησεις U+05D0A 10 δικαιων] διων U+05D0*\n(δικων U+05D0c.a) | πολις] + και επ απωλεια ασεβων αγαλλιαμα (11) εν ευλογιαις\nδικαιων υφωθησεται πολις Bᵇ ᵐᵍ sup + και εν απωλια (-λ λεια A) ασ. αγαλλ.\n(11) εν ευλογια (-γεια A) ευθιων (-θειων A) υψ. πολις U+05D0c.aA 12 ενδεεις A |\nU+05D0ρονιμος] pr ο U+05D0* (om U+05D0c.a) 14 φυλλον U+05D0* (φυλλα U+05D0c.a) | om δε U+05D0*\nhab U+05D0c.a) 15 συνμειξη B* συμμειξη U+05D0 συμμιξη BᵇA 17 εξολλυει]\nξολλυσι U+05D0c.a | αυτου 2⁰] το εαυτου U+05D0c.a"
  },
  {
    "id": "p-21253a",
    "offset": 2032,
    "text": "χειρὶ χεῖρας ἐμβαλὼν ἀδίκως οὐκ ἀτιμώρητος ἔσται,"
  },
  {
    "id": "p-fef8d6",
    "offset": 2083,
    "text": "ὁ δὲ σπείρων δικαιοσύνην λήμψεται μισθὸν πιστόν."
  },
  {
    "id": "p-600fc7",
    "offset": 2133,
    "text": "ὥσπερ ἐνώτιον ἐν ῥινὶ ὑός,"
  },
  {
    "id": "p-66057c",
    "offset": 2161,
    "text": "οὕτως γυναικὶ κακόφρονι κάλλος."
  },
  {
    "id": "p-71a7f1",
    "offset": 2194,
    "text": "ἐπιθυμία δικαίων πᾶσα ἀγαθή,"
  },
  {
    "id": "p-3247a4",
    "offset": 2224,
    "text": "ἐλπὶς δὲ ἀσεβῶν ἀπολεῖται."
  },
  {
    "id": "p-db85a5",
    "offset": 2252,
    "text": "εἰσὶν οἳ τὰ ἴδια σπείροντες πλείονα ποιοῦσιν·"
  },
  {
    "id": "p-e1e22e",
    "offset": 2299,
    "text": "εἰσὶν καὶ οἳ συνάγοντες ἐλαττονοῦνται."
  },
  {
    "id": "p-23f1a7",
    "offset": 2339,
    "text": "ψυχὴ εὐλογουμένη πᾶσα ἁπλῆ,"
  },
  {
    "id": "p-5b115a",
    "offset": 2368,
    "text": "ἀνὴρ δὲ θυμώδης οὐκ εὐσχήμων."
  },
  {
    "id": "p-15ba75",
    "offset": 2399,
    "text": "ὁ συνέχων σῖτον, ὑπολίποιτο αὐτὸν τοῖς ἔθνεσιν·"
  },
  {
    "id": "p-7c2041",
    "offset": 2448,
    "text": "εὐλογία δὲ εἰς κεφαλὴν τοῦ μεταδιδόντος."
  },
  {
    "id": "p-af4276",
    "offset": 2490,
    "text": "τεκταινόμενος ἀγαθὰ ζητεῖ χάριν ἀγαθήν,"
  },
  {
    "id": "p-ee403b",
    "offset": 2531,
    "text": "ἐκζητοῦντα δὲ κακὰ καταλήμψεται αὐτόν."
  },
  {
    "id": "p-cf382e",
    "offset": 2571,
    "text": "ὁ πεποιθὼς ἐπὶ πλούτῳ, οὗτος πεσεῖται,"
  },
  {
    "id": "p-b2358b",
    "offset": 2611,
    "text": "ὁ δὲ ἀντιλαμβανόμενος δικαίων, οὗτος ἀνατελεῖ."
  },
  {
    "id": "p-de9751",
    "offset": 2659,
    "text": "ὁ μὴ συνπεριφερόμενος τῷ ἑαυτοῦ οἴκῳ κληρονομήσει ἄνεμον,"
  },
  {
    "id": "p-595993",
    "offset": 2718,
    "text": "δουλεύσει δὲ ἄφρων φρονίμῳ."
  },
  {
    "id": "p-80ed5f",
    "offset": 2747,
    "text": "ἐκ καρποῦ δικαιοσύνης φύεται δένδρον ζωῆς,"
  },
  {
    "id": "p-f5169f",
    "offset": 2791,
    "text": "ἀφαιροῦνται δὲ ἄωροι ψυχαὶ παρανόμαων."
  },
  {
    "id": "p-1d588f",
    "offset": 2831,
    "text": "εἰ ὁ μὲν δίκαιος μόλις σώζεται, ὁ ἀσεβὴς καὶ ἁμαρτωλὸς ποῦ"
  },
  {
    "id": "p-885a4e",
    "offset": 2891,
    "text": "φανεῖται;"
  }
]