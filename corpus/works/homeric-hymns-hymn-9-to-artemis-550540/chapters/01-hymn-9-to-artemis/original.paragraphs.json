[
  {
    "id": "p-956717",
    "offset": 0,
    "text": "Ἄρτεμιν ὕμνει, Μοῦσα, κασιγνήτην Ἑκάτοιο."
  },
  {
    "id": "p-510897",
    "offset": 43,
    "text": "παρθένον ἰοχέαιραν, ὁμότροφον Ἀπόλλωνος,"
  },
  {
    "id": "p-f21e92",
    "offset": 85,
    "text": "ἥθʼ ἵππους ἄρσασα βαθυσχοίνοιο Μέλητος"
  },
  {
    "id": "p-62453c",
    "offset": 125,
    "text": "ῥίμφα διὰ Σμύρνης παγχρύσεον ἅρμα διώκει"
  },
  {
    "id": "p-e334fb",
    "offset": 167,
    "text": "ἐς Κλάρον ἀμπελόεσσαν, ὅθʼ ἀργυρότοξος Ἀπόλλων"
  },
  {
    "id": "p-4c69da",
    "offset": 215,
    "text": "ἧσται μιμνάζων ἑκατηβόλον ἰοχέαιραν."
  },
  {
    "id": "p-7ade42",
    "offset": 253,
    "text": "καὶ σὺ μὲν οὕτω χαῖρε θεαί θʼ ἅμα πᾶσαι ἀοιδῇ·"
  },
  {
    "id": "p-186244",
    "offset": 301,
    "text": "αὐτὰρ ἐγώ σε πρῶτα καὶ ἐκ σέθεν ἄρχομʼ ἀείδειν,"
  },
  {
    "id": "p-3fd2e6",
    "offset": 350,
    "text": "σεῦ δʼ ἐγὼ ἀρξάμενος μεταβήσομαι ἄλλον ἐς ὕμνον."
  }
]