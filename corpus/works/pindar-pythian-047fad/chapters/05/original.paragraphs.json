[
  {
    "id": "p-6fc811",
    "offset": 0,
    "text": "ὁ πλοῦτος εὐρυσθενής,"
  },
  {
    "id": "p-4e909e",
    "offset": 23,
    "text": "ὅταν τις ἀρετᾷ κεκραμένον καθαρᾷ"
  },
  {
    "id": "p-4dc07d",
    "offset": 57,
    "text": "βροτήσιος ἀνὴρ πότμου παραδόντος, αὐτὸν ἀνάγῃ"
  },
  {
    "id": "p-a20bfb",
    "offset": 104,
    "text": "πολύφιλον ἑπέταν."
  },
  {
    "id": "p-9e3b27",
    "offset": 123,
    "text": "ὦ θεόμορʼ Ἀρκεσίλα,"
  },
  {
    "id": "p-70850e",
    "offset": 144,
    "text": "σύ τοί νιν κλυτᾶς"
  },
  {
    "id": "p-d75837",
    "offset": 163,
    "text": "αἰῶνος ἀκρᾶν βαθμίδων ἄπο"
  },
  {
    "id": "p-058807",
    "offset": 190,
    "text": "σὺν εὐδοξίᾳ μετανίσεαι"
  },
  {
    "id": "p-f4473b",
    "offset": 214,
    "text": "ἕκατι χρυσαρμάτου Κάστορος·"
  },
  {
    "id": "p-25e566",
    "offset": 243,
    "text": "εὐδίαν ὃς μετὰ χειμέριον ὄμβρον τεὰν"
  },
  {
    "id": "p-cd3575",
    "offset": 281,
    "text": "καταιθύσσει μάκαιραν ἑστίαν."
  },
  {
    "id": "p-1710f5",
    "offset": 311,
    "text": "σοφοὶ δέ τοι κάλλιον"
  },
  {
    "id": "p-3f8d89",
    "offset": 333,
    "text": "φέροντι καὶ τὰν θεόσδοτον δύναμιν."
  },
  {
    "id": "p-8e2175",
    "offset": 369,
    "text": "σὲ δʼ ἐρχόμενον ἐν δίκᾳ πολὺς ὄλβος ἀμφινέμεται·"
  },
  {
    "id": "p-ad19ec",
    "offset": 419,
    "text": "τὸ μέν, ὅτι βασιλεὺς"
  },
  {
    "id": "p-60fc0f",
    "offset": 441,
    "text": "ἐσσὶ μεγαλᾶν πολίων,"
  },
  {
    "id": "p-0d34ec",
    "offset": 463,
    "text": "ἔχει συγγενὴς"
  },
  {
    "id": "p-1a4dbf",
    "offset": 478,
    "text": "ὀφθαλμὸς αἰδοιότατον γέρας"
  },
  {
    "id": "p-26b4eb",
    "offset": 506,
    "text": "τεᾷ τοῦτο μιγνύμενον φρενί·"
  },
  {
    "id": "p-906a31",
    "offset": 535,
    "text": "μάκαρ δὲ καὶ νῦν, κλεεννᾶς ὅτι"
  },
  {
    "id": "p-0c9538",
    "offset": 567,
    "text": "εὖχος ἤδη παρὰ Πυθιάδος ἵπποις ἑλὼν"
  },
  {
    "id": "p-6ee2d4",
    "offset": 604,
    "text": "δέδεξαι τόνδε κῶμον ἀνέρων,"
  },
  {
    "id": "p-1de5f3",
    "offset": 633,
    "text": "Ἀπολλώνιον ἄθυρμα. τῷ σε μὴ λαθέτω"
  },
  {
    "id": "p-d756da",
    "offset": 669,
    "text": "Κυράνας γλυκὺν ἀμφὶ κᾶπον Ἀφροδίτας ἀειδόμενον,"
  },
  {
    "id": "p-b35e77",
    "offset": 718,
    "text": "παντὶ μὲν θεὸν αἴτιον ὑπερτιθέμεν·"
  },
  {
    "id": "p-891e64",
    "offset": 754,
    "text": "φιλεῖν δὲ Κάρρωτον ἔξοχʼ ἑταίρων·"
  },
  {
    "id": "p-0ffbea",
    "offset": 789,
    "text": "ὃς οὐ τὰν Ἐπιμαθέος ἄγων"
  },
  {
    "id": "p-d6050b",
    "offset": 815,
    "text": "ὀψινόου θυγατέρα Πρόφασιν, Βαττιδᾶν"
  },
  {
    "id": "p-e87407",
    "offset": 852,
    "text": "ἀφίκετο δόμους θεμισκρεόντων·"
  },
  {
    "id": "p-c51b74",
    "offset": 883,
    "text": "ἀλλʼ ἀρισθάρματον"
  },
  {
    "id": "p-71c2f5",
    "offset": 902,
    "text": "ὕδατι Κασταλίας ξενωθεὶς γέρας ἀμφέβαλε τεαῖσιν κόμαις,"
  },
  {
    "id": "p-73d7f9",
    "offset": 959,
    "text": "ἀκηράτοις ἁνίαις"
  },
  {
    "id": "p-7192bc",
    "offset": 977,
    "text": "ποδαρκέων δωδεκάδρομον τέμενος."
  },
  {
    "id": "p-e2c4ea",
    "offset": 1010,
    "text": "κατέκλασε γὰρ ἐντέων σθένος οὐδέν· ἀλλὰ κρέμαται,"
  },
  {
    "id": "p-6b086d",
    "offset": 1061,
    "text": "ὁπόσα χεριαρᾶν"
  },
  {
    "id": "p-77d80b",
    "offset": 1077,
    "text": "τεκτόνων δαίδαλʼ ἄγων"
  },
  {
    "id": "p-9adb73",
    "offset": 1100,
    "text": "Κρισαῖον λόφον"
  },
  {
    "id": "p-cb5788",
    "offset": 1116,
    "text": "ἄμειψεν ἐν κοιλόπεδον νάπος"
  },
  {
    "id": "p-bc7f2a",
    "offset": 1145,
    "text": "θεοῦ· τό σφʼ ἔχει κυπαρίσσινον"
  },
  {
    "id": "p-e3ad9e",
    "offset": 1177,
    "text": "μέλαθρον ἀμφʼ ἀνδριάντι σχεδόν,"
  },
  {
    "id": "p-e448cb",
    "offset": 1210,
    "text": "Κρῆτες ὃν τοξοφόροι τέγεϊ Παρνασσίῳ"
  },
  {
    "id": "p-231fa1",
    "offset": 1247,
    "text": "καθέσσαντο μονόδροπον φυτόν."
  },
  {
    "id": "p-7f8705",
    "offset": 1277,
    "text": "ἑκόντι τοίνυν πρέπει"
  },
  {
    "id": "p-6f2f33",
    "offset": 1299,
    "text": "νόῳ τὸν εὐεργέταν ὑπαντιάσαι."
  },
  {
    "id": "p-d536fe",
    "offset": 1330,
    "text": "Ἀλεξιβιάδα, σὲ δʼ ἠΰκομοι φλέγοντι Χάριτες."
  },
  {
    "id": "p-cf1451",
    "offset": 1375,
    "text": "μακάριος, ὃς ἔχεις"
  },
  {
    "id": "p-d6e4ca",
    "offset": 1395,
    "text": "καὶ πεδὰ μέγαν κάματον"
  },
  {
    "id": "p-da52ec",
    "offset": 1419,
    "text": "λόγων φερτάτων"
  },
  {
    "id": "p-46fea2",
    "offset": 1435,
    "text": "μναμήϊʼ· ἐν τεσσαράκοντα γὰρ"
  },
  {
    "id": "p-50b2b7",
    "offset": 1465,
    "text": "πετόντεσσιν ἁνιόχοις ὅλον"
  },
  {
    "id": "p-523465",
    "offset": 1492,
    "text": "δίφρον κομίξαις ἀταρβεῖ φρενί,"
  },
  {
    "id": "p-4b444e",
    "offset": 1524,
    "text": "ἦλθες ἤδη Λιβύας πεδίον ἐξ ἀγλαῶν"
  },
  {
    "id": "p-a2749d",
    "offset": 1559,
    "text": "ἀέθλων καὶ πατρωΐαν πόλιν."
  },
  {
    "id": "p-6963e2",
    "offset": 1587,
    "text": "πόνων δʼ οὔ τις ἀπόκλαρός ἐστιν οὔτʼ ἔσεται·"
  },
  {
    "id": "p-c18823",
    "offset": 1633,
    "text": "ὁ Βάττου δʼ ἕπεται παλαιὸς ὄλβος ἔμπαν τὰ καὶ τὰ νέμων,"
  },
  {
    "id": "p-32c3c6",
    "offset": 1690,
    "text": "πύργος ἄστεος ὄμμα τε φαεννότατον"
  },
  {
    "id": "p-3f47e7",
    "offset": 1725,
    "text": "ξένοισι. κεῖνόν γε καὶ βαρύκομποι"
  },
  {
    "id": "p-d70941",
    "offset": 1760,
    "text": "λέοντες περὶ δείματι φύγον,"
  },
  {
    "id": "p-b0075e",
    "offset": 1789,
    "text": "γλῶσσαν ἐπεί σφιν ἀπένεικεν ὑπερποντίαν·"
  },
  {
    "id": "p-87d243",
    "offset": 1831,
    "text": "ὁ δʼ ἀρχαγέτας ἔδωκʼ Ἀπόλλων"
  },
  {
    "id": "p-a0c4a1",
    "offset": 1861,
    "text": "θῆρας αἰνῷ φόβῳ,"
  },
  {
    "id": "p-56f8fc",
    "offset": 1879,
    "text": "ὄφρα μὴ ταμίᾳ Κυράνας ἀτελὴς γένοιτο μαντεύμασιν."
  },
  {
    "id": "p-8b581a",
    "offset": 1930,
    "text": "ὃ καὶ βαρειᾶν νόσων"
  },
  {
    "id": "p-32a7d4",
    "offset": 1951,
    "text": "ἀκέσματʼ ἄνδρεσσι καὶ γυναιξὶ νέμει,"
  },
  {
    "id": "p-7d9a1c",
    "offset": 1989,
    "text": "πόρεν τε κίθαριν, δίδωσί τε Μοῖσαν οἷς ἂν ἐθέλῃ,"
  },
  {
    "id": "p-88fad2",
    "offset": 2039,
    "text": "ἀπόλεμον ἀγαγὼν"
  },
  {
    "id": "p-6744e9",
    "offset": 2056,
    "text": "ἐς πραπίδας εὐνομίαν,"
  },
  {
    "id": "p-3184f5",
    "offset": 2079,
    "text": "μυχόν τʼ ἀμφέπει"
  },
  {
    "id": "p-054e62",
    "offset": 2097,
    "text": "μαντήϊον· τῷ Λακεδαίμονι"
  },
  {
    "id": "p-b8cf8a",
    "offset": 2123,
    "text": "ἐν Ἄργει τε καὶ ζαθέᾳ Πύλῳ"
  },
  {
    "id": "p-8baea3",
    "offset": 2151,
    "text": "ἔνασσεν ἀλκ άε ντας Ἡρακλέος"
  },
  {
    "id": "p-ecb1f0",
    "offset": 2181,
    "text": "ἐκγόνους Αἰγιμιοῦ τε. τὸ δʼ ἐμὸν γαρύειν"
  },
  {
    "id": "p-76c123",
    "offset": 2223,
    "text": "ἀπὸ Σπάρτας ἐπήρατον κλέος·"
  },
  {
    "id": "p-16688d",
    "offset": 2252,
    "text": "ὅθεν γεγενναμένοι"
  },
  {
    "id": "p-006f04",
    "offset": 2271,
    "text": "ἵκοντο Θήρανδε φῶτες Αἰγεΐδαι,"
  },
  {
    "id": "p-2ada73",
    "offset": 2303,
    "text": "ἐμοὶ πατέρες, οὐ θεῶν ἄτερ, ἀλλὰ μοῖρά τις ἄγεν·"
  },
  {
    "id": "p-b2d3c1",
    "offset": 2353,
    "text": "πολύθυτον ἔρανον"
  },
  {
    "id": "p-6d0a52",
    "offset": 2371,
    "text": "ἔνθεν ἀναδεξάμενοι,"
  },
  {
    "id": "p-6a5934",
    "offset": 2392,
    "text": "Ἄπολλον, τεᾷ,"
  },
  {
    "id": "p-3161df",
    "offset": 2407,
    "text": "Καρνήϊʼ, ἐν δαιτὶ σεβίζομεν"
  },
  {
    "id": "p-5d8551",
    "offset": 2436,
    "text": "Κυράνας ἀγακτιμέναν πόλιν·"
  },
  {
    "id": "p-8bc133",
    "offset": 2464,
    "text": "ἔχοντι τὰν χαλκοχάρμαι ξένοι"
  },
  {
    "id": "p-60b931",
    "offset": 2494,
    "text": "Τρῶες Ἀντανορίδαι. σὺν Ἑλένᾳ γὰρ μόλον,"
  },
  {
    "id": "p-c895af",
    "offset": 2535,
    "text": "καπνωθεῖσαν πάτραν ἐπεὶ ἴδον"
  },
  {
    "id": "p-a1314d",
    "offset": 2565,
    "text": "ἐν Ἄρει. τὸ δʼ ἐλάσιππον ἔθνος ἐνδυκέως"
  },
  {
    "id": "p-038512",
    "offset": 2606,
    "text": "δέκονται θυσίαισιν ἄνδρες οἰχνέοντές σφε δωροφόροι,"
  },
  {
    "id": "p-eca1eb",
    "offset": 2659,
    "text": "τοὺς Ἀριστοτέλης ἄγαγε, ναυσὶ θοαῖς"
  },
  {
    "id": "p-a73c4e",
    "offset": 2696,
    "text": "ἁλὸς βαθεῖαν κέλευθον ἀνοίγων."
  },
  {
    "id": "p-51cfc9",
    "offset": 2728,
    "text": "κτίσεν δʼ ἄλσεα μείζονα θεῶν,"
  },
  {
    "id": "p-877f8b",
    "offset": 2759,
    "text": "εὐθύτομόν τε κατέθηκεν Ἀπολλωνίαις"
  },
  {
    "id": "p-3a01a2",
    "offset": 2795,
    "text": "ἀλεξιμβρότοις πεδιάδα πομπαῖς"
  },
  {
    "id": "p-81ceb7",
    "offset": 2826,
    "text": "ἔμμεν ἱππόκροτον"
  },
  {
    "id": "p-790bf5",
    "offset": 2844,
    "text": "σκυρωτὰν ὁδόν, ἔνθα πρυμνοῖς ἀγορᾶς ἔπι δίχα κεῖται θανών."
  },
  {
    "id": "p-26ebf9",
    "offset": 2904,
    "text": "μάκαρ μὲν ἀνδρῶν μέτα"
  },
  {
    "id": "p-81ac10",
    "offset": 2927,
    "text": "ἔναιεν, ἥρως δʼ ἔπειτα λαοσεβής."
  },
  {
    "id": "p-de79dc",
    "offset": 2961,
    "text": "ἄτερθε δὲ πρὸ δωμάτων ἕτεροι λαχόντες Ἀΐδαν"
  },
  {
    "id": "p-989a22",
    "offset": 3006,
    "text": "βασιλέες ἱεροὶ"
  },
  {
    "id": "p-f14982",
    "offset": 3022,
    "text": "ἐντί, μεγάλαν δʼ ἀρετὰν"
  },
  {
    "id": "p-6150de",
    "offset": 3047,
    "text": "δρόσῳ μαλθακᾷ"
  },
  {
    "id": "p-fdc0af",
    "offset": 3062,
    "text": "ῥανθεῖσαν κώμων ὑπὸ χεύμασιν,"
  },
  {
    "id": "p-40256f",
    "offset": 3093,
    "text": "ἀκούοντί που χθονίᾳ φρενί,"
  },
  {
    "id": "p-9b13ef",
    "offset": 3121,
    "text": "σφὸν ὄλβον υἱῷ τε κοινὰν χάριν"
  },
  {
    "id": "p-64a457",
    "offset": 3153,
    "text": "ἔνδικόν τʼ Ἀρκεσίλᾳ. τὸν ἐν ἀοιδᾷ νέων"
  },
  {
    "id": "p-487de9",
    "offset": 3193,
    "text": "πρέπει χρυς άο ρα Φοῖβον ἀπύειν,"
  },
  {
    "id": "p-da66d0",
    "offset": 3227,
    "text": "ἔχοντα Πυθωνόθεν"
  },
  {
    "id": "p-8c8dd3",
    "offset": 3245,
    "text": "τὸ καλλίνικον λυτήριον δαπανᾶν"
  },
  {
    "id": "p-905e59",
    "offset": 3277,
    "text": "μέλος χαρίεν. ἄνδρα κεῖνον ἐπαινέοντι συνετοί."
  },
  {
    "id": "p-9bfbd3",
    "offset": 3325,
    "text": "λεγόμενον ἐρέω·"
  },
  {
    "id": "p-6c230f",
    "offset": 3342,
    "text": "κρέσσονα μὲν ἁλικίας"
  },
  {
    "id": "p-481fd5",
    "offset": 3364,
    "text": "νόον φέρβεται"
  },
  {
    "id": "p-68e526",
    "offset": 3379,
    "text": "γλῶσσάν τε· θάρσος δὲ τανύπτερος"
  },
  {
    "id": "p-699751",
    "offset": 3413,
    "text": "ἐν ὄρνιξιν αἰετὸς ἔπλετο·"
  },
  {
    "id": "p-1098d4",
    "offset": 3440,
    "text": "ἀγωνίας δʼ, ἕρκος οἷον, σθένος·"
  },
  {
    "id": "p-d25e7c",
    "offset": 3473,
    "text": "ἔν τε Μοίσαισι ποτανὸς ἀπὸ ματρὸς φίλας,"
  },
  {
    "id": "p-cc9d09",
    "offset": 3515,
    "text": "πέφανταί θʼ ἁρματηλάτας σοφός·"
  },
  {
    "id": "p-dee8af",
    "offset": 3547,
    "text": "ὅσαι τʼ εἰσὶν ἐπιχωρίων καλῶν ἔσοδοι,"
  },
  {
    "id": "p-6e06a8",
    "offset": 3586,
    "text": "τετόλμακε. θεός τέ οἱ τὸ νῦν τε πρόφρων τελεῖ δύνασιν,"
  },
  {
    "id": "p-d692e2",
    "offset": 3642,
    "text": "καὶ τὸ λοιπὸν ὁμοῖα, Κρονίδαι μάκαρες,"
  },
  {
    "id": "p-537fb9",
    "offset": 3682,
    "text": "διδοῖτʼ ἐπʼ ἔργοισιν ἀμφί τε βουλαῖς"
  },
  {
    "id": "p-4271fc",
    "offset": 3720,
    "text": "ἔχειν, μὴ φθινοπωρὶς ἀνέμων"
  },
  {
    "id": "p-4485e9",
    "offset": 3749,
    "text": "χειμερία κατὰ πνοὰ δαμαλίζοι χρόνον."
  },
  {
    "id": "p-50ecf4",
    "offset": 3787,
    "text": "Διός τοι νόος μέγας κυβερνᾷ"
  },
  {
    "id": "p-7cb489",
    "offset": 3816,
    "text": "δαίμονʼ ἀνδρῶν φίλων."
  },
  {
    "id": "p-123103",
    "offset": 3839,
    "text": "εὔχομαί νιν Ὀλυμπίᾳ τοῦτο"
  },
  {
    "id": "p-871bae",
    "offset": 3866,
    "text": "δόμεν γέρας ἔπι Βάττου γένει."
  }
]