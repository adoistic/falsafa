[
  {
    "id": "p-e67dcd",
    "offset": 0,
    "text": "Κάδμου κόραι, Σεμέλα μὲν Ὀλυμπιάδων ἀγυιᾶτις,"
  },
  {
    "id": "p-b2d029",
    "offset": 47,
    "text": "Ἰνώ τε Λευκοθέα ποντιᾶν ὁμοθάλαμε Νηρηΐδων,"
  },
  {
    "id": "p-ee13c1",
    "offset": 92,
    "text": "ἴτε σὺν Ἡρακλέος ἀριστογόνῳ"
  },
  {
    "id": "p-462be4",
    "offset": 121,
    "text": "ματρὶ πὰρ Μελίαν χρυσέων ἐς ἄδυτον τριπόδων"
  },
  {
    "id": "p-be8230",
    "offset": 166,
    "text": "θησαυρόν, ὃν περίαλλʼ ἐτίμασε Λοξίας,"
  },
  {
    "id": "p-c53f0a",
    "offset": 205,
    "text": "Ἰσμήνιον δʼ ὀνύμαξεν, ἀλαθέα μαντίων θῶκον,"
  },
  {
    "id": "p-eafdda",
    "offset": 250,
    "text": "ὦ παῖδες Ἁρμονίας, ἔνθα καί νυν ἐπίνομον ἡρωΐδων"
  },
  {
    "id": "p-eb663f",
    "offset": 300,
    "text": "στρατὸν ὁμαγερέα καλεῖ συνίμεν,"
  },
  {
    "id": "p-bc7308",
    "offset": 333,
    "text": "ὄφρα Θέμιν ἱερὰν Πυθῶνά τε καὶ ὀρθοδίκαν"
  },
  {
    "id": "p-902591",
    "offset": 375,
    "text": "γᾶς ὀμφαλὸν κελαδήσετʼ ἄκρᾳ σὺν ἑσπέρᾳ,"
  },
  {
    "id": "p-fb3b8e",
    "offset": 416,
    "text": "ἑπταπύλοισι Θήβαις"
  },
  {
    "id": "p-384974",
    "offset": 436,
    "text": "χάριν ἀγῶνί τε Κίρρας,"
  },
  {
    "id": "p-822d45",
    "offset": 460,
    "text": "ἐν τῷ Θρασυδαῖος ἔμνασεν ἑστίαν"
  },
  {
    "id": "p-2af364",
    "offset": 493,
    "text": "τρίτον ἐπὶ στέφανον πατρῴαν βαλών,"
  },
  {
    "id": "p-f39ebe",
    "offset": 529,
    "text": "ἐν ἀφνεαῖς ἀρούραισι Πυλάδα"
  },
  {
    "id": "p-2ea4f0",
    "offset": 558,
    "text": "νικῶν ξένου Λάκωνος Ὀρέστα."
  },
  {
    "id": "p-6f7ca0",
    "offset": 587,
    "text": "τὸν δὴ φονευομένου πατρὸς Ἀρσινόα Κλυταιμνήστρας"
  },
  {
    "id": "p-ecc4da",
    "offset": 637,
    "text": "χειρῶν ὕπο κρατερᾶν ἐκ δόλου τροφὸς ἄνελε δυσπενθέος,"
  },
  {
    "id": "p-3b9ef7",
    "offset": 692,
    "text": "ὁπότε Δαρδανίδα κόραν Πριάμου"
  },
  {
    "id": "p-4d1a59",
    "offset": 723,
    "text": "Κασσάνδραν πολιῷ χαλκῷ σὺν Ἀγαμεμνονίᾳ"
  },
  {
    "id": "p-e89a14",
    "offset": 763,
    "text": "ψυχᾷ πόρευσʼ Ἀχέροντος ἀκτὰν παρʼ εὔσκιον"
  },
  {
    "id": "p-db55ff",
    "offset": 806,
    "text": "νηλὴς γυνά. πότερόν νιν ἄρʼ Ἰφιγένειʼ ἐπʼ Εὐρίπῳ"
  },
  {
    "id": "p-03fe91",
    "offset": 856,
    "text": "σφαχθεῖσα τῆλε πάτρας ἔκνισεν βαρυπάλαμον ὄρσαι χόλον;"
  },
  {
    "id": "p-217348",
    "offset": 912,
    "text": "ἢ ἑτέρῳ λέχεϊ δαμαζομέναν"
  },
  {
    "id": "p-b7ceed",
    "offset": 939,
    "text": "ἔννυχοι πάραγον κοῖται; τὸ δὲ νέαις ἀλόχοις"
  },
  {
    "id": "p-6d3329",
    "offset": 984,
    "text": "ἔχθιστον ἀμπλάκιον καλύψαι τʼ ἀμάχανον"
  },
  {
    "id": "p-4c8f87",
    "offset": 1024,
    "text": "ἀλλοτρίαισι γλώσσαις·"
  },
  {
    "id": "p-b309ce",
    "offset": 1047,
    "text": "κακολόγοι δὲ πολῖται."
  },
  {
    "id": "p-5f4959",
    "offset": 1070,
    "text": "ἴσχει τε γὰρ ὄλβος οὐ μείονα φθόνον·"
  },
  {
    "id": "p-b31fee",
    "offset": 1108,
    "text": "ὁ δὲ χαμηλὰ πνέων ἄφαντον βρέμει."
  },
  {
    "id": "p-d7c730",
    "offset": 1143,
    "text": "θάνεν μὲν αὐτὸς ἥρως Ἀτρεΐδας"
  },
  {
    "id": "p-db6078",
    "offset": 1174,
    "text": "ἵκων χρόνῳ κλυταῖς ἐν Ἀμύκλαις,"
  },
  {
    "id": "p-264577",
    "offset": 1207,
    "text": "μάντιν τʼ ὄλεσσε κόραν, ἐπεὶ ἀμφʼ Ἑλένᾳ πυρωθέντων"
  },
  {
    "id": "p-ff7495",
    "offset": 1259,
    "text": "Τρώων ἔλυσε δόμους ἁβρότατος. ὁ δʼ ἄρα γέροντα ξένον"
  },
  {
    "id": "p-e3b04a",
    "offset": 1313,
    "text": "Στρόφιον ἐξίκετο, νέα κεφαλά,"
  },
  {
    "id": "p-d89930",
    "offset": 1344,
    "text": "Παρνασοῦ πόδα ναίοντʼ· ἀλλὰ χρονίῳ σὺν Ἄρει"
  },
  {
    "id": "p-eb1465",
    "offset": 1389,
    "text": "πέφνεν τε ματέρα θῆκέ τʼ Αἴγισθον ἐν φοναῖς."
  },
  {
    "id": "p-2b5e7f",
    "offset": 1435,
    "text": "ἦ ῥʼ, ὦ φίλοι, κατʼ ἀμευσιπόρους τριόδους ἐδινήθην,"
  },
  {
    "id": "p-4a8d28",
    "offset": 1488,
    "text": "ὀρθὰν κέλευθον ἰὼν τὸ πρίν· ἤ μέ τις ἄνεμος ἔξω πλόου"
  },
  {
    "id": "p-eb5124",
    "offset": 1543,
    "text": "ἔβαλεν, ὡς ὅτʼ ἄκατον εἰναλίαν;"
  },
  {
    "id": "p-11030e",
    "offset": 1576,
    "text": "Μοῖσα, τὸ δὲ τεόν, εἰ μισθοῖο συνέθευ παρέχειν"
  },
  {
    "id": "p-18b709",
    "offset": 1624,
    "text": "φωνὰν ὑπάργυρον, ἄλλοτʼ ἄλλᾳ ταρασσέμεν"
  },
  {
    "id": "p-129a09",
    "offset": 1665,
    "text": "ἢ πατρὶ Πυθονίκῳ"
  },
  {
    "id": "p-646aa0",
    "offset": 1683,
    "text": "τό γέ νυν ἢ Θρασυδαίῳ·"
  },
  {
    "id": "p-664814",
    "offset": 1707,
    "text": "τῶν εὐφροσύνα τε καὶ δόξʼ ἐπιφλέγει."
  },
  {
    "id": "p-b82fe2",
    "offset": 1745,
    "text": "τὰ μὲν ἐν ἅρμασι καλλίνικοι πάλαι,"
  },
  {
    "id": "p-d561f4",
    "offset": 1781,
    "text": "Ὀλυμπίᾳ ἀγώνων πολυφάτων"
  },
  {
    "id": "p-1533b7",
    "offset": 1807,
    "text": "ἔσχον θοὰν ἀκτῖνα σὺν ἵπποις·"
  },
  {
    "id": "p-9b4696",
    "offset": 1838,
    "text": "Πυθοῖ τε γυμνὸν ἐπὶ στάδιον καταβάντες ἤλεγξαν"
  },
  {
    "id": "p-0c5eb2",
    "offset": 1886,
    "text": "Ἑλλανίδα στρατιὰν ὠκύτατι. θεόθεν ἐραίμαν καλῶν,"
  },
  {
    "id": "p-acb3d7",
    "offset": 1936,
    "text": "δυνατὰ μαιόμενος ἐν ἁλικίᾳ."
  },
  {
    "id": "p-be227c",
    "offset": 1965,
    "text": "τῶν γὰρ ἂμ πόλιν εὑρίσκων τὰ μέσα μακροτέρῳ"
  },
  {
    "id": "p-02833c",
    "offset": 2010,
    "text": "ὄλβῳ τεθαλότα, μέμφομʼ αἶσαν τυραννίδων·"
  },
  {
    "id": "p-2e25ab",
    "offset": 2052,
    "text": "ξυναῖσι δʼ ἀμφʼ ἀρεταῖς τέταμαι. φθονεροὶ δʼ ἀμύνονται"
  },
  {
    "id": "p-af8dd6",
    "offset": 2108,
    "text": "ἆται, εἴ τις ἄκρον ἑλὼν ἁσυχᾶ τε νεμόμενος αἰνὰν ὕβριν"
  },
  {
    "id": "p-e2e128",
    "offset": 2164,
    "text": "ἀπέφυγεν· μέλανος ἂν ἐσχατιὰν"
  },
  {
    "id": "p-aef387",
    "offset": 2195,
    "text": "καλλίονα θανάτου στείχοι, γλυκυτάτᾳ γενεᾷ"
  },
  {
    "id": "p-8d1893",
    "offset": 2238,
    "text": "εὐώνυμον κτεάνων κρατίσταν χάριν πορών."
  },
  {
    "id": "p-9ae0c6",
    "offset": 2279,
    "text": "ἅ τε τὸν Ἰφικλείδαν"
  },
  {
    "id": "p-c53386",
    "offset": 2300,
    "text": "διαφέρει Ἰόλαον"
  },
  {
    "id": "p-d6a562",
    "offset": 2317,
    "text": "ὑμνητὸν ἐόντα, καὶ Κάστορος βίαν,"
  },
  {
    "id": "p-eaea6b",
    "offset": 2352,
    "text": "σέ τε, ἄναξ Πολύδευκες, υἱοὶ θεῶν,"
  },
  {
    "id": "p-71aee3",
    "offset": 2388,
    "text": "τὸ μὲν παρʼ ἆμαρ ἕδραισι Θεράπνας,"
  },
  {
    "id": "p-783a7b",
    "offset": 2424,
    "text": "τὸ δʼ οἰκέοντας ἔνδον Ὀλύμπου."
  }
]