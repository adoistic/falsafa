[
  {
    "id": "p-fd024a",
    "offset": 0,
    "text": "φιλόφρον Ἡσυχία, Δίκας"
  },
  {
    "id": "p-c9e31c",
    "offset": 24,
    "text": "ὦ μεγιστόπολι θύγατερ,"
  },
  {
    "id": "p-3878ad",
    "offset": 48,
    "text": "βουλᾶν τε καὶ πολέμων"
  },
  {
    "id": "p-094546",
    "offset": 71,
    "text": "ἔχοισα κλαῗδας ὑπερτάτας,"
  },
  {
    "id": "p-683036",
    "offset": 98,
    "text": "Πυθιόνικον τιμὰν Ἀριστομένει δέκευ."
  },
  {
    "id": "p-f721c7",
    "offset": 135,
    "text": "τὺ γὰρ τὸ μαλθακὸν ἔρξαι τε καὶ παθεῖν ὁμῶς"
  },
  {
    "id": "p-69c6d4",
    "offset": 180,
    "text": "ἐπίστασαι καιρῷ σὺν ἀτρεκεῖ·"
  },
  {
    "id": "p-44da2b",
    "offset": 210,
    "text": "τὺ δʼ, ὁπόταν τις ἀμείλιχον"
  },
  {
    "id": "p-f79963",
    "offset": 239,
    "text": "καρδίᾳ κότον ἐνελάσῃ,"
  },
  {
    "id": "p-ea2cda",
    "offset": 262,
    "text": "τραχεῖα δυσμενέων"
  },
  {
    "id": "p-291b69",
    "offset": 281,
    "text": "ὑπαντιάξαισα κράτει τιθεῖς"
  },
  {
    "id": "p-254bd8",
    "offset": 309,
    "text": "Ὕβριν ἐν ἄντλῳ. τὰν οὐδὲ Πορφυρίων μάθεν"
  },
  {
    "id": "p-bf7053",
    "offset": 351,
    "text": "παρʼ αἶσαν ἐξερεθίζων· κέρδος δὲ φίλτατον,"
  },
  {
    "id": "p-952f9c",
    "offset": 395,
    "text": "ἑκόντος εἴ τις ἐκ δόμων φέροι."
  },
  {
    "id": "p-94adc2",
    "offset": 427,
    "text": "βία δὲ καὶ μεγάλαυχον ἔσφαλεν ἐν χρόνῳ."
  },
  {
    "id": "p-4fa94f",
    "offset": 468,
    "text": "Τυφὼς Κίλιξ ἑκατόγκρανος οὔ νιν ἄλυξεν,"
  },
  {
    "id": "p-002650",
    "offset": 509,
    "text": "οὐδὲ μὰν βασιλεὺς Γιγάντων· δμᾶθεν δὲ κεραυνῷ"
  },
  {
    "id": "p-5d05ba",
    "offset": 556,
    "text": "τόξοισί τʼ Ἀπόλλωνος· ὃς εὐμενεῖ νόῳ"
  },
  {
    "id": "p-5d6004",
    "offset": 594,
    "text": "Ξενάρκειον ἔδεκτο Κίρραθεν ἐστεφανωμένον"
  },
  {
    "id": "p-8251e3",
    "offset": 636,
    "text": "υἱὸν ποίᾳ Παρνασσίδι Δωριεῖ τε κώμῳ."
  },
  {
    "id": "p-d24d8a",
    "offset": 674,
    "text": "ἔπεσε δʼ οὐ Χαρίτων ἑκὰς"
  },
  {
    "id": "p-e19c3c",
    "offset": 700,
    "text": "ἁ δικαιόπολις ἀρεταῖς"
  },
  {
    "id": "p-91f1be",
    "offset": 723,
    "text": "κλειναῖσιν Αἰακιδᾶν"
  },
  {
    "id": "p-372b61",
    "offset": 744,
    "text": "θιγοῖσα νᾶσος· τελέαν δʼ ἔχει"
  },
  {
    "id": "p-d5e5e2",
    "offset": 775,
    "text": "δόξαν ἀπʼ ἀρχᾶς. πολλοῖσι μὲν γὰρ ἀείδεται"
  },
  {
    "id": "p-a9eb25",
    "offset": 819,
    "text": "νικαφόροις ἐν ἀέθλοις θρέψαισα καὶ θοαῖς"
  },
  {
    "id": "p-28ef9f",
    "offset": 861,
    "text": "ὑπερτάτους ἥρωας ἐν μάχαις·"
  },
  {
    "id": "p-55fbcb",
    "offset": 890,
    "text": "τὰ δὲ καὶ ἀνδράσιν ἐμπρέπει."
  },
  {
    "id": "p-f7a7fe",
    "offset": 920,
    "text": "εἰμὶ δʼ ἄσχολος ἀναθέμεν"
  },
  {
    "id": "p-b61211",
    "offset": 946,
    "text": "πᾶσαν μακραγορίαν"
  },
  {
    "id": "p-4b951e",
    "offset": 965,
    "text": "λύρᾳ τε καὶ φθέγματι μαλθακῷ,"
  },
  {
    "id": "p-9a7eb9",
    "offset": 996,
    "text": "μὴ κόρος ἐλθὼν κνίσῃ. τὸ δʼ ἐν ποσί μοι τράχον"
  },
  {
    "id": "p-8e62d2",
    "offset": 1044,
    "text": "ἴτω τεὸν χρέος, ὦ παῖ, νεώτατον καλῶν,"
  },
  {
    "id": "p-58227a",
    "offset": 1084,
    "text": "ἐμᾷ ποτανὸν ἀμφὶ μαχανᾷ."
  },
  {
    "id": "p-2d34f3",
    "offset": 1110,
    "text": "παλαισμάτεσσι γὰρ ἰχνεύων ματραδελφεοὺς"
  },
  {
    "id": "p-199f01",
    "offset": 1151,
    "text": "Ὀλυμπίᾳ τε Θεόγνητον οὐ κατελέγχεις,"
  },
  {
    "id": "p-6f15ec",
    "offset": 1189,
    "text": "οὐδὲ Κλειτομάχοιο νίκαν Ἰσθμοῖ θρασύγυιον·"
  },
  {
    "id": "p-3a238d",
    "offset": 1233,
    "text": "αὔξων δὲ πάτραν Μιδυλιδᾶν λόγον φέρεις,"
  },
  {
    "id": "p-5459a6",
    "offset": 1274,
    "text": "τὸν ὅνπερ ποτʼ Ὀϊκλέος παῖς ἐν ἑπταπύλοις ἰδὼν"
  },
  {
    "id": "p-68dc44",
    "offset": 1322,
    "text": "υἱοὺς Θήβαις αἰνίξατο παρμένοντας αἰχμᾷ,"
  },
  {
    "id": "p-0bdb60",
    "offset": 1364,
    "text": "ὁπότʼ ἀπʼ Ἄργεος ἤλυθον"
  },
  {
    "id": "p-7a5be1",
    "offset": 1389,
    "text": "δευτέραν ὁδὸν Ἐπίγονοι."
  },
  {
    "id": "p-a6de8a",
    "offset": 1414,
    "text": "ὧδʼ εἶπε μαρναμένων·"
  },
  {
    "id": "p-7b78b2",
    "offset": 1436,
    "text": "φυᾷ τὸ γενναῖον ἐπιπρέπει"
  },
  {
    "id": "p-18e17c",
    "offset": 1463,
    "text": "ἐκ πατέρων παισὶ λῆμα. θαέομαι σαφὲς"
  },
  {
    "id": "p-9b8a36",
    "offset": 1501,
    "text": "δράκοντα ποικίλον αἰθᾶς Ἀλκμᾶνʼ ἐπʼ ἀσπίδος"
  },
  {
    "id": "p-8edad1",
    "offset": 1546,
    "text": "νωμῶντα πρῶτον ἐν Κάδμου πύλαις."
  },
  {
    "id": "p-64e28c",
    "offset": 1580,
    "text": "ὁ δὲ καμὼν προτέρᾳ πάθᾳ"
  },
  {
    "id": "p-4bc1d9",
    "offset": 1605,
    "text": "νῦν ἀρείονος ἐνέχεται"
  },
  {
    "id": "p-882da5",
    "offset": 1628,
    "text": "ὄρνιχος ἀγγελίᾳ"
  },
  {
    "id": "p-cb2a57",
    "offset": 1645,
    "text": "Ἄδραστος ἥρως· τὸ δὲ οἴκοθεν"
  },
  {
    "id": "p-293f5c",
    "offset": 1675,
    "text": "ἀντία πράξει. μοῦνος γὰρ ἐκ Δαναῶν στρατοῦ"
  },
  {
    "id": "p-5cbd9f",
    "offset": 1719,
    "text": "θανόντος ὀστέα λέξαις υἱοῦ, τύχᾳ θεῶν"
  },
  {
    "id": "p-82b01c",
    "offset": 1758,
    "text": "ἀφίξεται λαῷ σὺν ἀβλαβεῖ"
  },
  {
    "id": "p-64a1ef",
    "offset": 1784,
    "text": "Ἄβαντος εὐρυχόρους ἀγυιάς. τοιαῦτα μὲν"
  },
  {
    "id": "p-8da5c4",
    "offset": 1824,
    "text": "ἐφθέγξατʼ Ἀμφιάρηος. χαίρων δὲ καὶ αὐτὸς"
  },
  {
    "id": "p-ce2720",
    "offset": 1866,
    "text": "Ἀλκμᾶνα στεφάνοισι βάλλω, ῥαίνω δὲ καὶ ὕμνῳ,"
  },
  {
    "id": "p-051fd8",
    "offset": 1912,
    "text": "γείτων ὅτι μοι καὶ κτεάνων φύλαξ ἐμῶν"
  },
  {
    "id": "p-99aa8c",
    "offset": 1951,
    "text": "ὑπάντασεν ἰόντι γᾶς ὀμφαλὸν παρʼ ἀοίδιμον,"
  },
  {
    "id": "p-70f5d7",
    "offset": 1995,
    "text": "μαντευμάτων τʼ ἐφάψατο συγγόνοισι τέχναις."
  },
  {
    "id": "p-b9dd9e",
    "offset": 2039,
    "text": "τὺ δʼ,Ἑκαταβόλε, πάνδοκον"
  },
  {
    "id": "p-0782f4",
    "offset": 2066,
    "text": "ναὸν εὐκλέα διανέμων"
  },
  {
    "id": "p-97f6bd",
    "offset": 2088,
    "text": "Πυθῶνος ἐν γυάλοις,"
  },
  {
    "id": "p-0a013c",
    "offset": 2109,
    "text": "τὸ μὲν μέγιστον τόθι χαρμάτων"
  },
  {
    "id": "p-0165e9",
    "offset": 2140,
    "text": "ὤπασας· οἴκοι δὲ πρόσθεν ἁρπαλέαν δόσιν"
  },
  {
    "id": "p-405d46",
    "offset": 2181,
    "text": "πενταθλίου σὺν ἑορταῖς ὑμαῖς ἐπάγαγες."
  },
  {
    "id": "p-635251",
    "offset": 2221,
    "text": "ἄναξ, ἑκόντι δʼ εὔχομαι νόῳ"
  },
  {
    "id": "p-fed1fc",
    "offset": 2250,
    "text": "κατά τινʼ ἁρμονίαν βλέπειν,"
  },
  {
    "id": "p-3ce107",
    "offset": 2279,
    "text": "ἀμφʼ ἕκαστον ὅσα νέομαι."
  },
  {
    "id": "p-34ef96",
    "offset": 2305,
    "text": "κώμῳ μὲν ἁδυμελεῖ"
  },
  {
    "id": "p-a47018",
    "offset": 2324,
    "text": "Δίκα παρέστακε· θεῶν δʼ ὄπιν"
  },
  {
    "id": "p-670f87",
    "offset": 2354,
    "text": "ἄφθονον αἰτέω, Ξείναρκες, ὑμετέραις τύχαις."
  },
  {
    "id": "p-6f4ab3",
    "offset": 2399,
    "text": "εἰ γάρ τις ἐσλὰ πέπαται μὴ σὺν μακρῷ πόνῳ,"
  },
  {
    "id": "p-e23d3e",
    "offset": 2443,
    "text": "πολλοῖς σοφὸς δοκεῖ πεδʼ ἀφρόνων"
  },
  {
    "id": "p-5cae49",
    "offset": 2477,
    "text": "βίον κορυσσέμεν ὀρθοβούλοισι μαχαναῖς·"
  },
  {
    "id": "p-9ddd02",
    "offset": 2517,
    "text": "τὰ δʼ οὐκ ἐπʼ ἀνδράσι κεῖται· δαίμων δὲ παρίσχει,"
  },
  {
    "id": "p-2ffd8f",
    "offset": 2568,
    "text": "ἄλλοτʼ ἄλλον ὕπερθε βάλλων, ἄλλον δʼ ὑπὸ χειρῶν"
  },
  {
    "id": "p-1d6ba7",
    "offset": 2617,
    "text": "μέτρῳ καταβαίνει. Μεγάροις δʼ ἔχεις γέρας,"
  },
  {
    "id": "p-84201e",
    "offset": 2661,
    "text": "μυχῷ τʼ ἐν Μαραθῶνος, Ἥρας τʼ ἀγῶνʼ ἐπιχώριον"
  },
  {
    "id": "p-d5bd95",
    "offset": 2708,
    "text": "νίκαις τρισσαῖς, Ὦριστόμενες, δάμασσας ἔργῳ·"
  },
  {
    "id": "p-34107f",
    "offset": 2754,
    "text": "τέτρασι δʼ ἔμπετες ὑψόθεν"
  },
  {
    "id": "p-43e456",
    "offset": 2781,
    "text": "σωμάτεσσι κακὰ φρονέων,"
  },
  {
    "id": "p-e0953a",
    "offset": 2806,
    "text": "τοῖς οὔτε νόστος ὁμῶς"
  },
  {
    "id": "p-c13194",
    "offset": 2829,
    "text": "ἔπαλπνος ἐν Πυθιάδι κρίθη,"
  },
  {
    "id": "p-c339d4",
    "offset": 2857,
    "text": "οὐδὲ μολόντων πὰρ ματέρʼ ἀμφὶ γέλως γλυκὺς"
  },
  {
    "id": "p-18594f",
    "offset": 2901,
    "text": "ὦρσεν χάριν· κατὰ λαύρας δʼ ἐχθρῶν ἀπάοροι"
  },
  {
    "id": "p-23557a",
    "offset": 2945,
    "text": "πτώσσοντι, συμφορᾷ δεδαγμένοι."
  },
  {
    "id": "p-499f9e",
    "offset": 2977,
    "text": "ὁ δὲ καλόν τι νέον λαχὼν"
  },
  {
    "id": "p-0acf85",
    "offset": 3003,
    "text": "ἁβρότατος ἔπι μεγάλας"
  },
  {
    "id": "p-d65336",
    "offset": 3026,
    "text": "ἐξ ἐλπίδος πέταται"
  },
  {
    "id": "p-affc85",
    "offset": 3046,
    "text": "ὑποπτέροις ἀνορέαις, ἔχων"
  },
  {
    "id": "p-c80385",
    "offset": 3073,
    "text": "κρέσσονα πλούτου μέριμναν. ἐν δʼ ὀλίγῳ βροτῶν"
  },
  {
    "id": "p-28f220",
    "offset": 3120,
    "text": "τὸ τερπνὸν αὔξεται· οὕτω δὲ καὶ πίτνει χαμαί,"
  },
  {
    "id": "p-86be53",
    "offset": 3167,
    "text": "ἀποτρόπῳ γνώμᾳ σεσεισμένον."
  },
  {
    "id": "p-dea6f0",
    "offset": 3196,
    "text": "ἐπάμεροι· τί δέ τις; τί δʼ οὔ τις; σκιᾶς ὄναρ"
  },
  {
    "id": "p-0667e5",
    "offset": 3243,
    "text": "ἄνθρωπος. ἀλλʼ ὅταν αἴγλα διόσδοτος ἔλθῃ,"
  },
  {
    "id": "p-372fb4",
    "offset": 3286,
    "text": "λαμπρὸν φέγγος ἔπεστιν ἀνδρῶν καὶ μείλιχος αἰών·"
  },
  {
    "id": "p-01a19c",
    "offset": 3336,
    "text": "Αἴγινα φίλα μᾶτερ, ἐλευθέρῳ στόλῳ"
  },
  {
    "id": "p-cf1c22",
    "offset": 3371,
    "text": "πόλιν τάνδε κόμιζε Δὶ καὶ κρέοντι σὺν Αἰακῷ"
  },
  {
    "id": "p-c95279",
    "offset": 3416,
    "text": "Πηλεῖ τε κἀγαθῷ Τελαμῶνι σύν τʼ Ἀχιλλεῖ."
  }
]