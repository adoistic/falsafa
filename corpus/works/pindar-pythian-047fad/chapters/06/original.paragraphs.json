[
  {
    "id": "p-ef91c5",
    "offset": 0,
    "text": "ἀκούσατʼ· ἦ γὰρ ἑλικώπιδος Ἀφροδίτας"
  },
  {
    "id": "p-6df122",
    "offset": 38,
    "text": "ἄρουραν ἢ Χαρίτων"
  },
  {
    "id": "p-a3024c",
    "offset": 57,
    "text": "ἀναπολίζομεν, ὀμφαλὸν ἐριβρόμου"
  },
  {
    "id": "p-d3558f",
    "offset": 90,
    "text": "χθονὸς ἐς νάϊον προσοιχόμενοι·"
  },
  {
    "id": "p-6b6199",
    "offset": 122,
    "text": "Πυθιόνικος ἔνθʼ ὀλβίοισιν Ἐμμενίδαις"
  },
  {
    "id": "p-9dcf3a",
    "offset": 160,
    "text": "ποταμίᾳ τʼ Ἀκράγαντι καὶ μὰν Ξενοκράτει"
  },
  {
    "id": "p-42badc",
    "offset": 201,
    "text": "ἑτοῖμος ὕμνων"
  },
  {
    "id": "p-e27100",
    "offset": 216,
    "text": "θησαυρὸς ἐν πολυχρύσῳ"
  },
  {
    "id": "p-0eb833",
    "offset": 239,
    "text": "Ἀπολλωνίᾳ τετείχισται νάπᾳ·"
  },
  {
    "id": "p-adf996",
    "offset": 268,
    "text": "τὸν οὔτε χειμέριος ὄμβρος ἐπακτὸς ἐλθών,"
  },
  {
    "id": "p-155e7d",
    "offset": 310,
    "text": "ἐριβρόμου νεφέλας"
  },
  {
    "id": "p-10d420",
    "offset": 329,
    "text": "στρατὸς ἀμείλιχος, οὔτʼ ἄνεμος ἐς μυχοὺς"
  },
  {
    "id": "p-d921fb",
    "offset": 371,
    "text": "ἁλὸς ἄξοισι παμφόρῳ χεράδει"
  },
  {
    "id": "p-ee8c5f",
    "offset": 400,
    "text": "τυπτόμενον. φάει δὲ πρόσωπον ἐν καθαρῷ"
  },
  {
    "id": "p-60095f",
    "offset": 440,
    "text": "πατρὶ τεῷ, Θρασύβουλε, κοινάν τε γενεᾷ"
  },
  {
    "id": "p-451b8d",
    "offset": 480,
    "text": "λόγοισι θνατῶν"
  },
  {
    "id": "p-6a7b9f",
    "offset": 496,
    "text": "εὔδοξον ἅρματι νίκαν"
  },
  {
    "id": "p-f113f2",
    "offset": 518,
    "text": "Κρισαίαισιν ἐν πτυχαῖς ἀπαγγελεῖ."
  },
  {
    "id": "p-b14cdc",
    "offset": 553,
    "text": "σύ τοι σχεθών νιν ἐπιδέξια χειρός, ὀρθὰν"
  },
  {
    "id": "p-4e70eb",
    "offset": 595,
    "text": "ἄγεις ἐφημοσύναν,"
  },
  {
    "id": "p-e5a7af",
    "offset": 614,
    "text": "τά ποτʼ ἐν οὔρεσι φαντὶ μεγαλοσθενεῖ"
  },
  {
    "id": "p-8af56e",
    "offset": 652,
    "text": "Φιλύρας υἱὸν ὀρφανιζομένῲ"
  },
  {
    "id": "p-3a0f5b",
    "offset": 679,
    "text": "Πηλεΐδᾳ παραινεῖν· μάλιστα μὲν Κρονίδαν,"
  },
  {
    "id": "p-f5262a",
    "offset": 721,
    "text": "βαρυόπαν στεροπᾶν κεραυνῶν τε πρύτανιν,"
  },
  {
    "id": "p-42f679",
    "offset": 762,
    "text": "θεῶν σέβεσθαι·"
  },
  {
    "id": "p-e93a3b",
    "offset": 778,
    "text": "ταύτας δὲ μή ποτε τιμᾶς"
  },
  {
    "id": "p-22bc0c",
    "offset": 803,
    "text": "ἀμείρειν γονέων βίον πεπρωμένον."
  },
  {
    "id": "p-b69fcc",
    "offset": 837,
    "text": "ἔγεντο καὶ πρότερον Ἀντίλοχος βιατὰς"
  },
  {
    "id": "p-84a434",
    "offset": 875,
    "text": "νόημα τοῦτο φέρων,"
  },
  {
    "id": "p-b29319",
    "offset": 895,
    "text": "ὃς ὑπερέφθιτο πατρός, ἐναρίμβροτον"
  },
  {
    "id": "p-774abd",
    "offset": 931,
    "text": "ἀναμείναις στράταρχον Αἰθιόπων"
  },
  {
    "id": "p-bc9cc8",
    "offset": 963,
    "text": "Μέμνονα. Νεστόρειον γὰρ ἵππος ἅρμʼ ἐπέδα"
  },
  {
    "id": "p-67ca5f",
    "offset": 1005,
    "text": "Πάριος ἐκ βελέων δαϊχθείς· ὁ δʼ ἔφεπεν"
  },
  {
    "id": "p-45b55a",
    "offset": 1045,
    "text": "κραταιὸν ἔγχος·"
  },
  {
    "id": "p-058c68",
    "offset": 1062,
    "text": "Μεσσανίου δὲ γέροντος"
  },
  {
    "id": "p-5ea09f",
    "offset": 1085,
    "text": "δονηθεῖσα φρὴν βόασε παῖδα ὅν·"
  },
  {
    "id": "p-ee1a26",
    "offset": 1117,
    "text": "χαμαιπετὲς δʼ ἄρʼ ἔπος οὐκ ἀπέριψεν· αὐτοῦ"
  },
  {
    "id": "p-1659f9",
    "offset": 1161,
    "text": "μένων δʼ ὁ θεῖος ἀνὴρ"
  },
  {
    "id": "p-a20e6c",
    "offset": 1184,
    "text": "πρίατο μὲν θανάτοιο κομιδὰν πατρός,"
  },
  {
    "id": "p-8ce844",
    "offset": 1221,
    "text": "ἐδόκησέν τε τῶν πάλαι γενεᾷ"
  },
  {
    "id": "p-422aa9",
    "offset": 1250,
    "text": "ὁπλοτέροισιν, ἔργον πελώριον τελέσαις,"
  },
  {
    "id": "p-18a0df",
    "offset": 1290,
    "text": "ὕπατος ἀμφὶ τοκεῦσιν ἔμμεν πρὸς ἀρετάν."
  },
  {
    "id": "p-aed5b3",
    "offset": 1331,
    "text": "τὰ μὲν παρίκει·"
  },
  {
    "id": "p-1006b2",
    "offset": 1348,
    "text": "τῶν νῦν δὲ καὶ Θρασύβουλος"
  },
  {
    "id": "p-fece1c",
    "offset": 1376,
    "text": "πατρῴαν μάλιστα πρὸς στάθμαν ἔβα,"
  },
  {
    "id": "p-3d5207",
    "offset": 1411,
    "text": "πάτρῳ τʼ ἐπερχόμενος ἀγλαΐαν ἅπασαν."
  },
  {
    "id": "p-062e96",
    "offset": 1449,
    "text": "νόῳ δὲ πλοῦτον ἄγει,"
  },
  {
    "id": "p-65f04f",
    "offset": 1471,
    "text": "ἄδικον οὔθʼ ὑπέροπλον ἥβαν δρέπων,"
  },
  {
    "id": "p-85a245",
    "offset": 1507,
    "text": "σοφίαν δʼ ἐν μυχοῖσι Πιερίδων·"
  },
  {
    "id": "p-6dc8ff",
    "offset": 1539,
    "text": "τίν τʼ, Ἐλέλιχθον, ἃς εὗρες ἱππίας ἐσόδους, μάλα ἁδόντι νόῳ, Ποσειδᾶν, προσέχεται. γλυκεῖα δὲ φρὴν καὶ συμπόταισιν ὁμιλεῖν μελισσᾶν ἀμείβεται τρητὸν πόνον."
  }
]