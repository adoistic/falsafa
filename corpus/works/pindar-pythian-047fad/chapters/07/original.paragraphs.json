[
  {
    "id": "p-bed6a5",
    "offset": 0,
    "text": "κάλλιστον αἱ μεγαλοπόλιες Ἀθᾶναι"
  },
  {
    "id": "p-edd697",
    "offset": 34,
    "text": "προοίμιον Ἀλκμανιδᾶν εὐρυσθενεῖ γενεᾷ"
  },
  {
    "id": "p-98f387",
    "offset": 73,
    "text": "κρηπῖδʼ ἀοιδᾶν"
  },
  {
    "id": "p-aea95f",
    "offset": 89,
    "text": "ἵπποισι βαλέσθαι."
  },
  {
    "id": "p-b40843",
    "offset": 108,
    "text": "ἐπεὶ τίνα πάτραν, τίνα οἶκον"
  },
  {
    "id": "p-39a84b",
    "offset": 138,
    "text": "ναίων ὀνυμάξεαι"
  },
  {
    "id": "p-6130dc",
    "offset": 155,
    "text": "ἐπιφανέστερον"
  },
  {
    "id": "p-42baa0",
    "offset": 170,
    "text": "Ἑλλάδι πυθέσθαι;"
  },
  {
    "id": "p-3fecc6",
    "offset": 188,
    "text": "πάσαισι γὰρ πολίεσι λόγος ὁμιλεῖ"
  },
  {
    "id": "p-71206a",
    "offset": 222,
    "text": "Ἐρεχθέος ἀστῶν, Ἄπολλον, οἳ τεόν γε δόμον"
  },
  {
    "id": "p-61cbaa",
    "offset": 265,
    "text": "Πυθῶνι δίᾳ"
  },
  {
    "id": "p-318b09",
    "offset": 277,
    "text": "θαητὸν ἔτευξαν."
  },
  {
    "id": "p-e8cdf7",
    "offset": 294,
    "text": "ἄγοντι δέ με πέντε μὲν Ἰσθμοῖ"
  },
  {
    "id": "p-7d8109",
    "offset": 325,
    "text": "νῖκαι, μία δʼ ἐκπρεπὴς"
  },
  {
    "id": "p-872f4e",
    "offset": 349,
    "text": "Διὸς Ὀλυμπιάς,"
  },
  {
    "id": "p-fd0b26",
    "offset": 365,
    "text": "δύο δʼ ἀπὸ Κίρρας,"
  },
  {
    "id": "p-c8ef87",
    "offset": 385,
    "text": "ὦ Μεγάκλεες, ὑμαί τε καὶ προγόνων."
  },
  {
    "id": "p-2a5d0e",
    "offset": 421,
    "text": "νέα δʼ εὐπραγίᾳ χαίρω τι· τὸ δʼ ἄχνυμαι,"
  },
  {
    "id": "p-9a2e55",
    "offset": 463,
    "text": "φθόνον ἀμειβόμενον τὰ καλὰ ἔργα."
  },
  {
    "id": "p-ae63e2",
    "offset": 497,
    "text": "φαντί γε μὰν οὕτω κεν ἀνδρὶ παρμονίμαν"
  },
  {
    "id": "p-674061",
    "offset": 537,
    "text": "θάλλοισαν εὐδαιμονίαν"
  },
  {
    "id": "p-7f442a",
    "offset": 560,
    "text": "τὰ καὶ τὰ φέρεσθαι."
  }
]