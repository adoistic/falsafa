  },
  {
    "id": "p-7f0b25",
    "offset": 2266,
    "text": "πᾶς δέ χρυσὸς θαλάσσης ὑπʼ αὐτὸν ὥσπερ πηλὸς"
  },
  {
    "id": "p-0cf680",
    "offset": 2312,
    "text": "ἀμύθητος."
  },
  {
    "id": "p-9ec9f7",
    "offset": 2323,
    "text": "ἀναζεῖ τὴν ἄβυσσον ὥσπερ χαλκεῖον·"
  },
  {
    "id": "p-337a44",
    "offset": 2359,
    "text": "ἥγηται δὲ τὴν θάλασσαν ὥσπερ ἐξάλιπτρον,"
  },
  {
    "id": "p-e4f884",
    "offset": 2401,
    "text": "τὸν δὲ τάρταρον τῆς ἀβύσσου ὥσπερ αἰχμάλωτον·"
  },
  {
    "id": "p-0d8f08",
    "offset": 2448,
    "text": "λογίσατο ἄβυσσον εἰς περίπατον."
  },
  {
    "id": "p-495fff",
    "offset": 2481,
    "text": "οὐκ ἔστιν οὐδὲν ἐπὶ τῆς γῆς ὅμοιον αὐτῷ, πεποιημένον"
  },
  {
    "id": "p-ae56d9",
    "offset": 2535,
    "text": "ἐνκαταπαίζεσθαι ὑπὸ τῶν ἀγγέλων μου·"
  },
  {
    "id": "p-73e684",
    "offset": 2573,
    "text": "πᾶν ὑψηλὸν ὁρᾷ,"
  },
  {
    "id": "p-39d5f0",
    "offset": 2590,
    "text": "αὐτὸς δὲ βασιλεὺς πάντων τῶν ἐν τοῖς ὕδασιν."
  }
]