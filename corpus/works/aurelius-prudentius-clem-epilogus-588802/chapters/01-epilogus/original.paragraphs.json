[
  {
    "id": "p-eea429",
    "offset": 0,
    "text": "1. Epilogus\nInmolat Deo Patri"
  },
  {
    "id": "p-201e0c",
    "offset": 31,
    "text": "pius, fidelis, innocens, pudicus"
  },
  {
    "id": "p-69778b",
    "offset": 65,
    "text": "dona conscientiae,"
  },
  {
    "id": "p-4ea27a",
    "offset": 85,
    "text": "quibus beata mens abundat intus."
  },
  {
    "id": "p-21b28e",
    "offset": 119,
    "text": "alter et pecuniam"
  },
  {
    "id": "p-2f2fba",
    "offset": 138,
    "text": "recidit, unde victitent egeni."
  },
  {
    "id": "p-89e615",
    "offset": 170,
    "text": "nos citos iambicos"
  },
  {
    "id": "p-d6ee78",
    "offset": 190,
    "text": "sacramus et rotatiles trochaeos"
  },
  {
    "id": "p-8a64f5",
    "offset": 223,
    "text": "sanctitatis indigi"
  },
  {
    "id": "p-a22c10",
    "offset": 243,
    "text": "nec ad levamen pauperum potentes."
  },
  {
    "id": "p-3014e7",
    "offset": 278,
    "text": "approbat tamen Deus"
  },
  {
    "id": "p-78d041",
    "offset": 299,
    "text": "pedestre carmen et benignus audit."
  },
  {
    "id": "p-47f7b0",
    "offset": 335,
    "text": "multa divitis domo"
  },
  {
    "id": "p-aefa2b",
    "offset": 355,
    "text": "sita est per omnes angulos supellex:"
  },
  {
    "id": "p-0d32b9",
    "offset": 393,
    "text": "fulget aureus scyphus"
  },
  {
    "id": "p-588172",
    "offset": 416,
    "text": "nec aere defit expolita pelvis,"
  },
  {
    "id": "p-374ea1",
    "offset": 449,
    "text": "est et olla fictilis"
  },
  {
    "id": "p-f20cb9",
    "offset": 471,
    "text": "gravisque et ampla argentea est parapsis,"
  },
  {
    "id": "p-878fac",
    "offset": 514,
    "text": "sunt eburna quaepiam,"
  },
  {
    "id": "p-a4eb0f",
    "offset": 537,
    "text": "nonnulla quercu sunt cavata et ulmo."
  },
  {
    "id": "p-a420f6",
    "offset": 575,
    "text": "omne vas fit utile"
  },
  {
    "id": "p-2a5e44",
    "offset": 595,
    "text": "quod est ad usum congruens erilem;"
  },
  {
    "id": "p-a91ac7",
    "offset": 631,
    "text": "instruunt enim domum"
  },
  {
    "id": "p-b115b8",
    "offset": 653,
    "text": "ut empta magno, sic parata ligno."
  },
  {
    "id": "p-14fded",
    "offset": 688,
    "text": "me paterno in atrio"
  },
  {
    "id": "p-89df72",
    "offset": 709,
    "text": "ut obsoletum vasculum caducis"
  },
  {
    "id": "p-742869",
    "offset": 740,
    "text": "Christus aptat usibus"
  },
  {
    "id": "p-1f5a90",
    "offset": 763,
    "text": "sinitque parte in anguli manere."
  },
  {
    "id": "p-8570da",
    "offset": 797,
    "text": "munus ecce fictile"
  },
  {
    "id": "p-c0d6ce",
    "offset": 817,
    "text": "inimus intra regiam salutis."
  },
  {
    "id": "p-3bdc38",
    "offset": 847,
    "text": "attamen vel infimam"
  },
  {
    "id": "p-37c711",
    "offset": 868,
    "text": "Deo obsequellam praestitisse prodest."
  },
  {
    "id": "p-0540b3",
    "offset": 907,
    "text": "quidquid illud accidit,"
  },
  {
    "id": "p-ce10e1",
    "offset": 932,
    "text": "iuvabit ore personasse Christum. 1"
  }
]