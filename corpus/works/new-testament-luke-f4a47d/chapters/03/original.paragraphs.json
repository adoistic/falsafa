[
  {
    "id": "p-6902e9",
    "offset": 0,
    "text": "ΕΝ ΕΤΕΙ δὲ πεντεκαιδεκάτῳ τῆς ἡγεμονίας Τιβερίου"
  },
  {
    "id": "p-10433a",
    "offset": 50,
    "text": "Καίσαρος, ἡγεμονεύοντος Ποντίου Πειλάτου τῆς Ἰουδαίας,"
  },
  {
    "id": "p-83773f",
    "offset": 106,
    "text": "καὶ τετρααρχοῦντος τῆς Γαλιλαίας Ἡρῴδου, Φιλίππου δὲ"
  },
  {
    "id": "p-29e9f3",
    "offset": 160,
    "text": "τοῦ ἀδελφοῦ αὐτοῦ τετρααρχοῦντος τῆς Ἰτουραίας καὶ"
  },
  {
    "id": "p-01cdf7",
    "offset": 212,
    "text": "Τραχωνίτιδος χώρας, καὶ Λυσανίου τῆς Ἀβειληνῆς τετρααρχοῦντος,"
  },
  {
    "id": "p-f66091",
    "offset": 276,
    "text": "ἐπὶ ἀρχιερέως Ἅννα καὶ Καιάφα,"
  },
  {
    "id": "p-1593a5",
    "offset": 308,
    "text": "ἐγένετο ῥῆμα"
  },
  {
    "id": "p-3916cd",
    "offset": 322,
    "text": "θεοῦ ἐπὶ Ἰωάνην τὸν Ζαχαρίου υἱὸν ἐν τῇ ἐρήμῳ."
  },
  {
    "id": "p-474d8a",
    "offset": 370,
    "text": "καὶ"
  },
  {
    "id": "p-1f7818",
    "offset": 375,
    "text": "ἦλθεν εἰς πᾶσαν περίχωρον τοῦ Ἰορδάνου κηρύσσων βάπτισμα"
  },
  {
    "id": "p-22f81f",
    "offset": 433,
    "text": "μετανοίας εἰς ἄφεσιν ἁμαρτιῶν,"
  },
  {
    "id": "p-a2be2e",
    "offset": 465,
    "text": "ὡς γέγραπται ἐν"
  },
  {
    "id": "p-3fd734",
    "offset": 482,
    "text": "βίβλῳ λόγων Ἠσαίου τοῦ προφήτου"
  },
  {
    "id": "p-a0747b",
    "offset": 515,
    "text": "φωνὴ βοῶντος ἐν τῇ ἐρήμῳ"
  },
  {
    "id": "p-8a7136",
    "offset": 541,
    "text": "Ἑτοιμάσατε τὴν ὁδὸν Κυρίου,"
  },
  {
    "id": "p-7087bc",
    "offset": 570,
    "text": "εὐθείας ποιεῖτε τὰς τρίβους αὐτοῦ."
  },
  {
    "id": "p-9b77a0",
    "offset": 606,
    "text": "πᾶσα φάραγξ πληρωθήσεται"
  },
  {
    "id": "p-9476d0",
    "offset": 632,
    "text": "καὶ πᾶν ὄρος καὶ βουνὸς ταπεινωθήσεται,"
  },
  {
    "id": "p-0c98fc",
    "offset": 673,
    "text": "καὶ ἔσται τὰ σκολιὰ εἰς εὐθείας"
  },
  {
    "id": "p-060332",
    "offset": 706,
    "text": "καὶ αἱ τραχεῖαι εἰς ὁδοὺς λείας·"
  },
  {
    "id": "p-790d92",
    "offset": 740,
    "text": "καὶ ὄψεται πᾶσα σὰρξ τὸ σωτήριον τοῦ θεοῦ."
  },
  {
    "id": "p-e6dcbe",
    "offset": 784,
    "text": "Ἔλεγεν οὖν τοῖς ἐκπορευομένοις ὄχλοις βαπτισθῆναι ὑπʼ αὐτοῦ"
  },
  {
    "id": "p-ebefa2",
    "offset": 845,
    "text": "Γεννήματα ἐχιδνῶν, τίς ὑπέδειξεν ὑμῖν φυγεῖν ἀπὸ"
  },
  {
    "id": "p-189a8e",
    "offset": 895,
    "text": "τῆς μελλούσης ὀργῆς;"
  },
  {
    "id": "p-4f7e43",
    "offset": 917,
    "text": "ποιήσατε οὖν καρποὺς ἀξίους"
  },
  {
    "id": "p-cded7e",
    "offset": 946,
    "text": "τῆς μετανοίας· καὶ μὴ ἄρξησθε λέγειν ἐν ἑαυτοῖς Πατέρα"
  },
  {
    "id": "p-b6bb1c",
    "offset": 1002,
    "text": "ἔχομεν τὸν Ἀβραάμ, λέγω γὰρ ὑμῖν ὅτι δύναται ὁ θεὸς"
  },
  {
    "id": "p-63a586",
    "offset": 1055,
    "text": "ἐκ τῶν λίθων τούτων ἐγεῖραι τέκνα τῷ Ἀβραάμ."
  },
  {
    "id": "p-192fc3",
    "offset": 1101,
    "text": "ἤδη δὲ καὶ"
  },
  {
    "id": "p-b21130",
    "offset": 1113,
    "text": "ἡ ἀξίνη πρὸς τὴν ῥίζαν τῶν δένδρων κεῖται· πᾶν οὖν δένδρον"
  },
  {
    "id": "p-5ecd67",
    "offset": 1173,
    "text": "μὴ ποιοῦν καρπὸν [καλὸν] ἐκκόπτεται καὶ εἰς πῦρ"
  },
  {
    "id": "p-5f2da3",
    "offset": 1222,
    "text": "βάλλεται."
  },
  {
    "id": "p-db21ca",
    "offset": 1233,
    "text": "καὶ ἐπηρώτων αὐτὸν οἱ ὄχλοι λέγοντες Τί"
  },
  {
    "id": "p-e73c03",
    "offset": 1274,
    "text": "οὖν ποιήσωμεν;"
  },
  {
    "id": "p-ce66ca",
    "offset": 1290,
    "text": "ἀποκριθεὶς δὲ ἔλεγεν αὐτοῖς Ὁ ἔχων"
  },
  {
    "id": "p-61227b",
    "offset": 1326,
    "text": "δύο χιτῶνας μεταδότω τῷ μὴ ἔχοντι, καὶ ὁ ἔχων βρώματα"
  },
  {
    "id": "p-b3c4d8",
    "offset": 1381,
    "text": "ὁμοίως ποιείτω."
  },
  {
    "id": "p-8b4dc7",
    "offset": 1398,
    "text": "ἦλθον δὲ καὶ τελῶναι βαπτισθῆναι καὶ"
  },
  {
    "id": "p-a919c3",
    "offset": 1436,
    "text": "εἶπαν πρὸς αὐτόν Διδάσκαλε,"
  },
  {
    "id": "p-b9ab5b",
    "offset": 1465,
    "text": "τί ποιήσωμεν;"
  },
  {
    "id": "p-f741ce",
    "offset": 1480,
    "text": "ὁ δὲ εἶπεν"
  },
  {
    "id": "p-70f957",
    "offset": 1492,
    "text": "πρὸς αὐτούς Μηδὲν πλέον παρὰ τὸ διατεταγμένον ὑμῖν"
  },
  {
    "id": "p-c1ad4c",
    "offset": 1544,
    "text": "πράσσετε."
  },
  {
    "id": "p-2070f7",
    "offset": 1555,
    "text": "ἐπηρώτων δὲ αὐτὸν καὶ στρατευόμενοι λέγοντες"
  },
  {
    "id": "p-1c686f",
    "offset": 1601,
    "text": "Τί ποιήσωμεν καὶ ἡμεῖς; καὶ εἶπεν αὐτοῖς Μηδένα"
  },
  {
    "id": "p-a662ab",
    "offset": 1650,
    "text": "διασείσητε μηδὲ συκοφαντήσητε, καὶ ἀρκεῖσθε"
  },
  {
    "id": "p-5f76b0",
    "offset": 1695,
    "text": "τοῖς ὀψωνίοις ὑμῶν."
  },
  {
    "id": "p-de1d5c",
    "offset": 1716,
    "text": "Προσδοκῶντος δὲ τοῦ λαοῦ"
  },
  {
    "id": "p-c0e197",
    "offset": 1742,
    "text": "καὶ διαλογιζομένων πάντων ἐν ταῖς καρδίαις αὐτῶν"
  },
  {
    "id": "p-558ac9",
    "offset": 1792,
    "text": "περὶ τοῦ Ἰωάνου,"
  },
  {
    "id": "p-c729b3",
    "offset": 1810,
    "text": "μή ποτε αὐτὸς εἴη ὁ χριστός,"
  },
  {
    "id": "p-497386",
    "offset": 1840,
    "text": "ἀπεκρίνατο"
  },
  {
    "id": "p-78f696",
    "offset": 1852,
    "text": "λέγων πᾶσιν ὁ Ἰωάνης Ἐγὼ μὲν ὕδατι βαπτίζω"
  },
  {
    "id": "p-959395",
    "offset": 1896,
    "text": "ὑμᾶς· ἔρχεται δὲ ὁ ἰσχυρότερός μου, οὗ οὐκ εἰμὶ ἱκανὸς"
  },
  {
    "id": "p-152447",
    "offset": 1952,
    "text": "λῦσαι τὸν ἱμάντα τῶν ὑποδημάτων αὐτοῦ· αὐτὸς ὑμᾶς"
  },
  {
    "id": "p-44e0d2",
    "offset": 2003,
    "text": "βαπτίσει ἐν πνεύματι ἁγίῳ καὶ πυρί·"
  },
  {
    "id": "p-2360f8",
    "offset": 2040,
    "text": "οὗ τὸ πτύον ἐν τῇ"
  },
  {
    "id": "p-0ca9a7",
    "offset": 2059,
    "text": "χειρὶ αὐτοῦ διακαθᾶραι τὴν ἅλωνα αὐτοῦ καὶ συναγαγεῖν"
  },
  {
    "id": "p-1dbc86",
    "offset": 2114,
    "text": "τὸν σῖτον εἰς τὴν ἀποθήκην αὐτοῦ, τὸ δὲ ἄχυρον κατακαύσει"
  },
  {
    "id": "p-006244",
    "offset": 2173,
    "text": "πυρὶ ἀσβέστῳ."
  },
  {
    "id": "p-5997ae",
    "offset": 2188,
    "text": "Πολλὰ μὲν οὖν καὶ"
  },
  {
    "id": "p-eb075d",
    "offset": 2207,
    "text": "ἕτερα παρακαλῶν εὐηγγελίζετο τὸν λαόν·"
  },
  {
    "id": "p-fa565d",
    "offset": 2247,
    "text": "ὁ δὲ Ἡρῴδης ὁ"
  },
  {
    "id": "p-196782",
    "offset": 2262,
    "text": "τετραάρχης, ἐλεγχόμενος ὑπʼ αὐτοῦ περὶ Ἡρῳδιάδος τῆς"
  },
  {
    "id": "p-53ca0a",
    "offset": 2316,
    "text": "γυναικὸς τοῦ ἀδελφοῦ αὐτοῦ καὶ περὶ πάντων ὧν ἐποίησεν"
  },
  {
    "id": "p-0794df",
    "offset": 2372,
    "text": "πονηρῶν ὁ Ἡρῴδης,"
  },
  {
    "id": "p-018a45",
    "offset": 2391,
    "text": "προσέθηκεν καὶ τοῦτο ἐπὶ πᾶσιν,"
  },
  {
    "id": "p-e625cb",
    "offset": 2424,
    "text": "κατέκλεισεν τὸν Ἰωάνην ἐν φυλακῇ."
  },
  {
    "id": "p-b60870",
    "offset": 2459,
    "text": "Ἐγένετο δὲ ἐν τῷ βαπτισθῆναι ἅπαντα τὸν λαὸν καὶ Ἰησοῦ"
  },
  {
    "id": "p-21a932",
    "offset": 2515,
    "text": "βαπτισθέντος καὶ προσευχομένου ἀνεῳχθῆναι τὸν οὐρανὸν"
  },
  {
    "id": "p-7ec6c9",
    "offset": 2570,
    "text": "καὶ καταβῆναι τὸ πνεῦμα τὸ ἅγιον σωματικῷ εἴδει ὡς"
  },
  {
    "id": "p-f1dd39",
    "offset": 2622,
    "text": "περιστερὰν ἐπʼ αὐτόν, καὶ φωνὴν ἐξ οὐρανοῦ γενέσθαι Σὺ"
  },
  {
    "id": "p-eba541",
    "offset": 2678,
    "text": "εἶ ὁ υἱός μου ὁ ἀγαπητός, ἐν σοὶ εὐδόκησα."
  },
  {
    "id": "p-a16aaa",
    "offset": 2722,
    "text": "Καὶ"
  },
  {
    "id": "p-6fd6c7",
    "offset": 2727,
    "text": "αὐτὸς ἦν Ἰησοῦς ἀρχόμενος ὡσεὶ ἐτῶν τριάκοντα, ὢν υἱός,"
  },
  {
    "id": "p-b59ca7",
    "offset": 2784,
    "text": "ὡς ἐνομίζετο, Ἰωσήφ"
  },
  {
    "id": "p-0b4000",
    "offset": 2805,
    "text": "τοῦ Ἡλεί"
  },
  {
    "id": "p-113f66",
    "offset": 2815,
    "text": "τοῦ Ματθάτ"
  },
  {
    "id": "p-5257b9",
    "offset": 2827,
    "text": "τοῦ Λευεί"
  },
  {
    "id": "p-b3ca60",
    "offset": 2838,
    "text": "τοῦ Μελχεί"
  },
  {
    "id": "p-a7f929",
    "offset": 2850,
    "text": "τοῦ Ἰανναί"
  },
  {
    "id": "p-cf1978",
    "offset": 2862,
    "text": "τοῦ Ἰωσήφ"
  },
  {
    "id": "p-e0158a",
    "offset": 2873,
    "text": "τοῦ Ματταθίου"
  },
  {
    "id": "p-c1ae5a",
    "offset": 2888,
    "text": "τοῦ Ἀμώς"
  },
  {
    "id": "p-f973dd",
    "offset": 2898,
    "text": "τοῦ Ναούμ"
  },
  {
    "id": "p-d26189",
    "offset": 2909,
    "text": "τοῦ Ἐσλεί"
  },
  {
    "id": "p-d92914",
    "offset": 2920,
    "text": "τοῦ Ναγγαί"
  },
  {
    "id": "p-ec2fea",
    "offset": 2932,
    "text": "τοῦ Μαάθ"
  },
  {
    "id": "p-e0158a",
    "offset": 2942,
    "text": "τοῦ Ματταθίου"
  },
  {
    "id": "p-b61004",
    "offset": 2957,
    "text": "τοῦ Σεμεείν"
  },
  {
    "id": "p-d01979",
    "offset": 2970,
    "text": "τοῦ Ἰωσήχ"
  },
  {
    "id": "p-476d0f",
    "offset": 2981,
    "text": "τοῦ Ἰωδά"
  },
  {
    "id": "p-2be616",
    "offset": 2991,
    "text": "τοῦ Ἰωανάν"
  },
  {
    "id": "p-6c4067",
    "offset": 3003,
    "text": "τοῦ Ῥησά"
  },
  {
    "id": "p-f64b1b",
    "offset": 3013,
    "text": "τοῦ Ζοροβάβελ"
  },
  {
    "id": "p-8f1f3b",
    "offset": 3028,
    "text": "τοῦ Σαλαθιήλ"
  },
  {
    "id": "p-89351c",
    "offset": 3042,
    "text": "τοῦ Νηρεί"
  },
  {
    "id": "p-b3ca60",
    "offset": 3053,
    "text": "τοῦ Μελχεί"
  },
  {
    "id": "p-a6da38",
    "offset": 3065,
    "text": "τοῦ Ἀδδεί"
  },
  {
    "id": "p-052234",
    "offset": 3076,
    "text": "τοῦ Κωσάμ"
  },
  {
    "id": "p-0d1052",
    "offset": 3087,
    "text": "τοῦ Ἐλμαδάμ"
  },
  {
    "id": "p-4f7631",
    "offset": 3100,
    "text": "τοῦ Ἤρ"
  },
  {
    "id": "p-9ea398",
    "offset": 3108,
    "text": "τοῦ Ἰησοῦ"
  },
  {
    "id": "p-4eea6a",
    "offset": 3119,
    "text": "τοῦ Ἐλιέζερ"
  },
  {
    "id": "p-faedac",
    "offset": 3132,
    "text": "τοῦ Ἰωρείμ"
  },
  {
    "id": "p-666754",
    "offset": 3144,
    "text": "τοῦ Μαθθάτ"
  },
  {
    "id": "p-5257b9",
    "offset": 3156,
    "text": "τοῦ Λευεί"
  },
  {
    "id": "p-b4df04",
    "offset": 3167,
    "text": "τοῦ Συμεών"
  },
  {
    "id": "p-fdf789",
    "offset": 3179,
    "text": "τοῦ Ἰούδα"
  },
  {
    "id": "p-cf1978",
    "offset": 3190,
    "text": "τοῦ Ἰωσήφ"
  },
  {
    "id": "p-7eceec",
    "offset": 3201,
    "text": "τοῦ Ἰωνάμ"
  },
  {
    "id": "p-f2afd4",
    "offset": 3212,
    "text": "τοῦ Ἐλιακείμ"
  },
  {
    "id": "p-78912a",
    "offset": 3226,
    "text": "τοῦ Μελεά"
  },
  {
    "id": "p-62864a",
    "offset": 3237,
    "text": "τοῦ Μεννά"
  },
  {
    "id": "p-3b4fa8",
    "offset": 3248,
    "text": "τοῦ Ματταθά"
  },
  {
    "id": "p-df2617",
    "offset": 3261,
    "text": "τοῦ Ναθάμ"
  },
  {
    "id": "p-05a321",
    "offset": 3272,
    "text": "τοῦ Δαυείδ"
  },
  {
    "id": "p-ba2b78",
    "offset": 3284,
    "text": "τοῦ Ἰεσσαί"
  },
  {
    "id": "p-986819",
    "offset": 3296,
    "text": "τοῦ Ἰωβήλ"
  },
  {
    "id": "p-f4ff25",
    "offset": 3307,
    "text": "τοῦ Βοός"
  },
  {
    "id": "p-2df9b7",
    "offset": 3317,
    "text": "τοῦ Σαλά"
  },
  {
    "id": "p-1f2c8c",
    "offset": 3327,
    "text": "τοῦ Ναασσών"
  },
  {
    "id": "p-3c6c2f",
    "offset": 3340,
    "text": "τοῦ Ἀδμείν"
  },
  {
    "id": "p-ea05e0",
    "offset": 3352,
    "text": "τοῦ Ἀρνεί"
  },
  {
    "id": "p-9f3469",
    "offset": 3363,
    "text": "τοῦ Ἑσρών"
  },
  {
    "id": "p-4c37cd",
    "offset": 3374,
    "text": "τοῦ Φαρές"
  },
  {
    "id": "p-fdf789",
    "offset": 3385,
    "text": "τοῦ Ἰούδα"
  },
  {
    "id": "p-db60bd",
    "offset": 3396,
    "text": "τοῦ Ἰακώβ"
  },
  {
    "id": "p-9ae770",
    "offset": 3407,
    "text": "τοῦ Ἰσαάκ"
  },
  {
    "id": "p-a9f3ed",
    "offset": 3418,
    "text": "τοῦ Ἀβραάμ"
  },
  {
    "id": "p-08561c",
    "offset": 3430,
    "text": "τοῦ Θαρά"
  },
  {
    "id": "p-0b0ee8",
    "offset": 3440,
    "text": "τοῦ Ναχώρ"
  },
  {
    "id": "p-c6cbda",
    "offset": 3451,
    "text": "τοῦ Σερούχ"
  },
  {
    "id": "p-ab687b",
    "offset": 3463,
    "text": "τοῦ Ῥαγαύ"
  },
  {
    "id": "p-1ff278",
    "offset": 3474,
    "text": "τοῦ Φάλεκ"
  },
  {
    "id": "p-e8f3c6",
    "offset": 3485,
    "text": "τοῦ Ἔβερ"
  },
  {
    "id": "p-2df9b7",
    "offset": 3495,
    "text": "τοῦ Σαλά"
  },
  {
    "id": "p-194a43",
    "offset": 3505,
    "text": "τοῦ Καινάμ"
  },
  {
    "id": "p-c8e6ee",
    "offset": 3517,
    "text": "τοῦ Ἀρφαξάδ"
  },
  {
    "id": "p-96e5d9",
    "offset": 3530,
    "text": "τοῦ Σήμ"
  },
  {
    "id": "p-382bf1",
    "offset": 3539,
    "text": "τοῦ Νῶε"
  },
  {
    "id": "p-7d1e93",
    "offset": 3548,
    "text": "τοῦ Λάμεχ"
  },
  {
    "id": "p-525d3e",
    "offset": 3559,
    "text": "τοῦ Μαθουσαλά"
  },
  {
    "id": "p-bf7a86",
    "offset": 3574,
    "text": "τοῦ Ἑνώχ"
  },
  {
    "id": "p-949341",
    "offset": 3584,
    "text": "τοῦ Ἰάρετ"
  },
  {
    "id": "p-da2993",
    "offset": 3595,
    "text": "τοῦ Μαλελεήλ"
  },
