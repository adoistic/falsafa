[
  {
    "id": "p-3eb30e",
    "offset": 0,
    "text": "Χορός:\nβασιλεῦ τᾶν ἱερᾶν Ἀθανᾶν,"
  },
  {
    "id": "p-8fb029",
    "offset": 34,
    "text": "τῶν ἁβροβίων ἄναξ Ἰώνων,"
  },
  {
    "id": "p-1075bd",
    "offset": 60,
    "text": "τί νέον ἔκλαγε χαλκοκώδων"
  },
  {
    "id": "p-ee307b",
    "offset": 87,
    "text": "σάλπιγξ πολεμηΐαν ἀοιδάν;"
  },
  {
    "id": "p-3db384",
    "offset": 114,
    "text": "ἦ τις ἁμετέρας χθονὸς"
  },
  {
    "id": "p-015aea",
    "offset": 137,
    "text": "δυσμενὴς ὅριʼ ἀμφιβάλλει"
  },
  {
    "id": "p-b0d969",
    "offset": 163,
    "text": "στρατα·γέτας ἀνήρ;"
  },
  {
    "id": "p-adcebb",
    "offset": 183,
    "text": "ἢ λῃσταὶ κακομάχανοι"
  },
  {
    "id": "p-a2443c",
    "offset": 205,
    "text": "ποιμένων ἀέκατι μήλων"
  },
  {
    "id": "p-e79f32",
    "offset": 228,
    "text": "σεύοντʼ ἀγέλας βίᾳ;"
  },
  {
    "id": "p-b7e0de",
    "offset": 249,
    "text": "ἢ τί τοι κραδίαν ἀμύσσει;"
  },
  {
    "id": "p-30f54b",
    "offset": 276,
    "text": "φθέγγευ· δοκέω γὰρ εἴ τινι βροτῶν"
  },
  {
    "id": "p-9fd0ff",
    "offset": 311,
    "text": "ἀλκίμων ἐπικουρίαν"
  },
  {
    "id": "p-ba13c7",
    "offset": 331,
    "text": "καὶ τὶν ἔμμεναι νέων,"
  },
  {
    "id": "p-7ce66f",
    "offset": 354,
    "text": "ὦ Πανδίονος υἱὲ καὶ Κρεούσας."
  },
  {
    "id": "p-9f7229",
    "offset": 385,
    "text": "Αἰγεύς:\nνέ]ον ἦλθεν δολιχὰν ἀμείψας"
  },
  {
    "id": "p-9b22dd",
    "offset": 422,
    "text": "κᾶρυξ ποσὶν Ἰσθμίαν κέλευθον·"
  },
  {
    "id": "p-09a00c",
    "offset": 453,
    "text": "ἄφατα δʼ ἔργα λέγει κραταιοῦ"
  },
  {
    "id": "p-7cdb16",
    "offset": 483,
    "text": "φωτός· τὸν ὑπέρβιόν τʼ ἔπεφνεν"
  },
  {
    "id": "p-0143d1",
    "offset": 515,
    "text": "Σίνιν, ὃς ἰσχύϊ φέρτατος"
  },
  {
    "id": "p-8d2ff6",
    "offset": 541,
    "text": "θνατῶν ἦν, Κρονίδα Λυταίου"
  },
  {
    "id": "p-3b25f5",
    "offset": 569,
    "text": "σεισίχθονος τέκος·"
  },
  {
    "id": "p-066e37",
    "offset": 589,
    "text": "σῦν τʼ ἀνδροκτόνον ἐν νάπαις"
  },
  {
    "id": "p-0d6825",
    "offset": 619,
    "text": "Κρεμμυῶνος, ἀτάσθαλόν τε"
  },
  {
    "id": "p-fbfa2f",
    "offset": 645,
    "text": "Σκίρωνα κατέκτανεν·"
  },
  {
    "id": "p-6556e2",
    "offset": 666,
    "text": "τάν τε Κερκυόνος παλαίστραν"
  },
  {
    "id": "p-7a8726",
    "offset": 695,
    "text": "ἔσχεν, Πολυπήμονός τε καρτερὰν"
  },
  {
    "id": "p-fb4558",
    "offset": 727,
    "text": "σφῦραν ἐξέβαλεν Προκό-"
  },
  {
    "id": "p-b326d2",
    "offset": 751,
    "text": "πτας, ἀρείονος τυχὼν"
  },
  {
    "id": "p-8218c4",
    "offset": 773,
    "text": "φωτός. ταῦτα δέδοιχʼ ὅπᾳ τελεῖται."
  },
  {
    "id": "p-926244",
    "offset": 809,
    "text": "Χορός:\nτίνα δʼ ἔμμεν πόθεν ἄνδρα τοῦτον"
  },
  {
    "id": "p-593a9f",
    "offset": 850,
    "text": "λέγει, τίνα τε στολὰν ἔχοντα;"
  },
  {
    "id": "p-f87d21",
    "offset": 881,
    "text": "πότερα σὺν πολεμηΐοις ὅ-"
  },
  {
    "id": "p-1d1145",
    "offset": 907,
    "text": "πλοισι στρατιὰν ἄγοντα πολλάν;"
  },
  {
    "id": "p-d23af2",
    "offset": 939,
    "text": "ἢ μοῦνον σὺν ὀπ.άοσιν"
  },
  {
    "id": "p-ae9365",
    "offset": 962,
    "text": "στείχειν ἔμπορον οἷʼ ἀλάταν"
  },
  {
    "id": "p-787c29",
    "offset": 991,
    "text": "ἐπʼ ἀλλοδαμίαν,"
  },
  {
    "id": "p-467683",
    "offset": 1008,
    "text": "ἰσχυρόν τε καὶ ἄλκιμον"
  },
  {
    "id": "p-49d242",
    "offset": 1032,
    "text": "ὧδε καὶ θρασύν, ὅς τε τούτων"
  },
  {
    "id": "p-2d336e",
    "offset": 1062,
    "text": "ἀνδρῶν κρατερὸν σθένος"
  },
  {
    "id": "p-bae644",
    "offset": 1086,
    "text": "ἔσχεν; ἦ θεὸς αὐτὸν ὁρμᾷ,"
  },
  {
    "id": "p-722e4d",
    "offset": 1113,
    "text": "δίκας ἀδίκοισιν ὄφρα μήσεται·"
  },
  {
    "id": "p-7b5a0a",
    "offset": 1144,
    "text": "οὐ γὰρ ῥᾴδιον αἰὲν ἔρ-"
  },
  {
    "id": "p-c823f7",
    "offset": 1168,
    "text": "δοντα μὴ ʼντυχεῖν κακῷ."
  },
  {
    "id": "p-e820db",
    "offset": 1193,
    "text": "πάντʼ ἐν τῷ δολιχῷ χρόνῳ τελεῖται."
  },
  {
    "id": "p-75247a",
    "offset": 1229,
    "text": "Αἰγεύς:\nδύο ϝοι φῶτε μόνους ἁμαρτεῖν"
  },
  {
    "id": "p-fdb06c",
    "offset": 1267,
    "text": "λέγει, περὶ φαιδίμοισι δʼ ὤμοις"
  },
  {
    "id": "p-42e555",
    "offset": 1300,
    "text": "ξίφος ἔχειν ἐλεφαντόκωπον ·"
  },
  {
    "id": "p-ef9864",
    "offset": 1329,
    "text": "ξεστοὺς δὲ δύʼ ἐν χέρεσσʼ ἄκοντας"
  },
  {
    "id": "p-c8eef2",
    "offset": 1364,
    "text": "κηὔτυκτον κυνέαν Λάκαι-"
  },
  {
    "id": "p-74d366",
    "offset": 1389,
    "text": "ναν κρατὸς πέρι πυρσοχαίτου·"
  },
  {
    "id": "p-80f657",
    "offset": 1419,
    "text": "στέρνοις τε πορφύρ εο ν"
  },
  {
    "id": "p-edc502",
    "offset": 1444,
    "text": "χιτῶνʼ ἄμφι, καὶ οὔλιον"
  },
  {
    "id": "p-43c98d",
    "offset": 1469,
    "text": "Θεσσαλὰν χλαμύδʼ· ὀμμάτων δὲ"
  },
  {
    "id": "p-571a20",
    "offset": 1499,
    "text": "στίλβειν ἄπο Λαμνίαν"
  },
  {
    "id": "p-8b2776",
    "offset": 1521,
    "text": "φοίνισσαν φλόγα· παῖδα δʼ ἔμμεν"
  },
  {
    "id": "p-84a7ef",
    "offset": 1554,
    "text": "πρώθηβον, ἀρηΐων δʼ ἀθυρμάτων"
  },
  {
    "id": "p-06fa57",
    "offset": 1585,
    "text": "μεμνᾶσθαι πολέμου τε καὶ"
  },
  {
    "id": "p-77e5e2",
    "offset": 1611,
    "text": "χαλκεοκτύπου μάχας·"
  },
  {
    "id": "p-c1b466",
    "offset": 1632,
    "text": "δίζησθαι δὲ φιλαγλάους Ἀθάνας."
  }
]