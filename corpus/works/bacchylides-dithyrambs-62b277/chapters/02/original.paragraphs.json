[
  {
    "id": "p-ee35fa",
    "offset": 0,
    "text": "Πυθ]ίου [ἔπʼ εἶμʼ], ἐπεὶ"
  },
  {
    "id": "p-d903ff",
    "offset": 26,
    "text": "ὁλκ]άδʼ ἔπεμψεν ἐμοὶ χρυσέαν"
  },
  {
    "id": "p-800dc2",
    "offset": 56,
    "text": "Πιερ]ίαθε[ν ἐΰθ]ρονος Οὐρανία,"
  },
  {
    "id": "p-e5e03a",
    "offset": 88,
    "text": "πολυφ]άτων γέμουσαν ὕμνων"
  },
  {
    "id": "p-650d84",
    "offset": 115,
    "text": "!!!!!]ν̣ εἴτʼ ἄρʼ ἐπʼ ἀνθεμόεντι Ἕβρῳ"
  },
  {
    "id": "p-9e358f",
    "offset": 154,
    "text": "!!!!! ἀ]γάλλεται ἢ δολιχαύχενι κύκνῳ,"
  },
  {
    "id": "p-4761e4",
    "offset": 193,
    "text": "ὀπὶ ἁ]δεΐᾳ φρένα τερπόμενος,"
  },
  {
    "id": "p-bc892c",
    "offset": 223,
    "text": "!!!!!!]δʼ ἵκῃ παιηόνων"
  },
  {
    "id": "p-9284d1",
    "offset": 247,
    "text": "ἄνθεα πεδοιχνεῖν,"
  },
  {
    "id": "p-283a79",
    "offset": 266,
    "text": "Πύθιʼ Ἄπολλον,"
  },
  {
    "id": "p-d0ce13",
    "offset": 282,
    "text": "τόσα χοροὶ Δελφῶν"
  },
  {
    "id": "p-928d42",
    "offset": 301,
    "text": "σὸν κελάδησαν παρʼ ἀγακλέα ναόν."
  },
  {
    "id": "p-8f6f6c",
    "offset": 335,
    "text": "πρίν γε κλέομεν λιπεῖν"
  },
  {
    "id": "p-d6c0d5",
    "offset": 359,
    "text": "Οἰχαλίαν πυρὶ δαπτομέναν"
  },
  {
    "id": "p-efa1a2",
    "offset": 385,
    "text": "Ἀμφιτρυωνιάδαν θρασυμηδέα φῶ-"
  },
  {
    "id": "p-9c5d94",
    "offset": 416,
    "text": "θʼ, ἵκετο δʼ ἀμφικύμονʼ ἀκτάν·"
  },
  {
    "id": "p-11cccb",
    "offset": 448,
    "text": "ἔνθʼ ἀπὸ λαΐδος εὐρυνεφεῖ Κηναίῳ"
  },
  {
    "id": "p-df8f9b",
    "offset": 482,
    "text": "Ζηνὶ θύεν βαρυαχέας ἐννέα ταύρους"
  },
  {
    "id": "p-82a3c2",
    "offset": 517,
    "text": "δύο τʼ ὀρσιάλῳ δαμασίχθονι μέλ-"
  },
  {
    "id": "p-c78cb7",
    "offset": 550,
    "text": "λε κόρᾳ τʼ ὀβριμοδερκεῖ ἄζυγα"
  },
  {
    "id": "p-82b785",
    "offset": 581,
    "text": "παρθένῳ Ἀθάνᾳ"
  },
  {
    "id": "p-6ae9db",
    "offset": 596,
    "text": "ὑψικέραν βοῦν."
  },
  {
    "id": "p-093f11",
    "offset": 612,
    "text": "τότʼ ἄμαχος δαίμων"
  },
  {
    "id": "p-37f7cd",
    "offset": 632,
    "text": "Δαϊανείρᾳ πολύδακρυν ὕφανε"
  },
  {
    "id": "p-6006ff",
    "offset": 660,
    "text": "μῆτιν ἐπίφρονʼ, ἐπεὶ"
  },
  {
    "id": "p-e9ca90",
    "offset": 682,
    "text": "πύθετʼ ἀγγελίαν ταλαπενθέα,"
  },
  {
    "id": "p-38dc3c",
    "offset": 711,
    "text": "Ἰόλαν ὅτι λευκώλενον"
  },
  {
    "id": "p-cb992c",
    "offset": 733,
    "text": "Διὸς υἱὸς ἀταρβομάχας"
  },
  {
    "id": "p-2797ab",
    "offset": 756,
    "text": "ἄλοχον λιπαρὸ[ν π]οτὶ δόμον πέμποι."
  },
  {
    "id": "p-d1057f",
    "offset": 793,
    "text": "ἆ δύσμορος, ἆ τάλαινʼ, οἷον ἐμήσατο·"
  },
  {
    "id": "p-965e79",
    "offset": 831,
    "text": "φθόνος εὐρυβίας νιν ἀπώλεσεν,"
  },
  {
    "id": "p-0767da",
    "offset": 862,
    "text": "δνόφεόν τε κάλυμμα τῶν"
  },
  {
    "id": "p-da0bf6",
    "offset": 886,
    "text": "ὕστερον ἐρχομένων,"
  },
  {
    "id": "p-40a582",
    "offset": 906,
    "text": "ὅτʼ ἐπὶ ῥοδόεντι Λυκόρμᾳ"
  },
  {
    "id": "p-ac52b2",
    "offset": 932,
    "text": "δέξατο Νέσσου πάρα δαιμόνιον τέρ[ας."
  }
]