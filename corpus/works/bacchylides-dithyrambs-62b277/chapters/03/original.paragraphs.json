[
  {
    "id": "p-120b52",
    "offset": 0,
    "text": "Κυανόπρῳρα μὲν ναῦς μενέκτυπον"
  },
  {
    "id": "p-451191",
    "offset": 32,
    "text": "Θησέα δὶς ἑπτά τʼ ἀγλαοὺς ἄγουσα"
  },
  {
    "id": "p-382c2f",
    "offset": 66,
    "text": "κούρους Ἰαόνων"
  },
  {
    "id": "p-fba32a",
    "offset": 82,
    "text": "Κρητικὸν τάμνε πέλαγος·"
  },
  {
    "id": "p-c805b0",
    "offset": 107,
    "text": "τηλαυγέϊ γὰρ [ἐν] φάρεϊ"
  },
  {
    "id": "p-369c66",
    "offset": 132,
    "text": "βορήϊαι πίτνον αὖραι"
  },
  {
    "id": "p-778a26",
    "offset": 154,
    "text": "κλυτᾶς ἕκατι π[ο]λεμαίγιδος Ἀθάνας·"
  },
  {
    "id": "p-c8de86",
    "offset": 191,
    "text": "κνίσεν τε Μίνωϊ κέαρ"
  },
  {
    "id": "p-5ab585",
    "offset": 213,
    "text": "ἱμεράμπυκος θεᾶς"
  },
  {
    "id": "p-fbbb22",
    "offset": 231,
    "text": "Κύπριδος αἰνὰ δῶρα·"
  },
  {
    "id": "p-607caf",
    "offset": 252,
    "text": "χεῖρα δʼ οὐκέτι παρθενικᾶς"
  },
  {
    "id": "p-9c485f",
    "offset": 280,
    "text": "ἄτερθʼ ἐράτυεν, θίγεν"
  },
  {
    "id": "p-87231c",
    "offset": 303,
    "text": "δὲ λευκᾶν παρηΐδων·"
  },
  {
    "id": "p-e8cf6d",
    "offset": 324,
    "text": "βόασέ τʼ Ἐρίβοια χαλκο-"
  },
  {
    "id": "p-76d6b8",
    "offset": 349,
    "text": "θώρακα Πανδίονος"
  },
  {
    "id": "p-d26337",
    "offset": 367,
    "text": "ἔκγονον· ἴδεν δὲ Θησεύς,"
  },
  {
    "id": "p-e1c354",
    "offset": 393,
    "text": "μέλαν δʼ ὑπʼ ὀφρύων"
  },
  {
    "id": "p-f54669",
    "offset": 414,
    "text": "δίνασεν ὄμμα, καρδίαν τέ ϝοι"
  },
  {
    "id": "p-493525",
    "offset": 444,
    "text": "σχέτλιον ἄμυξεν ἄλγος,"
  },
  {
    "id": "p-890ba1",
    "offset": 468,
    "text": "εἶρέν τε· Διὸς υἱὲ φερτάτου,"
  },
  {
    "id": "p-36384f",
    "offset": 498,
    "text": "ὅσιον οὐκέτι τεᾶν"
  },
  {
    "id": "p-8befa4",
    "offset": 517,
    "text": "ἔσω κυβερνᾷς φρενῶν"
  },
  {
    "id": "p-d4d6f4",
    "offset": 538,
    "text": "θυμόν· ἴσχε μεγαλοῦχον ἥρως βίαν."
  },
  {
    "id": "p-7262d4",
    "offset": 573,
    "text": "ὅ τι μὲν ἐκ θεῶν μοῖρα παγκρατὴς"
  },
  {
    "id": "p-11df1b",
    "offset": 607,
    "text": "ἄμμι κατένευσε καὶ Δίκας ῥέπει τά-"
  },
  {
    "id": "p-f0a003",
    "offset": 643,
    "text": "λαντον, πεπρωμέναν"
  },
  {
    "id": "p-6c5ff8",
    "offset": 663,
    "text": "αἶσαν ἐκπλήσομεν, ὅταν"
  },
  {
    "id": "p-05fd14",
    "offset": 687,
    "text": "ἔλθῃ· σὺ δὲ βαρεῖαν κάτε-"
  },
  {
    "id": "p-ba409f",
    "offset": 714,
    "text": "χε μῆτιν. εἰ καί σε κεδνὰ"
  },
  {
    "id": "p-d9c8a8",
    "offset": 741,
    "text": "τέκεν λέχει Διὸς ὑπὸ κρόταφον Ἴδας"
  },
  {
    "id": "p-8d7faf",
    "offset": 777,
    "text": "μιγεῖσα Φοίνικος ἐρα-"
  },
  {
    "id": "p-a3d1bd",
    "offset": 800,
    "text": "τώνυμος κόρα βροτῶν"
  },
  {
    "id": "p-553571",
    "offset": 821,
    "text": "φέρτατον, ἀλλὰ κἀμὲ"
  },
  {
    "id": "p-99e615",
    "offset": 842,
    "text": "Πιτθέος θυγάτηρ ἀφνεοῦ"
  },
  {
    "id": "p-f2c7a9",
    "offset": 866,
    "text": "πλαθεῖσα ποντίῳ τέκεν"
  },
  {
    "id": "p-4cd588",
    "offset": 889,
    "text": "Ποσειδᾶνι, χρύσεον"
  },
  {
    "id": "p-56b390",
    "offset": 909,
    "text": "τέ ϝοι δόσαν ἰόπλοκοι"
  },
  {
    "id": "p-16e90d",
    "offset": 932,
    "text": "κάλυμμα Νηρηΐδες."
  },
  {
    "id": "p-6a341c",
    "offset": 951,
    "text": "τῶ σε, πολέμαρχε Κνωσίων,"
  },
  {
    "id": "p-934714",
    "offset": 978,
    "text": "κέλομαι πολύστονον"
  },
  {
    "id": "p-8bce7a",
    "offset": 998,
    "text": "ἐρύκεν ὕβριν· οὐ γὰρ ἂν θελοι-"
  },
  {
    "id": "p-72447f",
    "offset": 1030,
    "text": "μʼ ἀμβρότου ἐραννὸν Ἀοῦς"
  },
  {
    "id": "p-09333f",
    "offset": 1056,
    "text": "ἰδεῖν φάος, ἐπεί τινʼ ἠϊθ έω ν"
  },
  {
    "id": "p-392b2c",
    "offset": 1088,
    "text": "σὺ δαμάσειας ἀέκον-"
  },
  {
    "id": "p-178dae",
    "offset": 1109,
    "text": "τα· πρόσθε χειρῶν βίαν"
  },
  {
    "id": "p-3940b5",
    "offset": 1133,
    "text": "δείξομεν· τὰ δʼ ἐπιόντα δαίμων κρινεῖ."
  },
  {
    "id": "p-7e49d1",
    "offset": 1173,
    "text": "τόσʼ εἶ]πεν ἀρέταιχμος ἥρως·"
  },
  {
    "id": "p-9f71a9",
    "offset": 1203,
    "text": "τάφον δὲ ναυβάται"
  },
  {
    "id": "p-ea8db2",
    "offset": 1222,
    "text": "φωτὸς] ὑπεράφανον"
  },
  {
    "id": "p-1eadec",
    "offset": 1241,
    "text": "θάρσος· Ἁλίου τε γαμβρῷ χολώ[σατʼ ἦτορ,"
  },
  {
    "id": "p-fda21a",
    "offset": 1282,
    "text": "ὕφαινέ τε ποταινίαν"
  },
  {
    "id": "p-bf1a79",
    "offset": 1303,
    "text": "μῆτιν, εἶπέν τε· μεγαλοσθενὲς"
  },
  {
    "id": "p-a26d67",
    "offset": 1334,
    "text": "Ζεῦ πάτερ, ἄκουσον· εἴπερ μ[ε κούρ]α"
  },
  {
    "id": "p-251d45",
    "offset": 1372,
    "text": "Φοίνισσα λευκώλενος σοὶ τέκε,"
  },
  {
    "id": "p-e0221a",
    "offset": 1403,
    "text": "νῦν πρόπεμπʼ ἀπʼ οὐρανοῦ θ[οὰν"
  },
  {
    "id": "p-659741",
    "offset": 1435,
    "text": "πυριέθειραν ἀστραπὰν"
  },
  {
    "id": "p-6beef4",
    "offset": 1457,
    "text": "σᾶμʼ ἀρίγνωτον· εἰ"
  },
  {
    "id": "p-3c599d",
    "offset": 1477,
    "text": "δὲ καὶ σὲ Τροιζηνία σεισίχθονι"
  },
  {
    "id": "p-b4e5dd",
    "offset": 1509,
    "text": "φύτευσεν Αἴθρα Ποσει-"
  },
  {
    "id": "p-2c6880",
    "offset": 1532,
    "text": "δᾶνι, τόνδε χρύσεον"
  },
  {
    "id": "p-739441",
    "offset": 1553,
    "text": "χειρὸς ἀγλαὸν"
  },
  {
    "id": "p-5ae8ba",
    "offset": 1568,
    "text": "ἔνεγκε κόσμον ἐκ βαθείας ἁλός,"
  },
  {
    "id": "p-65be54",
    "offset": 1600,
    "text": "δικὼν θράσει σῶμα πατρὸς ἐς δόμους."
  },
  {
    "id": "p-e40963",
    "offset": 1637,
    "text": "εἴσεαι δʼ αἴ κʼ ἐμᾶς κλύῃ"
  },
  {
    "id": "p-7b1206",
    "offset": 1664,
    "text": "Κρόνιος εὐχᾶς"
  },
  {
    "id": "p-63bf09",
    "offset": 1679,
    "text": "ἀναξιβρόντας ὁ πάντων μεδ έω ν."
  },
  {
    "id": "p-00a307",
    "offset": 1712,
    "text": "κλύε δʼ ἄμετρον εὐχὰν μεγασθενὴς"
  },
  {
    "id": "p-a26260",
    "offset": 1746,
    "text": "Ζεύς, ὑπέροχόν τε Μίνωϊ φύτευσε"
  },
  {
    "id": "p-7ca25a",
    "offset": 1779,
    "text": "τιμὰν φίλῳ θέλων"
  },
  {
    "id": "p-0adbf8",
    "offset": 1797,
    "text": "παιδὶ πανδερκέα θέμεν,"
  },
  {
    "id": "p-82b105",
    "offset": 1821,
    "text": "ἄστραψέ θʼ· ὁ δὲ θυμάρμενον"
  },
  {
    "id": "p-0a7fe0",
    "offset": 1850,
    "text": "ἰδὼν τέρας πέτασε χεῖρας"
  },
  {
    "id": "p-67a983",
    "offset": 1876,
    "text": "κλυτὰν ἐς αἰθέρα μενεπτόλεμος ἥρως,"
  },
  {
    "id": "p-78433f",
    "offset": 1913,
    "text": "εἶρέν τε· Θησεῦ, σὺ τάδε"
  },
  {
    "id": "p-2796b0",
    "offset": 1939,
    "text": "μὲν βλέπεις σαφῆ Διὸς"
  },
  {
    "id": "p-792e11",
    "offset": 1962,
    "text": "δῶρα· σὺ δʼ ὄρνυʼ ἐς βα-"
  },
  {
    "id": "p-ff0d7b",
    "offset": 1988,
    "text": "ρύβρομον πέλαγος· Κρονίδας"
  },
  {
    "id": "p-b9de4f",
    "offset": 2016,
    "text": "δέ τοι πατὴρ ἄναξ τελεῖ"
  },
  {
    "id": "p-d80ad2",
    "offset": 2041,
    "text": "Ποσειδὰν ὑπέρτατον"
  },
  {
    "id": "p-41b382",
    "offset": 2061,
    "text": "κλέος χθόνα κατʼ ἠΰδενδρον."
  },
  {
    "id": "p-6d4c37",
    "offset": 2090,
    "text": "ὣς εἶπε· τῷ δʼ οὐ πάλιν"
  },
  {
    "id": "p-9c78e0",
    "offset": 2115,
    "text": "θυμὸς ἀνεκάμπτετʼ, ἀλλʼ εὐ-"
  },
  {
    "id": "p-252607",
    "offset": 2144,
    "text": "πάκτων ἐπʼ ἰκρίων"
  },
  {
    "id": "p-de03d1",
    "offset": 2163,
    "text": "σταθεὶς ὄρουσε, πόντιόν τέ νιν"
  },
  {
    "id": "p-82c154",
    "offset": 2195,
    "text": "δέξατο θελημὸν ἄλσος."
  },
  {
    "id": "p-405025",
    "offset": 2218,
    "text": "τά[φ]εν δὲ Διὸς υἱὸς ἔνδοθεν"
  },
  {
    "id": "p-77a7e7",
    "offset": 2248,
    "text": "κέαρ, κέλευσέ τε κατʼ οὖ-"
  },
  {
    "id": "p-954e41",
    "offset": 2275,
    "text": "ρον ἴσχεν εὐδαίδαλον"
  },
  {
    "id": "p-dbde1f",
    "offset": 2297,
    "text": "νᾶα· μοῖρα δʼ ἑτέραν ἐπόρσυνʼ ὁδόν."
  },
  {
    "id": "p-9aff13",
    "offset": 2334,
    "text": "ἵετο δʼ ὠκύπομπον δόρυ· σόει"
  },
  {
    "id": "p-6852a9",
    "offset": 2364,
    "text": "νιν βορεὰς ἐξόπιν πνέουσʼ ἀήτα·"
  },
  {
    "id": "p-d76ea1",
    "offset": 2397,
    "text": "τρέσσαν δʼ Ἀθαναίων"
  },
  {
    "id": "p-dd9900",
    "offset": 2418,
    "text": "ἠϊθ έω ν πᾶν γένος, ἐπεὶ"
  },
  {
    "id": "p-2e5206",
    "offset": 2444,
    "text": "ἥρως θόρεν πόντονδε, κα-"
  },
  {
    "id": "p-1ae9e7",
    "offset": 2470,
    "text": "τὰ λειρίων τʼ ὀμμάτων δά-"
  },
  {
    "id": "p-413811",
    "offset": 2497,
    "text": "κρυ χ έο ν, βαρεῖαν ἐπιδέγμενοι ἀνάγκαν·"
  },
  {
    "id": "p-1441e3",
    "offset": 2539,
    "text": "φέρον δὲ δελφῖνες ἁλι-"
  },
  {
    "id": "p-872273",
    "offset": 2563,
    "text": "ναιέται μέγαν θοῶς"
  },
  {
    "id": "p-03d53b",
    "offset": 2583,
    "text": "Θησέα πατρὸς ἱππί-"
  },
  {
    "id": "p-f6f0af",
    "offset": 2603,
    "text": "ου δόμον, μέγαρόν τε θεῶν"
  },
  {
    "id": "p-4da267",
    "offset": 2630,
    "text": "μόλεν· τόθι κλυτὰς ἰδὼν"
  },
  {
    "id": "p-1fa88b",
    "offset": 2655,
    "text": "ἔδεισʼ ὀλβίοιο Νη-"
  },
  {
    "id": "p-3ffa5a",
    "offset": 2675,
    "text": "ρέος κόρας· ἀπὸ γὰρ ἀγλα-"
  },
  {
    "id": "p-be695d",
    "offset": 2702,
    "text": "ῶν λάμπε γυίων σέλας"
  },
  {
    "id": "p-c2b66f",
    "offset": 2724,
    "text": "ὧτε πυρός, ἀμφὶ χαίταις"
  },
  {
    "id": "p-46191c",
    "offset": 2749,
    "text": "δὲ χρυσεόπλοκοι"
  },
  {
    "id": "p-cfb722",
    "offset": 2766,
    "text": "δίνηντο ταινίαι· χορῷ δʼ ἔτερ-"
  },
  {
    "id": "p-77e413",
    "offset": 2798,
    "text": "πον κέαρ ὑγροῖσι ποσσίν·"
  },
  {
    "id": "p-1ee495",
    "offset": 2824,
    "text": "σεμνάν τε πατρὸς ἄλοχον φίλαν"
  },
  {
    "id": "p-74fb6c",
    "offset": 2855,
    "text": "ἴδε βοῶπιν ἐρατοῖ-"
  },
  {
    "id": "p-48f468",
    "offset": 2875,
    "text": "σιν Ἀμφιτρίταν δόμοις·"
  },
  {
    "id": "p-1fed57",
    "offset": 2899,
    "text": "ἅ νιν ἀμφέβαλεν αἰόλαν πορφύραν,"
  },
  {
    "id": "p-00d1fe",
    "offset": 2933,
    "text": "κόμαισί τʼ ἐπέθηκεν οὔλαις"
  },
  {
    "id": "p-07d631",
    "offset": 2961,
    "text": "ἀμεμφέα πλόκον,"
  },
  {
    "id": "p-da619c",
    "offset": 2978,
    "text": "τόν ποτέ ϝοι ἐν γάμῳ"
  },
  {
    "id": "p-ea9b7d",
    "offset": 3000,
    "text": "δῶκε δόλιος Ἀφροδίτα ῥόδοις ἐρεμνόν."
  },
  {
    "id": "p-cf30a1",
    "offset": 3038,
    "text": "ἄπιστον ὅ τι δαίμονες"
  },
  {
    "id": "p-c927e0",
    "offset": 3061,
    "text": "θ\nέω\nσιν οὐδὲν φρενοάραις βροτοῖς·"
  },
  {
    "id": "p-b24f4c",
    "offset": 3097,
    "text": "νᾶα παρὰ λεπτόπρυμνον φάνη· φεῦ,"
  },
  {
    "id": "p-0e6c8a",
    "offset": 3131,
    "text": "οἵαισιν ἐν φροντίσι Κνώσιον"
  },
  {
    "id": "p-eb3cfa",
    "offset": 3160,
    "text": "ἔσχασεν στραταγέταν, ἐπεὶ"
  },
  {
    "id": "p-89f4e8",
    "offset": 3187,
    "text": "μόλʼ ἀδίαντος ἐξ ἁλὸς"
  },
  {
    "id": "p-bd6f63",
    "offset": 3210,
    "text": "θαῦμα πάντεσσι, λάμ-"
  },
  {
    "id": "p-97b8e1",
    "offset": 3232,
    "text": "πε δʼ ἀμφὶ γυίοις θεῶν δῶρʼ, ἀγλαό-"
  },
  {
    "id": "p-59a062",
    "offset": 3269,
    "text": "θρονοί τε κοῦραι σὺν εὐ-"
  },
  {
    "id": "p-783d12",
    "offset": 3295,
    "text": "θυμία νεοκτίτῳ"
  },
  {
    "id": "p-60412f",
    "offset": 3311,
    "text": "ὠλόλυξαν, ἔ-"
  },
  {
    "id": "p-d7728a",
    "offset": 3325,
    "text": "κλαγεν δὲ πόντος· ἠΐθ εο ι δʼ ἐγγύθεν"
  },
  {
    "id": "p-798f29",
    "offset": 3364,
    "text": "νέοι παιάνιξαν ἐρατᾷ ϝοπί."
  },
  {
    "id": "p-ae5be2",
    "offset": 3392,
    "text": "Δάλιε, χοροῖσι Κηΐων"
  },
  {
    "id": "p-88e419",
    "offset": 3414,
    "text": "φρένα ἰανθεὶς"
  },
  {
    "id": "p-56cae6",
    "offset": 3429,
    "text": "ὄπαζε θ εό πομπον ἐσθλῶν τύχαν."
  }
]