[
  {
    "id": "p-2760ef",
    "offset": 0,
    "text": "ἔστιν ἀνθρώποις ἀνέμων ὅτε πλείστα"
  },
  {
    "id": "p-44737b",
    "offset": 36,
    "text": "χρῆσις, ἔστιν δʼ οὐρανίων ὑδάτων,"
  },
  {
    "id": "p-72299d",
    "offset": 71,
    "text": "ὀμβρίων παίδων νεφέλας."
  },
  {
    "id": "p-06ed9e",
    "offset": 96,
    "text": "εἰ δὲ σὺν πόνῳ τις εὖ πράσσοι, μελιγάρυες ὕμνοι"
  },
  {
    "id": "p-6263b7",
    "offset": 145,
    "text": "ὑστέρων ἀρχὰ λόγων"
  },
  {
    "id": "p-cf698a",
    "offset": 165,
    "text": "τέλλεται καὶ πιστὸν ὅρκιον μεγάλαις ἀρεταῖς."
  },
  {
    "id": "p-642991",
    "offset": 211,
    "text": "ἀφθόνητος δʼ αἶνος Ὀλυμπιονίκαις"
  },
  {
    "id": "p-17b71d",
    "offset": 245,
    "text": "οὗτος ἄγκειται. τὰ μὲν ἁμετέρα"
  },
  {
    "id": "p-006581",
    "offset": 277,
    "text": "γλῶσσα ποιμαίνειν ἐθέλει·"
  },
  {
    "id": "p-8e73f2",
    "offset": 304,
    "text": "ἐκ θεοῦ δʼ ἀνὴρ σοφαῖς ἀνθεῖ πραπίδεσσιν ὁμοίως."
  },
  {
    "id": "p-60564c",
    "offset": 354,
    "text": "ἴσθι νῦν, Ἀρχεστράτου"
  },
  {
    "id": "p-9c5dd4",
    "offset": 377,
    "text": "παῖ, τεᾶς, Ἁγησίδαμε, πυγμαχίας ἕνεκεν"
  },
  {
    "id": "p-76d5a6",
    "offset": 417,
    "text": "κόσμον ἐπὶ στεφάνῳ χρυσέας ἐλαίας"
  },
  {
    "id": "p-8f5595",
    "offset": 452,
    "text": "ἁδυμελῆ κελαδήσω,"
  },
  {
    "id": "p-d65147",
    "offset": 471,
    "text": "Ζεφυρίων, Λοκρῶν γενεὰν ἀλέγων."
  },
  {
    "id": "p-2f2d7d",
    "offset": 504,
    "text": "ἔνθα συγκωμάξατʼ· ἐγγυάσομαι"
  },
  {
    "id": "p-14e2ad",
    "offset": 534,
    "text": "ὔμμιν, ὦ Μοῖσαι, φυγόξενον στρατὸν"
  },
  {
    "id": "p-17132e",
    "offset": 570,
    "text": "μηδʼ ἀπείρατον καλῶν,"
  },
  {
    "id": "p-4f002d",
    "offset": 593,
    "text": "ἀκρόσοφον δὲ καὶ αἰχματὰν ἀφίξεσθαι. τὸ γὰρ"
  },
  {
    "id": "p-555786",
    "offset": 638,
    "text": "ἐμφυὲς οὔτʼ αἴθων ἀλώπηξ"
  },
  {
    "id": "p-52f738",
    "offset": 664,
    "text": "οὔτʼ ἐρίβρομοι λέοντες διαλλάξαντο ἦθος."
  }
]