[
  {
    "id": "p-02b116",
    "offset": 0,
    "text": "τρισολυμπιονίκαν"
  },
  {
    "id": "p-8fee28",
    "offset": 18,
    "text": "ἐπαινέων οἶκον ἅμερον ἀστοῖς,"
  },
  {
    "id": "p-1e4470",
    "offset": 49,
    "text": "ξένοισι δὲ θεράποντα, γνώσομαι"
  },
  {
    "id": "p-a2d9fc",
    "offset": 81,
    "text": "τὰν ὀλβίαν Κόρινθον, Ἰσθμίου"
  },
  {
    "id": "p-16bda9",
    "offset": 111,
    "text": "πρόθυρον Ποτειδᾶνος, ἀγλαόκουρον."
  },
  {
    "id": "p-d22440",
    "offset": 146,
    "text": "ἐν τᾷ γὰρ Εὐνομία ναίει, κασίγνηταί τε, βάθρον πολίων ἀσφαλές,"
  },
  {
    "id": "p-be721e",
    "offset": 210,
    "text": "Δίκα καὶ ὁμότροφος Εἰρήνα, ταμίαι ἀνδράσι πλούτου,"
  },
  {
    "id": "p-aa9bbc",
    "offset": 262,
    "text": "χρύσεαι παῖδες εὐβούλου Θέμιτος·"
  },
  {
    "id": "p-ce9d12",
    "offset": 296,
    "text": "ἐθέλοντι δʼ ἀλέξειν"
  },
  {
    "id": "p-2547b4",
    "offset": 317,
    "text": "Ὕβριν, Κόρου ματέρα θρασύμυθον."
  },
  {
    "id": "p-c978ef",
    "offset": 350,
    "text": "ἔχω καλά τε φράσαι, τόλμα τέ μοι"
  },
  {
    "id": "p-f1ae3b",
    "offset": 384,
    "text": "εὐθεῖα γλῶσσαν ὀρνύει λέγειν."
  },
  {
    "id": "p-528a99",
    "offset": 415,
    "text": "ἄμαχον δὲ κρύψαι τὸ συγγενὲς ἦθος."
  },
  {
    "id": "p-a0a4fd",
    "offset": 451,
    "text": "ὔμμιν δέ, παῖδες Ἀλάτα, πολλὰ μὲν νικαφόρον ἀγλαΐαν ὤπασαν"
  },
  {
    "id": "p-4283b1",
    "offset": 511,
    "text": "ἄκραις ἀρεταῖς ὑπερελθόντων ἱεροῖς ἐν ἀέθλοις,"
  },
  {
    "id": "p-477e8f",
    "offset": 559,
    "text": "πολλὰ δʼ ἐν καρδίαις ἀνδρῶν ἔβαλον"
  },
  {
    "id": "p-bfc823",
    "offset": 595,
    "text": "ὧραι πολυάνθεμοι ἀρχαῖα σοφίσμαθʼ. ἅπαν δʼ εὑρόντος ἔργον."
  },
  {
    "id": "p-1753fa",
    "offset": 655,
    "text": "ταὶ Διωνύσου πόθεν ἐξέφανεν"
  },
  {
    "id": "p-4d0bf7",
    "offset": 684,
    "text": "σὺν βοηλάτᾳ χάριτες διθυράμβῳ·"
  },
  {
    "id": "p-6b8aa8",
    "offset": 716,
    "text": "τίς γὰρ ἱππείοις ἐν ἔντεσσιν μέτρα,"
  },
  {
    "id": "p-f75c96",
    "offset": 753,
    "text": "ἢ θεῶν ναοῖσιν οἰωνῶν βασιλέα δίδυμον"
  },
  {
    "id": "p-2c6c81",
    "offset": 792,
    "text": "ἐπέθηκʼ; ἐν δὲ Μοῖσʼ ἁδύπνοος,"
  },
  {
    "id": "p-f0e648",
    "offset": 824,
    "text": "ἐν δʼ Ἄρης ἀνθεῖ νέων οὐλίαις αἰχμαῖσιν ἀνδρῶν."
  },
  {
    "id": "p-bd592f",
    "offset": 873,
    "text": "ὕπατʼ εὐρὺ ἀνάσσων"
  },
  {
    "id": "p-85777e",
    "offset": 893,
    "text": "Ὀλυμπίας, ἀφθόνητος ἔπεσσιν"
  },
  {
    "id": "p-fcf680",
    "offset": 922,
    "text": "γένοιο χρόνον ἅπαντα, Ζεῦ πάτερ,"
  },
  {
    "id": "p-63e24f",
    "offset": 956,
    "text": "καὶ τόνδε λαὸν ἀβλαβῆ νέμων"
  },
  {
    "id": "p-3d9bc1",
    "offset": 985,
    "text": "Ξενοφῶντος εὔθυνε δαίμονος οὖρον·"
  },
  {
    "id": "p-36f2cb",
    "offset": 1020,
    "text": "δέξαι τέ οἱ στεφάνων ἐγκώμιον τεθμόν, τὸν ἄγει πεδίων ἐκ Πίσας,"
  },
  {
    "id": "p-a4a02f",
    "offset": 1085,
    "text": "πεντάθλῳ ἅμα σταδίου νικῶν δρόμον· ἀντεβόλησεν"
  },
  {
    "id": "p-df3fd0",
    "offset": 1133,
    "text": "τῶν ἀνὴρ θνατὸς οὔπω τις πρότερον."
  },
  {
    "id": "p-09c9b3",
    "offset": 1169,
    "text": "δύο δʼ αὐτὸν ἔρεψαν"
  },
  {
    "id": "p-fd8ccf",
    "offset": 1190,
    "text": "πλόκοι σελίνων ἐν Ἰσθμιάδεσσιν"
  },
  {
    "id": "p-d71e0a",
    "offset": 1222,
    "text": "φανέντα· Νέμεά τʼ οὐκ ἀντιξοεῖ."
  },
  {
    "id": "p-9311d8",
    "offset": 1255,
    "text": "πατρὸς δὲ Θεσσαλοῦ ἐπʼ Ἀλφεοῦ"
  },
  {
    "id": "p-a84cc7",
    "offset": 1286,
    "text": "ῥεέθροισιν αἴγλα ποδῶν ἀνάκειται,"
  },
  {
    "id": "p-460c6e",
    "offset": 1321,
    "text": "Πυθοῖ τʼ ἔχει σταδίου τιμὰν διαύλου θʼ ἁλίῳ ἀμφʼ ἑνί, μηνός τέ οἱ"
  },
  {
    "id": "p-0b5302",
    "offset": 1388,
    "text": "τωὐτοῦ κρανααῖς ἐνʼ Ἀθάναισι τρία ἔργα ποδαρκὴς"
  },
  {
    "id": "p-ee6488",
    "offset": 1437,
    "text": "ἅμερα θῆκε κάλλιστʼ ἀμφὶ κόμαις,"
  },
  {
    "id": "p-eb6e27",
    "offset": 1471,
    "text": "Ἑλλώτια δʼ ἑπτάκις· ἐν δʼ ἀμφιάλοισι Ποτειδᾶνος τεθμοῖσιν"
  },
  {
    "id": "p-9d7a4c",
    "offset": 1530,
    "text": "Πτοιοδώρῳ σὺν πατρὶ μακρότεραι"
  },
  {
    "id": "p-d95dcd",
    "offset": 1562,
    "text": "Τερψίᾳ θʼ ἕψοντʼ Ἐριτίμῳ τʼ ἀοιδαί."
  },
  {
    "id": "p-b29abd",
    "offset": 1599,
    "text": "ὅσσα τʼ ἐν Δελφοῖσιν ἀριστεύσατε"
  },
  {
    "id": "p-eef376",
    "offset": 1633,
    "text": "ἠδὲ χόρτοις ἐν λέοντος, δηρίομαι πολέσιν"
  },
  {
    "id": "p-7b3da6",
    "offset": 1675,
    "text": "περὶ πλήθει καλῶν, ὡς μὰν σαφὲς"
  },
  {
    "id": "p-76eb56",
    "offset": 1708,
    "text": "οὐκ ἂν εἰδείην λέγειν ποντιᾶν ψάφων ἀριθμόν."
  },
  {
    "id": "p-b6e970",
    "offset": 1754,
    "text": "ἕπεται δʼ ἐν ἑκάστῳ"
  },
  {
    "id": "p-dc1e3e",
    "offset": 1775,
    "text": "μέτρον· νοῆσαι δὲ καιρὸς ἄριστος."
  },
  {
    "id": "p-5b9e15",
    "offset": 1810,
    "text": "ἐγὼ δὲ ἴδιος ἐν κοινῷ σταλεὶς"
  },
  {
    "id": "p-2cce24",
    "offset": 1841,
    "text": "μῆτίν τε γαρύων παλαιγόνων"
  },
  {
    "id": "p-b36cab",
    "offset": 1869,
    "text": "πόλεμόν τʼ ἐν ἡρωΐαις ἀρεταῖσιν"
  },
  {
    "id": "p-02b883",
    "offset": 1902,
    "text": "οὐ ψεύσομʼ ἀμφὶ Κορίνθῳ, Σίσυφον μὲν πυκνότατον παλάμαις ὡς θεόν,"
  },
  {
    "id": "p-351421",
    "offset": 1969,
    "text": "καὶ τὰν πατρὸς ἀντία Μήδειαν θεμέναν γάμον αὐτᾷ,"
  },
  {
    "id": "p-8345ab",
    "offset": 2019,
    "text": "ναῒ σώτειραν Ἀργοῖ καὶ προπόλοις."
  },
  {
    "id": "p-606236",
    "offset": 2054,
    "text": "τὰ δὲ καί ποτʼ ἐν ἀλκᾷ"
  },
  {
    "id": "p-b007fe",
    "offset": 2078,
    "text": "πρὸ Δαρδάνου τειχέων ἐδόκησαν"
  },
  {
    "id": "p-478626",
    "offset": 2109,
    "text": "ἐπʼ ἀμφότερα μαχᾶν τάμνειν τέλος,"
  },
  {
    "id": "p-b01cb0",
    "offset": 2144,
    "text": "τοὶ μὲν γένει φίλῳ σὺν Ἀτρέος"
  },
  {
    "id": "p-a442bd",
    "offset": 2175,
    "text": "Ἑλέναν κομίζοντες, οἱ δʼ ἀπὸ πάμπαν"
  },
  {
    "id": "p-870477",
    "offset": 2212,
    "text": "εἴργοντες· ἐκ Λυκίας δὲ Γλαῦκον ἐλθόντα τρόμεον Δαναοί. τοῖσι μὲν"
  },
  {
    "id": "p-376f6d",
    "offset": 2279,
    "text": "ἐξεύχετʼ ἐν ἄστεϊ Πειράνας σφετέρου πατρὸς ἀρχὰν"
  },
  {
    "id": "p-a7a815",
    "offset": 2329,
    "text": "καὶ βαθὺν κλᾶρον ἔμμεν καὶ μέγαρον·"
  },
  {
    "id": "p-0e3373",
    "offset": 2366,
    "text": "ὃς τᾶς ὀφιώδεος υἱόν ποτε Γοργόνος ἦ πόλλʼ ἀμφὶ κρουνοῖς"
  },
  {
    "id": "p-2e353d",
    "offset": 2424,
    "text": "Πάγασον ζεῦξαι ποθέων ἔπαθεν,"
  },
  {
    "id": "p-7b87ff",
    "offset": 2455,
    "text": "πρίν γέ οἱ χρυσάμπυκα κούρα χαλινὸν"
  },
  {
    "id": "p-234ce8",
    "offset": 2492,
    "text": "Παλλὰς ἤνεγκʼ· ἐξ ὀνείρου δʼ αὐτίκα"
  },
  {
    "id": "p-1bad24",
    "offset": 2529,
    "text": "ἦν ὕπαρ· φώνασε δʼ· εὕδεις, Αἰολίδα βασιλεῦ;"
  },
  {
    "id": "p-3c11a7",
    "offset": 2575,
    "text": "ἄγε φίλτρον τόδʼ ἵππειον δέκευ,"
  },
  {
    "id": "p-dd50a3",
    "offset": 2608,
    "text": "καὶ Δαμαίῳ νιν θύων ταῦρον ἀργᾶντα πατρὶ δεῖξον."
  },
  {
    "id": "p-efb14b",
    "offset": 2658,
    "text": "κυαναιγὶς ἐν ὄρφνᾳ"
  },
  {
    "id": "p-f093c9",
    "offset": 2678,
    "text": "κνώσσοντί οἱ παρθένος τόσα εἰπεῖν"
  },
  {
    "id": "p-4a4937",
    "offset": 2713,
    "text": "ἔδοξεν· ἀνὰ δʼ ἐπᾶλτʼ ὀρθῷ ποδί."
  },
  {
    "id": "p-d0c45f",
    "offset": 2747,
    "text": "παρκείμενον δὲ συλλαβὼν τέρας,"
  },
  {
    "id": "p-0938fb",
    "offset": 2779,
    "text": "ἐπιχώριον μάντιν ἄσμενος εὗρεν,"
  },
  {
    "id": "p-6f1288",
    "offset": 2812,
    "text": "δεῖξέν τε Κοιρανίδᾳ πᾶσαν τελευτὰν πράγματος, ὥς τʼ ἀνὰ βωμῷ θεᾶς"
  },
  {
    "id": "p-e08894",
    "offset": 2879,
    "text": "κοιτάξατο νύκτʼ ἀπὸ κείνου χρήσιος. ὥς τέ οἱ αὐτὰ"
  },
  {
    "id": "p-2fb0a2",
    "offset": 2930,
    "text": "Ζηνὸς ἐγχεικεραύνου παῖς ἔπορεν"
  },
  {
    "id": "p-3c63cb",
    "offset": 2963,
    "text": "δαμασίφρονα χρυσόν."
  },
  {
    "id": "p-8d0f3f",
    "offset": 2984,
    "text": "ἐνυπνίῳ δʼ ᾇ τάχιστα πιθέσθαι"
  },
  {
    "id": "p-4c2e60",
    "offset": 3015,
    "text": "κελήσατό μιν, ὅταν δʼ εὐρυσθενεῖ"
  },
  {
    "id": "p-b92326",
    "offset": 3049,
    "text": "καρταίποδʼ ἀναρύῃ Γαιαόχῳ,"
  },
  {
    "id": "p-802a7f",
    "offset": 3077,
    "text": "θέμεν Ἱππίᾳ βωμὸν εὐθὺς Ἀθάνᾳ."
  },
  {
    "id": "p-926877",
    "offset": 3109,
    "text": "τελεῖ δὲ θεῶν δύναμις καὶ τὰν παρʼ ὅρκον καὶ παρὰ ἐλπίδα κούφαν κτίσιν."
  },
  {
    "id": "p-bcce66",
    "offset": 3182,
    "text": "ἤτοι καὶ ὁ καρτερὸς ὁρμαίνων ἕλε Βελλεροφόντας,"
  },
  {
    "id": "p-cc547c",
    "offset": 3231,
    "text": "φάρμακον πραῢ τείνων ἀμφὶ γένυι,"
  },
  {
    "id": "p-37805d",
    "offset": 3265,
    "text": "ἵππον πτερόεντʼ· ἀναβὰς δʼ εὐθὺς ἐνόπλια χαλκωθεὶς ἔπαιζεν."
  },
  {
    "id": "p-e6603b",
    "offset": 3326,
    "text": "σὺν δὲ κείνῳ καί ποτʼ Ἀμαζονίδων"
  },
  {
    "id": "p-118bc7",
    "offset": 3360,
    "text": "αἰθέρος ψυχρῶν ἀπὸ κόλπων ἐρήμου"
  },
  {
    "id": "p-4750a0",
    "offset": 3394,
    "text": "τοξόταν βάλλων γυναικεῖον στρατόν,"
  },
  {
    "id": "p-9b1f3e",
    "offset": 3430,
    "text": "καὶ Χίμαιραν πῦρ πνέοισαν καὶ Σολύμους ἔπεφνεν."
  },
  {
    "id": "p-57de30",
    "offset": 3479,
    "text": "διασωπάσομαί οἱ μόρον ἐγώ·"
  },
  {
    "id": "p-a84005",
    "offset": 3507,
    "text": "τὸν δʼ ἐν Οὐλύμπῳ φάτναι Ζηνὸς ἀρχαῖαι δέκονται."
  },
  {
    "id": "p-9f66f7",
    "offset": 3557,
    "text": "ἐμὲ δʼ εὐθὺν ἀκόντων"
  },
  {
    "id": "p-1a0ddc",
    "offset": 3579,
    "text": "ἱέντα ῥόμβον παρὰ σκοπὸν οὐ χρὴ"
  },
  {
    "id": "p-5ce4bb",
    "offset": 3612,
    "text": "τὰ πολλὰ βέλεα καρτύνειν χεροῖν."
  },
  {
    "id": "p-007ff6",
    "offset": 3646,
    "text": "Μοίσαις γὰρ ἀγλαοθρόνοις ἑκὼν"
  },
  {
    "id": "p-1e106a",
    "offset": 3677,
    "text": "Ὀλιγαιθίδαισίν τʼ ἔβαν ἐπίκουρος."
  },
  {
    "id": "p-9ad92c",
    "offset": 3712,
    "text": "Ἰσθμοῖ τά τʼ ἐν Νεμέᾳ παύρῳ ἔπει θήσω φανέρʼ ἀθρόʼ, ἀλαθής τέ μοι"
  },
  {
    "id": "p-bbf845",
    "offset": 3779,
    "text": "ἔξορκος ἐπέσσεται ἑξηκοντάκι δὴ ἀμφοτέρωθεν"
  },
  {
    "id": "p-f07398",
    "offset": 3824,
    "text": "ἁδύγλωσσος βοὰ κάρυκος ἐσλοῦ."
  },
  {
    "id": "p-a82ebb",
    "offset": 3855,
    "text": "τὰ δʼ Ὀλυμπίᾳ αὐτῶν"
  },
  {
    "id": "p-8c331f",
    "offset": 3876,
    "text": "ἔοικεν ἤδη πάροιθε λελέχθαι·"
  },
  {
    "id": "p-c13975",
    "offset": 3906,
    "text": "τά τʼ ἐσσόμενα τότʼ ἂν φαίην σαφές·"
  },
  {
    "id": "p-4df95e",
    "offset": 3943,
    "text": "νῦν δʼ ἔλπομαι μέν, ἐν θεῷ γε μὰν"
  },
  {
    "id": "p-c63d47",
    "offset": 3978,
    "text": "τέλος· εἰ δὲ δαίμων γενέθλιος ἕρποι,"
  },
  {
    "id": "p-040e47",
    "offset": 4016,
    "text": "διʼ τοῦτʼ Ἐνυαλίῳ τʼ ἐκδώσομεν πράσσειν. τὰ δʼ ὑπʼ ὀφρύϊ Παρνασσίᾳ"
  },
  {
    "id": "p-b0782c",
    "offset": 4084,
    "text": "ἕξ· Ἄργεΐ θʼ ὅσσα καὶ ἐν Θήβαις, ὅσα τʼ Ἀρκάσιν ἀνάσσων"
  },
  {
    "id": "p-83481f",
    "offset": 4141,
    "text": "μαρτυρήσει Λυκαίου βωμὸς ἄναξ,"
  },
  {
    "id": "p-149210",
    "offset": 4173,
    "text": "Πέλλανά τε καὶ Σικυὼν καὶ Μέγαρʼ Αἰακιδᾶν τʼ εὐερκὲς ἄλσος,"
  },
  {
    "id": "p-f76ddf",
    "offset": 4234,
    "text": "ἅ τʼ Ἐλευσὶς καὶ λιπαρὰ Μαραθών,"
  },
  {
    "id": "p-d69155",
    "offset": 4268,
    "text": "ταί θʼ ὑπʼ Αἴτνας ὑψιλόφου καλλίπλουτοι"
  },
  {
    "id": "p-0dc870",
    "offset": 4309,
    "text": "πόλιες, ἅ τʼ Εὔβοια· καὶ πᾶσαν κατὰ"
  },
  {
    "id": "p-9ea097",
    "offset": 4346,
    "text": "Ἑλλάδʼ εὑρήσεις ἐρευνῶν μάσσονʼ ἢ ὡς ἰδέμεν."
  },
  {
    "id": "p-6cc60e",
    "offset": 4392,
    "text": "ἄνα, κούφοισιν ἐκνεῦσαι ποσίν·"
  },
  {
    "id": "p-ea3b53",
    "offset": 4424,
    "text": "Ζεῦ τέλειʼ, αἰδῶ δίδοι καὶ τύχαν τερπνῶν γλυκεῖαν."
  }
]