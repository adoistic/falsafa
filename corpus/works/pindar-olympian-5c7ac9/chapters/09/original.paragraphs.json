[
  {
    "id": "p-f2cb85",
    "offset": 0,
    "text": "τὸ μὲν Ἀρχιλόχου μέλος"
  },
  {
    "id": "p-27f8fc",
    "offset": 24,
    "text": "φωνᾶεν Ὀλυμπίᾳ, καλλίνικος ὁ τριπλόος κεχλαδώς,"
  },
  {
    "id": "p-924a5e",
    "offset": 73,
    "text": "ἄρκεσε Κρόνιον παρʼ ὄχθον ἁγεμονεῦσαι"
  },
  {
    "id": "p-7e2c28",
    "offset": 112,
    "text": "κωμάζοντι φίλοις Ἐφαρμόστῳ σὺν ἑταίροις·"
  },
  {
    "id": "p-f9cb68",
    "offset": 154,
    "text": "ἀλλὰ νῦν ἑκαταβόλων Μοισᾶν ἀπὸ τόξων"
  },
  {
    "id": "p-ac4ff8",
    "offset": 192,
    "text": "Δία τε φοινικοστερόπαν σεμνόν τʼ ἐπίνειμαι"
  },
  {
    "id": "p-702412",
    "offset": 236,
    "text": "ἀκρωτήριον Ἄλιδος"
  },
  {
    "id": "p-d286e4",
    "offset": 255,
    "text": "τοιοῖσδε βέλεσσιν,"
  },
  {
    "id": "p-bbe16f",
    "offset": 275,
    "text": "τὸ δή ποτε Λυδὸς ἥρως Πέλοψ"
  },
  {
    "id": "p-2953b3",
    "offset": 304,
    "text": "ἐξάρατο κάλλιστον ἕδνον Ἱπποδαμείας·"
  },
  {
    "id": "p-214bac",
    "offset": 342,
    "text": "πτερόεντα δʼ ἵει γλυκὺν"
  },
  {
    "id": "p-10e9a3",
    "offset": 367,
    "text": "Πυθώναδʼ ὀϊστόν· οὔτοι χαμαιπετέων λόγων ἐφάψεαι"
  },
  {
    "id": "p-67c8d0",
    "offset": 417,
    "text": "ἀνδρὸς ἀμφὶ παλαίσμασιν φόρμιγγʼ ἐλελίζων"
  },
  {
    "id": "p-5138aa",
    "offset": 460,
    "text": "κλεινᾶς ἐξ Ὀπόεντος· αἰνήσαις ἓ καὶ υἱόν,"
  },
  {
    "id": "p-1122a5",
    "offset": 503,
    "text": "ἃν Θέμις θυγάτηρ τέ οἱ σώτειρα λέλογχεν"
  },
  {
    "id": "p-4cbc73",
    "offset": 544,
    "text": "μεγαλόδοξος Εὐνομία, θάλλει δʼ ἀρεταῖσιν"
  },
  {
    "id": "p-dbecce",
    "offset": 586,
    "text": "σόν τε, Κασταλία, πάρα"
  },
  {
    "id": "p-5c4ff3",
    "offset": 610,
    "text": "Ἀλφεοῦ τε ῥέεθρον·"
  },
  {
    "id": "p-513463",
    "offset": 630,
    "text": "ὅθεν στεφάνων ἄωτοι κλυτὰν"
  },
  {
    "id": "p-96a020",
    "offset": 658,
    "text": "Λοκρῶν ἐπαείροντι ματέρʼ ἀγλαόδενδρον."
  },
  {
    "id": "p-623a9b",
    "offset": 698,
    "text": "ἐγὼ δέ τοι φίλαν πόλιν"
  },
  {
    "id": "p-407935",
    "offset": 722,
    "text": "μαλεραῖς ἐπιφλέγων ἀοιδαῖς,"
  },
  {
    "id": "p-6898fa",
    "offset": 751,
    "text": "καὶ ἀγάνορος ἵππου"
  },
  {
    "id": "p-16713b",
    "offset": 771,
    "text": "θᾶσσον καὶ ναὸς ὑποπτέρου παντᾷ"
  },
  {
    "id": "p-6fce99",
    "offset": 804,
    "text": "ἀγγελίαν πέμψω ταύταν,"
  },
  {
    "id": "p-66dbb5",
    "offset": 828,
    "text": "εἰ σύν τινι μοιριδίῳ παλάμᾳ"
  },
  {
    "id": "p-82d61e",
    "offset": 857,
    "text": "ἐξαίρετον Χαρίτων νέμομαι κᾶπον·"
  },
  {
    "id": "p-eca9c3",
    "offset": 891,
    "text": "κεῖναι γὰρ ὤπασαν τὰ τέρπνʼ· ἀγαθοὶ δὲ καὶ σοφοὶ κατὰ δαίμονʼ ἄνδρες"
  },
  {
    "id": "p-a2a000",
    "offset": 961,
    "text": "ἐγένοντʼ· ἐπεὶ ἀντία"
  },
  {
    "id": "p-0f245d",
    "offset": 983,
    "text": "πῶς ἂν τριόδοντος Ἡρακλέης σκύταλον τίναξε χερσίν,"
  },
  {
    "id": "p-55a04a",
    "offset": 1035,
    "text": "ἁνίκʼ ἀμφὶ Πύλον σταθεὶς ἤρειδε Ποσειδᾶν"
  },
  {
    "id": "p-a190a6",
    "offset": 1077,
    "text": "ἤρειδεν δέ νιν ἀργυρέῳ τόξῳ πολεμίζων"
  },
  {
    "id": "p-e1bf4f",
    "offset": 1116,
    "text": "Φοῖβος, οὐδʼ Ἀΐδας ἀκινήταν ἔχε ῥάβδον,"
  },
  {
    "id": "p-22661a",
    "offset": 1157,
    "text": "βρότεα σώμαθʼ ᾇ κατάγει κοίλαν πρὸς ἀγυιὰν"
  },
  {
    "id": "p-2c1e51",
    "offset": 1201,
    "text": "θνᾳσκόντων; ἀπό μοι λόγον"
  },
  {
    "id": "p-dc27dc",
    "offset": 1228,
    "text": "τοῦτον, στόμα, ῥῖψον·"
  },
  {
    "id": "p-908e99",
    "offset": 1251,
    "text": "ἐπεὶ τό γε λοιδορῆσαι θεοὺς"
  },
  {
    "id": "p-05a672",
    "offset": 1280,
    "text": "ἐχθρὰ σοφία, καὶ τὸ καυχᾶσθαι παρὰ καιρὸν"
  },
  {
    "id": "p-239de4",
    "offset": 1323,
    "text": "μανίαισιν ὑποκρέκει."
  },
  {
    "id": "p-7cea86",
    "offset": 1345,
    "text": "μὴ νῦν λαλάγει τὰ τοιαῦτʼ· ἔα πόλεμον μάχαν τε πᾶσαν"
  },
  {
    "id": "p-68dc0f",
    "offset": 1399,
    "text": "χωρὶς ἀθανάτων· φέροις δὲ Πρωτογενείας"
  },
  {
    "id": "p-e986af",
    "offset": 1439,
    "text": "ἄστει γλῶσσαν, ἵνʼ αἰολοβρόντα Διὸς αἴσᾳ"
  },
  {
    "id": "p-8bba9b",
    "offset": 1481,
    "text": "Πύρρα Δευκαλίων τε Παρνασοῦ καταβάντε"
  },
  {
    "id": "p-044413",
    "offset": 1520,
    "text": "δόμον ἔθεντο πρῶτον, ἄτερ δʼ εὐνᾶς ὁμόδαμον"
  },
  {
    "id": "p-15a70c",
    "offset": 1565,
    "text": "κτισσάσθαν λίθινον γόνον·"
  },
  {
    "id": "p-6068e3",
    "offset": 1592,
    "text": "λαοὶ δʼ ὀνύμασθεν."
  },
  {
    "id": "p-2ea5a7",
    "offset": 1612,
    "text": "ἔγειρʼ ἐπέων σφιν οἶμον λιγύν,"
  },
  {
    "id": "p-8cd430",
    "offset": 1644,
    "text": "αἴνει δὲ παλαιὸν μὲν οἶνον, ἄνθεα δʼ ὕμνων"
  },
  {
    "id": "p-841a35",
    "offset": 1688,
    "text": "νεωτέρων. λέγοντι μὰν"
  },
  {
    "id": "p-091bf3",
    "offset": 1711,
    "text": "χθόνα μὲν κατακλύσαι μέλαιναν"
  },
  {
    "id": "p-b87a01",
    "offset": 1742,
    "text": "ὕδατος σθένος, ἀλλὰ"
  },
  {
    "id": "p-9bebb9",
    "offset": 1763,
    "text": "Ζηνὸς τέχναις ἀνάπωτιν ἐξαίφνας"
  },
  {
    "id": "p-a13ef2",
    "offset": 1796,
    "text": "ἄντλον ἑλεῖν. κείνων ἔσαν"
  },
  {
    "id": "p-84fb46",
    "offset": 1823,
    "text": "χαλκάσπιδες ὑμέτεροι πρόγονοι"
  },
  {
    "id": "p-75a20a",
    "offset": 1854,
    "text": "ἀρχᾶθεν Ἰαπετιονίδος φύτλας"
  },
  {
    "id": "p-e67fef",
    "offset": 1883,
    "text": "κοῦροι κορᾶν καὶ φερτάτων Κρονιδᾶν, ἐγχώριοι βασιλῆες αἰεί,"
  },
  {
    "id": "p-39103d",
    "offset": 1944,
    "text": "πρὶν Ὀλύμπιος ἁγεμὼν"
  },
  {
    "id": "p-4bd325",
    "offset": 1966,
    "text": "θύγατρʼ ἀπὸ γᾶς Ἐπειῶν Ὀπόεντος ἀναρπάσαις, ἕκαλος"
  },
  {
    "id": "p-dad0a1",
    "offset": 2018,
    "text": "μίχθη Μαιναλίαισιν ἐν δειραῖς, καὶ ἔνεικεν"
  },
  {
    "id": "p-20925d",
    "offset": 2062,
    "text": "Λοκρῷ, μὴ καθέλοι μιν αἰὼν πότμον ἐφάψαις"
  },
  {
    "id": "p-c9622b",
    "offset": 2105,
    "text": "ὀρφανὸν γενεᾶς. ἔχεν δὲ σπέρμα μέγιστον"
  },
  {
    "id": "p-19cd5c",
    "offset": 2146,
    "text": "ἄλοχος, εὐφράνθη τε ἰδὼν ἥρως θετὸν υἱόν,"
  },
  {
    "id": "p-0cabd8",
    "offset": 2189,
    "text": "μάτρωος δʼ ἐκάλεσσέ νιν"
  },
  {
    "id": "p-c00154",
    "offset": 2214,
    "text": "ἰσώνυμον ἔμμεν,"
  },
  {
    "id": "p-fc7ff9",
    "offset": 2231,
    "text": "ὑπέρφατον ἄνδρα μορφᾷ τε καὶ"
  },
  {
    "id": "p-ebf1b3",
    "offset": 2261,
    "text": "ἔργοισι. πόλιν δʼ ὤπασεν λαόν τε διαιτᾶν."
  },
  {
    "id": "p-59a552",
    "offset": 2304,
    "text": "ἀφίκοντο δέ οἱ ξένοι,"
  },
  {
    "id": "p-a1ce8b",
    "offset": 2327,
    "text": "ἔκ τʼ Ἄργεος ἔκ τε Θηβᾶν, οἱ δʼ Ἀρκάδες, οἱ δὲ καὶ Πισᾶται·"
  },
  {
    "id": "p-aa643b",
    "offset": 2388,
    "text": "υἱὸν δʼ Ἄκτορος ἐξόχως τίμασεν ἐποίκων"
  },
  {
    "id": "p-e4f5ce",
    "offset": 2428,
    "text": "Αἰγίνας τε Μενοίτιον· τοῦ παῖς ἅμʼ Ἀτρείδαις"
  },
  {
    "id": "p-e98504",
    "offset": 2474,
    "text": "Τεύθραντος πεδίον μολὼν ἔστα σὺν Ἀχιλλεῖ"
  },
  {
    "id": "p-a3aeac",
    "offset": 2516,
    "text": "μόνος, ὅτʼ ἀλκᾶντας Δαναοὺς τρέψαις ἁλίαισιν"
  },
  {
    "id": "p-7d822e",
    "offset": 2562,
    "text": "πρύμναις Τήλεφος ἔμβαλεν·"
  },
  {
    "id": "p-a568ed",
    "offset": 2589,
    "text": "ὥστʼ ἔμφρονι δεῖξαι"
  },
  {
    "id": "p-c885e0",
    "offset": 2610,
    "text": "μαθεῖν Πατρόκλου βιατὰν νόον."
  },
  {
    "id": "p-28a6f7",
    "offset": 2641,
    "text": "ἐξ οὗ Θέτιος γόνος οὐλίῳ νιν ἐν Ἄρει"
  },
  {
    "id": "p-2e95de",
    "offset": 2679,
    "text": "παραγορεῖτο μή ποτε"
  },
  {
    "id": "p-71b317",
    "offset": 2700,
    "text": "σφετέρας ἄτερθε ταξιοῦσθαι"
  },
  {
    "id": "p-8bf9e1",
    "offset": 2728,
    "text": "δαμασιμβρότου αἰχμᾶς."
  },
  {
    "id": "p-58f8b2",
    "offset": 2751,
    "text": "εἴην εὑρησιεπὴς ἀναγεῖσθαι"
  },
  {
    "id": "p-c8ba4f",
    "offset": 2779,
    "text": "πρόσφορος ἐν Μοισᾶν δίφρῳ·"
  },
  {
    "id": "p-155407",
    "offset": 2807,
    "text": "τόλμα δὲ καὶ ἀμφιλαφὴς δύναμις"
  },
  {
    "id": "p-4b118d",
    "offset": 2839,
    "text": "ἕσποιτο. προξενίᾳ δʼ ἀρετᾷ τʼ ἦλθον"
  },
  {
    "id": "p-6a787d",
    "offset": 2876,
    "text": "τιμάορος Ἰσθμίαισι Λαμπρομάχου μίτραις, ὅτʼ ἀμφότεροι κράτησαν"
  },
  {
    "id": "p-9294d7",
    "offset": 2940,
    "text": "μίαν ἔργον ἀνʼ ἁμέραν."
  },
  {
    "id": "p-95e233",
    "offset": 2964,
    "text": "ἄλλαι δὲ δύʼ ἐν Κορίνθου πύλαις ἐγένοντʼ ἔπειτα χάρμαι,"
  },
  {
    "id": "p-c2d783",
    "offset": 3021,
    "text": "ταὶ δὲ καὶ Νεμέας Ἐφαρμόστῳ κατὰ κόλπον·"
  },
  {
    "id": "p-0005c2",
    "offset": 3063,
    "text": "Ἄργει τʼ ἔσχεθε κῦδος ἀνδρῶν, παῖς δʼ ἐν Ἀθάναις,"
  },
  {
    "id": "p-610dcd",
    "offset": 3114,
    "text": "οἷον δʼ ἐν Μαραθῶνι συλαθεὶς ἀγενείων"
  },
  {
    "id": "p-4bc094",
    "offset": 3153,
    "text": "μένεν ἀγῶνα πρεσβυτέρων ἀμφʼ ἀργυρίδεσσιν·"
  },
  {
    "id": "p-f9708d",
    "offset": 3197,
    "text": "φῶτας δʼ ὀξυρεπεῖ δόλῳ"
  },
  {
    "id": "p-5f635a",
    "offset": 3221,
    "text": "ἀπτῶτι δαμάσσαις"
  },
  {
    "id": "p-4c6a21",
    "offset": 3239,
    "text": "διήρχετο κύκλον ὅσσᾳ βοᾷ,"
  },
  {
    "id": "p-66a623",
    "offset": 3266,
    "text": "ὡραῖος ἐὼν καὶ καλὸς κάλλιστά τε ῥέξαις."
  },
  {
    "id": "p-28cbfe",
    "offset": 3308,
    "text": "τὰ δὲ Παρρασίῳ στρατῷ"
  },
  {
    "id": "p-a2a2de",
    "offset": 3331,
    "text": "θαυμαστὸς ἐὼν φάνη Ζηνὸς ἀμφὶ πανάγυριν Λυκαίου,"
  },
  {
    "id": "p-41c9f6",
    "offset": 3381,
    "text": "καὶ ψυχρᾶν ὁπότʼ εὐδιανὸν φάρμακον αὐρᾶν"
  },
  {
    "id": "p-cb8436",
    "offset": 3423,
    "text": "Πελλάνᾳ φέρε· σύνδικος δʼ αὐτῷ Ἰολάου"
  },
  {
    "id": "p-02575a",
    "offset": 3462,
    "text": "τύμβος εἰναλία τʼ Ἐλευσὶς ἀγλαΐαισιν."
  },
  {
    "id": "p-69383a",
    "offset": 3501,
    "text": "τὸ δὲ φυᾷ κράτιστον ἅπαν· πολλοὶ δὲ διδακταῖς"
  },
  {
    "id": "p-58c05b",
    "offset": 3548,
    "text": "ἀνθρώπων ἀρεταῖς κλέος"
  },
  {
    "id": "p-0d7575",
    "offset": 3572,
    "text": "ὤρουσαν ἀρέσθαι."
  },
  {
    "id": "p-f99123",
    "offset": 3590,
    "text": "ἄνευ δὲ θεοῦ σεσιγαμένον"
  },
  {
    "id": "p-667eaa",
    "offset": 3616,
    "text": "οὐ σκαιότερον χρῆμʼ ἕκαστον. ἐντὶ γὰρ ἄλλαι"
  },
  {
    "id": "p-58d1bf",
    "offset": 3661,
    "text": "ὁδῶν ὁδοὶ περαίτεραι,"
  },
  {
    "id": "p-056c72",
    "offset": 3684,
    "text": "μία δʼ οὐχ ἅπαντας ἄμμε θρέψει"
  },
  {
    "id": "p-300b86",
    "offset": 3716,
    "text": "μελέτα· σοφίαι μὲν"
  },
  {
    "id": "p-f5d1ac",
    "offset": 3736,
    "text": "αἰπειναί· τοῦτο δὲ προσφέρων ἆθλον,"
  },
  {
    "id": "p-23da43",
    "offset": 3773,
    "text": "ὄρθιον ὤρυσαι θαρσέων,"
  },
  {
    "id": "p-e2decb",
    "offset": 3797,
    "text": "τόνδʼ ἀνέρα δαιμονίᾳ γεγάμεν"
  },
  {
    "id": "p-b2ecbb",
    "offset": 3827,
    "text": "εὔχειρα, δεξιόγυιον, ὁρῶντʼ ἀλκάν,"
  },
  {
    "id": "p-e1774e",
    "offset": 3863,
    "text": "Αἰάντειόν τʼ ἐν δαιτὶ Ἰλιάδα νικῶν ἐπεστεφάνωσε βωμόν."
  }
]