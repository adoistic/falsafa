[
  {
    "id": "p-8fbf9d",
    "offset": 0,
    "text": "ἐλατὴρ ὑπέρτατε βροντᾶς ἀκαμαντόποδος Ζεῦ· τεαὶ γὰρ ὧραι"
  },
  {
    "id": "p-d18ae7",
    "offset": 58,
    "text": "ὑπὸ ποικιλοφόρμιγγος ἀοιδᾶς ἑλισσόμεναί μʼ ἔπεμψαν"
  },
  {
    "id": "p-2eff9b",
    "offset": 110,
    "text": "ὑψηλοτάτων μάρτυρʼ ἀέθλων."
  },
  {
    "id": "p-8d1a17",
    "offset": 138,
    "text": "ξείνων δʼ εὖ πρασσόντων ἔσαναν αὐτίκʼ ἀγγελίαν"
  },
  {
    "id": "p-cbf695",
    "offset": 186,
    "text": "ποτὶ γλυκεῖαν ἐσλοί."
  },
  {
    "id": "p-44f6fa",
    "offset": 208,
    "text": "ἀλλʼ, ὦ Κρόνου παῖ, ὃς Αἴτναν ἔχεις,"
  },
  {
    "id": "p-e8bf48",
    "offset": 246,
    "text": "ἶπον ἀνεμόεσσαν ἑκατογκεφάλα Τυφῶνος ὀβρίμου,"
  },
  {
    "id": "p-6d0b7c",
    "offset": 293,
    "text": "Οὐλυμπιονίκαν δέκευ"
  },
  {
    "id": "p-ce8779",
    "offset": 314,
    "text": "Χαρίτων ἕκατι τόνδε κῶμον,"
  },
  {
    "id": "p-4d23e3",
    "offset": 342,
    "text": "χρονιώτατον φάος εὐρυσθενέων ἀρετᾶν. Ψαύμιος γὰρ ἵκει"
  },
  {
    "id": "p-18b58c",
    "offset": 397,
    "text": "ὀχέων, ὅς, ἐλαίᾳ στεφανωθεὶς Πισάτιδι, κῦδος ὄρσαι"
  },
  {
    "id": "p-a24977",
    "offset": 449,
    "text": "σπεύδει Καμαρίνᾳ. θεὸς εὔφρων"
  },
  {
    "id": "p-1e687e",
    "offset": 480,
    "text": "εἴη λοιπαῖς εὐχαῖς· ἐπεί νιν αἰνέω μάλα μὲν"
  },
  {
    "id": "p-27b70e",
    "offset": 525,
    "text": "τροφαῖς ἑτοῖμον ἵππων,"
  },
  {
    "id": "p-ea495b",
    "offset": 549,
    "text": "χαίροντά τε ξενίαις πανδόκοις"
  },
  {
    "id": "p-d4340a",
    "offset": 580,
    "text": "καὶ πρὸς ἁσυχίαν φιλόπολιν καθαρᾷ γνώμᾳ τετραμμένον."
  },
  {
    "id": "p-b729cb",
    "offset": 634,
    "text": "οὐ ψεύδεϊ τέγξω λόγον·"
  },
  {
    "id": "p-b029cd",
    "offset": 658,
    "text": "διάπειρά τοι βροτῶν ἔλεγχος·"
  },
  {
    "id": "p-7e01bc",
    "offset": 688,
    "text": "ἅπερ Κλυμένοιο παῖδα"
  },
  {
    "id": "p-965765",
    "offset": 710,
    "text": "Λαμνιάδων γυναικῶν"
  },
  {
    "id": "p-244729",
    "offset": 730,
    "text": "ἔλυσεν ἐξ ἀτιμίας."
  },
  {
    "id": "p-890f5e",
    "offset": 750,
    "text": "χαλκέοισι δʼ ἐν ἔντεσι νικῶν δρόμον"
  },
  {
    "id": "p-fec1ff",
    "offset": 787,
    "text": "ἔειπεν Ὑψιπυλείᾳ μετὰ στέφανον ἰών·"
  },
  {
    "id": "p-e85c3b",
    "offset": 824,
    "text": "οὗτος ἐγὼ ταχυτᾶτι·"
  },
  {
    "id": "p-f47087",
    "offset": 845,
    "text": "χεῖρες δὲ καὶ ἦτορ ἴσον."
  },
  {
    "id": "p-548548",
    "offset": 871,
    "text": "φύονται δὲ καὶ νέοις ἐν ἀνδράσιν"
  },
  {
    "id": "p-e6b8c8",
    "offset": 905,
    "text": "πολιαὶ θαμὰ καὶ παρὰ τὸν ἁλικίας"
  },
  {
    "id": "p-ed8c99",
    "offset": 939,
    "text": "ἐοικότα χρόνον."
  }
]