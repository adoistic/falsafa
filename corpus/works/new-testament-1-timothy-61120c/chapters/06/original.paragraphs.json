[
  {
    "id": "p-bd1286",
    "offset": 0,
    "text": "Ὅσοι"
  },
  {
    "id": "p-36bef1",
    "offset": 6,
    "text": "εἰσὶν ὑπὸ ζυγὸν δοῦλοι, τοὺς ἰδίους δεσπότας πάσης τιμῆς"
  },
  {
    "id": "p-6d6f34",
    "offset": 64,
    "text": "ἀξίους ἡγείσθωσαν, ἵνα μὴ τὸ ὄνομα τοῦ θεοῦ καὶ ἡ διδασκαλία"
  },
  {
    "id": "p-393efe",
    "offset": 126,
    "text": "βλασφημῆται."
  },
  {
    "id": "p-74a19d",
    "offset": 140,
    "text": "οἱ δὲ πιστοὺς ἔχοντες δεσπότας"
  },
  {
    "id": "p-bf571b",
    "offset": 172,
    "text": "μὴ καταφρονείτωσαν, ὅτι ἀδελφοί εἰσιν· ἀλλὰ μᾶλλον"
  },
  {
    "id": "p-f1cc47",
    "offset": 224,
    "text": "δουλευέτωσαν, ὅτι πιστοί εἰσιν καὶ ἀγαπητοὶ οἱ τῆς εὐεργεσίας"
  },
  {
    "id": "p-bfdfb3",
    "offset": 287,
    "text": "ἀντιλαμβανόμενοι."
  },
  {
    "id": "p-a8bd9a",
    "offset": 306,
    "text": "Ταῦτα δίδασκε καὶ παρακάλει. εἴ τις ἑτεροδιδασκαλεῖ"
  },
  {
    "id": "p-501ca5",
    "offset": 359,
    "text": "καὶ μὴ προσέρχεται ὑγιαίνουσι λόγοις, τοῖς τοῦ κυρίου"
  },
  {
    "id": "p-1e60df",
    "offset": 414,
    "text": "ἡμῶν Ἰησοῦ Χριστοῦ, καὶ τῇ κατʼ εὐσέβειαν διδασκαλίᾳ,"
  },
  {
    "id": "p-342b6d",
    "offset": 469,
    "text": "τετύφωται,"
  },
  {
    "id": "p-54d1d3",
    "offset": 481,
    "text": "μηδὲν ἐπιστάμενος, ἀλλὰ νοσῶν περὶ ζητήσεις"
  },
  {
    "id": "p-471473",
    "offset": 526,
    "text": "καὶ λογομαχίας, ἐξ ὧν γίνεται φθόνος, ἔρις, βλασφημίαι,"
  },
  {
    "id": "p-0c74b9",
    "offset": 583,
    "text": "ὑπόνοιαι πονηραί,"
  },
  {
    "id": "p-f6bd45",
    "offset": 602,
    "text": "διαπαρατριβαὶ διεφθαρμένων ἀνθρώπων"
  },
  {
    "id": "p-372f92",
    "offset": 639,
    "text": "τὸν νοῦν καὶ ἀπεστερημένων τῆς ἀληθείας, νομιζόντων πορισμὸν"
  },
  {
    "id": "p-467ddc",
    "offset": 701,
    "text": "εἶναι τὴν εὐσέβειαν."
  },
  {
    "id": "p-5e763f",
    "offset": 723,
    "text": "ἔστιν δὲ πορισμὸς μέγας ἡ"
  },
  {
    "id": "p-fbbffa",
    "offset": 750,
    "text": "εὐσέβεια μετὰ αὐταρκείας·"
  },
  {
    "id": "p-a3b8c7",
    "offset": 777,
    "text": "οὐδὲν γὰρ εἰσηνέγκαμεν εἰς τὸν κόσμον, ὅτι οὐδὲ ἐξενεγκεῖν τι δυνάμεθα·"
  },
  {
    "id": "p-0e4c53",
    "offset": 850,
    "text": "ἔχοντες δὲ διατροφὰς"
  },
  {
    "id": "p-98453f",
    "offset": 872,
    "text": "καὶ σκεπάσματα, τούτοις ἀρκεσθησόμεθα."
  },
  {
    "id": "p-b914f0",
    "offset": 912,
    "text": "οἱ δὲ"
  },
  {
    "id": "p-8478d3",
    "offset": 919,
    "text": "βουλόμενοι πλουτεῖν ἐμπίπτουσιν εἰς πειρασμὸν καὶ παγίδα"
  },
  {
    "id": "p-0ecbf0",
    "offset": 977,
    "text": "καὶ ἐπιθυμίας πολλὰς ἀνοήτους καὶ βλαβεράς, αἵτινες"
  },
  {
    "id": "p-b62b9c",
    "offset": 1030,
    "text": "βυθίζουσι τοὺς ἀνθρώπους εἰς ὄλεθρον καὶ ἀπώλειαν·"
  },
  {
    "id": "p-4df2fa",
    "offset": 1082,
    "text": "ῥίζα"
  },
  {
    "id": "p-77b264",
    "offset": 1088,
    "text": "γὰρ πάντων τῶν κακῶν ἐστὶν ἡ φιλαργυρία, ἧς τινὲς ὀρεγόμενοι"
  },
  {
    "id": "p-5005ce",
    "offset": 1150,
    "text": "ἀπεπλανήθησαν ἀπὸ τῆς πίστεως καὶ ἑαυτοὺς"
  },
  {
    "id": "p-2e53c5",
    "offset": 1193,
    "text": "περιέπειραν ὀδύναις πολλαῖς."
  },
  {
    "id": "p-69d4f5",
    "offset": 1223,
    "text": "Σὺ δέ, ὦ ἄν"
  },
  {
    "id": "p-cd4550",
    "offset": 1236,
    "text": "θρωπε θεοῦ, ταῦτα φεῦγε· δίωκε δὲ δικαιοσύνην, εὐσέβειαν,"
  },
  {
    "id": "p-9c74cf",
    "offset": 1295,
    "text": "πίστιν, ἀγάπην, ὑπομονήν, πραϋπαθίαν."
  },
  {
    "id": "p-e2fcb3",
    "offset": 1334,
    "text": "ἀγωνίζου"
  },
  {
    "id": "p-76ab02",
    "offset": 1344,
    "text": "τὸν καλὸν ἀγῶνα τῆς πίστεως, ἐπιλαβοῦ τῆς αἰωνίου ζωῆς,"
  },
  {
    "id": "p-2d0332",
    "offset": 1401,
    "text": "εἰς ἣν ἐκλήθης καὶ ὡμολόγησας τὴν καλὴν ὁμολογίαν ἐνώπιον"
  },
  {
    "id": "p-996f4d",
    "offset": 1460,
    "text": "πολλῶν μαρτύρων."
  },
  {
    "id": "p-36d907",
    "offset": 1478,
    "text": "παραγγέλλω σοι ἐνώπιον τοῦ"
  },
  {
    "id": "p-677e05",
    "offset": 1506,
    "text": "θεοῦ τοῦ ζωογονοῦντος τὰ πάντα καὶ Χριστοῦ Ἰησοῦ τοῦ"
  },
  {
    "id": "p-4dc5a3",
    "offset": 1560,
    "text": "μαρτυρήσαντος ἐπὶ Ποντίου Πειλάτου τὴν καλὴν ὁμολογίαν,"
  },
  {
    "id": "p-418952",
    "offset": 1617,
    "text": "τηρῆσαί σε τὴν ἐντολὴν ἄσπιλον ἀνεπίλημπτον"
  },
  {
    "id": "p-eb4417",
    "offset": 1662,
    "text": "μέχρι τῆς ἐπιφανείας τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ,"
  },
  {
    "id": "p-51e4fc",
    "offset": 1715,
    "text": "ἣν"
  },
  {
    "id": "p-9d0bd2",
    "offset": 1719,
    "text": "καιροῖς ἰδίοις δείξει ὁ μακάριος καὶ μόνος δυνάστης, ὁ"
  },
  {
    "id": "p-2957f0",
    "offset": 1775,
    "text": "βασιλεὺς τῶν βασιλευόντων καὶ κύριος τῶν κυριευόντων,"
  },
  {
    "id": "p-c3e175",
    "offset": 1830,
    "text": "ὁ"
  },
  {
    "id": "p-5743ee",
    "offset": 1833,
    "text": "μόνος ἔχων ἀθανασίαν, φῶς οἰκῶν ἀπρόσιτον, ὃν εἶδεν"
  },
  {
    "id": "p-50b1c8",
    "offset": 1886,
    "text": "οὐδεὶς ἀνθρώπων οὐδὲ ἰδεῖν δύναται· ᾧ τιμὴ καὶ κράτος"
  },
  {
    "id": "p-07db89",
    "offset": 1941,
    "text": "αἰώνιον· ἀμήν."
  },
  {
    "id": "p-987b72",
    "offset": 1957,
    "text": "Τοῖς πλουσίοις ἐν τῷ νῦν αἰῶνι"
  },
  {
    "id": "p-257259",
    "offset": 1989,
    "text": "παράγγελλε μὴ ὑψηλοφρονεῖν μηδὲ ἠλπικέναι ἐπὶ πλού"
  },
  {
    "id": "p-2b3732",
    "offset": 2041,
    "text": "του ἀδηλότητι, ἀλλʼ ἐπὶ θεῷ τῷ παρέχοντι ἡμῖν πάντα"
  },
  {
    "id": "p-251b49",
    "offset": 2094,
    "text": "πλουσίως εἰς ἀπόλαυσιν,"
  },
  {
    "id": "p-343b4c",
    "offset": 2119,
    "text": "ἀγαθοεργεῖν, πλουτεῖν ἐν ἔργοις καλοῖς,"
  },
  {
    "id": "p-8bca7d",
    "offset": 2160,
    "text": "εὐμεταδότους εἶναι, κοινωνικούς,"
  },
  {
    "id": "p-422bef",
    "offset": 2194,
    "text": "ἀποθησαυρίζοντας"
  },
  {
    "id": "p-26dcec",
    "offset": 2212,
    "text": "ἑαυτοῖς θεμέλιον καλὸν εἰς τὸ μέλλον, ἵνα ἐπιλάβωνται τῆς"
  },
  {
    "id": "p-ca8cea",
    "offset": 2271,
    "text": "ὄντως ζωῆς."
  },
  {
    "id": "p-8e0002",
    "offset": 2284,
    "text": "Ὦ Τιμόθεε, τὴν παραθήκην"
  },
  {
    "id": "p-c41446",
    "offset": 2310,
    "text": "φύλαξον, ἐκτρεπόμενος τὰς βεβήλους κενοφωνίας καὶ"
  },
  {
    "id": "p-741c09",
    "offset": 2361,
    "text": "ἀντιθέσεις τῆς ψευδωνύμου γνώσεως,"
  },
  {
    "id": "p-4fd55e",
    "offset": 2397,
    "text": "ἥν τινες ἐπαγγελλόμενοι"
  },
  {
    "id": "p-11bfd0",
    "offset": 2422,
    "text": "περὶ τὴν πίστιν ἠστόχησαν."
  },
  {
    "id": "p-59570f",
    "offset": 2450,
    "text": "Ἡ χάρις μεθʼ ὑμῶν."
  }
]