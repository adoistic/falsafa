[
  {
    "id": "p-7bcc39",
    "offset": 0,
    "text": "Πρεσβυτέρῳ μὴ ἐπιπλήξῃς, ἀλλὰ παρακάλει ὡς πατέρα,"
  },
  {
    "id": "p-339887",
    "offset": 52,
    "text": "νεωτέρους ὡς ἀδελφούς,"
  },
  {
    "id": "p-bf8f34",
    "offset": 76,
    "text": "πρεσβυτέρας ὡς μητέρας,"
  },
  {
    "id": "p-5cebc4",
    "offset": 101,
    "text": "νεωτέρας ὡς ἀδελφὰς ἐν πάσῃ ἁγνίᾳ."
  },
  {
    "id": "p-3871b1",
    "offset": 137,
    "text": "Χήρας τίμα τὰς"
  },
  {
    "id": "p-59171e",
    "offset": 153,
    "text": "ὄντως χήρας."
  },
  {
    "id": "p-39ea69",
    "offset": 167,
    "text": "εἰ δέ τις χήρα τέκνα ἢ ἔκγονα ἔχει, μανθανέτωσαν"
  },
  {
    "id": "p-1f6cc2",
    "offset": 217,
    "text": "πρῶτον τὸν ἴδιον οἶκον εὐσεβεῖν καὶ ἀμοιβὰς ἀποδιδόναι"
  },
  {
    "id": "p-fea021",
    "offset": 273,
    "text": "τοῖς προγόνοις, τοῦτο γάρ ἐστιν ἀπόδεκτον ἐνώπιον"
  },
  {
    "id": "p-d60e8e",
    "offset": 324,
    "text": "τοῦ θεοῦ."
  },
  {
    "id": "p-a180d9",
    "offset": 335,
    "text": "ἡ δὲ ὄντως χήρα καὶ μεμονωμένη ἤλπικεν ἐπὶ [τὸν] θεὸν καὶ προσμένει ταῖς δεήσεσιν καὶ ταῖς προσευχαῖς"
  },
  {
    "id": "p-62c161",
    "offset": 438,
    "text": "νυκτὸς καὶ ἡμέρας·"
  },
  {
    "id": "p-5a7f2d",
    "offset": 458,
    "text": "ἡ δὲ σπαταλῶσα ζῶσα τέθνηκεν."
  },
  {
    "id": "p-1a0917",
    "offset": 489,
    "text": "καὶ ταῦτα παράγγελλε, ἵνα ἀνεπίλημπτοι ὦσιν·"
  },
  {
    "id": "p-f2f4c2",
    "offset": 535,
    "text": "εἰ δέ τις"
  },
  {
    "id": "p-e119e5",
    "offset": 546,
    "text": "τῶν ἰδίων καὶ μάλιστα οἰκείων οὐ προνοεῖ,"
  },
  {
    "id": "p-d9ac88",
    "offset": 589,
    "text": "τὴν πίστιν"
  },
  {
    "id": "p-0dcd85",
    "offset": 601,
    "text": "ἤρνηται καὶ ἔστιν ἀπίστου χείρων."
  },
  {
    "id": "p-6eaea1",
    "offset": 636,
    "text": "Χήρα καταλεγέσθω"
  },
  {
    "id": "p-a2c17c",
    "offset": 654,
    "text": "μὴ ἔλαττον ἐτῶν ἑξήκοντα γεγονυῖα, ἑνὸς ἀνδρὸς γυνή,"
  },
  {
    "id": "p-e02b6e",
    "offset": 708,
    "text": "ἐν ἔργοις καλοῖς μαρτυρουμένη,"
  },
  {
    "id": "p-c76a03",
    "offset": 740,
    "text": "εἰ ἐτεκνοτρόφησεν, εἰ"
  },
  {
    "id": "p-68a926",
    "offset": 763,
    "text": "ἐξενοδόχησεν, εἰ ἁγίων πόδας ἔνιψεν, εἰ θλιβομένοις"
  },
  {
    "id": "p-656ad9",
    "offset": 816,
    "text": "ἐπήρκεσεν, εἰ παντὶ ἔργῳ ἀγαθῷ ἐπηκολούθησεν."
  },
  {
    "id": "p-59ff17",
    "offset": 863,
    "text": "νεωτέρας"
  },
  {
    "id": "p-02f89d",
    "offset": 873,
    "text": "δὲ χήρας παραιτοῦ· ὅταν γὰρ καταστρηνιάσωσιν τοῦ"
  },
  {
    "id": "p-6dad49",
    "offset": 923,
    "text": "χριστοῦ,"
  },
  {
    "id": "p-e4996f",
    "offset": 933,
    "text": "γαμεῖν θέλουσιν,"
  },
  {
    "id": "p-c2b57e",
    "offset": 951,
    "text": "ἔχουσαι κρίμα ὅτι τὴν πρώτην"
  },
  {
    "id": "p-41a1d2",
    "offset": 981,
    "text": "πίστιν ἠθέτησαν·"
  },
  {
    "id": "p-100a56",
    "offset": 999,
    "text": "ἅμα δὲ καὶ ἀργαὶ μανθάνουσιν,"
  },
  {
    "id": "p-5ee26a",
    "offset": 1030,
    "text": "περιερχόμεναι"
  },
  {
    "id": "p-621fac",
    "offset": 1045,
    "text": "τὰς οἰκίας, οὐ μόνον δὲ ἀργαὶ ἀλλὰ καὶ φλύαροι"
  },
  {
    "id": "p-a8b349",
    "offset": 1093,
    "text": "καὶ περίεργοι, λαλοῦσαι τὰ μὴ δέοντα."
  },
  {
    "id": "p-4ec980",
    "offset": 1132,
    "text": "βούλομαι οὖν"
  },
  {
    "id": "p-8769c6",
    "offset": 1146,
    "text": "νεῶτέρας γαμεῖν, τεκνογονεῖν, οἰκοδεσποτεῖν, μηδεμίαν"
  },
  {
    "id": "p-8a6915",
    "offset": 1201,
    "text": "ἀφορμὴν διδόναι τῷ ἀντικειμένῳ λοιδορίας χάριν·"
  },
  {
    "id": "p-cb98f3",
    "offset": 1250,
    "text": "ἤδη γάρ"
  },
  {
    "id": "p-8e00f6",
    "offset": 1259,
    "text": "τινες ἐξετράπησαν ὀπίσω τοῦ Σατανᾶ."
  },
  {
    "id": "p-2eb04f",
    "offset": 1296,
    "text": "εἴ τις πιστὴ ἔχει"
  },
  {
    "id": "p-d97825",
    "offset": 1315,
    "text": "χήρας, ἐπαρκείτω αὐταῖς, καὶ μὴ βαρείσθω ἡ ἐκκλησία,"
  },
  {
    "id": "p-206904",
    "offset": 1369,
    "text": "ἵνα ταῖς ὄντως χήραις ἐπαρκέσῃ."
  },
  {
    "id": "p-00e017",
    "offset": 1402,
    "text": "Οἱ καλῶς"
  },
  {
    "id": "p-6e8287",
    "offset": 1412,
    "text": "προεστῶτες πρεσβύτεροι διπλῆς τιμῆς ἀξιούσθωσαν, μάλιστα"
  },
  {
    "id": "p-02c2be",
    "offset": 1470,
    "text": "οἱ κοπιῶντες ἐν λόγῳ καὶ διδασκαλίᾳ·"
  },
  {
    "id": "p-d028ef",
    "offset": 1508,
    "text": "λέγει γὰρ ἡ"
  },
  {
    "id": "p-8aeb39",
    "offset": 1521,
    "text": "γραφή Βοῦν ἀλοῶντα οὐ φιμώσεις· καὶ Ἄξιος ὁ ἐργάτης"
  },
  {
    "id": "p-5de001",
    "offset": 1574,
    "text": "τοῦ μισθοῦ αὐτοῦ."
  },
  {
    "id": "p-62873b",
    "offset": 1593,
    "text": "κατὰ πρεσβυτέρου κατηγορίαν"
  },
  {
    "id": "p-98faae",
    "offset": 1622,
    "text": "μὴ παραδέχου, ἐκτὸς εἰ μὴ ἐπὶ δύο ἢ τριῶν μαρτύρων·"
  },
  {
    "id": "p-ecfad8",
    "offset": 1675,
    "text": "τοὺς [δὲ] ἁμαρτάνοντας ἐνώπιον πάντων ἔλεγχε,"
  },
  {
    "id": "p-7af25b",
    "offset": 1722,
    "text": "ἵνα καὶ οἱ"
  },
  {
    "id": "p-0bc350",
    "offset": 1734,
    "text": "λοιποὶ φόβον ἔχωσιν."
  },
  {
    "id": "p-a74433",
    "offset": 1756,
    "text": "Διαμαρτύρομαι ἐνώπιον τοῦ θεοῦ"
  },
  {
    "id": "p-fdd495",
    "offset": 1788,
    "text": "καὶ Χριστοῦ Ἰησοῦ καὶ τῶν ἐκλεκτῶν ἀγγέλων, ἵνα ταῦτα"
  },
  {
    "id": "p-fea522",
    "offset": 1843,
    "text": "φυλάξῃς χωρὶς προκρίματος, μηδὲν ποιῶν κατὰ πρόσκλισιν."
  },
  {
    "id": "p-e7cf74",
    "offset": 1900,
    "text": "Χεῖρας ταχέως μηδενὶ ἐπιτίθει,"
  },
  {
    "id": "p-e35075",
    "offset": 1932,
    "text": "μηδὲ κοινωνει"
  },
  {
    "id": "p-35eb3d",
    "offset": 1947,
    "text": "ἁμαρτίαις ἀλλοτρίαις· σεαυτὸν ἁγνὸν τήρει."
  },
  {
    "id": "p-30fadc",
    "offset": 1991,
    "text": "Μηκέτι ὑδροπότει,"
  },
  {
    "id": "p-29eaa3",
    "offset": 2010,
    "text": "ἀλλὰ οἴνῳ ὀλίγῳ χρῶ διὰ τὸν στόμαχον καὶ τὰς"
  },
  {
    "id": "p-e2000c",
    "offset": 2056,
    "text": "πυκνάς σου ἀσθενείας."
  },
  {
    "id": "p-86d219",
    "offset": 2079,
    "text": "Τινῶν ἀνθρώπων αἱ ἁμαρτίαι"
  },
  {
    "id": "p-c926f4",
    "offset": 2107,
    "text": "πρόδηλοί εἰσιν, προάγουσαι εἰς κρίσιν, τισὶν δὲ καὶ ἐπακολουθοῦσιν·"
  },
  {
    "id": "p-282d14",
    "offset": 2176,
    "text": "ὡσαύτως καὶ τὰ ἔργα τὰ καλὰ πρόδηλα,"
  },
  {
    "id": "p-474d8a",
    "offset": 2214,
    "text": "καὶ"
  },
  {
    "id": "p-09a426",
    "offset": 2219,
    "text": "τὰ ἄλλως ἔχοντα κρυβῆναι οὐ δύνανται."
  }
]