[
  {
    "id": "p-3ef599",
    "offset": 0,
    "text": "Sophoclidisca:\nSatis fúit índoctae, ímmemori, insípienti dicére totiens."
  },
  {
    "id": "p-351f38",
    "offset": 74,
    "text": "nimis tándem me quidem pró barda et pro rústica reor habitam ésse aps te."
  },
  {
    "id": "p-29413d",
    "offset": 149,
    "text": "quamquam égo vinum bibo, at mándata non cónsuevi simul bíbere una."
  },
  {
    "id": "p-162923",
    "offset": 217,
    "text": "me quídem iam satis tibi spéctatam censébam esse et meos móres."
  },
  {
    "id": "p-493adf",
    "offset": 282,
    "text": "nam equidém te iam sectór quintum hunc annúm, quom interea, crédo, ovis si ín ludum iret, pótuisset iam fíeri ut probe litterás sciret, quom interím tu meum ingeniúm fans atque infans nondum etiam edídicisti."
  },
  {
    "id": "p-33351d",
    "offset": 492,
    "text": "potin út taceas? potin né moneas?"
  },
  {
    "id": "p-59697f",
    "offset": 527,
    "text": "memini ét scio et calleo et cómmemini."
  },
  {
    "id": "p-a0924f",
    "offset": 567,
    "text": "amas pól misera: id tuos scátit animus."
  },
  {
    "id": "p-d4db7f",
    "offset": 608,
    "text": "ego istúc placidum tibi ut sít faciam."
  },
  {
    "id": "p-21dd17",
    "offset": 648,
    "text": "Lemniselenis:\nMiser ést qui amat.—"
  },
  {
    "id": "p-90ffeb",
    "offset": 684,
    "text": "Sophoclidisca:\nCérto is quidém nihilist, qui níl amat: quíd ei homini ópus vita est?"
  },
  {
    "id": "p-05fbf5",
    "offset": 770,
    "text": "iré decet me, út erae opsequéns fiam, libéra ea opera ócius ut sit."
  },
  {
    "id": "p-6a7573",
    "offset": 839,
    "text": "convéniam hunc Toxilum: eius auris, quae mandata sunt, onerabo."
  },
  {
    "id": "p-235ca3",
    "offset": 904,
    "text": "Toxilvs:\nSátin haec tibi sunt plána et certa? sátin haec meministi ét tenes?"
  },
  {
    "id": "p-b9e5d4",
    "offset": 982,
    "text": "Paegnivm:\nMelius quam tu qui docuisti."
  },
  {
    "id": "p-d82754",
    "offset": 1022,
    "text": "Toxilvs:\nAin véro, verbereum caput?"
  },
  {
    "id": "p-ea38dd",
    "offset": 1059,
    "text": "Paegnivm:\nAio enim véro."
  },
  {
    "id": "p-f7fad2",
    "offset": 1085,
    "text": "Toxilvs:\nQuid ergo dixi?"
  },
  {
    "id": "p-86a8c0",
    "offset": 1111,
    "text": "Paegnivm:\nEgo recte apud illam dixero."
  },
  {
    "id": "p-aa0676",
    "offset": 1151,
    "text": "Toxilvs:\nNon edepol scis."
  },
  {
    "id": "p-898f1e",
    "offset": 1178,
    "text": "Paegnivm:\nDa hercle pignus, ni omnia memini et scio, et quidem sí scis tute, quot hodie habeas digitos in manu."
  },
  {
    "id": "p-4c357e",
    "offset": 1291,
    "text": "Toxilvs:\nEgon dem pignus tecum?"
  },
  {
    "id": "p-db0d3b",
    "offset": 1324,
    "text": "Paegnivm:\nAudacter, si lubido est perdere."
  },
  {
    "id": "p-3fcf4c",
    "offset": 1368,
    "text": "Toxilvs:\nBona pax sit potius."
  },
  {
    "id": "p-ea51a6",
    "offset": 1399,
    "text": "Paegnivm:\nTum tu igitur sine me ire."
  },
  {
    "id": "p-c953aa",
    "offset": 1437,
    "text": "Toxilvs:\nEt iubeo et sino;"
  },
  {
    "id": "p-ce6324",
    "offset": 1465,
    "text": "sed ita volo te ire, ut domí sis, cum ego te esse illi censeam."
  },
  {
    "id": "p-4f105a",
    "offset": 1530,
    "text": "Paegnivm:\nFaciam."
  },
  {
    "id": "p-b79b24",
    "offset": 1549,
    "text": "Toxilvs:\nQuo ergo is nunc?"
  },
  {
    "id": "p-914908",
    "offset": 1577,
    "text": "Paegnivm:\nDomum: uti domi sim, quom illi censeas."
  },
  {
    "id": "p-af1819",
    "offset": 1628,
    "text": "Toxilvs:"
  },
  {
    "id": "p-2f1643",
    "offset": 1638,
    "text": "Scelus tu pueri es, atque ob istánc rem ego aliqui te peculiabo."
  },
  {
    "id": "p-f1846f",
    "offset": 1704,
    "text": "Paegnivm:\nScio fide hercle erili ut soleat impudicitia opprobrari nec subigi queantur umquam, ut pro éa fide habeant iudicem."
  },
  {
    "id": "p-0a014b",
    "offset": 1831,
    "text": "Toxilvs:\nAbi modo."
  },
  {
    "id": "p-30e5c7",
    "offset": 1851,
    "text": "Paegnivm:\nEgo laudabis faxo."
  },
  {
    "id": "p-f5c5d9",
    "offset": 1881,
    "text": "Toxilvs:\nSed has tabellas, Paegnium, ipsi Lemniseleni fac des et quae iussi nuntiato."
  },
  {
    "id": "p-1e5fb8",
    "offset": 1968,
    "text": "Sophoclidisca:"
  },
  {
    "id": "p-a7ed7f",
    "offset": 1984,
    "text": "Cesso ire ego quo missa sum?"
  },
  {
    "id": "p-4906de",
    "offset": 2014,
    "text": "Paegnivm:\nEo ego."
  },
  {
    "id": "p-c25bda",
    "offset": 2033,
    "text": "Toxilvs:\nI sane. ego domum ibo. face rem hanc cum cura geras."
  },
  {
    "id": "p-e5038a",
    "offset": 2096,
    "text": "vola curriculo.—"
  },
  {
    "id": "p-27a81a",
    "offset": 2114,
    "text": "Paegnivm:\nIstuc marinus passer per circum solet."
  },
  {
    "id": "p-7dae95",
    "offset": 2164,
    "text": "illic hinc abiit intro huc. sed quis haec ést quae med advorsum incedit?"
  },
  {
    "id": "p-e67e88",
    "offset": 2238,
    "text": "Sophoclidisca:\nPaegnium hic quidem est."
  },
  {
    "id": "p-4a651c",
    "offset": 2279,
    "text": "Paegnivm:\nSophoclidisca haéc peculiarest eius quo ego sum missus."
  },
  {
    "id": "p-a4f795",
    "offset": 2346,
    "text": "Sophoclidisca:\nNullus esse hodie hóc puero peior perhibetur."
  },
  {
    "id": "p-6d2c8b",
    "offset": 2408,
    "text": "Paegnivm:\nCompellabo."
  },
  {
    "id": "p-7be7a6",
    "offset": 2431,
    "text": "Sophoclidisca:\nCommorandust."
  },
  {
    "id": "p-6f3b40",
    "offset": 2461,
    "text": "Paegnivm:\nApud hanc obieci"
  },
  {
    "id": "p-8471ed",
    "offset": 2489,
    "text": "Sophoclidisca:\nPaegnium, deliciae pueri, salve. quid agis? ut vales?"
  },
  {
    "id": "p-2436fc",
    "offset": 2559,
    "text": "Paegnivm:\nSophoclidisca, di me amabunt."
  },
  {
    "id": "p-3c9c58",
    "offset": 2600,
    "text": "Sophoclidisca:\nQuid me?"
  },
  {
    "id": "p-199516",
    "offset": 2625,
    "text": "Paegnivm:\nVtrum hercle di volent;"
  },
  {
    "id": "p-5fd505",
    "offset": 2660,
    "text": "sed si ut digna es faciant, odio hercle habeant et faciant male."
  },
  {
    "id": "p-1e5fb8",
    "offset": 2726,
    "text": "Sophoclidisca:"
  },
  {
    "id": "p-a820a0",
    "offset": 2742,
    "text": "Mitte male loqui."
  },
  {
    "id": "p-c80e81",
    "offset": 2761,
    "text": "Paegnivm:\nQuom ut digna es dico, bene, non male loquor."
  },
  {
    "id": "p-da1e84",
    "offset": 2818,
    "text": "Sophoclidisca:\nQuid agis?"
  },
  {
    "id": "p-686f19",
    "offset": 2845,
    "text": "Paegnivm:\nFeminam scelestam te astans contra contuor."
  },
  {
    "id": "p-d33b3c",
    "offset": 2900,
    "text": "Sophoclidisca:\nCerte equidem puerum peiorem quam te novi neminem."
  },
  {
    "id": "p-627bef",
    "offset": 2967,
    "text": "Paegnivm:\nQuid male facio aut quoi male dico?"
  },
  {
    "id": "p-80c410",
    "offset": 3014,
    "text": "Sophoclidisca:\nQuoi pol cumque occasio est."
  },
  {
    "id": "p-f4d762",
    "offset": 3059,
    "text": "Paegnivm:\nNemo homo umquam ita arbitratust."
  },
  {
    "id": "p-fbbf7d",
    "offset": 3104,
    "text": "Sophoclidisca:\nAt pol multi esse ita sciunt."
  },
  {
    "id": "p-920908",
    "offset": 3150,
    "text": "Paegnivm:"
  },
  {
    "id": "p-d596c9",
    "offset": 3161,
    "text": "Heia."
  },
  {
    "id": "p-6d128c",
    "offset": 3168,
    "text": "Sophoclidisca:\nBeia."
  },
  {
    "id": "p-2062bd",
    "offset": 3190,
    "text": "Paegnivm:\nTuo ex ingenio mores alienos probas."
  },
  {
    "id": "p-e5d184",
    "offset": 3238,
    "text": "Sophoclidisca:\nFateor ego profecto me esse ut decet lenonis familiae."
  },
  {
    "id": "p-112f44",
    "offset": 3309,
    "text": "Paegnivm:\nSatis iam dictum habeo."
  },
  {
    "id": "p-a00d8a",
    "offset": 3344,
    "text": "Sophoclidisca:\nSed quid tu? confitere ut te autumo?"
  },
  {
    "id": "p-9d52be",
    "offset": 3397,
    "text": "Paegnivm:\nFatear, si ita sim."
  },
  {
    "id": "p-11d7cb",
    "offset": 3428,
    "text": "Sophoclidisca:\nIam ábi, vicisti."
  },
  {
    "id": "p-b5577a",
    "offset": 3462,
    "text": "Paegnivm:\nAbi núnciam ergo."
  },
  {
    "id": "p-6574cf",
    "offset": 3491,
    "text": "Sophoclidisca:\nHoc mi expedi, quó agis?"
  },
  {
    "id": "p-aa07cf",
    "offset": 3532,
    "text": "Paegnivm:\nQuo tu?"
  },
  {
    "id": "p-9feb11",
    "offset": 3551,
    "text": "Sophoclidisca:\nDic tu."
  },
  {
    "id": "p-1e3bcf",
    "offset": 3575,
    "text": "Paegnivm:\nDic tu."
  },
  {
    "id": "p-91e475",
    "offset": 3594,
    "text": "Sophoclidisca:\nPrior rogavi."
  },
  {
    "id": "p-fb8531",
    "offset": 3624,
    "text": "Paegnivm:\nAt post scies."
  },
  {
    "id": "p-1e5fb8",
    "offset": 3650,
    "text": "Sophoclidisca:"
  },
  {
    "id": "p-c12979",
    "offset": 3666,
    "text": "Eo ego hinc haud longe."
  },
  {
    "id": "p-771456",
    "offset": 3691,
    "text": "Paegnivm:\nEt quidem ego haud longe hinc eo."
  },
  {
    "id": "p-48e765",
    "offset": 3736,
    "text": "Sophoclidisca:\nQuo ergo is, scelus?"
  },
  {
    "id": "p-0027f2",
    "offset": 3773,
    "text": "Paegnivm:\nNisi scieró prius ex te, tu ex me numquam hoc quod rogitas scies."
  },
  {
    "id": "p-657183",
    "offset": 3850,
    "text": "Sophoclidisca:\nNumquam ecastor hodie scibis prius quam ex te audivero."
  },
  {
    "id": "p-25b206",
    "offset": 3922,
    "text": "Paegnivm:\nItane est?"
  },
  {
    "id": "p-1dc788",
    "offset": 3944,
    "text": "Sophoclidisca:\nItane est."
  },
  {
    "id": "p-99ba23",
    "offset": 3971,
    "text": "Paegnivm:\nMala es."
  },
  {
    "id": "p-5b8dc4",
    "offset": 3991,
    "text": "Sophoclidisca:\nScelestu's scelestus es."
  },
  {
    "id": "p-00205b",
    "offset": 4032,
    "text": "Paegnivm:\nDecet me."
  },
  {
    "id": "p-750055",
    "offset": 4053,
    "text": "Sophoclidisca:\nMe quidem addecet."
  },
  {
    "id": "p-a7cd44",
    "offset": 4088,
    "text": "Paegnivm:\nQuid ais? certumnest celare, quó iter facias, pessuma?"
  },
  {
    "id": "p-1e5fb8",
    "offset": 4154,
    "text": "Sophoclidisca:"
  },
  {
    "id": "p-9c383b",
    "offset": 4170,
    "text": "Offirmastin occultare quo te immittas, pessume?"
  },
  {
    "id": "p-247c7b",
    "offset": 4219,
    "text": "Paegnivm:\nPar pari respondes dicto. abi iam, quando ita certa res."
  },
  {
    "id": "p-81f2ad",
    "offset": 4287,
    "text": "nihili facio scire. valeas."
  },
  {
    "id": "p-5dce93",
    "offset": 4316,
    "text": "Sophoclidisca:\nAsta."
  },
  {
    "id": "p-1b1291",
    "offset": 4338,
    "text": "Paegnivm:\nAt propero."
  },
  {
    "id": "p-f0e5c9",
    "offset": 4361,
    "text": "Sophoclidisca:\nEt pol ego item."
  },
  {
    "id": "p-6b0803",
    "offset": 4394,
    "text": "Paegnivm:\nEcquid habes?"
  },
  {
    "id": "p-7b6f39",
    "offset": 4419,
    "text": "Sophoclidisca:\nEcquid tú?"
  },
  {
    "id": "p-c68bbb",
    "offset": 4446,
    "text": "Paegnivm:\nNil equidem."
  },
  {
    "id": "p-ae2589",
    "offset": 4470,
    "text": "Sophoclidisca:\nCedo manum ergo."
  },
  {
    "id": "p-d3753a",
    "offset": 4503,
    "text": "Paegnivm:\nEstne haec manus?"
  },
  {
    "id": "p-72ad95",
    "offset": 4532,
    "text": "Sophoclidisca:\nVbi illa altera ést furtifica laeva?"
  },
  {
    "id": "p-9a4d79",
    "offset": 4585,
    "text": "Paegnivm:\nDomi eccam. huc nullam attuli."
  },
  {
    "id": "p-1e5fb8",
    "offset": 4627,
    "text": "Sophoclidisca:"
  },
  {
    "id": "p-8f6b1d",
    "offset": 4643,
    "text": "Habes nescio quid."
  },
  {
    "id": "p-8fbc5a",
    "offset": 4663,
    "text": "Paegnivm:\nNe me attrecta, subigitatrix."
  },
  {
    "id": "p-7630b4",
    "offset": 4704,
    "text": "Sophoclidisca:\nSin te amo?"
  },
  {
    "id": "p-8ff4d6",
    "offset": 4732,
    "text": "Paegnivm:\nMale operam locas."
  },
  {
    "id": "p-dea1b1",
    "offset": 4762,
    "text": "Sophoclidisca:\nQui?"
  },
  {
    "id": "p-f3beea",
    "offset": 4783,
    "text": "Paegnivm:\nQuia enim nihil amas, quom ingratum amas."
  },
  {
    "id": "p-43c4f0",
    "offset": 4836,
    "text": "Sophoclidisca:\nTemperi hanc vigilare oportet formulam atque aetatulam, né, ubi versicapillus fias, foede semper servias."
  },
  {
    "id": "p-5ffa25",
    "offset": 4958,
    "text": "tu quidem haud étiam es octoginta pondo."
  },
  {
    "id": "p-d695e4",
    "offset": 5000,
    "text": "Paegnivm:\nAt confidentia illa militia militatur multo magis quam pondere."
  },
  {
    "id": "p-c81f5d",
    "offset": 5075,
    "text": "atque ego hanc operam perdo."
  },
  {
    "id": "p-0e48a7",
    "offset": 5105,
    "text": "Sophoclidisca:\nQuid iam?"
  },
  {
    "id": "p-04ca5e",
    "offset": 5131,
    "text": "Paegnivm:\nQuia peritae praedico."
  },
  {
    "id": "p-549aaa",
    "offset": 5165,
    "text": "sed ego cesso."
  },
  {
    "id": "p-58c061",
    "offset": 5181,
    "text": "Sophoclidisca:\nMane."
  },
  {
    "id": "p-01b4c4",
    "offset": 5203,
    "text": "Paegnivm:\nMolesta es."
  },
  {
    "id": "p-5a7b35",
    "offset": 5226,
    "text": "Sophoclidisca:\nErgo ero quoque, nisi scio, quó agas te."
  },
  {
    "id": "p-a6f021",
    "offset": 5283,
    "text": "Paegnivm:\nAd vos."
  },
  {
    "id": "p-7393b8",
    "offset": 5302,
    "text": "Sophoclidisca:\nEt pol ego ad vos."
  },
  {
    "id": "p-b74521",
    "offset": 5337,
    "text": "Paegnivm:\nQuid eo?"
  },
  {
    "id": "p-e68f10",
    "offset": 5357,
    "text": "Sophoclidisca:\nQuid id ad te attinet?"
  },
  {
    "id": "p-0be516",
    "offset": 5396,
    "text": "Paegnivm:\nEnim non ibis nunc, vicissim nisi scio."
  },
  {
    "id": "p-e218fd",
    "offset": 5447,
    "text": "Sophoclidisca:\nOdiosu's odiosus es."
  },
  {
    "id": "p-c5dbf5",
    "offset": 5484,
    "text": "Paegnivm:\nLubet."
  },
  {
    "id": "p-7478d0",
    "offset": 5502,
    "text": "numquam hercle istuc exterebrabis, tu ut sis peior quam ego siem."
  },
  {
    "id": "p-e8e819",
    "offset": 5569,
    "text": "Sophoclidisca:\nMalitia certare tecum miseria est."
  },
  {
    "id": "p-ea41d4",
    "offset": 5620,
    "text": "Paegnivm:\nMers tu mala es."
  },
  {
    "id": "p-e5dddf",
    "offset": 5648,
    "text": "Sophoclidisca:\nQuid est quod metuas?"
  },
  {
    "id": "p-4e4f85",
    "offset": 5686,
    "text": "Paegnivm:\nIdem istuc quod tu."
  },
  {
    "id": "p-55896d",
    "offset": 5717,
    "text": "Sophoclidisca:\nDic ergo"
  },
  {
    "id": "p-bbf56e",
    "offset": 5742,
    "text": "Paegnivm:\nEdictum est magno opere mihi, ne quoiquam hoc homini crederem, omnes muti ut eloquerentur prius hoc quám ego."
  },
  {
    "id": "p-44ec36",
    "offset": 5863,
    "text": "Sophoclidisca:\nAt tu hoc face:"
  },
  {
    "id": "p-c5550b",
    "offset": 5895,
    "text": "fide data credamus."
  },
  {
    "id": "p-3900b6",
    "offset": 5916,
    "text": "Paegnivm:\nNovi: omnes sunt lenae levifidae, neque tippulae levius pondust, quam fides lenonia."
  },
  {
    "id": "p-27f4ea",
    "offset": 6012,
    "text": "Sophoclidisca:\nDic amabo."
  },
  {
    "id": "p-f85d2e",
    "offset": 6039,
    "text": "Paegnivm:\nDic amabo."
  },
  {
    "id": "p-62a7b1",
    "offset": 6061,
    "text": "Sophoclidisca:\nNolo ames."
  },
  {
    "id": "p-1f1202",
    "offset": 6088,
    "text": "Paegnivm:\nFacile impetras."
  },
  {
    "id": "p-c95d95",
    "offset": 6116,
    "text": "Sophoclidisca:\nTecum habeto."
  },
  {
    "id": "p-a08445",
    "offset": 6146,
    "text": "Paegnivm:\nEt tu hoc taceto."
  },
  {
    "id": "p-aa8f37",
    "offset": 6175,
    "text": "Sophoclidisca:\nTacitum erit."
  },
  {
    "id": "p-d47473",
    "offset": 6205,
    "text": "Paegnivm:\nCelabitur."
  },
  {
    "id": "p-1e5fb8",
    "offset": 6227,
    "text": "Sophoclidisca:"
  },
  {
    "id": "p-b25d2e",
    "offset": 6243,
    "text": "Toxilo has fero tabellas tuo ero."
  },
  {
    "id": "p-d8a9bc",
    "offset": 6278,
    "text": "Paegnivm:\nAbi, eccillum domi."
  },
  {
    "id": "p-490766",
    "offset": 6309,
    "text": "at ego hánc ad Lemniselenem tuam eram opsignatam abietem."
  },
  {
    "id": "p-e627a9",
    "offset": 6368,
    "text": "Sophoclidisca:\nQuid istic scriptum?"
  },
  {
    "id": "p-dcda1b",
    "offset": 6405,
    "text": "Paegnivm:\nIuxta tecum, si tu nescis, nescio;"
  },
  {
    "id": "p-1e9fa1",
    "offset": 6451,
    "text": "nisi fortasse blanda verba."
  },
  {
    "id": "p-fc2d71",
    "offset": 6480,
    "text": "Sophoclidisca:\nÁbeo."
  },
  {
    "id": "p-046833",
    "offset": 6502,
    "text": "Paegnivm:\nEt ego ábiero.—"
  },
  {
    "id": "p-4e8713",
    "offset": 6529,
    "text": "Sophoclidisca:\nAmbula.—"
  },
  {
    "id": "p-d91681",
    "offset": 6554,
    "text": "Sagaristio:\nIóvi opulento, íncluto,"
  },
  {
    "id": "p-8d58db",
    "offset": 6591,
    "text": "Ope gnáto, suprémo, validó, viripoténti, opés, spes bonás, copiás commodánti lubens vítulorque merito, quiá meo amico amíciter hanc cómmoditatis cópiam danúnt, argenti mutui ut éi egenti opem adferam;"
  },
  {
    "id": "p-945d1f",
    "offset": 6793,
    "text": "quód ego non magis sómniabam neque opinabar neque censebam, eam fore mihi occasionem, ea nunc quasi decidit de caelo;"
  },
  {
    "id": "p-ba57ff",
    "offset": 6912,
    "text": "nam erus meus me Eretriam misit, domitos boves ut sibi mercarer, dedit argentum, nam ibi mercatum dixit esse die septumi:"
  },
  {
    "id": "p-3a779a",
    "offset": 7035,
    "text": "stultus, qui hoc mihi daret argentum, cuius ingenium noverat."
  },
  {
    "id": "p-143d34",
    "offset": 7098,
    "text": "nam hoc argentum álibi abutar: boves, quos emerem, non erant;"
  },
  {
    "id": "p-a8a9c5",
    "offset": 7161,
    "text": "nunc et amico prosperabo et genio meo multá bona faciam, diu quo bene erit, die úno absolvam: tux tax tergo erit meo. non curo."
  },
  {
    "id": "p-ec80b0",
    "offset": 7290,
    "text": "nunc amico homini boves dómitos mea ex crumina largiar."
  },
  {
    "id": "p-551dc1",
    "offset": 7347,
    "text": "nam id demum lepidumst, triparcos homines, vetulos, avidos, aridos béne admordere, qui salinum servo obsignant cum sale."
  },
  {
    "id": "p-fc86fe",
    "offset": 7469,
    "text": "virtús, ubi occásio admonet, dispicere. quid faciet mihi?"
  },
  {
    "id": "p-1f7345",
    "offset": 7528,
    "text": "verberibus caedi iusserit, compédes impingi? vapulet, ne sibi me credat supplicem fore: vae illi, nil iam mihi novi offérre potest, quin sím peritus. sed Toxili púerum Paegnium eccum."
  },
  {
    "id": "p-282b28",
    "offset": 7713,
    "text": "Paegnivm:\nPensúm meum, quod datumst, cónfeci. nunc dómum propero."
  },
  {
    "id": "p-2fa7e4",
    "offset": 7780,
    "text": "Sagaristio:\nMane, etsí properas."
  },
  {
    "id": "p-c30ad6",
    "offset": 7814,
    "text": "Paégnium, ausculta."
  },
  {
    "id": "p-7dec92",
    "offset": 7835,
    "text": "Paegnivm:\nEmere oportet, quem tibi oboediré velis."
  },
  {
    "id": "p-232803",
    "offset": 7887,
    "text": "Sagaristio:\nAsta."
  },
  {
    "id": "p-b57e80",
    "offset": 7906,
    "text": "Paegnivm:\nExhibeas molestiam, ut opínor, si quid debeam, qui nunc sic tamen es molestus."
  },
  {
    "id": "p-2281d2",
    "offset": 7996,
    "text": "Sagaristio:\nScelerate, etiam respicis?"
  },
  {
    "id": "p-920908",
    "offset": 8036,
    "text": "Paegnivm:"
  },
  {
    "id": "p-e4530b",
    "offset": 8047,
    "text": "Scio ego quid sim aetatis, eo istuc maledictum impune auferes."
  },
  {
    "id": "p-619f23",
    "offset": 8111,
    "text": "Sagaristio:\nVbi Tóxilus est tuus érus?"
  },
  {
    "id": "p-2627b6",
    "offset": 8151,
    "text": "Paegnivm:\nVbi illí libet, néque te consulit."
  },
  {
    "id": "p-f6e295",
    "offset": 8197,
    "text": "Sagaristio:\nEtiam dicís ubi sit, venéfice?"
  },
  {
    "id": "p-3aee94",
    "offset": 8241,
    "text": "Paegnivm:\nNéscio, inquam, ulmítriba tu."
  },
  {
    "id": "p-63e4a9",
    "offset": 8282,
    "text": "Sagaristio:\nMale dícis maiorí."
  },
  {
    "id": "p-1466c8",
    "offset": 8314,
    "text": "Paegnivm:\nPrior proméritus perpetiáre."
  },
  {
    "id": "p-6ff024",
    "offset": 8354,
    "text": "servam operam, linguam liberam erus iussit med habere."
  },
  {
    "id": "p-2fbddc",
    "offset": 8410,
    "text": "Sagaristio:\nDicisne mi, ubi sit Toxilus?"
  },
  {
    "id": "p-c24dee",
    "offset": 8452,
    "text": "Paegnivm:\nDico ut perpetuo pereas."
  },
  {
    "id": "p-5d2b4c",
    "offset": 8488,
    "text": "Sagaristio:\nCaedere hodie tu restibus."
  },
  {
    "id": "p-92d9a8",
    "offset": 8528,
    "text": "Paegnivm:\nTua quidem, cucule, causa!"
  },
  {
    "id": "p-03e2df",
    "offset": 8566,
    "text": "non hercle, si os perciderim tibi, metuam, morticine."
  },
  {
    "id": "p-ec3bba",
    "offset": 8621,
    "text": "Sagaristio:\nVideo ego te: iam incubitatus es."
  },
  {
    "id": "p-786b92",
    "offset": 8668,
    "text": "Paegnivm:\nIta sum. quid id ad te?"
  },
  {
    "id": "p-ef64c2",
    "offset": 8703,
    "text": "at non sum, ita ut tu, gratiis."
  },
  {
    "id": "p-6eebab",
    "offset": 8736,
    "text": "Sagaristio:\nConfidens."
  },
  {
    "id": "p-95d9ee",
    "offset": 8760,
    "text": "Paegnivm:\nSum hercle vero."
  },
  {
    "id": "p-4260c8",
    "offset": 8788,
    "text": "nam ego me confido liberum fore, tu te numquam speras."
  },
  {
    "id": "p-5e0e64",
    "offset": 8844,
    "text": "Sagaristio:\nPotin ut molestus ne sies?"
  },
  {
    "id": "p-f783b5",
    "offset": 8884,
    "text": "Paegnivm:\nQuod dicis facere non quis."
  },
  {
    "id": "p-7bf7a8",
    "offset": 8923,
    "text": "Sagaristio:\nAbi in malam rem."
  },
  {
    "id": "p-501111",
    "offset": 8954,
    "text": "Paegnivm:\nAt tu domum: nam ibi tibi parata praestost."
  },
  {
    "id": "p-57f6ab",
    "offset": 9009,
    "text": "Sagaristio:\nVadatur hic me."
  },
  {
    "id": "p-cf33b4",
    "offset": 9038,
    "text": "Paegnivm:\nVtinam vades desint, in carcere ut sis."
  },
  {
    "id": "p-70adde",
    "offset": 9089,
    "text": "Sagaristio:"
  },
  {
    "id": "p-5adf00",
    "offset": 9102,
    "text": "Quid hoc?"
  },
  {
    "id": "p-226a0f",
    "offset": 9113,
    "text": "Paegnivm:\nQuid est?"
  },
  {
    "id": "p-0dfdcd",
    "offset": 9134,
    "text": "Sagaristio:\nEtiam, scelus, male loquere?"
  },
  {
    "id": "p-d0e146",
    "offset": 9176,
    "text": "Paegnivm:\nTandem ut liceat, quom servos sis, servom tibi male dicere."
  },
  {
    "id": "p-7b8722",
    "offset": 9247,
    "text": "Sagaristio:\nItane? specta quid dedero."
  },
  {
    "id": "p-d28812",
    "offset": 9287,
    "text": "Paegnivm:\nNil, nam nil habes."
  },
  {
    "id": "p-4048f7",
    "offset": 9318,
    "text": "Sagaristio:\nDi deaeque me omnes perdant—"
  },
  {
    "id": "p-848377",
    "offset": 9360,
    "text": "Paegnivm:\nAmicus sum, eveniant volo tibi quae optas."
  },
  {
    "id": "p-dfa048",
    "offset": 9414,
    "text": "Sagaristio:\nAtque id fiat, nisi te hodie, si prehendero, defigam in terram colaphis."
  },
  {
    "id": "p-920908",
    "offset": 9500,
    "text": "Paegnivm:"
  },
  {
    "id": "p-6eeb78",
    "offset": 9511,
    "text": "Tun me defigas? te cruci ipsum adfigent propediem alii."
  },
  {
    "id": "p-6ecf59",
    "offset": 9568,
    "text": "Sagaristio:\nQui te di deaeque—scis quid hinc porro dicturus fuerim, ni linguae moderari queam. potin abeas?"
  },
  {
    "id": "p-960c71",
    "offset": 9677,
    "text": "Paegnivm:\nAbigis facile."
  },
  {
    "id": "p-4ccbbb",
    "offset": 9703,
    "text": "nam umbra mea iam intus vapulat.—"
  },
  {
    "id": "p-05c28e",
    "offset": 9738,
    "text": "Sagaristio:\nVt istúnc di deaeque perdant."
  },
  {
    "id": "p-de4d2c",
    "offset": 9781,
    "text": "tamquam proserpens bestiast bilinguis et scelestus."
  },
  {
    "id": "p-f1f5ea",
    "offset": 9834,
    "text": "hercle illum abiisse gaudeo. foris aperit, eccere autem quem convenire maxime cupiebam egreditur intus."
  },
  {
    "id": "p-2a3820",
    "offset": 9939,
    "text": "Toxilvs:\nParatum iam esse dicito, unde argentum sit futurum, iubeto habere animum bonum, dic me illam amare multum;"
  },
  {
    "id": "p-fdc286",
    "offset": 10056,
    "text": "ubi se adiuvat, ibi me adiuvat. quae dixi ut nuntiares, satin ea tenes?"
  },
  {
    "id": "p-e3337d",
    "offset": 10129,
    "text": "Sophoclidisca:\nMagis cálleo quam aprugnum callum callet.—"
  },
  {
    "id": "p-af1819",
    "offset": 10188,
    "text": "Toxilvs:"
  },
  {
    "id": "p-4a8b23",
    "offset": 10198,
    "text": "Propera, abi domum."
  },
  {
    "id": "p-ca2755",
    "offset": 10219,
    "text": "Sagaristio:\nNunc ego huic graphice facetus fiam."
  },
  {
    "id": "p-f72cb5",
    "offset": 10269,
    "text": "subnixis alis me inferam atque amicibor gloriose."
  },
  {
    "id": "p-c41a01",
    "offset": 10320,
    "text": "Toxilvs:\nSed quís hic ansatus ambulat?"
  },
  {
    "id": "p-43e619",
    "offset": 10360,
    "text": "Sagaristio:\nMagnifice conscreabor."
  },
  {
    "id": "p-566236",
    "offset": 10396,
    "text": "Toxilvs:\nSagaristio hic quidemst. quíd agitur, Sagaristio? ut valetur?"
  },
  {
    "id": "p-ccce5f",
    "offset": 10468,
    "text": "ecquid, quod mandavi tibi, †estne in te speculae?"
  },
  {
    "id": "p-e22fe2",
    "offset": 10519,
    "text": "Sagaristio:\nAdito."
  },
  {
    "id": "p-d3f02a",
    "offset": 10539,
    "text": "videbitur. factum volo. venito. promoneto."
  },
  {
    "id": "p-0ca7e8",
    "offset": 10583,
    "text": "Toxilvs:\nQuid hoc híc in collo tibi tumet?"
  },
  {
    "id": "p-1a9ffc",
    "offset": 10627,
    "text": "Sagaristio:\nVomicast, pressare parce;"
  },
  {
    "id": "p-c49533",
    "offset": 10666,
    "text": "nam ubi quí mala tangit manu, dolores cooriuntur."
  },
  {
    "id": "p-eda526",
    "offset": 10717,
    "text": "Toxilvs:\nQuando istaec innatast tibi?"
  },
  {
    "id": "p-4811e9",
    "offset": 10756,
    "text": "Sagaristio:\nHodie."
  },
  {
    "id": "p-9d1782",
    "offset": 10776,
    "text": "Toxilvs:\nSecari iubeas."
  },
  {
    "id": "p-9936cb",
    "offset": 10801,
    "text": "Sagaristio:\nMetuo, ne immaturam secem, ne exhibeat plus negoti."
  },
  {
    "id": "p-af1819",
    "offset": 10866,
    "text": "Toxilvs:"
  },
  {
    "id": "p-194c24",
    "offset": 10876,
    "text": "Inspicere morbum tuom lubet."
  },
  {
    "id": "p-037e03",
    "offset": 10906,
    "text": "Sagaristio:\nAh ah, abi atque cave sis a cornu."
  },
  {
    "id": "p-be397a",
    "offset": 10954,
    "text": "Toxilvs:\nQuid iam?"
  },
  {
    "id": "p-09d354",
    "offset": 10974,
    "text": "Sagaristio:\nQuia boves bini hic sunt in crumina."
  },
  {
    "id": "p-22dec2",
    "offset": 11024,
    "text": "Toxilvs:\nEmitte sodes, ne enices fame; sine ire pastum."
  },
  {
    "id": "p-8fde6b",
    "offset": 11081,
    "text": "Sagaristio:\nEnim métuo, ut possim reicere in bubile, ne vagentur."
  },
  {
    "id": "p-166ee8",
    "offset": 11148,
    "text": "Toxilvs:\nEgo reiciam. habe animum bonum."
  },
  {
    "id": "p-814d66",
    "offset": 11190,
    "text": "Sagaristio:\nCredetur, commodabo."
  },
  {
    "id": "p-3c57fa",
    "offset": 11224,
    "text": "sequere hac sis. argentum hic inest, quod mecum dudum orasti."
  },
  {
    "id": "p-17c6b0",
    "offset": 11287,
    "text": "Toxilvs:\nQuid tú ais?"
  },
  {
    "id": "p-9eacc5",
    "offset": 11310,
    "text": "Sagaristio:\nDominus me bovis mercatum Eretriam misit."
  },
  {
    "id": "p-cd86a7",
    "offset": 11365,
    "text": "nunc mi Eretria erit haec tua domus."
  },
  {
    "id": "p-fa5744",
    "offset": 11403,
    "text": "Toxilvs:\nNimis tú facete loquere."
  },
  {
    "id": "p-920c5c",
    "offset": 11438,
    "text": "atque ego omne argentúm tibi hoc actutum incolume redigam;"
  },
  {
    "id": "p-b3e774",
    "offset": 11498,
    "text": "nam iam omnes sycophantias instruxi et comparavi, quo pacto ab lenone auferam hoc argentum,"
  },
  {
    "id": "p-d2bb87",
    "offset": 11591,
    "text": "Sagaristio:\nTanto melior."
  },
  {
    "id": "p-a964ae",
    "offset": 11618,
    "text": "Toxilvs:\nEt mulier ut sit libera atque ipse ultro det argentum."
  },
  {
    "id": "p-4e6afb",
    "offset": 11683,
    "text": "sed sequere me: ad eam rem usus est tua mihi opera.—"
  },
  {
    "id": "p-01b108",
    "offset": 11737,
    "text": "Sagaristio:\nVtere ut vis.—"
  }
]