[
  {
    "id": "p-770f6e",
    "offset": 0,
    "text": "1. Phoebe silvarumque potens Diana,"
  },
  {
    "id": "p-6d3e49",
    "offset": 37,
    "text": "Lucidum caeli decus, o colendi"
  },
  {
    "id": "p-7413f7",
    "offset": 69,
    "text": "Semper et culti, date quae precamur"
  },
  {
    "id": "p-328775",
    "offset": 106,
    "text": "Tempore sacro,"
  },
  {
    "id": "p-549b8c",
    "offset": 122,
    "text": "Quo Sibyllini monuere versus"
  },
  {
    "id": "p-076c2a",
    "offset": 152,
    "text": "Virgines lectas puerosque castos"
  },
  {
    "id": "p-c6f72d",
    "offset": 186,
    "text": "Dis quibus septem placuere colles"
  },
  {
    "id": "p-14d5dd",
    "offset": 221,
    "text": "Dicere carmen."
  },
  {
    "id": "p-e6d38e",
    "offset": 237,
    "text": "Alme Sol, curru nitido diem qui"
  },
  {
    "id": "p-2d7cf0",
    "offset": 270,
    "text": "Promis et celas aliusque et idem"
  },
  {
    "id": "p-89a6a8",
    "offset": 304,
    "text": "Nasceris, possis nihil urbe Roma"
  },
  {
    "id": "p-517870",
    "offset": 338,
    "text": "Visere maius !"
  },
  {
    "id": "p-fa5fc8",
    "offset": 354,
    "text": "Rite maturos aperire partus"
  },
  {
    "id": "p-1179bd",
    "offset": 383,
    "text": "Lenis, Ilithyia, tuere matres,"
  },
  {
    "id": "p-1928ab",
    "offset": 415,
    "text": "Sive tu Lucina probas vocari"
  },
  {
    "id": "p-57776d",
    "offset": 445,
    "text": "Seu Genitalis:"
  },
  {
    "id": "p-1684b2",
    "offset": 461,
    "text": "Diva, producas subolem patrumque"
  },
  {
    "id": "p-bcb99a",
    "offset": 495,
    "text": "Prosperes decreta super iugandis"
  },
  {
    "id": "p-67be07",
    "offset": 529,
    "text": "Feminis prolisque novae feraci"
  },
  {
    "id": "p-9c4b1e",
    "offset": 561,
    "text": "Lege marita,"
  },
  {
    "id": "p-213b51",
    "offset": 575,
    "text": "Certus undenos deciens per annos"
  },
  {
    "id": "p-37aa4d",
    "offset": 609,
    "text": "Orbis ut cantus referatque ludos"
  },
  {
    "id": "p-75df49",
    "offset": 643,
    "text": "Ter die claro totiensque grata"
  },
  {
    "id": "p-bb4f77",
    "offset": 675,
    "text": "Nocte frequentes."
  },
  {
    "id": "p-00a423",
    "offset": 694,
    "text": "Vosque veraces cecinisse, Parcae,"
  },
  {
    "id": "p-bd97a6",
    "offset": 729,
    "text": "Quod semel dictumst stabilisque rerum"
  },
  {
    "id": "p-6e4978",
    "offset": 768,
    "text": "Terminus servet, bona iam peractis"
  },
  {
    "id": "p-efba4e",
    "offset": 804,
    "text": "Iungite fata."
  },
  {
    "id": "p-0e3a17",
    "offset": 819,
    "text": "Fertilis frugum pecorisque tellus"
  },
  {
    "id": "p-fa147c",
    "offset": 854,
    "text": "Spicea donet Cererem corona;"
  },
  {
    "id": "p-2b3909",
    "offset": 884,
    "text": "Nutriant fetus et aquae salubres"
  },
  {
    "id": "p-54896e",
    "offset": 918,
    "text": "Et Iovis aurae."
  },
  {
    "id": "p-000609",
    "offset": 935,
    "text": "Condito mitis placidusque telo"
  },
  {
    "id": "p-543e99",
    "offset": 967,
    "text": "Supplices audi pueros, Apollo;"
  },
  {
    "id": "p-ef5e79",
    "offset": 999,
    "text": "Siderum regina bicornis, audi,"
  },
  {
    "id": "p-31b732",
    "offset": 1031,
    "text": "Luna, puellas:"
  },
  {
    "id": "p-89acc9",
    "offset": 1047,
    "text": "Roma si vestrumst opus, Iliaeque"
  },
  {
    "id": "p-1507bd",
    "offset": 1081,
    "text": "Litus Etruscum tenuere turmae,"
  },
  {
    "id": "p-a82b1c",
    "offset": 1113,
    "text": "Iussa pars mutare Lares et urbem"
  },
  {
    "id": "p-15465e",
    "offset": 1147,
    "text": "Sospite cursu,"
  },
  {
    "id": "p-5a992b",
    "offset": 1163,
    "text": "Cui per ardentem sine fraude Troiam"
  },
  {
    "id": "p-f8e77d",
    "offset": 1200,
    "text": "Castus Aeneas patriae superstes"
  },
  {
    "id": "p-da247a",
    "offset": 1233,
    "text": "Liberum munivit iter, daturus"
  },
  {
    "id": "p-590012",
    "offset": 1264,
    "text": "Plura relictis:"
  },
  {
    "id": "p-045722",
    "offset": 1281,
    "text": "Di, probos mores docili iuventae,"
  },
  {
    "id": "p-d0baab",
    "offset": 1316,
    "text": "Di, senectuti placidae quietem,"
  },
  {
    "id": "p-1c536a",
    "offset": 1349,
    "text": "Romulae genti date remque prolemque"
  },
  {
    "id": "p-5cfb77",
    "offset": 1386,
    "text": "Et decus omne."
  },
  {
    "id": "p-cd2c75",
    "offset": 1402,
    "text": "Quaeque vos bobus veneratur albis"
  },
  {
    "id": "p-03531d",
    "offset": 1437,
    "text": "Clarus Anchisae Venerisque sanguis,"
  },
  {
    "id": "p-0c0923",
    "offset": 1474,
    "text": "Impetret, bellante prior, iacentem"
  },
  {
    "id": "p-7a0ef7",
    "offset": 1510,
    "text": "Lenis in hostem."
  },
  {
    "id": "p-1d632e",
    "offset": 1528,
    "text": "iam mari terraque manus potentes"
  },
  {
    "id": "p-8c815c",
    "offset": 1562,
    "text": "Medus Albanasque timet secures,"
  },
  {
    "id": "p-2e9c01",
    "offset": 1595,
    "text": "Iam Scythae responsa petunt superbi"
  },
  {
    "id": "p-47f657",
    "offset": 1632,
    "text": "Nuper, et Indi."
  },
  {
    "id": "p-603d57",
    "offset": 1649,
    "text": "Iam Fides et Pax et Honor Pudorque"
  },
  {
    "id": "p-95b8fb",
    "offset": 1685,
    "text": "Priscus et neglecta redire Virtus"
  },
  {
    "id": "p-fadab3",
    "offset": 1720,
    "text": "Audet, adparetque beata pleno"
  },
  {
    "id": "p-966cbf",
    "offset": 1751,
    "text": "Copia cornu."
  },
  {
    "id": "p-460eb1",
    "offset": 1765,
    "text": "Augur et fulgente decorus arcu"
  },
  {
    "id": "p-0e85d7",
    "offset": 1797,
    "text": "Phoebus acceptusque novem Camenis,"
  },
  {
    "id": "p-926b1b",
    "offset": 1833,
    "text": "Qui salutari levat arte fessos"
  },
  {
    "id": "p-2c1550",
    "offset": 1865,
    "text": "Corporis artus,"
  },
  {
    "id": "p-8d3a83",
    "offset": 1882,
    "text": "Si Palatinas videt aequus arces,"
  },
  {
    "id": "p-73a2a4",
    "offset": 1916,
    "text": "Remque Romanam Latiumque felix"
  },
  {
    "id": "p-5524f1",
    "offset": 1948,
    "text": "Alterum in lustrum meliusque semper"
  },
  {
    "id": "p-895a7c",
    "offset": 1985,
    "text": "Prorogat aevum."
  },
  {
    "id": "p-d20b6f",
    "offset": 2002,
    "text": "Quaeque Aventinum tenet Algidumque,"
  },
  {
    "id": "p-19c9f1",
    "offset": 2039,
    "text": "Quindecim Diana preces virorum"
  },
  {
    "id": "p-6f2afd",
    "offset": 2071,
    "text": "Curat et votis puerorum amicas"
  },
  {
    "id": "p-c94c13",
    "offset": 2103,
    "text": "Adplicat aures."
  },
  {
    "id": "p-70f1d2",
    "offset": 2120,
    "text": "Haec Iovem sentire deosque cunctos"
  },
  {
    "id": "p-f54bd9",
    "offset": 2156,
    "text": "Spem bonam certamque domum reporto,"
  },
  {
    "id": "p-d87ccd",
    "offset": 2193,
    "text": "Doctus et Phoebi chorus et Dianae"
  },
  {
    "id": "p-7b7fe8",
    "offset": 2228,
    "text": "Dicere laudes."
  }
]