[
  {
    "id": "p-6aeac2",
    "offset": 0,
    "text": "Σὺ δὲ λάλει ἃ πρέπει τῇ ὑγιαινούσῃ διδασκαλίᾳ."
  },
  {
    "id": "p-dc3610",
    "offset": 48,
    "text": "Πρεσβύτας νηφαλίους εἶναι, σεμνούς, σώφρονας, ὑγιαίνοντας"
  },
  {
    "id": "p-3362aa",
    "offset": 107,
    "text": "τῇ πίστει, τῇ ἀγάπῃ, τῇ ὑπομονῇ."
  },
  {
    "id": "p-1bab26",
    "offset": 141,
    "text": "πρεσβύτιδας"
  },
  {
    "id": "p-a5b818",
    "offset": 154,
    "text": "ὡσαύτως ἐν καταστήματι ἱεροπρεπεῖς, μὴ διαβόλους"
  },
  {
    "id": "p-d1a1b0",
    "offset": 204,
    "text": "μηδὲ οἴνῳ πολλῷ δεδουλωμένας,"
  },
  {
    "id": "p-cdab89",
    "offset": 235,
    "text": "καλοδιδασκάλους,"
  },
  {
    "id": "p-5b1e2f",
    "offset": 253,
    "text": "ἵνα"
  },
  {
    "id": "p-ed85e1",
    "offset": 258,
    "text": "σωφρονίζωσι τὰς νέας φιλάνδρους εἶναι,"
  },
  {
    "id": "p-dbb81f",
    "offset": 298,
    "text": "φιλοτέκνους,"
  },
  {
    "id": "p-7cd6e2",
    "offset": 312,
    "text": "σώφρονας,"
  },
  {
    "id": "p-6db3b6",
    "offset": 323,
    "text": "ἁγνάς, οἰκουργούς, ἀγαθάς, ὑποτασσομένας τοῖς"
  },
  {
    "id": "p-7b7f1c",
    "offset": 370,
    "text": "ἰδίοις ἀνδράσιν, ἵνα μὴ ὁ λόγος τοῦ θεοῦ βλασφημῆται."
  },
  {
    "id": "p-cd7974",
    "offset": 425,
    "text": "τοὺς νεωτέρους ὡσαύτως παρακάλει σωφρονεῖν·"
  },
  {
    "id": "p-797fea",
    "offset": 470,
    "text": "περὶ πάντα"
  },
  {
    "id": "p-67f9d9",
    "offset": 482,
    "text": "σεαυτὸν παρεχόμενος τύπον καλῶν ἔργων,"
  },
  {
    "id": "p-4a9d62",
    "offset": 522,
    "text": "ἐν τῇ διδασκαλίᾳ ἀφθορίαν,"
  },
  {
    "id": "p-b9ebe9",
    "offset": 550,
    "text": "σεμνότητα,"
  },
  {
    "id": "p-d7df1d",
    "offset": 562,
    "text": "λόγον ὑγιῆ ἀκατάγνωστον, ἵνα"
  },
  {
    "id": "p-9ba379",
    "offset": 592,
    "text": "ὁ ἐξ ἐναντίας ἐντραπῇ μηδὲν ἔχων λέγειν περὶ ἡμῶν φαῦλον."
  },
  {
    "id": "p-b7c85a",
    "offset": 651,
    "text": "δούλους ἰδίοις δεσπόταις ὑποτάσσεσθαι ἐν πᾶσιν,"
  },
  {
    "id": "p-8b11e8",
    "offset": 700,
    "text": "εὐαρέστους εἶναι,"
  },
  {
    "id": "p-304f4f",
    "offset": 719,
    "text": "μὴ ἀντιλέγοντας,"
  },
  {
    "id": "p-1d5883",
    "offset": 737,
    "text": "μὴ νοσφιζομένους,"
  },
  {
    "id": "p-54befa",
    "offset": 756,
    "text": "ἀλλὰ πᾶσαν πίστιν ἐνδεικνυμένους ἀγαθήν, ἵνα τὴν"
  },
  {
    "id": "p-1f76ab",
    "offset": 806,
    "text": "διδασκαλίαν τὴν τοῦ σωτῆρος ἡμῶν θεοῦ κοσμῶσιν ἐν"
  },
  {
    "id": "p-f3dcec",
    "offset": 857,
    "text": "πᾶσιν."
  },
  {
    "id": "p-063090",
    "offset": 865,
    "text": "Ἐπεφάνη γὰρ ἡ χάρις τοῦ θεοῦ σωτήριος"
  },
  {
    "id": "p-f77e69",
    "offset": 904,
    "text": "πᾶσιν ἀνθρώποις παιδεύουσα ἡμᾶς,"
  },
  {
    "id": "p-1c3f4f",
    "offset": 938,
    "text": "ἵνα ἀρνησάμενοι"
  },
  {
    "id": "p-426770",
    "offset": 955,
    "text": "τὴν ἀσέβειαν καὶ τὰς κοσμικὰς ἐπιθυμίας σωφρόνως καὶ"
  },
  {
    "id": "p-dc814e",
    "offset": 1009,
    "text": "δικαίως καὶ εὐσεβῶς ζήσωμεν ἐν τῷ νῦν αἰῶνι,"
  },
  {
    "id": "p-ed34f5",
    "offset": 1055,
    "text": "προσδεχόμενοι"
  },
  {
    "id": "p-95fe35",
    "offset": 1070,
    "text": "τὴν μακαρίαν ἐλπίδα καὶ ἐπιφάνειαν τῆς δόξης τοῦ"
  },
  {
    "id": "p-e3fdf2",
    "offset": 1120,
    "text": "μεγάλου θεοῦ καὶ σωτῆρος ἡμῶν Χριστοῦ Ἰησοῦ,"
  },
  {
    "id": "p-b1f4ec",
    "offset": 1166,
    "text": "ὃς"
  },
  {
    "id": "p-e477d7",
    "offset": 1170,
    "text": "ἔδωκεν ἑαυτὸν ὑπὲρ ἡμῶν ἵνα λυτρώσηται ἡμᾶς ἀπὸ πάσης"
  },
  {
    "id": "p-21dd8e",
    "offset": 1225,
    "text": "ἀνομίας καὶ καθαρίσῃ ἑαυτῷ λαὸν περιούσιον, ζηλωτὴν"
  },
  {
    "id": "p-8a4739",
    "offset": 1278,
    "text": "καλῶν ἔργων."
  },
  {
    "id": "p-598cf7",
    "offset": 1292,
    "text": "Ταῦτα λάλει καὶ παρακάλει"
  },
  {
    "id": "p-124ba3",
    "offset": 1319,
    "text": "καὶ ἔλεγχε μετὰ πάσης ἐπιταγῆς· μηδείς σου περιφρονείτω."
  }
]