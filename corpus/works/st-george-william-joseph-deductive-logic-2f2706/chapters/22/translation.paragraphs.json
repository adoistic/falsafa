[
  {
    "id": "p-bbe5eb",
    "offset": 0,
    "text": "Analyse the following propositions into subject, copula and predicate:--"
  },
  {
    "id": "p-177a00",
    "offset": 74,
    "text": "(1) He being dead yet speaketh."
  },
  {
    "id": "p-57a5ff",
    "offset": 107,
    "text": "(2) There are foolish politicians."
  },
  {
    "id": "p-3bd4f1",
    "offset": 143,
    "text": "(3) Little does he care."
  },
  {
    "id": "p-8237c8",
    "offset": 169,
    "text": "(4) There is a land of pure delight."
  },
  {
    "id": "p-753e70",
    "offset": 207,
    "text": "(5) All's well that ends well."
  },
  {
    "id": "p-bbcf5c",
    "offset": 239,
    "text": "(6) Sweet is the breath of morn."
  },
  {
    "id": "p-c86229",
    "offset": 273,
    "text": "(7) Now it came to pass that the beggar died."
  },
  {
    "id": "p-e421c5",
    "offset": 320,
    "text": "(8) Who runs may read."
  },
  {
    "id": "p-a8ffc3",
    "offset": 344,
    "text": "(9) Great is Diana of the Ephesians."
  },
  {
    "id": "p-ece31b",
    "offset": 382,
    "text": "(10) Such things are."
  },
  {
    "id": "p-f67af8",
    "offset": 405,
    "text": "(11) Not more than others I deserve."
  },
  {
    "id": "p-a03446",
    "offset": 443,
    "text": "(12) The day will come when Ilium's towers shall perish."
  }
]