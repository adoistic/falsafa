[
  {
    "id": "p-48746b",
    "offset": 0,
    "text": "Πόδαγρος, Χόρος, Ποδάγρα, Ἄγγελος, Ἰατροὶ, Βάσανοι"
  },
  {
    "id": "p-423fca",
    "offset": 52,
    "text": "Πόδαγρος\nὦ στυγνὸν οὔνομʼ, ὦ θεοῖς στυγούμενον,"
  },
  {
    "id": "p-16e3af",
    "offset": 101,
    "text": "ποδάγρα, πολυστένακτε, Κωκυτοῦ τέκνον,"
  },
  {
    "id": "p-daf918",
    "offset": 141,
    "text": "ἣν Ταρτάρου κευθμῶσιν ἐν βαθυσκίοις"
  },
  {
    "id": "p-54d126",
    "offset": 178,
    "text": "Μέγαιρʼ Ἐρινὺς γαστρὸς ἐξεγείνατο"
  },
  {
    "id": "p-a01daa",
    "offset": 213,
    "text": "μαζοῖσί τʼ ἐξέθρεψε, καὶ πικρῷ βρέφει"
  },
  {
    "id": "p-2ce3ea",
    "offset": 252,
    "text": "εἰς χεῖλος ἐστάλαξεν Ἀλληκτὼ γάλα,"
  },
  {
    "id": "p-f69efe",
    "offset": 288,
    "text": "τίς τὴν δυσώνυμόν σε δαιμόνων ἄρα"
  },
  {
    "id": "p-e9a617",
    "offset": 323,
    "text": "εἰς φῶς ἀνῆκεν; ἦλθες ἀνθρώποις βλάβος."
  },
  {
    "id": "p-abab39",
    "offset": 364,
    "text": "εἰ γὰρ τεθνῶσιν ἀμπλακημάτων τίσις"
  },
  {
    "id": "p-4a7e71",
    "offset": 400,
    "text": "βροτοῖς ὀπηδεῖ τῶν ἔδρασαν ἐν φάει,"
  },
  {
    "id": "p-a31ba4",
    "offset": 437,
    "text": "οὐ Τάνταλον ποτοῖσιν, οὐδʼ Ἰξίονα"
  },
  {
    "id": "p-8b3f57",
    "offset": 472,
    "text": "τροχῷ στροβητόν, οὐδὲ Σίσυφον πέτρῳ"
  },
  {
    "id": "p-f14050",
    "offset": 509,
    "text": "ἔδει κολάζειν ἐν δόμοισι Πλουτέως,"
  },
  {
    "id": "p-d40fd8",
    "offset": 545,
    "text": "ἁπλῶς δὲ πάντας τοὺς κακῶς δεδρακότας"
  },
  {
    "id": "p-12d8ed",
    "offset": 584,
    "text": "τοῖς σοῖς προσάπτειν ἀρθροκηδέσιν πόνοις,"
  },
  {
    "id": "p-7f8cfb",
    "offset": 627,
    "text": "ὥς μου τὸ λυπρὸν καὶ ταλαίπωρον δέμας"
  },
  {
    "id": "p-60b88a",
    "offset": 666,
    "text": "χειρῶν ἀπʼ ἄκρων εἰς ἄκρας ποδῶν βάσεις"
  },
  {
    "id": "p-a25259",
    "offset": 707,
    "text": "ἰχῶρι φαύλῳ καὶ πικρῷ χυμῷ χολῆς"
  },
  {
    "id": "p-b7c6bc",
    "offset": 741,
    "text": "πνεύματι βιαίῳ τόδε διασφίγγον πόρους"
  },
  {
    "id": "p-8e8903",
    "offset": 780,
    "text": "ἕστηκε καὶ μεμυκὸς ἐπιτείνει πόνους."
  },
  {
    "id": "p-74c49d",
    "offset": 818,
    "text": "σπλάγχνων δʼ ἐπʼ αὐτῶν διάπυρον τρέχει κακόν,"
  },
  {
    "id": "p-2a4763",
    "offset": 865,
    "text": "δίναισι φλογμῶν σάρκα πυρπολούμενον,"
  },
  {
    "id": "p-8e862b",
    "offset": 903,
    "text": "ὁποῖα κρητὴρ μεστὸς Αἰτναίου πυρὸς"
  },
  {
    "id": "p-f7d37b",
    "offset": 939,
    "text": "ἢ Σικελὸς αὐλὼν ἁλιπόρου διασφάγος,"
  },
  {
    "id": "p-916619",
    "offset": 976,
    "text": "ὅπου δυσεξέλικτα κυματούμενος"
  },
  {
    "id": "p-caab3f",
    "offset": 1007,
    "text": "σήραγξι πετρῶν σκολιὸς εἱλεῖται κλύδων."
  },
  {
    "id": "p-7d8ae6",
    "offset": 1048,
    "text": "ὦ δυστέκμαρτον πᾶσιν ἀνθρώποις τέλος,"
  },
  {
    "id": "p-8c674f",
    "offset": 1087,
    "text": "ὡς εἰς μάτην σε πάντες ἀμφιθάλπομεν"
  },
  {
    "id": "p-d54a61",
    "offset": 1124,
    "text": "ἐλπίδι ματαίᾳ μωρὰ βουκολούμενοι."
  },
  {
    "id": "p-5b3aea",
    "offset": 1159,
    "text": "Χόρος\nἀνὰ Δίνδυμον Κυβήβης"
  },
  {
    "id": "p-0e8f7e",
    "offset": 1187,
    "text": "Φρύγες ἔνθεον ὀλολυγὴν"
  },
  {
    "id": "p-ec27d6",
    "offset": 1211,
    "text": "ἁπαλῷ τελοῦσιν Ἄττῃ,"
  },
  {
    "id": "p-87a000",
    "offset": 1233,
    "text": "καὶ πρὸς μέλος κεραύλου"
  },
  {
    "id": "p-420715",
    "offset": 1258,
    "text": "Φρυγίου κατʼ ὄρεα Τμώλου"
  },
  {
    "id": "p-185f48",
    "offset": 1284,
    "text": "κῶμον βοῶσι Λυδοί·"
  },
  {
    "id": "p-5737da",
    "offset": 1304,
    "text": "παραπλῆγες δʼ ἀμφὶ ῥόπτροις"
  },
  {
    "id": "p-79ada6",
    "offset": 1333,
    "text": "κελαδοῦσι Κρητὶ ῥυθμῷ"
  },
  {
    "id": "p-f60175",
    "offset": 1356,
    "text": "νόμον Κορύβαντες εὐάν."
  },
  {
    "id": "p-d98e81",
    "offset": 1380,
    "text": "κλάζει βρίθουσα σάλπιγξ"
  },
  {
    "id": "p-bd9c03",
    "offset": 1405,
    "text": "Ἄρει κρέκουσα θούρῳ"
  },
  {
    "id": "p-f9c167",
    "offset": 1426,
    "text": "πολεμηίαν ἀϋτήν."
  },
  {
    "id": "p-fcca60",
    "offset": 1444,
    "text": "ἡμεῖς δὲ σοί, Ποδάγρα,"
  },
  {
    "id": "p-ba06ab",
    "offset": 1468,
    "text": "πρώταις ἔαρος ἐν ὥραις"
  },
  {
    "id": "p-2bf96d",
    "offset": 1492,
    "text": "μύσται τελοῦμεν οἴκτους,"
  },
  {
    "id": "p-6fe420",
    "offset": 1518,
    "text": "ὅτε πᾶς χλοητόκοισι"
  },
  {
    "id": "p-ea0a2e",
    "offset": 1539,
    "text": "ποίαις τέθηλε λειμών,"
  },
  {
    "id": "p-9590ec",
    "offset": 1562,
    "text": "Ζεφύρου δὲ δένδρα πνοιαῖς"
  },
  {
    "id": "p-578f26",
    "offset": 1589,
    "text": "ἁπαλοῖς κομᾷ πετήλοις,"
  },
  {
    "id": "p-177542",
    "offset": 1613,
    "text": "ἁ δύσγαμος κατʼ οἴκους"
  },
  {
    "id": "p-86d9e3",
    "offset": 1637,
    "text": "μερόπων θροεῖ χελιδών,"
  },
  {
    "id": "p-f6aaf1",
    "offset": 1661,
    "text": "καὶ νυκτέροις καθʼ ὕλαν"
  },
  {
    "id": "p-75993f",
    "offset": 1686,
    "text": "τὸν Ἴτυν στένει δακρύουσʼ"
  },
  {
    "id": "p-d7ef3b",
    "offset": 1713,
    "text": "Ἀτθὶς γόοις ἀηδών."
  },
  {
    "id": "p-b4d19c",
    "offset": 1733,
    "text": "Πόδαγρος\nὤμοι πόνων ἀρωγόν, ὦ τρίτου ποδὸς"
  },
  {
    "id": "p-e14c08",
    "offset": 1777,
    "text": "μοῖραν λελογχὸς βάκτρον, ἐξέρειδέ μου"
  },
  {
    "id": "p-b0a2b0",
    "offset": 1816,
    "text": "βάσιν τρέμουσαν καὶ κατίθυνον τρίβον,"
  },
  {
    "id": "p-9b252a",
    "offset": 1855,
    "text": "ἴχνος βέβαιον ὡς ἐπιστήσω πέδῳ."
  },
  {
    "id": "p-efec2c",
    "offset": 1888,
    "text": "ἔγειρε, τλῆμον, γυῖα δεμνίων ἄπο"
  },
  {
    "id": "p-eca31e",
    "offset": 1922,
    "text": "καὶ λίπε μελάθρων τὴν ὑπώροφον στέγην."
  },
  {
    "id": "p-70a201",
    "offset": 1962,
    "text": "σκέδασον δʼ ἀπʼ ὄσσων νύχιον ἀέρος βάθος"
  },
  {
    "id": "p-0e11cb",
    "offset": 2004,
    "text": "μολὼν θύραζε καὶ πρὸς ἡλίου φάος"
  },
  {
    "id": "p-4a6906",
    "offset": 2038,
    "text": "ἀθόλωτον αὔραν πνεύματος φαιδροῦ σπάσον·"
  },
  {
    "id": "p-4042f8",
    "offset": 2080,
    "text": "δέκατον γὰρ ἤδη τοῦτο πρὸς πέμπτῳ φάει,"
  },
  {
    "id": "p-41a702",
    "offset": 2121,
    "text": "ἐξ οὗ ζόφῳ σύγκλειστος ἡλίου δίχα"
  },
  {
    "id": "p-7174f8",
    "offset": 2156,
    "text": "εὐναῖς ἐν ἀστρώτοισι τείρομαι δέμας."
  },
  {
    "id": "p-988a9c",
    "offset": 2194,
    "text": "ψυχὴ μὲν οὖν μοι καὶ προθυμία πάρα"
  },
  {
    "id": "p-81a88d",
    "offset": 2230,
    "text": "βάσεις ἀμείβειν ἐπὶ θύρας ὡρμημένῳ,"
  },
  {
    "id": "p-504868",
    "offset": 2267,
    "text": "δέμας δὲ νωθρὸν οὐχ ὑπηρετεῖ πόθοις."
  },
  {
    "id": "p-d18fc1",
    "offset": 2305,
    "text": "ὅμως δʼ ἐπείγου, θυμέ, γιγνώσκων ὅτι"
  },
  {
    "id": "p-734e8f",
    "offset": 2343,
    "text": "πτωχὸς ποδαγρῶν, περιπατεῖν μὲν ἂν θέλῃ"
  },
  {
    "id": "p-539d38",
    "offset": 2384,
    "text": "καὶ μὴ δύνηται, τοῦτον ἐν νεκροῖς τίθει."
  },
  {
    "id": "p-2e533f",
    "offset": 2426,
    "text": "ἀλλʼ εἶα."
  },
  {
    "id": "p-a9a15e",
    "offset": 2437,
    "text": "τίνες γὰρ οἵδε βάκτρα νωμῶντες χεροῖν,"
  },
  {
    "id": "p-b84d9f",
    "offset": 2477,
    "text": "κάρηνα φύλλοις ἀκτέας καταστεφεῖς;"
  },
  {
    "id": "p-d4e5dc",
    "offset": 2513,
    "text": "τίνι δαιμόνων ἄγουσι κωμαστὴν χορόν;"
  },
  {
    "id": "p-5c34c8",
    "offset": 2551,
    "text": "μῶν, Φοῖβε Παιάν, σὸν γεραίρουσιν σέβας;"
  },
  {
    "id": "p-851963",
    "offset": 2593,
    "text": "ἀλλʼ οὐ στέφονται Δελφίδος φύλλῳ δάφνης."
  },
  {
    "id": "p-31489d",
    "offset": 2635,
    "text": "ἢ μή τις ὕμνος Βακχίῳ κωμάζεται;"
  },
  {
    "id": "p-d220a4",
    "offset": 2669,
    "text": "ἀλλ’ οὐκ ἔπεστι κισσίνη σφραγὶς κόμαις."
  },
  {
    "id": "p-70c498",
    "offset": 2710,
    "text": "τίνες ποθ’ ἡμῖν, ὦ ξένοι, βεβήκατε;"
  },
  {
    "id": "p-9e2b7f",
    "offset": 2747,
    "text": "αὐδᾶτε καὶ πρόεσθε νημερτῆ λόγον."
  },
  {
    "id": "p-2b1133",
    "offset": 2782,
    "text": "τίς δ’ ἔστιν, ἣν ὑμνεῖτε, λέξατ’, ὦ φίλοι."
  },
  {
    "id": "p-965397",
    "offset": 2826,
    "text": "Χόρος\nΣὺ δ’ ὢν τίς ἡμᾶς καὶ τίνων προσεννέπεις;"
  },
  {
    "id": "p-5055c7",
    "offset": 2875,
    "text": "ὡς γάρ σε βάκτρον καὶ βάσις μηνύετον,"
  },
  {
    "id": "p-2d212f",
    "offset": 2914,
    "text": "μύστην ὁρῶμεν τῆς ἀνικήτου θεᾶς."
  },
  {
    "id": "p-4b8a48",
    "offset": 2948,
    "text": "Πόδαγρος\nΕἶς εἰμι κἀγὼ τῆς θεᾶς ἐπάξιος;"
  },
  {
    "id": "p-d457e7",
    "offset": 2990,
    "text": "Χόρος\nΤὰν μὲν Κυπρίαν Ἀφροδίταν"
  },
  {
    "id": "p-c0fa3f",
    "offset": 3023,
    "text": "σταγόνων προπεσοῦσαν ἀπ’ αἰθέρος"
  },
  {
    "id": "p-e696e6",
    "offset": 3057,
    "text": "ἀνεθρέψατο χόσμιον ἁρμογὰν"
  },
  {
    "id": "p-241ec9",
    "offset": 3085,
    "text": "ἁλίοις ἐνὶ κύμασι Νηρεύς."
  },
  {
    "id": "p-e9b00a",
    "offset": 3112,
    "text": "τὰν δ’ Ὠχεανοῦ παρὰ παγαῖς"
  },
  {
    "id": "p-f8727c",
    "offset": 3140,
    "text": "Ζανὸς παράκοιτιν Ὀλυμπίου"
  },
  {
    "id": "p-b664d6",
    "offset": 3167,
    "text": "λευκώλενον εὐρέσι κόλποις"
  },
  {
    "id": "p-1bee83",
    "offset": 3194,
    "text": "Ἥραν ἐτιθήνατο Τηθύς."
  },
  {
    "id": "p-6928d3",
    "offset": 3217,
    "text": "κορυφαῖσι δὲ κρατὸς ἐν ἀφθίτου"
  },
  {
    "id": "p-2c4f46",
    "offset": 3249,
    "text": "ἐλόχευσε κόρας ἄτρομον φυὰν"
  },
  {
    "id": "p-cf8213",
    "offset": 3278,
    "text": "Κρονίδας, μέγ’ ἄριστος Ὀλυμπίων,"
  },
  {
    "id": "p-a8b3f5",
    "offset": 3312,
    "text": "τὰν ἐγρεκύδοιμον ᾿Αθάναν."
  },
  {
    "id": "p-642ea1",
    "offset": 3339,
    "text": "τὰν δ’ ἁμετέραν θεὸν ὀλβίαν"
  },
  {
    "id": "p-bf9a0d",
    "offset": 3368,
    "text": "ὁ γέρων λιπαραῖσιν ἐν ἀγκάλαις"
  },
  {
    "id": "p-a6715e",
    "offset": 3400,
    "text": "πρώταν ἐλόχευσεν Ὁφίων."
  },
  {
    "id": "p-d1370b",
    "offset": 3425,
    "text": "ὅτ’ ἐπαύσατο μὲν σκότιον χάος"
  },
  {
    "id": "p-5ea052",
    "offset": 3456,
    "text": "ἀνέτειλέ τε λαμπέτις ἀὼς"
  },
  {
    "id": "p-d8ff4c",
    "offset": 3482,
    "text": "καὶ παμφαὲς ἀελίου σέλας."
  },
  {
    "id": "p-1cc041",
    "offset": 3509,
    "text": "τότε καὶ Ποδάγρας ἐφάνη κράτος."
  },
  {
    "id": "p-06cbbe",
    "offset": 3542,
    "text": "ὅτε γὰρ λαγόνων σε τεκοῦσα"
  },
  {
    "id": "p-be7480",
    "offset": 3570,
    "text": "Μοῖρα Κλωθὼ τότ’ ἔλουσεν,"
  },
  {
    "id": "p-4c88d2",
    "offset": 3597,
    "text": "ἐγέλασσεν ἅπαν σέλας οὐρανοῦ,"
  },
  {
    "id": "p-3f5148",
    "offset": 3628,
    "text": "μέγα δ’ ἔκτυπεν εὔδιος αἰθήρ·"
  },
  {
    "id": "p-de6ff1",
    "offset": 3659,
    "text": "τὰν δ’ εὐγλαγέτοις ἐνὶ μαξοῖς"
  },
  {
    "id": "p-c67616",
    "offset": 3690,
    "text": "εὔολβος ἐθρέψατο Πλούτων."
  },
  {
    "id": "p-2bb61c",
    "offset": 3717,
    "text": "Πόδαγρος\nΤίσιν δὲ τελεταῖς ὀργιάξει προσπόλους;"
  },
  {
    "id": "p-648a4e",
    "offset": 3766,
    "text": "Χόρος\nΟὐχ αἷμα λάβρον προχέομεν ἀποτομαῖς σιδάρου,"
  },
  {
    "id": "p-57aa4a",
    "offset": 3818,
    "text": "οὐ τριχὸς ἀφέτου λυγίζεται στροφαῖσιν αὐχήν,"
  },
  {
    "id": "p-595926",
    "offset": 3864,
    "text": "οὐδὲ πολυκρότοις ἀστραγάλοις πέπληγε νῶτα,"
  },
  {
    "id": "p-8f76da",
    "offset": 3908,
    "text": "οὐδ’ ὠμὰ λακιστὰ κρέα σιτούμεθα ταύρων·"
  },
  {
    "id": "p-2381b7",
    "offset": 3949,
    "text": "ὅτε δὲ πτελέας ἔαρι βρύει τὸ λεπτὸν ἄνθος"
  },
  {
    "id": "p-1b9a18",
    "offset": 3992,
    "text": "καὶ πολυκέλαδος κόσσυφος ἐπὶ κλάδοισιν ᾄδει,"
  },
  {
    "id": "p-a67565",
    "offset": 4038,
    "text": "τότε διὰ μελέων ὀξὺ βέλος πέπηγε μύσταις,"
  },
  {
    "id": "p-a054bc",
    "offset": 4081,
    "text": "ἀφανές, κρύφιον. δεδυκὸς ὑπὸ μυχοῖσι γυίων,"
  },
  {
    "id": "p-a4253f",
    "offset": 4126,
    "text": "πόδα, γόνυ, κοτύλην. ἀστραγάλους. ἰσχία. μηρούς,"
  },
  {
    "id": "p-5c811e",
    "offset": 4176,
    "text": "χέρας, ὠμοπλάτας, βραχίονας, κορωνά, καρποὺς"
  },
  {
    "id": "p-88e976",
    "offset": 4222,
    "text": "ἔσθει, νέμεται, φλέγει, κρατεῖ, πυρο,. μαλάσσει,"
  },
  {
    "id": "p-c87542",
    "offset": 4272,
    "text": "μέχρις ἂν ἡ θεὸς τὸν πόνον ἀποφυγεῖν κελεύσῃ."
  },
  {
    "id": "p-892500",
    "offset": 4319,
    "text": "Πόδαγρος\nΕἷς ἆρα κἀγὼ τῶν κατωργιασμένων"
  },
  {
    "id": "p-17a85e",
    "offset": 4361,
    "text": "ἔλαθον ὑπάρχων; τοιγὰρ ἧκε πρευμενὴς"
  },
  {
    "id": "p-070750",
    "offset": 4399,
    "text": "δαίμων φανεῖσα. σὺν δ’ ἐγὼ μύσταις ὁμοῦ"
  },
  {
    "id": "p-1a9084",
    "offset": 4440,
    "text": "ὕμνων κατάρξω τὸ ποδαγρῶν ᾄδων μέλος."
  },
  {
    "id": "p-97672f",
    "offset": 4479,
    "text": "Χόρος\nΣῖγα μὲν αἰθὴρ νήνεμος ἔστω,"
  },
  {
    "id": "p-287f94",
    "offset": 4515,
    "text": "καὶ πᾶς ποδαγρῶν εὐφημείτω."
  },
  {
    "id": "p-b53ce5",
    "offset": 4544,
    "text": "ἴδε, πρὸς θυμέλας ἡ κλινοχαρὴς"
  },
  {
    "id": "p-2a2d7d",
    "offset": 4576,
    "text": "βαίνει δαίμων σκίπωνι βάσιν"
  },
  {
    "id": "p-521179",
    "offset": 4605,
    "text": "στηριξομένη. χαίροις μακάρων"
  },
  {
    "id": "p-c497ab",
    "offset": 4635,
    "text": "πολὺ πραοτάτη καὶ σοῖς προπόλοις"
  },
  {
    "id": "p-3d344f",
    "offset": 4669,
    "text": "ἵλαος ἔλθοις ὄμματι φαιδρῷ."
  },
  {
    "id": "p-ebcbaf",
    "offset": 4698,
    "text": "δοίης δὲ πόνοις λύσιν ὠκεῖαν"
  },
  {
    "id": "p-3ae113",
    "offset": 4728,
    "text": "ταῖσδ’ εἰαριναῖσιν ἐν ὥραις."
  },
  {
    "id": "p-1b01df",
    "offset": 4758,
    "text": "Ποδάγρα\nΤίς τὴν ἀνίκητόν με δεσπότιν πόνων"
  },
  {
    "id": "p-68ab6d",
    "offset": 4802,
    "text": "οὐκ οἶδε Ποδάγραν τῶν ἐπὶ χθονὸς βροτῶν;"
  },
  {
    "id": "p-c7942b",
    "offset": 4844,
    "text": "ἣν οὔτε λιβάνων ἀτμὸς ἐξιλάσκεται"
  },
  {
    "id": "p-318fbd",
    "offset": 4879,
    "text": "οὔτε χυθὲν αἷμα βωμίοις παρ’ ἐμπύροις,"
  },
  {
    "id": "p-63a0f8",
    "offset": 4919,
    "text": "οὐ ναὸς ὄλβου περικρεμὴς ἀγάλμασιν,"
  },
  {
    "id": "p-4776cd",
    "offset": 4956,
    "text": "ἣν οὔτε Παιὰν φαρμάκοις νικᾶν σθένει,"
  },
  {
    "id": "p-2ffbd6",
    "offset": 4995,
    "text": "πάντων ἰατρὸς τῶν ἐν οὐρανῷ θεῶν."
  },
  {
    "id": "p-a739af",
    "offset": 5030,
    "text": "οὐ παῖς ὁ Φοίβου πολυμαθὴς Ἀσκληπιός."
  },
  {
    "id": "p-b9bb01",
    "offset": 5069,
    "text": "ἐξ οὗ γὰρ ἐφύη πρῶτον ἀνθρώποις γένος,"
  },
  {
    "id": "p-b10348",
    "offset": 5109,
    "text": "τολμῶσι πάντες τοὐμὸν ἐκβαλεῖν σθένος,"
  },
  {
    "id": "p-889a7f",
    "offset": 5149,
    "text": "κυκῶντες αἰεὶ φαρμάκων τεχνήματα."
  },
  {
    "id": "p-26b7b3",
    "offset": 5184,
    "text": "ἄλλος γὰρ ἄλλην ἐπ’ ἐμὲ πειράξει τέχνην·"
  },
  {
    "id": "p-f1e7a4",
    "offset": 5226,
    "text": "τρίβουσιν ἀρνόγλωσσα καὶ σέλινά μοι"
  },
  {
    "id": "p-f040c8",
    "offset": 5263,
    "text": "καὶ φύλλα θριδάκων καὶ νομαίαν ἀνδράχνην."
  },
  {
    "id": "p-86a3c0",
    "offset": 5306,
    "text": "ἄλλοι πράσιον, οἱ δὲ ποταμογείτονα,"
  },
  {
    "id": "p-8ed417",
    "offset": 5343,
    "text": "ἄλλοι κνίδας τρίβουσιν, ἄλλοι σύμφυτον,"
  },
  {
    "id": "p-ff9f0c",
    "offset": 5384,
    "text": "ἄλλοι φακοὺς φέρουσι τοὺς ἐκ τελμάτων."
  },
  {
    "id": "p-306740",
    "offset": 5424,
    "text": "σταφυλῖνον ἑφθόν, οἱ δὲ φύλλα Περσικῶν,"
  },
  {
    "id": "p-7890ef",
    "offset": 5465,
    "text": "ὑοσκύαμον, μήκωνα, βολβούς, σίδια,"
  },
  {
    "id": "p-708b09",
    "offset": 5501,
    "text": "ψύλλιον, λίβανον. ῥίζαν ἑλλεβόρου, νίτρον,"
  },
  {
    "id": "p-c8e0c3",
    "offset": 5545,
    "text": "τῆλιν μετ’ οἴνου, γυρίνην, κολλάμφακον,"
  },
  {
    "id": "p-d89db9",
    "offset": 5586,
    "text": "κυπαρισσίνην κηκῖδα, γῦριν κριθίνην,"
  },
  {
    "id": "p-ce6ed3",
    "offset": 5624,
    "text": "χράμβης ἀπέφθου φύλλα, γύψον ἔκ Πάρου,"
  },
  {
    "id": "p-0c93ba",
    "offset": 5664,
    "text": "σπυράθους ὀρείας αἰγός, ἀνθρώπου κόπρον,"
  },
  {
    "id": "p-06407b",
    "offset": 5706,
    "text": "ἄλευρα κυάμων, ἄνθος ᾿Ασσίου λίθου·"
  },
  {
    "id": "p-abca79",
    "offset": 5743,
    "text": "ἕψουσι φρύνους, μυγαλᾶς, σαύρας, γαλᾶς,"
  },
  {
    "id": "p-cff5b9",
    "offset": 5784,
    "text": "βατράχους, ὑαίνας, τραγελάφους, ἀλώπεκας."
  },
  {
    "id": "p-7aa3b9",
    "offset": 5827,
    "text": "ποῖον μέταλλον οὐ πεπείρασται βροτοῖς;"
  },
  {
    "id": "p-c6ed1a",
    "offset": 5867,
    "text": "τίς οὐχὶ χυλός; ποῖον οὐ δένδρου δάχρυ;"
  },
  {
    "id": "p-4fc9e8",
    "offset": 5908,
    "text": "ξῴων ἁπάντων ὀστά, νεῦρα, δέρματα,"
  },
  {
    "id": "p-07cf2c",
    "offset": 5944,
    "text": "στέαρ, αἷμα. μυελός, οὖρον, ἀπόπατος, γάλα."
  },
  {
    "id": "p-9ae62b",
    "offset": 5989,
    "text": "πίνουσιν οἱ μὲν τὸ διὰ τεσσάρων ἄκος,"
  },
  {
    "id": "p-104fb5",
    "offset": 6028,
    "text": "οἱ δὲ τὸ δι᾿ ὀχτώ, τὸ δὲ δι᾿ ἑπτὰ πλείονες."
  },
  {
    "id": "p-907272",
    "offset": 6073,
    "text": "ἄλλος δὲ πίνων τὴν ἱερὰν καθαίρεται,"
  },
  {
    "id": "p-3529af",
    "offset": 6111,
    "text": "ἄλλος ἐπαοιδαῖς ἐπιθετῶν ἐμπαίζεται,"
  },
  {
    "id": "p-fdd786",
    "offset": 6149,
    "text": "Ἰουδαῖος ἕτερον μωρὸν ἐξᾴδει λαβών."
  },
  {
    "id": "p-a34eef",
    "offset": 6186,
    "text": "ὁ δὲ θεραπείαν ἔλαβε παρὰ τῆς Κυρράνης."
  },
  {
    "id": "p-c8437e",
    "offset": 6227,
    "text": "ἐγὼ δὲ τούτοις πᾶσιν οἰμώξειν λέγω"
  },
  {
    "id": "p-d825f5",
    "offset": 6263,
    "text": "καὶ τοῖς ποιοῦσι ταῦτα καὶ πειρῶσί με"
  },
  {
    "id": "p-a389fd",
    "offset": 6302,
    "text": "εἴωθ’ ἀπαντᾶν μᾶλλον ὀργιλωτέρα·"
  },
  {
    "id": "p-686be2",
    "offset": 6336,
    "text": "τοῖσι δὲ φρονοῦσι μηδὲν ἀντίξουν ἐμοὶ"
  },
  {
    "id": "p-67a9a8",
    "offset": 6375,
    "text": "ἤπιον ἔχω νοῦν εὐμενής τε γίνομαι."
  },
  {
    "id": "p-5f5a83",
    "offset": 6411,
    "text": "ὁ γὰρ μεταλαβὼν τῶν ἐμῶν μυστηρίων"
  },
  {
    "id": "p-766e9e",
    "offset": 6447,
    "text": "πρῶτον μὲν εὐθὺς εὐστομεῖν διδάσκεται"
  },
  {
    "id": "p-abac50",
    "offset": 6486,
    "text": "τέρπων ἅπαντας, εὐτραπέλους λέγων λόγους·"
  },
  {
    "id": "p-7f9b08",
    "offset": 6529,
    "text": "πᾶσιν δ’ ὁρᾶται μετὰ γέλωτος καὶ κρότου."
  },
  {
    "id": "p-3a398c",
    "offset": 6571,
    "text": "ὅτ’ ἐπὶ τὰ λουτρὰ φερόμενος βαστάζεται."
  },
  {
    "id": "p-bc2212",
    "offset": 6612,
    "text": "Ἄτη γάρ, ἣν Ὅμηρος εἶπεν, εἰμ’ ἐγώ,"
  },
  {
    "id": "p-6732ff",
    "offset": 6649,
    "text": "βαίνουσ’ ἐπ᾿ ἀνδρῶν κρᾶτα καὶ βάσεις ποδῶν"
  },
  {
    "id": "p-c931e1",
    "offset": 6693,
    "text": "ἁπαλὰς ἔχουσα, παρὰ δὲ τοῖς πολλοῖς βροτῶν"
  },
  {
    "id": "p-05413a",
    "offset": 6737,
    "text": "Ποδάγρα καλοῦμαι, γινομένη ποδῶν ἄγρα."
  },
  {
    "id": "p-4e47ff",
    "offset": 6777,
    "text": "ἀλλ’ εἶα μύσται πάντες ὀργίων ἐμῶν,"
  },
  {
    "id": "p-ef1ddd",
    "offset": 6814,
    "text": "γεραίρεθ’ ὕμνοις τὴν ἀνίκητον θεάν."
  },
  {
    "id": "p-1292fc",
    "offset": 6851,
    "text": "Χόρος\nἈδαμάντινον ἦθος ἔχουσα κόρα,"
  },
  {
    "id": "p-a74b4f",
    "offset": 6888,
    "text": "πουλυσθενές, ὀβριμόθυμε θεά,"
  },
  {
    "id": "p-7cf81d",
    "offset": 6918,
    "text": "κλύε σῶν ἱερῶν μερόπων ἐνοπάς."
  },
  {
    "id": "p-cc37f9",
    "offset": 6950,
    "text": "μέγα σὸν κράτος, ὀλβιόφρον Ποδάγρα,"
  },
  {
    "id": "p-7cae86",
    "offset": 6987,
    "text": "τὰν καὶ Διὸς ὠκὺ πέφρικε βέλος,"
  },
  {
    "id": "p-7786dc",
    "offset": 7020,
    "text": "τρομέει δέ σε κύμαθ’ ἁλὸς βυθίας,"
  },
  {
    "id": "p-d4bb2e",
    "offset": 7055,
    "text": "τρομέει βασιλεὺς ἐνέρων Ἀΐδας,"
  },
  {
    "id": "p-64cbfd",
    "offset": 7087,
    "text": "ἐπιδεσμοχαρές, κατακλινοβατές,"
  },
  {
    "id": "p-f08015",
    "offset": 7119,
    "text": "κολυσιδρόμα, βασαναστραγάλα,"
  },
  {
    "id": "p-056841",
    "offset": 7149,
    "text": "σφυροπρησιπύρα, μογισαψεδάφα,"
  },
  {
    "id": "p-e1a686",
    "offset": 7180,
    "text": "δοιδυκοφόβα, γονυκαυσαγρύπνα,"
  },
  {
    "id": "p-8f5762",
    "offset": 7211,
    "text": "περικονδυλοπωρυφίλα,"
  },
  {
    "id": "p-e5f65b",
    "offset": 7233,
    "text": "γονυκαμψεπίκυρτε Ποδάγρα."
  },
  {
    "id": "p-31ab59",
    "offset": 7260,
    "text": "Ἄγγελος\nΔέσποινα, καιρίῳ γὰρ ἤντησας ποδί,"
  },
  {
    "id": "p-a05367",
    "offset": 7304,
    "text": "ἄκου’, ἔπος γὰρ οὐκ ἐτώσιον φέρω,"
  },
  {
    "id": "p-2539f0",
    "offset": 7339,
    "text": "ἀλλ’ ἔστι πρᾶξις τῶν λόγων συνέμπορος·"
  },
  {
    "id": "p-797edf",
    "offset": 7379,
    "text": "ἐγὼ γάρ, ὡς ἔταξας, ἠρέμῳ ποδὶ"
  },
  {
    "id": "p-120ac1",
    "offset": 7411,
    "text": "πόλεις ἰχνεύων πάντας ἠρεύνων δόμους"
  },
  {
    "id": "p-c6b1fd",
    "offset": 7449,
    "text": "μαθεῖν ποθῶν εἴ τις σὸν οὐ τιμᾷ κράτος."
  },
  {
    "id": "p-e2b7a0",
    "offset": 7490,
    "text": "καὶ τῶν μὲν ἄλλων εἶδον ἥσυχον φρένα"
  },
  {
    "id": "p-9c9124",
    "offset": 7528,
    "text": "νικωμένων, ἄνασσα, σαῖν βίᾳ χεροῖν,"
  },
  {
    "id": "p-bde14b",
    "offset": 7565,
    "text": "δύω δὲ τώδε φῶτε τολμηρὼ θράσει"
  },
  {
    "id": "p-41f245",
    "offset": 7598,
    "text": "ἐφραξέτην λαοῖσι καὶ κατωμνύτην."
  },
  {
    "id": "p-83d221",
    "offset": 7632,
    "text": "ὡς οὐκέτ’ ἔστι σὸν κράτος σεβάσμιον,"
  },
  {
    "id": "p-a3f353",
    "offset": 7670,
    "text": "ἀλλ’ ἔκβολον βροτῶν σε θήσουσιν βίου."
  },
  {
    "id": "p-7af062",
    "offset": 7709,
    "text": "διόπερ κραταιῷ συνοχμάσας δεσμῷ πόδα"
  },
  {
    "id": "p-3d1010",
    "offset": 7747,
    "text": "πεμπταῖος ἥκω στάδια διανύσας δύο."
  },
  {
    "id": "p-4221bb",
    "offset": 7783,
    "text": "Ποδάγρα\nὩς κραιπνὸς ἔπτης, ἀγγέλων ὤκιστέ μοι."
  },
  {
    "id": "p-2ee81b",
    "offset": 7831,
    "text": "τίνος δὲ καὶ γῆς ὅρια δυσβάτου λιπὼν"
  },
  {
    "id": "p-dde4b4",
    "offset": 7869,
    "text": "ἥκεις; σαφῶς μήνυσον, ὡς εἰδῶ τάχος."
  },
  {
    "id": "p-da30ea",
    "offset": 7907,
    "text": "Ἄγγελος\nΠρῶτον μὲν ἔλιπον πέντε βαθμῶν κλίμακα,"
  },
  {
    "id": "p-78bd4e",
    "offset": 7956,
    "text": "ξύλων τρέμουσαν διαλύτοισιν ἁρμογαῖς,"
  },
  {
    "id": "p-4e7ff3",
    "offset": 7995,
    "text": "ὅθεν μὲ δέχεται κορδυβαλλῶδες πέδον"
  },
  {
    "id": "p-c041ec",
    "offset": 8032,
    "text": "σχληροῖσι ταρσοῖς ἀντερεῖδον κρούμασιν."
  },
  {
    "id": "p-3a281c",
    "offset": 8073,
    "text": "ὅπερ διανύσας ἴχνεσιν ἀλγεινοῖς ἐγὼ"
  },
  {
    "id": "p-f12f26",
    "offset": 8110,
    "text": "ἐστρωμένην χάλιξιν εἰσέβην ὁδὸν"
  },
  {
    "id": "p-5dadd4",
    "offset": 8143,
    "text": "καὶ δυσπάτητον ὀξέσιν κέντροις λίθων."
  },
  {
    "id": "p-c42694",
    "offset": 8182,
    "text": "μεθ’ ἣν ὀλίσθῳ περιπεσὼν λείας ὁδοῦ"
  },
  {
    "id": "p-252def",
    "offset": 8219,
    "text": "ἔσπευδον εἰς τὸ πρόσθε, διάλυτος δέ μου"
  },
  {
    "id": "p-441735",
    "offset": 8260,
    "text": "ἔσυρεν ὀπίσω πηλὸς ἀσθενῆ σφυρά,"
  },
  {
    "id": "p-1dafc7",
    "offset": 8294,
    "text": "δι᾿ ἧς περῶντι νότιος ἐκ μελῶν ἱδρὼς"
  },
  {
    "id": "p-128916",
    "offset": 8332,
    "text": "ἔρρει βάσιν μου σαθρὰν ἐκλελυμένῳ."
  },
  {
    "id": "p-4ea5fd",
    "offset": 8368,
    "text": "ὅθεν μὲ δέχεται πᾶν μέλος κεκμηκότα"
  },
  {
    "id": "p-559421",
    "offset": 8405,
    "text": "πλατεῖα μὲν κέλευθος, ἀλλ’ οὐκ ἀσφαλής·"
  },
  {
    "id": "p-75c8f7",
    "offset": 8446,
    "text": "τὰ μὲν γὰρ ἔνθεν, τὰ δέ μ’ ἐχκεῖθ’ ὀχήματα"
  },
  {
    "id": "p-a62d46",
    "offset": 8490,
    "text": "ἤπειγεν, ἠνάγκαξεν, ἔσπερχεν τρέχειν."
  },
  {
    "id": "p-52846b",
    "offset": 8529,
    "text": "ἐγὼ δὲ νωθρὸν ἐλαφρὰ κουφίζων πόδα"
  },
  {
    "id": "p-19cfc6",
    "offset": 8565,
    "text": "δόχμιος ἔβαινον εἰς ὁδοῦ πέζαν στενήν,"
  },
  {
    "id": "p-c2f115",
    "offset": 8605,
    "text": "ἕως ἀπήνη παραδράμῃ τροχήλατος·"
  },
  {
    "id": "p-c5ce7e",
    "offset": 8638,
    "text": "μύστης γὰρ ὢν σὸς ταχὺ τρέχειν οὐκ ἔσθενον."
  },
  {
    "id": "p-31bbc0",
    "offset": 8683,
    "text": "Ποδάγρα\nΟὐκ εἰς μάτην, βέλτιστε, πρᾶξις ἥδε σοι"
  },
  {
    "id": "p-b06019",
    "offset": 8732,
    "text": "ὀρθὼς πέπρακται. τῇ δὲ σῇ προθυμίᾳ"
  },
  {
    "id": "p-ca15a5",
    "offset": 8768,
    "text": "ἴσαισι τιμαῖς ἀντισηκώσω χάριν."
  },
  {
    "id": "p-6bdd5e",
    "offset": 8801,
    "text": "ἔστω δέ σοι δώρημα θυμῆρες τόδε,"
  },
  {
    "id": "p-245ff5",
    "offset": 8835,
    "text": "ἑξῆς τριετίας πειράσῃ κούφων πόνων."
  },
  {
    "id": "p-fac426",
    "offset": 8872,
    "text": "ὑμεῖς δὲ μιαροὶ καὶ θεοῖς ἐχθίστατοι,"
  },
  {
    "id": "p-8cb91b",
    "offset": 8911,
    "text": "τίνες πότ’ ὄντες καὶ τίνων πεφυκότες"
  },
  {
    "id": "p-8e0f96",
    "offset": 8949,
    "text": "τολμᾶτε Ποδάγρας ἀνθαμιλλᾶσθαι κράτει,"
  },
  {
    "id": "p-540bb8",
    "offset": 8989,
    "text": "τῆς οὐδ’ ὁ Κρονίδας οἶδε νικῆσαι βίαν;"
  },
  {
    "id": "p-0915fb",
    "offset": 9029,
    "text": "λέγετ’, ὦ κάκιστοι· καὶ γὰρ ἡρώων ἐγὼ"
  },
  {
    "id": "p-3468e8",
    "offset": 9068,
    "text": "ἐδάμασα πλείστους, ὥς γ’ ἐπίστανται σοφοί."
  },
  {
    "id": "p-ea0a58",
    "offset": 9112,
    "text": "Πρίαμος Ποδάρκης ποδαγρὸς ὢν ἐκλῄξετο·"
  },
  {
    "id": "p-f6cae9",
    "offset": 9152,
    "text": "ἔθανε δ’ Ἀχιλλεὺς ποδαγρὸς ὢν ὁ Πηλέως·"
  },
  {
    "id": "p-86a797",
    "offset": 9193,
    "text": "ὁ Βελλεροφόντης ποδαγρὸς ὢν ἐκαρτέρει·"
  },
  {
    "id": "p-ebcbce",
    "offset": 9233,
    "text": "Θηβῶν δυνάστης Οἰδίπους ποδαγρὸς ἦν·"
  },
  {
    "id": "p-887249",
    "offset": 9271,
    "text": "ἐκ τῶν Πελοπιδῶν ποδαγρὸς ἦν ὁ Πλεισθένης·"
  },
  {
    "id": "p-c0f4c4",
    "offset": 9315,
    "text": "Ποίαντος υἱὸς ποδαγρὸς ὢν ἦρχε στόλου"
  },
  {
    "id": "p-208664",
    "offset": 9354,
    "text": "ἄλλος Ποδάρκης Θεσσαλῶν ἦν ἡγεμών,"
  },
  {
    "id": "p-d714b0",
    "offset": 9390,
    "text": "ὅς, ἐπείπερ ἔπεσε Πρωτεσίλαος ἐν μάχῃ,"
  },
  {
    "id": "p-ecccf8",
    "offset": 9430,
    "text": "ὅμως ποδαγρὸς ὢν καὶ πονῶν ἦρχε στόλου·"
  },
  {
    "id": "p-b5bf78",
    "offset": 9471,
    "text": "Ἰθάκης ἄνακτα Λαρτιάδην Ὀδυσσέα"
  },
  {
    "id": "p-3adcc1",
    "offset": 9504,
    "text": "ἐγὼ κατέπεφνον. οὐκ ἄκανθα τρυγόνος."
  },
  {
    "id": "p-29d461",
    "offset": 9542,
    "text": "ὡς οὔτι χαιρήσοντες, ὦ δυσδαίμονες,"
  },
  {
    "id": "p-94e5af",
    "offset": 9579,
    "text": "ἴσην πάθηθε κόλασιν οἷς δεδράκατε."
  },
  {
    "id": "p-fe9cb5",
    "offset": 9615,
    "text": "Ἰατροὶ\nΣύροι μέν ἐσμεν, ἐκ Δαμασκοῦ τῷ γένει,"
  },
  {
    "id": "p-5d3dd3",
    "offset": 9662,
    "text": "λιμῷ δὲ πολλῷ καὶ πενίᾳ κρατούμενοι"
  },
  {
    "id": "p-5a32e8",
    "offset": 9699,
    "text": "γὴν καὶ θάλασσαν ἐφέπομεν πλανώμενοι·"
  },
  {
    "id": "p-9eeb4f",
    "offset": 9738,
    "text": "ἔχομεν δὲ χρῖσμα πατροδώρητον τόδε,"
  },
  {
    "id": "p-e794ae",
    "offset": 9775,
    "text": "ἐν ᾧ παρηγοροῦμεν ἀλγούντων πόνους."
  },
  {
    "id": "p-ce93e3",
    "offset": 9812,
    "text": "Ποδάγρα\nΤί δὴ τὸ χρῖσμα καὶ τίς ἡ σκευή; φράσον."
  },
  {
    "id": "p-49e4e1",
    "offset": 9862,
    "text": "Ἰατρός\nΜύστης με σιγᾶν ὅρκος οὐκ ἐᾷ φράσαι."
  },
  {
    "id": "p-d56623",
    "offset": 9907,
    "text": "καὶ λοισθία θνήσκοντος ἐντολὴ πατρός,"
  },
  {
    "id": "p-cb1df1",
    "offset": 9946,
    "text": "ὃς ἔταξε κεύθειν φαρμάκου μέγα σθένος,"
  },
  {
    "id": "p-5594ea",
    "offset": 9986,
    "text": "ὃ καὶ σὲ παύειν οἶδεν ἠγριωμένην."
  },
  {
    "id": "p-b41813",
    "offset": 10021,
    "text": "Ποδάγρα\nΕἶτ’ ὦ κατάρατοι καὶ κακῶς ὀλούμενοι,"
  },
  {
    "id": "p-3036f0",
    "offset": 10068,
    "text": "ἔστιν τις ἐν γῇ φαρμάκου δρᾶσις τόση,"
  },
  {
    "id": "p-f03054",
    "offset": 10107,
    "text": "ὃ χρισθὲν οἶδε τὴν ἐμὴν παῦσαι βίαν;"
  },
  {
    "id": "p-1088c3",
    "offset": 10145,
    "text": "ἀλλ’ εἶα. τήνδε σύμβασιν συνθώμεθα,"
  },
  {
    "id": "p-06602b",
    "offset": 10182,
    "text": "καὶ πειράσωμεν εἴτε φαρμάκου σθένος"
  },
  {
    "id": "p-645e5f",
    "offset": 10219,
    "text": "ὑπέρτερον πέφυκεν εἴτ’ ἐμαὶ φλόγες."
  },
  {
    "id": "p-b96f12",
    "offset": 10256,
    "text": "δεῦτ’, ὦ σκυθρωπαί, πάντοθεν ποτώμεναι"
  },
  {
    "id": "p-3e4383",
    "offset": 10296,
    "text": "βάσανοι, πάρεδροι τῶν ἐμῶν βακχευμάτων,"
  },
  {
    "id": "p-c6337a",
    "offset": 10337,
    "text": "πελάζετ’ ἆσσον· καὶ σὺ μὲν ποδῶν ἄκρους"
  },
  {
    "id": "p-e561da",
    "offset": 10378,
    "text": "φλέγμαινε ταρσοὺς δακτύλων ποδῶν ἄχρι,"
  },
  {
    "id": "p-574be9",
    "offset": 10418,
    "text": "σὺ δὲ σφυροῖς ἔμβαινε, σὺ δὲ μηρῶν ἄπο"
  },
  {
    "id": "p-2ee79b",
    "offset": 10458,
    "text": "ἐς γόνατα λεῖβε πικρὸν ἰχώρων βάθος,"
  },
  {
    "id": "p-0cbfec",
    "offset": 10496,
    "text": "ὑμεῖς δὲ χειρῶν δακτύλους λυγίζετε."
  },
  {
    "id": "p-23d56a",
    "offset": 10533,
    "text": "Πόνοι\nἼδ’, ὡς ἔταξας πάντα σοι δεδράκαμεν·"
  },
  {
    "id": "p-feb40f",
    "offset": 10577,
    "text": "κεῖνται βοῶντες οἱ ταλαίπωροι μέγα,"
  },
  {
    "id": "p-1ed2c7",
    "offset": 10614,
    "text": "ἅπαντα γυῖα προσβολῇ στρεβλούμενοι."
  },
  {
    "id": "p-b2153c",
    "offset": 10651,
    "text": "Ποδάγρα\nΦέρετ’, ὦ ξένοι, μάθωμεν ἀτρεκέστατον,"
  },
  {
    "id": "p-46c190",
    "offset": 10699,
    "text": "εἰ χρισθὲν ὑμᾶς φάρμακον τόδ’ ὠφελεῖ."
  },
  {
    "id": "p-cf03c0",
    "offset": 10738,
    "text": "εἰ γὰρ σαφῶς τόδ’ ἐστὶν ἀντίξουν ἐιιοί,"
  },
  {
    "id": "p-c958cb",
    "offset": 10779,
    "text": "λείπουσα γαῖαν εἰς μυχοὺς εἶμι χθονός,"
  },
  {
    "id": "p-96bea4",
    "offset": 10819,
    "text": "ἄϊστος, ἀφανής, πύματα Ταρτάρου βαθη."
  },
  {
    "id": "p-554bbd",
    "offset": 10858,
    "text": "Ἰατρός\nἸδού, κέχρισται, κοὐ χαλᾷ φλογμὸν πόνων."
  },
  {
    "id": "p-3b8449",
    "offset": 10907,
    "text": "Πόδαγρος\nΟἴμοι, παπαῖ γε, τείρομαι, διόλλυμαι,"
  },
  {
    "id": "p-ca085e",
    "offset": 10955,
    "text": "ἅπαν πέπαρμαι γυῖον ἀσκόπῳ κακῷ·"
  },
  {
    "id": "p-dba433",
    "offset": 10989,
    "text": "οὐ Ζεὺς κεραυνοῦ τοῖον αἰωρεῖ βέλος,"
  },
  {
    "id": "p-4f9703",
    "offset": 11027,
    "text": "οὐδεὶς θαλάσσης τοῖα μαίνεται κλύδων,"
  },
  {
    "id": "p-c56cab",
    "offset": 11066,
    "text": "οὐδὲ στροβητὴ λαίλαπος τόσση βία."
  },
  {
    "id": "p-1b2a05",
    "offset": 11101,
    "text": "μὴ κάρχαρον πορθεῖ με δῆγμα Κερβέρου;"
  },
  {
    "id": "p-66032f",
    "offset": 11140,
    "text": "μή τίς μ’ ἐχίδνης ἰὸς ἀμφιβόσκεται,"
  },
  {
    "id": "p-444529",
    "offset": 11177,
    "text": "ἢ διαβρεχὴς ἰχῶρι Κενταύρου πέπλος;"
  },
  {
    "id": "p-7c8718",
    "offset": 11214,
    "text": "ἐλέαιρ’, ἄνασσα, φάρμακον γὰρ οὔτ’ ἐμὸν"
  },
  {
    "id": "p-2f6db0",
    "offset": 11255,
    "text": "οὔτ’ ἄλλο δύναται σὸν ἀναχαιτίσαι δρόμον,"
  },
  {
    "id": "p-0bd553",
    "offset": 11298,
    "text": "ψήφοις δὲ πάσαις πᾶν ἔθνος νικᾶς βροτῶν."
  },
  {
    "id": "p-e88544",
    "offset": 11340,
    "text": "Ποδάγρα\nΠαύσασθε.βάσανοι,καὶπόνους μειώσατε"
  },
  {
    "id": "p-7849ce",
    "offset": 11385,
    "text": "τῶν μετανοούντων εἰς ἐμὴν ἔριν μολεῖν."
  },
  {
    "id": "p-d3bfe4",
    "offset": 11425,
    "text": "γινωσκέτω δὲ πᾶς τις ὡς μόνη θεῶν"
  },
  {
    "id": "p-3e30b7",
    "offset": 11460,
    "text": "ἄτεγχτος οὖσα φαρμάκοις οὐ πείθομαι."
  },
  {
    "id": "p-34b4d8",
    "offset": 11498,
    "text": "Χόρος\nΟὔτε Διὸς βρονταῖς Σαλμωνέος ἤρισε βία,"
  },
  {
    "id": "p-1899b7",
    "offset": 11545,
    "text": "ἀλλ’ ἔθανε ψολόεντι δαμεῖσα θεοῦ φρένα βέλει,"
  },
  {
    "id": "p-fe715a",
    "offset": 11592,
    "text": "οὐκ ἐρίσας ἐχάρη Φοίβῳ σάτυρος Μαρσύας,"
  },
  {
    "id": "p-200684",
    "offset": 11633,
    "text": "ἀλλὰ λιγὺ ψαίρει κείνου περὶ δέρμα πίτυϊ."
  },
  {
    "id": "p-7caed3",
    "offset": 11676,
    "text": "πένθος ἀείμνηστον δι’ ἔριν τοκὰς ἔσχε Νιόβη."
  },
  {
    "id": "p-93a1c9",
    "offset": 11722,
    "text": "ἀλλ’ ἔτι μυρομένη προχέει πολὺ δάκρυ Σιπύλῳ."
  },
  {
    "id": "p-7e83b5",
    "offset": 11768,
    "text": "Μαιονία δ’ Ἀράχνη Τριτωνίδος ἦλθεν ἐς ἔριν,"
  },
  {
    "id": "p-d8bb4d",
    "offset": 11813,
    "text": "ἀλλ’ ὀλέσασα τύπον καὶ νῦν ἔτι νήματα πλέκει·"
  },
  {
    "id": "p-0f7c1c",
    "offset": 11860,
    "text": "οὐ γὰρ ἴσον μακάρων ὀργαῖς θράσος ἐστὶ μερόπων,"
  },
  {
    "id": "p-3efa99",
    "offset": 11909,
    "text": "ὡς Διός, ὡς Δητοῦς, ὡς Παλλάδος, ὡς Πυθίου."
  },
  {
    "id": "p-7f0c80",
    "offset": 11954,
    "text": "ἤπιον. ὦ πάνδημε, φέροις ἄλγημα, Ποδάγρα,"
  },
  {
    "id": "p-086a1d",
    "offset": 11997,
    "text": "κοῦφον, ἐλαφρόν, ἄδριμυ, βραχυβλαβές, ἀνώδυνον,"
  },
  {
    "id": "p-4a4f25",
    "offset": 12046,
    "text": "εὔφορον, εὔληκτον, ὀλιγοδρανές, εὐπερίπατον."
  },
  {
    "id": "p-3b9966",
    "offset": 12092,
    "text": "Πολλαὶ μορφαὶ τῶν ἀτυχούντων,"
  },
  {
    "id": "p-c1f9d9",
    "offset": 12123,
    "text": "μελέται δὲ πόνων καὶ τὸ σύνηθες"
  },
  {
    "id": "p-aee2cf",
    "offset": 12156,
    "text": "τοὺς ποδαγρῶντας παραμυθείσθω."
  },
  {
    "id": "p-293eb3",
    "offset": 12188,
    "text": "ὅθεν εὐθύμως, ὦ σύγκληροι,"
  },
  {
    "id": "p-667536",
    "offset": 12216,
    "text": "λήσεσθε πόνων,"
  },
  {
    "id": "p-3cf7db",
    "offset": 12232,
    "text": "εἰ τὰ δοκηθέντ’ οὐκ ἐτελέσθη,"
  },
  {
    "id": "p-8afaf6",
    "offset": 12263,
    "text": "τοῖς δ’ ἀδοκήτοις πόρον εὗρε θεός."
  },
  {
    "id": "p-d9970c",
    "offset": 12299,
    "text": "πᾶς δ’ ἀνεχέσθω τῶν πασχόντων"
  },
  {
    "id": "p-cceed3",
    "offset": 12330,
    "text": "ἐμπαιξόμενος καὶ σκωπτόμενος·"
  },
  {
    "id": "p-8119d4",
    "offset": 12361,
    "text": "τοῖον γὰρ ἔφυ τόδε πρᾶγμα."
  }
]