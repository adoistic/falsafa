[
  {
    "id": "p-64cb71",
    "offset": 0,
    "text": "Nocte ante pugnam Pompeius inani somnii specie luditur."
  },
  {
    "id": "p-979c20",
    "offset": 57,
    "text": "Orto sole, cupidis pugnae militibus, ipsoque Cicerone hortante,"
  },
  {
    "id": "p-a2ef42",
    "offset": 122,
    "text": "Magnus, quamquam invitus, signum pugnae dat."
  },
  {
    "id": "p-4c3d41",
    "offset": 168,
    "text": "Milites se parant."
  },
  {
    "id": "p-b6e854",
    "offset": 188,
    "text": "Prodigia narrantur."
  },
  {
    "id": "p-aa2c79",
    "offset": 209,
    "text": "Populi metuunt."
  },
  {
    "id": "p-891efd",
    "offset": 226,
    "text": "Vates quidam in Italia superiore praedicat pugnam ea ipsa die inter Pompeium et Caesarem pugnari."
  },
  {
    "id": "p-e85d50",
    "offset": 325,
    "text": "Describitur Pompeii acies."
  },
  {
    "id": "p-003361",
    "offset": 353,
    "text": "Laetus eam conspicit Caesar."
  },
  {
    "id": "p-c92c3e",
    "offset": 383,
    "text": "Caesar militesque suos alloquitur."
  },
  {
    "id": "p-219f85",
    "offset": 419,
    "text": "Arripiunt arma."
  },
  {
    "id": "p-364aa9",
    "offset": 436,
    "text": "Pompeius alloquitur suos."
  },
  {
    "id": "p-97ac26",
    "offset": 463,
    "text": "Conqueritur poeta de funesto Romae bello, deque amissa per pugnam Pharsalicam libertate Romana."
  },
  {
    "id": "p-59e836",
    "offset": 560,
    "text": "Primus pugnam inchoat Crastinus Caesarianus."
  },
  {
    "id": "p-a89865",
    "offset": 606,
    "text": "Describitur furor pugnantium."
  },
  {
    "id": "p-0f6af3",
    "offset": 637,
    "text": "Caesar Pompeianos ab latere adoritur. Pelluntur Pompeii equites, e barbaris populis collecti."
  },
  {
    "id": "p-1e8497",
    "offset": 732,
    "text": "Centrum tamen resistit, ubi Romani."
  },
  {
    "id": "p-7dda2c",
    "offset": 769,
    "text": "Abhorret poeta ab descriptione pugnae."
  },
  {
    "id": "p-282a85",
    "offset": 809,
    "text": "Caesar suos hortatur."
  },
  {
    "id": "p-15209e",
    "offset": 832,
    "text": "Brutus in exercitu Pompeii."
  },
  {
    "id": "p-3be30b",
    "offset": 861,
    "text": "Cadunt patricii; cadit Domitius."
  },
  {
    "id": "p-1b3124",
    "offset": 895,
    "text": "Horret queriturque pugnam poeta."
  },
  {
    "id": "p-e7b0e7",
    "offset": 929,
    "text": "Fugit Pompeius equo."
  },
  {
    "id": "p-0547aa",
    "offset": 951,
    "text": "Apostrophe ad eum."
  },
  {
    "id": "p-69e56a",
    "offset": 971,
    "text": "Pompeius Larissam venit; dein pergit in fuga."
  },
  {
    "id": "p-15093a",
    "offset": 1018,
    "text": "Caesar castra Pompeii occupat."
  },
  {
    "id": "p-5ee74f",
    "offset": 1050,
    "text": "Inhumata iacent cadavera."
  },
  {
    "id": "p-d7944c",
    "offset": 1077,
    "text": "Ferae ad dapes veniunt."
  },
  {
    "id": "p-a8b562",
    "offset": 1102,
    "text": "Apostrophe."
  }
]