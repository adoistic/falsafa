[
  {
    "id": "p-ab27b9",
    "offset": 0,
    "text": "Praefatur poeta argumentum."
  },
  {
    "id": "p-25bda5",
    "offset": 29,
    "text": "Conqueritur de bello ipso."
  },
  {
    "id": "p-6f08bd",
    "offset": 57,
    "text": "Alloquitur Neronem."
  },
  {
    "id": "p-42fd60",
    "offset": 78,
    "text": "De causis belli internis."
  },
  {
    "id": "p-e18ba2",
    "offset": 105,
    "text": "Aemulatio inter Pompeium et Caesarem, mortuo Crasso."
  },
  {
    "id": "p-fc8d73",
    "offset": 159,
    "text": "Luxuries Romana."
  },
  {
    "id": "p-706bb2",
    "offset": 177,
    "text": "Caesar Rubiconem transit, Ariminumque invadit."
  },
  {
    "id": "p-ff3764",
    "offset": 225,
    "text": "Queruntur incolae eius regionis, sese primos cuiusque belli sentire damna."
  },
  {
    "id": "p-39f589",
    "offset": 301,
    "text": "Accedit Curio, Roma expulsus, ad Caesarem, eumque ad bellum hortatur."
  },
  {
    "id": "p-149eb8",
    "offset": 372,
    "text": "Caesar milites alloquitur."
  },
  {
    "id": "p-1165e6",
    "offset": 400,
    "text": "Dubiis militibus, Laelius item ad bellum hortatur."
  },
  {
    "id": "p-c369e4",
    "offset": 452,
    "text": "Adsentiunt milites."
  },
  {
    "id": "p-b3eed1",
    "offset": 473,
    "text": "Ergo Caesar Romam petit. Enumerantur copiae."
  },
  {
    "id": "p-d1cf5f",
    "offset": 519,
    "text": "Fama maior vero Romae de eius adventu. Metus populi. Fugiunt senatores et cives, et ipse Pompeius."
  },
  {
    "id": "p-b8f7b7",
    "offset": 619,
    "text": "Prodigia visa enarrantur."
  },
  {
    "id": "p-b43bcc",
    "offset": 646,
    "text": "Ea propter consulitur Tuscus vates Aruns. Lustratur urbs. Sacrificium fit infaustum. Mala praesagit Aruns."
  },
  {
    "id": "p-32f2c6",
    "offset": 754,
    "text": "Item Figulus."
  },
  {
    "id": "p-721eb1",
    "offset": 769,
    "text": "Item matrona quaedam."
  }
]