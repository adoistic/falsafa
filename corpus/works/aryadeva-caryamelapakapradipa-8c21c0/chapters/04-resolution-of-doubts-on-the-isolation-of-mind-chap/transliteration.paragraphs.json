[
  {
    "id": "p-4f4b4f",
    "offset": 0,
    "text": "**CMP 4.1**"
  },
  {
    "id": "p-b0d221",
    "offset": 13,
    "text": "dūraṅgamekacaramaśarīraṃ guhāśayam / ye cittaṃ sanniveśayanti mucyante mārabandhanād // iti /"
  },
  {
    "id": "p-6b9eb9",
    "offset": 108,
    "text": "**CMP 4.2**"
  },
  {
    "id": "p-c7f3dd",
    "offset": 121,
    "text": "pratītyotpadyate yadyadindriyairviṣayairmanaḥ //"
  },
  {
    "id": "p-5560a3",
    "offset": 171,
    "text": "**CMP 4.3**"
  },
  {
    "id": "p-aa4ca6",
    "offset": 184,
    "text": "tanmanastvaśītikhyātasrakārastrāṇanārthataḥ // iti /"
  },
  {
    "id": "p-0a79dd",
    "offset": 238,
    "text": "**CMP 4.4**"
  },
  {
    "id": "p-e514cb",
    "offset": 251,
    "text": "saṃvittimātrakaṃ jñānamākāśavadalakṣaṇam / kintu tasya prabhedo 'sti sandhyārātridivātmanā //"
  },
  {
    "id": "p-231265",
    "offset": 346,
    "text": "**CMP 4.5**"
  },
  {
    "id": "p-983454",
    "offset": 359,
    "text": "ālokālokabhāsau ca tathālokopalabdhakam / cittaṃ trividhamityuktamādhārastasya kathyate //"
  },
  {
    "id": "p-902b2e",
    "offset": 451,
    "text": "**CMP 4.6**"
  },
  {
    "id": "p-2606e5",
    "offset": 464,
    "text": "vāyunā sūkṣmarūpeṇa jñānaṃ sanmiśratāṃ gatam //"
  },
  {
    "id": "p-a9ed63",
    "offset": 513,
    "text": "**CMP 4.7**"
  },
  {
    "id": "p-8b7390",
    "offset": 526,
    "text": "niḥsṛtyendriyamārgebhyo viṣayānavalambate //"
  },
  {
    "id": "p-8cabc3",
    "offset": 572,
    "text": "**CMP 4.8**"
  },
  {
    "id": "p-a95423",
    "offset": 585,
    "text": "ābhāsena yadā yukto vāyurvāhanatāṃ gataḥ / tadā tatprakṛtiḥ sarvā astavyastā pravartate //"
  },
  {
    "id": "p-3659c0",
    "offset": 677,
    "text": "**CMP 4.9**"
  },
  {
    "id": "p-f7bfee",
    "offset": 690,
    "text": "yatra yatra sthito vāyustāṃ tāṃ prakṛtimudvaheta // iti /"
  },
  {
    "id": "p-be170b",
    "offset": 749,
    "text": "**CMP 4.colophon**"
  },
  {
    "id": "p-cd5458",
    "offset": 769,
    "text": "cittavivekasaṃśayamelāvaṇaparicchedaścaturthaḥ // 4 //"
  }
]