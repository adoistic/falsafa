[
  {
    "id": "p-7be78f",
    "offset": 0,
    "text": "**CMP 9.1**"
  },
  {
    "id": "p-2940e6",
    "offset": 13,
    "text": "phalena hetumāmudrya phalamāmudrya hetunā / vibhāvyamanyathāsiddhiṃ kalpakoṭirna jāyate // iti /"
  },
  {
    "id": "p-8abc62",
    "offset": 111,
    "text": "**CMP 9.2**"
  },
  {
    "id": "p-abda41",
    "offset": 124,
    "text": "vajrasattvo mahārājaścodanīyo muhurmuhuḥ // iti /"
  },
  {
    "id": "p-0198e0",
    "offset": 175,
    "text": "**CMP 9.3**"
  },
  {
    "id": "p-7f76a5",
    "offset": 188,
    "text": "pādaprasārikaṃ muktvā tyaktvā saṃsārapeṭakam / sādhayed vajrasattvāgraṃ nityamudyuktamānasaḥ //"
  },
  {
    "id": "p-d8bd0d",
    "offset": 285,
    "text": "**CMP 9.4**"
  },
  {
    "id": "p-6f6498",
    "offset": 298,
    "text": "kaukṛtyastyānamiddhādīn parityajya prayatnataḥ / anyathā naiva siddhiḥ syāt kalpakoṭiśatairapi // iti /"
  },
  {
    "id": "p-a07404",
    "offset": 403,
    "text": "**CMP 9.5**"
  },
  {
    "id": "p-2b8418",
    "offset": 416,
    "text": "bhikṣubhāve sthitā ye 'tra ye tu tarkaratā narāḥ / vṛddhabhāve sthitā ye tu teṣāṃ tattvaṃ na deśayet // iti /"
  },
  {
    "id": "p-7f983d",
    "offset": 527,
    "text": "**CMP 9.6**"
  },
  {
    "id": "p-52ec04",
    "offset": 540,
    "text": "upāyarahitaṃ jñānaṃ śikṣā cāpi hi deśitā / śrāvakāṇāṃ mahāvīra avatā(dhā)raya teṣu vai //"
  },
  {
    "id": "p-e5d6d1",
    "offset": 631,
    "text": "**CMP 9.7**"
  },
  {
    "id": "p-ef0f77",
    "offset": 644,
    "text": "mūlasūtre 'pyāha- daśakuśalān karmapathānicchanti jñānavarjitāḥ // iti /"
  },
  {
    "id": "p-7d4a4b",
    "offset": 718,
    "text": "**CMP 9.8**"
  },
  {
    "id": "p-8fb03f",
    "offset": 731,
    "text": "śrāvakayānamaśikṣatha bhikṣo bodhicariyata tatra carīye / bodhicarīṃ cara buddhaguṇeṣu eṣa nidānabhaviṣya svayaṃbhūḥ // iti /"
  },
  {
    "id": "p-94d91d",
    "offset": 858,
    "text": "**CMP 9.9**"
  },
  {
    "id": "p-cb5e71",
    "offset": 871,
    "text": "duṣkarairniyamaistīrvrairmūrtiḥ śuṣyati duḥkhitā / duḥkhād vikṣipyate cittaṃ vikṣepāt siddhiranyathā // iti /"
  },
  {
    "id": "p-937a19",
    "offset": 982,
    "text": "**CMP 9.10**"
  },
  {
    "id": "p-2484c5",
    "offset": 996,
    "text": "mūlasūtre 'pyāha- duṣkarairniyamaistīvraiḥ sevyamāno na siddhyati / sarvakāmopabhogaistu sevayaṃścāśu siddhyati // iti /"
  },
  {
    "id": "p-9c9cd2",
    "offset": 1118,
    "text": "**CMP 9.11**"
  },
  {
    "id": "p-ede475",
    "offset": 1132,
    "text": "rāgo dveṣaśca mohaśca traya ete viṣaṅgatāḥ / viṣatvamupayāntyeva viṣameṇa tu sevitā //"
  },
  {
    "id": "p-8c8aca",
    "offset": 1220,
    "text": "**CMP 9.12**"
  },
  {
    "id": "p-4cc795",
    "offset": 1234,
    "text": "amṛtatvaṃ punaryānti, amṛtena tu sevitāḥ // iti /"
  },
  {
    "id": "p-f59a92",
    "offset": 1285,
    "text": "**CMP 9.13**"
  },
  {
    "id": "p-6f6649",
    "offset": 1299,
    "text": "badhyati yena jaḍaḥ parimucyati tena budhaḥ / bodhivibhāvanayā viparītamidaṃ sakalam //"
  },
  {
    "id": "p-f7b741",
    "offset": 1388,
    "text": "**CMP 9.14**"
  },
  {
    "id": "p-66f1a4",
    "offset": 1402,
    "text": "yena mūḍhāḥ prabadhyante śīryante rauravāntike / taireva hi vimucyante sukhaṃ prajñābalena tu // iti /"
  },
  {
    "id": "p-103c42",
    "offset": 1506,
    "text": "**CMP 9.15**"
  },
  {
    "id": "p-6c4038",
    "offset": 1520,
    "text": "athātaḥ saṃpravakṣyāmi sarvato viśvamuttamam / sarvabuddhasamāyogaḍākinījālasaṃvaram //"
  },
  {
    "id": "p-311808",
    "offset": 1609,
    "text": "**CMP 9.16**"
  },
  {
    "id": "p-253b42",
    "offset": 1623,
    "text": "rahasye parame ramye sarvātmani sadā sthitaḥ / sarvabuddhamayaḥ śrīmān vajrasattvodayaḥ sukhaḥ //"
  },
  {
    "id": "p-6a9e46",
    "offset": 1722,
    "text": "**CMP 9.17**"
  },
  {
    "id": "p-d84f76",
    "offset": 1736,
    "text": "tathāgatamahādivyaratnajālādyalaṅkṛtam / tato ghaṇṭāvasaṃsaktavitānavitatojjvale //"
  },
  {
    "id": "p-ab7e25",
    "offset": 1821,
    "text": "**CMP 9.18**"
  },
  {
    "id": "p-a7cf23",
    "offset": 1835,
    "text": "vajragītiṃ ca pūjāṃ ca gītavādyairvikurvitam / puṣpadhūpādiyogena dīpagandhādibhistathā //"
  },
  {
    "id": "p-d4a110",
    "offset": 1927,
    "text": "**CMP 9.19**"
  },
  {
    "id": "p-42530f",
    "offset": 1941,
    "text": "prasādhayanti bhavane sodyānādiṣu vā punaḥ / sarvabuddhasamāyogaḍākinījālasaṃvaram //"
  },
  {
    "id": "p-3d6237",
    "offset": 2028,
    "text": "**CMP 9.20**"
  },
  {
    "id": "p-1d87d1",
    "offset": 2042,
    "text": "tatrāsanaṃ niveśyādau mṛdusaṃsparśajaṃ sukham / viśvapadmapaṭacchannaṃ sarvaśuddhāsanaṃ hi tat //"
  },
  {
    "id": "p-54dd82",
    "offset": 2141,
    "text": "**CMP 9.21**"
  },
  {
    "id": "p-4a943f",
    "offset": 2155,
    "text": "sarvabuddhasamāyogaṃ yogeśvaravikurvitam / śrīvajrasattvarūpāstu vikurvanti hi yatra(tattu) vai //"
  },
  {
    "id": "p-b74dac",
    "offset": 2255,
    "text": "**CMP 9.22**"
  },
  {
    "id": "p-2307e8",
    "offset": 2269,
    "text": "sarvadhātumayī(yo) vāpi jīvamūlamayastathā / svādhidaivatpratimukhaiḥ siddhimudrāpravartanam //"
  },
  {
    "id": "p-8e3e49",
    "offset": 2366,
    "text": "**CMP 9.23**"
  },
  {
    "id": "p-d4975b",
    "offset": 2380,
    "text": "niṣiktāṃ ghaṭitāṃ vāpi(bhi)saṃskṛtāṃ vā sucitritām / vicitrapratibimbāṃ ca cinhamudrāṃ prakalpayet //"
  },
  {
    "id": "p-91eef7",
    "offset": 2483,
    "text": "**CMP 9.24**"
  },
  {
    "id": "p-878eef",
    "offset": 2497,
    "text": "tadāsaneṣu prāṇasarvān yathāsthānaṃ hi vinyaset / caturasraṃ caturdvāraṃ catustoraṇamaṇḍitam / vajraratnapadmādi tu dvārapālena yojayet //"
  },
  {
    "id": "p-f96ac0",
    "offset": 2637,
    "text": "**CMP 9.25**"
  },
  {
    "id": "p-747886",
    "offset": 2651,
    "text": "svādhidaivatpratimukhaiḥ suprasādhitayoṣitam / svamudrācinhasubhagāṃ kalpayed gaṇamaṇḍalam //"
  },
  {
    "id": "p-0c512e",
    "offset": 2746,
    "text": "**CMP 9.26**"
  },
  {
    "id": "p-b6cc85",
    "offset": 2760,
    "text": "caturasraṃ caturdvāraṃ catustoraṇamaṇḍitam / catuḥsūtrasamāyuktamaṣṭastambhopaśobhitam //"
  },
  {
    "id": "p-f27b71",
    "offset": 2851,
    "text": "**CMP 9.27**"
  },
  {
    "id": "p-26bbc7",
    "offset": 2865,
    "text": "hārārddhahāraracitaṃ paṭṭasragdāmabhūṣitam / ghaṇṭāpatākasaṃśobhaṃ cāmarādivibhūṣitam //"
  },
  {
    "id": "p-455e5e",
    "offset": 2955,
    "text": "**CMP 9.28**"
  },
  {
    "id": "p-38dd73",
    "offset": 2969,
    "text": "candrārddhavajrakoṇaṃ ca dvāraniryūhasandhiṣu / patvi(kṣi)ṇīkramaśīrṣādivicitra paṭamaṇḍitam //"
  },
  {
    "id": "p-3b9c41",
    "offset": 3066,
    "text": "**CMP 9.29**"
  },
  {
    "id": "p-cf1615",
    "offset": 3080,
    "text": "sarvadevyupabhogaistu sevyamānairyathāsukham / svādhidaivatayogena svamātmānaṃ prapūjayet //"
  },
  {
    "id": "p-857e3a",
    "offset": 3174,
    "text": "**CMP 9.30**"
  },
  {
    "id": "p-037be0",
    "offset": 3188,
    "text": "pūjyate 'nuyogena sarvayogasukhena tu / samāsvādayamānastvatiyogena siddhyati //"
  },
  {
    "id": "p-6def68",
    "offset": 3270,
    "text": "**CMP 9.31**"
  },
  {
    "id": "p-c6bc79",
    "offset": 3284,
    "text": "anena sarvabuddhātmā rasāyanasukhena tu / siddhyet śrīvajrasattvāyuryauvanārogyasatsukham //"
  },
  {
    "id": "p-0b7f3d",
    "offset": 3378,
    "text": "**CMP 9.32**"
  },
  {
    "id": "p-453cbb",
    "offset": 3392,
    "text": "sarvabuddhamahākāyaḥ sarvabuddhasarasvatī / sarvabuddhamahācittaḥ sarvabuddhamahāmahaḥ //"
  },
  {
    "id": "p-b4a2f2",
    "offset": 3483,
    "text": "**CMP 9.33**"
  },
  {
    "id": "p-2a78e1",
    "offset": 3497,
    "text": "sarvabuddhamahārājā sarvavajradharādhipaḥ / sarvalokeśvarapatiḥ sarvaratnādhipeśvaraḥ //"
  },
  {
    "id": "p-a91d2c",
    "offset": 3587,
    "text": "**CMP 9.34**"
  },
  {
    "id": "p-3e535e",
    "offset": 3601,
    "text": "tābhiḥ saṃramyamāṇastu yātyutpattiṃ tu gacchataḥ / sarvadevīmahāsidhya(ddha)ścakravartī prasidhyati // iti /"
  },
  {
    "id": "p-42544f",
    "offset": 3711,
    "text": "**CMP 9.35**"
  },
  {
    "id": "p-919f87",
    "offset": 3725,
    "text": "pratyahaṃ pratimāsaṃ vā pratisaṃvatsaraṃ tathā / yathādhiṣṭhānato vāpi nāṭayed buddhasaṃvaram // iti /"
  },
  {
    "id": "p-700c17",
    "offset": 3829,
    "text": "**CMP 9.36**"
  },
  {
    "id": "p-6bca2f",
    "offset": 3843,
    "text": "utthito vā niṣaṇṇo vā caṃkraman vā yathāsthitaḥ / praharṣan vā jalpan vā yatra tatra yathā tathā //"
  },
  {
    "id": "p-092fb2",
    "offset": 3944,
    "text": "**CMP 9.37**"
  },
  {
    "id": "p-c3f22a",
    "offset": 3958,
    "text": "yadyadindriyamārgatvaṃ yāyāttattatsvabhāvataḥ / asamāhitayogena sarvabuddhamayaṃ vahet //"
  },
  {
    "id": "p-6c8cac",
    "offset": 4049,
    "text": "**CMP 9.38**"
  },
  {
    "id": "p-115280",
    "offset": 4063,
    "text": "khasamaṃ khasamākāramaparyantasāgaropamam / rāgadharmanayo dveṣo vilāsaḥ krīḍāvistaraḥ //"
  },
  {
    "id": "p-559baa",
    "offset": 4154,
    "text": "**CMP 9.39**"
  },
  {
    "id": "p-28afe0",
    "offset": 4168,
    "text": "gṛhītaṃ vastumātraṃ ca śiṣyabodhanakāraṇāt / kati janmāntaraṃ vaktuṃ sahyate rāgadeśanā //"
  },
  {
    "id": "p-d37cfd",
    "offset": 4260,
    "text": "**CMP 9.colophon**"
  },
  {
    "id": "p-d5a760",
    "offset": 4280,
    "text": "śrīsarvabuddhasamāyogaḍākinījālasaṃvaranyāyena bodhisattvacaritadharmodayābhisaṃbodhiprapañcatāmelāvaṇa-saṃśayaparicchedo navamaḥ // 9 //"
  }
]