[
  {
    "id": "p-db8c38",
    "offset": 0,
    "text": "Ἁλληλουιά· Ἁγγαίου καὶ Ζαχαρίου."
  },
  {
    "id": "p-2f67bd",
    "offset": 34,
    "text": "Αἰνεῖτε τὸν κύριον ἐκ τῶν οὐρανῶν,"
  },
  {
    "id": "p-c85372",
    "offset": 70,
    "text": "αἰνεῖτε αὐτὸν ἐν τοῖς ὑψίστοις."
  },
  {
    "id": "p-e3e4d9",
    "offset": 103,
    "text": "αἰνεῖτε αὐτόν, πάντες οἱ ἄγελοι αὐτοῦ·"
  },
  {
    "id": "p-21acac",
    "offset": 143,
    "text": "αἰνεῖτε αὐτόν, πᾶσαι αἱ δυνάμεις αὐτοῦ."
  },
  {
    "id": "p-8d811c",
    "offset": 184,
    "text": "αφωῖτε αὐτόν, ἥλιος καὶ σελήνη·"
  },
  {
    "id": "p-6c06af",
    "offset": 217,
    "text": "αἰνεῖτε αὐτόν, πάντα τὰ ἄστρα καὶ τὸ φῶς."
  },
  {
    "id": "p-3f9eeb",
    "offset": 260,
    "text": "αἰοτεῖτε αὐτόν, οἱ οὐρανοὶ τῶν οὐρανῶν,"
  },
  {
    "id": "p-48b6b6",
    "offset": 301,
    "text": "αγεσάτωσαν τὸ ὄνομα Κυρίου·"
  },
  {
    "id": "p-f51d48",
    "offset": 330,
    "text": "καὶ τὸ ὕδωρ τὸ ὑπεράνω τῶν οὐρανῶν."
  },
  {
    "id": "p-c2576f",
    "offset": 367,
    "text": "ὅτι αὐτὸς εἶπεν καὶ ἐγενήθησαν,"
  },
  {
    "id": "p-01dd9a",
    "offset": 400,
    "text": "αὐτὸς ἐνετείλατο καὶ ἐκτίσθησαν."
  },
  {
    "id": "p-99d4a2",
    "offset": 434,
    "text": "ἔστησεν αὐτὰ εἰς τὸν αἰῶνα"
  },
  {
    "id": "p-738e6f",
    "offset": 462,
    "text": "καὶ εἰς τὸν αἰῶνα τοῦ αἰῶνος·"
  },
  {
    "id": "p-0ece47",
    "offset": 493,
    "text": "πρόσταγμα ἔθετο, καὶ οὐ παρελεύσεται."
  },
  {
    "id": "p-1df8b6",
    "offset": 532,
    "text": "αἰνεῖτε τὸν κύριον ἐκ τῆς γῆς,"
  },
  {
    "id": "p-932575",
    "offset": 564,
    "text": "δράκοντες καὶ πᾶσαι ἄβυσσοι·"
  },
  {
    "id": "p-57ea32",
    "offset": 594,
    "text": "πῦρ, χάλαζα. χάν. κρύσταλλος. πνεῦμα καταιγίδος,"
  },
  {
    "id": "p-0a4025",
    "offset": 644,
    "text": "τὰ ποιοῦντα τὸν λόγον αὐτοῦ·"
  },
  {
    "id": "p-7cdb5d",
    "offset": 674,
    "text": "τὰ ὄρη καὶ πάντες βουνοί,"
  },
  {
    "id": "p-9629ac",
    "offset": 701,
    "text": "ξύλα καρποφόρα καὶ πᾶσαι κέδροι·"
  },
  {
    "id": "p-a61d10",
    "offset": 735,
    "text": "τὰ θηρία καὶ πάντα τὰ κτήνη,"
  },
  {
    "id": "p-eb5ee1",
    "offset": 765,
    "text": "ἐρπετὰ καὶ πετεινὰ πτερωτά·"
  },
  {
    "id": "p-b3488e",
    "offset": 794,
    "text": "βασιλεῖς τῆς γῆς καὶ πάντες λαοί,"
  },
  {
    "id": "p-59289f",
    "offset": 829,
    "text": "ἄρχοντες καὶ πάντες κριταὶ γῆς·"
  },
  {
    "id": "p-59a282",
    "offset": 862,
    "text": "νεανίσκοι καὶ παρθένοι,"
  },
  {
    "id": "p-a4e241",
    "offset": 887,
    "text": "πρεσβῦται μετὰ νεωτέρων·"
  },
  {
    "id": "p-bb5fd9",
    "offset": 913,
    "text": "αἰνεσάτωσαν τὸ ὄνομα Κυρίου,"
  },
  {
    "id": "p-b4ed1a",
    "offset": 943,
    "text": "ὅτι ὑψώθη τὸ ὄνομα αὐτοῦ μόνου,"
  },
  {
    "id": "p-cf85b2",
    "offset": 976,
    "text": "ἡ ἐξομολόγησις αὐτοῦ ἐπὶ γῆς καὶ οὐρανοῦ·"
  },
  {
    "id": "p-963bb4",
    "offset": 1019,
    "text": "καὶ ὑψώσει κέρας λαοῦ αὐτοῦ,"
  },
  {
    "id": "p-ff5ea6",
    "offset": 1049,
    "text": "τοῖς υἱοῖς Ἰσραήλ, λαῷ ἐγγίζοντι αὐτῷ."
  }
]