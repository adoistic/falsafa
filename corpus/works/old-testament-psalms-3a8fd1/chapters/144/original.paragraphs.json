[
  {
    "id": "p-bdd8dc",
    "offset": 0,
    "text": "Ἁλληλουιά· Ἀγγαίου καὶ Ζαχαρίου."
  },
  {
    "id": "p-bbe232",
    "offset": 34,
    "text": "Aἴνει, ἡ ψυχὴ μου, τὸν κύριον·"
  },
  {
    "id": "p-fe20b4",
    "offset": 66,
    "text": "αἰὰέσω Κύριον ἐν ζωῇ μου,"
  },
  {
    "id": "p-82ec16",
    "offset": 93,
    "text": "ψαλῶ τῷ θεῷ μου ἕως ὑπάρχω."
  },
  {
    "id": "p-ad6d66",
    "offset": 122,
    "text": "μὴ πεποίθατε ἐπʼ ἄρχοντας καὶ ἐφʼ υἱοὺς ἀνθρώπων, οἷς"
  },
  {
    "id": "p-c86712",
    "offset": 177,
    "text": "οὐκ ἔστιν σωτηρία·"
  },
  {
    "id": "p-4f1ad2",
    "offset": 197,
    "text": "ἐξελεύσεται τὸ πνεῦμα αὐτοῦ"
  },
  {
    "id": "p-1eec89",
    "offset": 226,
    "text": "καὶ ἐπιστρέψει εἰς τὴν γῆν αὐτοῦ·"
  },
  {
    "id": "p-416790",
    "offset": 261,
    "text": "ἐν ἐκείνῃ τῇ ἡμέρᾳ ἀπολοῦνται πάντες οἱ διαλογισμοὶ αὐτῶν."
  },
  {
    "id": "p-ce9c17",
    "offset": 321,
    "text": "μακάριος οὗ ὁ θεὸς Ἰακὼβ βοηθός,"
  },
  {
    "id": "p-e13c8f",
    "offset": 355,
    "text": "ἡ ἐλπὶς αὐτοῦ ἐπὶ Κύριον τὸν θεὸν αὐτοῦ·"
  },
  {
    "id": "p-bea5ce",
    "offset": 397,
    "text": "τὸν ποιήσαντα τὸν οὐρανὸν καὶ τὴν γῆν,"
  },
  {
    "id": "p-29ecd2",
    "offset": 437,
    "text": "τὴν θάλασσαν καὶ πάντα τὰ ἐν αὐτοῖς·"
  },
  {
    "id": "p-b8bfb2",
    "offset": 475,
    "text": "τὸν φυλάσσοντα ἀλήθειαν εἰς τὸν αἰῶνα,"
  },
  {
    "id": "p-e17cf2",
    "offset": 515,
    "text": "ποιοῦντα κρίμα τοῖς ἀδικουμένοις,"
  },
  {
    "id": "p-7e4534",
    "offset": 550,
    "text": "διδόντα τροφὴν τοῖς πεινῶσιν."
  },
  {
    "id": "p-4422b9",
    "offset": 581,
    "text": "Κύριος λύει πεπεδημένους·"
  },
  {
    "id": "p-8a4c62",
    "offset": 608,
    "text": "Κύρος ἀνορθοῖ κατερραγμένους·"
  },
  {
    "id": "p-d0b2f0",
    "offset": 639,
    "text": "Κύριος σοφοῖ τυφλούς·"
  },
  {
    "id": "p-c6f105",
    "offset": 662,
    "text": "Κύριος ἀγαπᾷ δικαίους·"
  },
  {
    "id": "p-4675f5",
    "offset": 686,
    "text": "Κύριος φυλάσσει τοὺς προσηλύτους,"
  },
  {
    "id": "p-d73958",
    "offset": 721,
    "text": "ὀρφανὸν καὶ χήραν ἀναλήμψεται,"
  },
  {
    "id": "p-abdcba",
    "offset": 753,
    "text": "καὶ ὁδὸν ἁμαρτωλῶν ἀφανιεῖ."
  },
  {
    "id": "p-cf55db",
    "offset": 782,
    "text": "βασιλεύσει Κύριος εἰς τὸν αἰῶνα, ὁ θεός σου, Σιών,"
  },
  {
    "id": "p-12750d",
    "offset": 834,
    "text": "εἰς γενεὰν καὶ γενεάν."
  }
]