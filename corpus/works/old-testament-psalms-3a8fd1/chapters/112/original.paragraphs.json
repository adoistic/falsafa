[
  {
    "id": "p-15ff4f",
    "offset": 0,
    "text": "Ἁλληλουιά."
  },
  {
    "id": "p-d64c4a",
    "offset": 12,
    "text": "Αἰνεῖτε, παῖδες, Κύριον,"
  },
  {
    "id": "p-bfc86b",
    "offset": 38,
    "text": "αἰνεῖτε τὸ ὄνομα αὐτοῦ."
  },
  {
    "id": "p-dea59b",
    "offset": 63,
    "text": "εἴη τὸ ὄνομα Κυρίου εὐλογημένον"
  },
  {
    "id": "p-a29d14",
    "offset": 96,
    "text": "ἀπὸ τοῦ νῦν καὶ ἕως τοῦ αἰῶνος·"
  },
  {
    "id": "p-f497db",
    "offset": 129,
    "text": "ἀπὸ ἀνατολῶν ἡλίου μέχρι δυσμῶν"
  },
  {
    "id": "p-f2cdff",
    "offset": 162,
    "text": "αἰνεῖται τὸ ὄνομα Κυρίου."
  },
  {
    "id": "p-9b0fb8",
    "offset": 189,
    "text": "ὑψηλὸς ἐπὶ πάντα τὸ ἔθνη ὁ κύριος,"
  },
  {
    "id": "p-cfa83d",
    "offset": 225,
    "text": "ἐπὶ τοὺς οὐρανοὺς ἡ δόξα αὐτοῦ."
  },
  {
    "id": "p-6abb73",
    "offset": 258,
    "text": "τίς ὡς Κύριος ὁ θεὸς ἡμῶν;"
  },
  {
    "id": "p-c48bf8",
    "offset": 286,
    "text": "ὁ ἐν ὑψηλοῖς κατοικῶν,"
  },
  {
    "id": "p-15d08c",
    "offset": 310,
    "text": "καὶ τὰ ταπεινὰ ἐφορῶν"
  },
  {
    "id": "p-da25f7",
    "offset": 333,
    "text": "ἐν τῷ οὐρανῷ καὶ ἐν τῇ γῇ·"
  },
  {
    "id": "p-50955b",
    "offset": 361,
    "text": "ὁ ἐγείρων ἀπὸ γῆς πτωχόν."
  },
  {
    "id": "p-b86f8f",
    "offset": 388,
    "text": "καὶ ἀπὸ κοπρίας ἀνυψῶν πένητα,"
  },
  {
    "id": "p-68037d",
    "offset": 420,
    "text": "τοῦ καθίσαι αὐτὸν μετὰ ἀρχόντων,"
  },
  {
    "id": "p-bfd31b",
    "offset": 454,
    "text": "μετὰ ἀρχόντων λαοῦ αὐτοῦ·"
  },
  {
    "id": "p-66e920",
    "offset": 481,
    "text": "ὁ κατοικίζων στεῖραν ἐν οἴκῳ,"
  },
  {
    "id": "p-74cd53",
    "offset": 512,
    "text": "μητέρα τέκνων εὐφραινομένων."
  },
