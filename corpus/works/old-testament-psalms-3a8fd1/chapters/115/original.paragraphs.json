[
  {
    "id": "p-15ff4f",
    "offset": 0,
    "text": "Ἁλληλουιά."
  },
  {
    "id": "p-e34fad",
    "offset": 12,
    "text": "Ἐπίστευσα, διὸ ἐλάλησα·"
  },
  {
    "id": "p-f67fc6",
    "offset": 37,
    "text": "ἐγὼ δὲ ἐταπεινώθην σφόδρα."
  },
  {
    "id": "p-8e8ef9",
    "offset": 65,
    "text": "ἐγὼ εἶπα ἐν τῇ ἐκστάσει μου"
  },
  {
    "id": "p-b35a4e",
    "offset": 94,
    "text": "Πᾶς ἄνθρωπος ψεύστης."
  },
  {
    "id": "p-1a7608",
    "offset": 117,
    "text": "τί ἀνταποδώσω τῷ κυρίῳ"
  },
  {
    "id": "p-e3c5a7",
    "offset": 141,
    "text": "περὶ ὧν ἀνταπέδωκέν μοι;"
  },
  {
    "id": "p-3cdb76",
    "offset": 167,
    "text": "ποτήριον σωτηρίου λήμψομαι,"
  },
  {
    "id": "p-b787cf",
    "offset": 196,
    "text": "καὶ τὸ ὄνομα Κυρίου ἐπικαλέσομαι."
  },
  {
    "id": "p-0d9d15",
    "offset": 231,
    "text": "τίμιος ἐναντίον Κυρίου"
  },
  {
    "id": "p-de713b",
    "offset": 255,
    "text": "ὁ θάυατος τῶν ὁσίων αὐτοῦ."
  },
  {
    "id": "p-482eca",
    "offset": 283,
    "text": "ὦ Κύριε. ἐγὼ δοῦλος σός."
  },
  {
    "id": "p-fd25c1",
    "offset": 309,
    "text": "ἐγὼ δοῦλος σὸς καὶ υἱὸς τῆς παιδίσκης σου·"
  },
  {
    "id": "p-a260c4",
    "offset": 353,
    "text": "διέρρηξας τοὺς δεσμούς μου."
  },
  {
    "id": "p-2be988",
    "offset": 382,
    "text": "σοὶ θύσω θυσίαν αἰνέσεως·"
  },
  {
    "id": "p-144bb7",
    "offset": 409,
    "text": "τὰς εὐχάς μου ἀποδώσω τῷ κυρίῳ"
  },
  {
    "id": "p-030922",
    "offset": 441,
    "text": "ἐναντίον παντὸς τοῦ λαοῦ αὐτοῦ,"
  },
  {
    "id": "p-17d3b5",
    "offset": 474,
    "text": "ἐν αὐλαῖς οἴκου Κυρίου,"
  },
  {
    "id": "p-1aa8aa",
    "offset": 499,
    "text": "ἐν μέσῳ σου, Ἰερουσαλήμ."
  }
]