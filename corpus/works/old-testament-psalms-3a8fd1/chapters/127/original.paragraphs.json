[
  {
    "id": "p-6ea6a0",
    "offset": 0,
    "text": "ᾨδὴ τῶν ἀναβαθμῶν."
  },
  {
    "id": "p-dfa1b1",
    "offset": 20,
    "text": "Πλεονάκις ἐπολέμησάν με ἐκ νεότητός μου,"
  },
  {
    "id": "p-cd9fe6",
    "offset": 62,
    "text": "εἰπάτω δὴ Ἰσραήλ·"
  },
  {
    "id": "p-a2cf1b",
    "offset": 81,
    "text": "πλεονάκις ἐπολέμησάν με ἐκ νεότητός μου,"
  },
  {
    "id": "p-04f076",
    "offset": 123,
    "text": "καὶ γὰρ οὐκ ἠδυνήθησαν μοι."
  },
  {
    "id": "p-103b7e",
    "offset": 152,
    "text": "ἐπὶ τοῦ νώτου μου ἐτέκταινον οἱ ἁμαρτωλοί,"
  },
  {
    "id": "p-547095",
    "offset": 196,
    "text": "ἀμάκρυναν τὴν ἀνομίαν αὐτῶν·"
  },
  {
    "id": "p-ebba0e",
    "offset": 226,
    "text": "Κύριος δίκαιος συνέκοψεν αὐχένα ἁμαρτωλῶν·"
  },
  {
    "id": "p-84614b",
    "offset": 270,
    "text": "αἰσχυνθήτωσαν καὶ ἀποστραφήτωσαν εἰς τὰ ὀπίσω πάντες οἱ"
  },
  {
    "id": "p-e8bcb3",
    "offset": 327,
    "text": "μισοῦντες Σιών·"
  },
  {
    "id": "p-40f5c2",
    "offset": 344,
    "text": "γενηθήτωσαν ὡς χόρτος δωμάτων,"
  },
  {
    "id": "p-268a2d",
    "offset": 376,
    "text": "ὃς πρὸ τοῦ ἐκσπασθῆναι ἐξηράνθη·"
  },
  {
    "id": "p-d7ccf7",
    "offset": 410,
    "text": "οὗ οὐκ ἐπλήρωσεν τὴν χεῖρα αὐτοῦ ὁ θερίζων,"
  },
  {
    "id": "p-7665b9",
    "offset": 455,
    "text": "καὶ τὸν κόλπον αὐτοῦ ὁ τὰ δράγματα συλλέγων·"
  },
  {
    "id": "p-e9fc3d",
    "offset": 501,
    "text": "καὶ οὐκ εἶπαν οἱ παράγοντες Εὐλογία Κυρίου ἐφʼ ἡμᾶς,"
  },
  {
    "id": "p-40fd1f",
    "offset": 555,
    "text": "εὐλογήσομεν ὑμᾶς ἐν ὀνόματι Κυρίου."
  }
]