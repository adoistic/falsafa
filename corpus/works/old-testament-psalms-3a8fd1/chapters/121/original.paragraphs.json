[
  {
    "id": "p-6ea6a0",
    "offset": 0,
    "text": "ᾨδὴ τῶν ἀναβαθμῶν."
  },
  {
    "id": "p-7b51e0",
    "offset": 20,
    "text": "Πρὸς σὲ ἦρα τοὺς ὀφθαλμούς μου, τὸν κατοικοῦντα ἐν τῷ"
  },
  {
    "id": "p-29c567",
    "offset": 75,
    "text": "οὐρανῷ."
  },
  {
    "id": "p-a77f4c",
    "offset": 84,
    "text": "ἰδοὺ ὡς ὀφθαλμοὶ δούλων εἰς χεῖρας τῶν κυρίων αὐτῶν,"
  },
  {
    "id": "p-4add67",
    "offset": 138,
    "text": "ὣς ὀφθαλμοὶ παιδίσκης εἰς χεῖρας τῆς κυρίας αὐτῆς,"
  },
  {
    "id": "p-fc1fa7",
    "offset": 190,
    "text": "οὕτως οἱ ὀφθαλμοὶ ἡμῶν πρὸς Κύριον τὸν θεὸν ἡμῶν,"
  },
  {
    "id": "p-557fce",
    "offset": 241,
    "text": "ἕως οὗ οἰκτειρῆσαι ἡμᾶς."
  },
  {
    "id": "p-a8447e",
    "offset": 267,
    "text": "ἐλέησον ἡμᾶς, Κύριε, ἐλέησον ἡμᾶς."
  },
  {
    "id": "p-f1858b",
    "offset": 303,
    "text": "ὅτι ἐπὶ πολὺ ἐπληθύνθημεν ἐξουδενώσεως·"
  },
  {
    "id": "p-69f435",
    "offset": 344,
    "text": "ἐπὶ πλεῖον ἐπληθύνθη ἡ ψυχὴ ἡμῶν·"
  },
  {
    "id": "p-deabd3",
    "offset": 379,
    "text": "τὸ ὄνειδος τοῖς εὐθηνοῦσιν"
  },
  {
    "id": "p-ce1c94",
    "offset": 407,
    "text": "καὶ ἡ ἐξουδένωσις τοῖς ὑπερηφάνοις."
  }
]