[
  {
    "id": "p-ff118c",
    "offset": 0,
    "text": "Αλληλουιά· Ἀγγαίου καὶ Ζαχαρίου."
  },
  {
    "id": "p-d55a04",
    "offset": 34,
    "text": "Ἐπαίνει, Ἰερουσαλήμ, τὸν κύριον,"
  },
  {
    "id": "p-454ec5",
    "offset": 68,
    "text": "αὔει τὸν θεόν σου, Σειών·"
  },
  {
    "id": "p-15d714",
    "offset": 95,
    "text": "ὅτι ἐνίσχυσεν τοὺς μοχλοὺς τῶν πυλῶν σου,"
  },
  {
    "id": "p-8ac56d",
    "offset": 138,
    "text": "εὐλόγησεν τοὺς υἱούς σου ἐν σοί."
  },
  {
    "id": "p-fc9c33",
    "offset": 172,
    "text": "ὁ τιθεὶς τὰ ὅριά σου εἰρήνην,"
  },
  {
    "id": "p-90561b",
    "offset": 203,
    "text": "καὶ στέαρ πυροῦ ἐμπιπλῶν σε·"
  },
  {
    "id": "p-c05d94",
    "offset": 233,
    "text": "ὁ ἀποστέλλων τὸ λόγιον αὐτοῦ τῇ γῆ,"
  },
  {
    "id": "p-435dbe",
    "offset": 270,
    "text": "ἕως τάχους δραμεῖται ὁ λόγος αὐτοῦ·"
  },
  {
    "id": "p-97f6e4",
    "offset": 307,
    "text": "τοῦ διδόντος χιόνα ὡσεὶ ἔριον,"
  },
  {
    "id": "p-9c2008",
    "offset": 339,
    "text": "ὁμίχλην ὡσεὶ σποδὸν πάσσοντος·"
  },
  {
    "id": "p-7bc82e",
    "offset": 371,
    "text": "βάλλοντος κρύσταλλον αὐτοῦ ὡσεὶ ψωμούς,"
  },
  {
    "id": "p-6d4713",
    "offset": 412,
    "text": "κατὰ πρόσωπον ψύχους αὐτοῦ τίς ὑποστήσεται;"
  },
  {
    "id": "p-1fb488",
    "offset": 457,
    "text": "ἀποστελεῖ τὸν λόγον αὐτοῦ καὶ τήξει αὐτά·"
  },
  {
    "id": "p-1b1223",
    "offset": 500,
    "text": "πνεύσει τὸ πνεῦμα αὐτοῦ, καὶ ῥυήσεται ὕδατα."
  },
  {
    "id": "p-c8154b",
    "offset": 546,
    "text": "ἀπαγγέλλων τὸν λόγον αὐτοῦ τῷ Ἰακώβ,"
  },
  {
    "id": "p-9c081e",
    "offset": 584,
    "text": "δικαιώματα καὶ κρίματα αὐτοῦ τῷ Ἰσραήλ."
  },
  {
    "id": "p-967fa4",
    "offset": 625,
    "text": "οὐκ ἐποίησεν οὕτως παντὶ ἔθνει,"
  },
  {
    "id": "p-73945a",
    "offset": 658,
    "text": "καὶ τὰ κρίματα αὐτοῦ οὐκ ἐδήλωσεν αὐτοῖς."
  }
]