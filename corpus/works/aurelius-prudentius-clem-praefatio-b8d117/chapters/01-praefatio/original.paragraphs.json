[
  {
    "id": "p-213b6b",
    "offset": 0,
    "text": "1. Praefatio\nPer quinquennia iam decem,"
  },
  {
    "id": "p-881bb6",
    "offset": 41,
    "text": "ni fallor, fuimus; septimus insuper"
  },
  {
    "id": "p-b76b74",
    "offset": 78,
    "text": "annum cardo rotat, dum fruimur sole volubili."
  },
  {
    "id": "p-526a82",
    "offset": 125,
    "text": "instat terminus, et diem"
  },
  {
    "id": "p-66ce53",
    "offset": 151,
    "text": "vicinum senio iam Deus adplicat."
  },
  {
    "id": "p-490bc0",
    "offset": 185,
    "text": "quid nos utile tanti spatio temporis egimus?"
  },
  {
    "id": "p-d47c05",
    "offset": 231,
    "text": "aetas prima crepantibus"
  },
  {
    "id": "p-92ba9b",
    "offset": 256,
    "text": "flevit sub ferulis. mox docuit toga"
  },
  {
    "id": "p-e6bedd",
    "offset": 293,
    "text": "infectum vitiis falsa loqui, non sine crimine."
  },
  {
    "id": "p-675b61",
    "offset": 341,
    "text": "tum lasciva protervitas"
  },
  {
    "id": "p-ac8138",
    "offset": 366,
    "text": "et luxus petulans (heu pudet ac piget!)"
  },
  {
    "id": "p-64a647",
    "offset": 407,
    "text": "foedavit iuvenem nequitiae sordibus ac luto."
  },
  {
    "id": "p-8ec93c",
    "offset": 453,
    "text": "exim iurgia turbidos"
  },
  {
    "id": "p-88d27f",
    "offset": 475,
    "text": "armarunt animos, et male pertinax"
  },
  {
    "id": "p-be7958",
    "offset": 510,
    "text": "vincendi studium subiacuit casibus asperis."
  },
  {
    "id": "p-0efe25",
    "offset": 555,
    "text": "bis legum moderamine"
  },
  {
    "id": "p-2fa7fe",
    "offset": 577,
    "text": "frenos nobilium reximus urbium,"
  },
  {
    "id": "p-1febf6",
    "offset": 610,
    "text": "ius civile bonis reddidimus, terruimus reos."
  },
  {
    "id": "p-7bd26e",
    "offset": 656,
    "text": "tandem militiae gradu"
  },
  {
    "id": "p-0e9ff8",
    "offset": 679,
    "text": "evectum pietas principis extulit"
  },
  {
    "id": "p-21fcc6",
    "offset": 713,
    "text": "adsumptum propius stare iubens ordine proximo."
  },
  {
    "id": "p-de2949",
    "offset": 761,
    "text": "haec dum vita volans agit,"
  },
  {
    "id": "p-267443",
    "offset": 789,
    "text": "inrepsit subito canities seni,"
  },
  {
    "id": "p-60f7be",
    "offset": 821,
    "text": "oblitum veteris me Saliae consulis arguens,"
  },
  {
    "id": "p-4f1065",
    "offset": 866,
    "text": "sub quo prima dies mihi"
  },
  {
    "id": "p-2083d9",
    "offset": 891,
    "text": "quam multas hiemes volverit, et rosas"
  },
  {
    "id": "p-792181",
    "offset": 930,
    "text": "pratis post glaciem reddiderit, nix capitis probat,"
  },
  {
    "id": "p-54fa15",
    "offset": 983,
    "text": "numquid talia proderunt"
  },
  {
    "id": "p-142d04",
    "offset": 1008,
    "text": "carnis post obitum vel bona vel mala"
  },
  {
    "id": "p-08c65d",
    "offset": 1046,
    "text": "cum iam, quidquid id est quod fueram, mors aboleverit?"
  },
  {
    "id": "p-f24f8a",
    "offset": 1102,
    "text": "dicendum mihi: ‘quisquis es,"
  },
  {
    "id": "p-a4fede",
    "offset": 1132,
    "text": "mundum, quem coluit, mens tua perdidit."
  },
  {
    "id": "p-9c156e",
    "offset": 1173,
    "text": "non sunt illa Dei, quae studuit, cuius habeberis.’"
  },
  {
    "id": "p-cc4acd",
    "offset": 1225,
    "text": "atqui fine sub ultimo"
  },
  {
    "id": "p-5b9dcf",
    "offset": 1248,
    "text": "peccatrix anima stultitiam exuat:"
  },
  {
    "id": "p-f0d787",
    "offset": 1283,
    "text": "saltem voce Deum concelebret, si meritis nequit,"
  },
  {
    "id": "p-a4499c",
    "offset": 1333,
    "text": "hymnis continuet dies,"
  },
  {
    "id": "p-6e8578",
    "offset": 1357,
    "text": "nec nox ulla vacet quin Dominum canat;"
  },
  {
    "id": "p-b9eb53",
    "offset": 1397,
    "text": "pugnet contra hereses, catholicam discutiat fidem,"
  },
  {
    "id": "p-c5f103",
    "offset": 1449,
    "text": "conculcet sacra gentium,"
  },
  {
    "id": "p-3b3130",
    "offset": 1475,
    "text": "labem, Roma, tuis inferat idolis,"
  },
  {
    "id": "p-4505fc",
    "offset": 1510,
    "text": "carmen martyribus devoveat, laudet apostolos,"
  },
  {
    "id": "p-d8dd9a",
    "offset": 1557,
    "text": "haec dum scribo vel eloquor,"
  },
  {
    "id": "p-54f0a7",
    "offset": 1587,
    "text": "vinclis o utinam corporis emicem"
  },
  {
    "id": "p-d8ba61",
    "offset": 1621,
    "text": "liber, quo tulerit lingua sono mobilis ultimo!"
  }
]