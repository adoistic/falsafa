[
  {
    "id": "p-3ff585",
    "offset": 0,
    "text": "Dorippa:\nQuoniam a viro ad me rus advenit nuntius, rus non iturum, feci ego ingenium meum, reveni, ut illum persequar qui me fugit."
  },
  {
    "id": "p-7be47b",
    "offset": 133,
    "text": "sed anum non video consequi nostram Syram."
  },
  {
    "id": "p-c1231a",
    "offset": 177,
    "text": "atque eccam incedit tandem. quin is ocius?"
  },
  {
    "id": "p-5f6e32",
    "offset": 221,
    "text": "Syra:\nnequeo mecastor, tantum hoc onerist quod fero."
  },
  {
    "id": "p-39b054",
    "offset": 275,
    "text": "Dorippa:\nQuid oneris?"
  },
  {
    "id": "p-7dc76e",
    "offset": 298,
    "text": "Syra:\nAnnos octoginta et quattuor;"
  },
  {
    "id": "p-40b0c7",
    "offset": 334,
    "text": "et eodem accedit servitus, sudor, sitis:"
  },
  {
    "id": "p-3fda98",
    "offset": 376,
    "text": "simul haec quae porto deprimunt."
  },
  {
    "id": "p-297b6f",
    "offset": 410,
    "text": "Dorippa:\nAliquid cedo qui hánc vicini nostri áram augeam."
  },
  {
    "id": "p-850dcc",
    "offset": 469,
    "text": "da sane hanc virgam lauri. abi tu intro."
  },
  {
    "id": "p-9fcabe",
    "offset": 511,
    "text": "Syra:\nEo.—"
  },
  {
    "id": "p-3ac8d2",
    "offset": 523,
    "text": "Dorippa:\nApollo, quaeso te, ut des pacem propitius, salutem et sanitatem nostrae familiae, meoque ut parcas gnato pace propitius."
  },
  {
    "id": "p-6644c3",
    "offset": 654,
    "text": "Syra:"
  },
  {
    "id": "p-b1bede",
    "offset": 661,
    "text": "Disperii, perii misera, vae miserae mihi."
  },
  {
    "id": "p-2a0ff5",
    "offset": 704,
    "text": "Dorippa:\nSatin tu sana es, obsecro? quid eiulas?"
  },
  {
    "id": "p-a18179",
    "offset": 754,
    "text": "Syra:\nDorippa, mea Dorippa."
  },
  {
    "id": "p-ce66de",
    "offset": 783,
    "text": "Dorippa:\nQuid clamas, obsecro?"
  },
  {
    "id": "p-5ce428",
    "offset": 815,
    "text": "Syra:\nNescio quaest mulier intus hic in aedibus."
  },
  {
    "id": "p-dd23f1",
    "offset": 865,
    "text": "Dorippa:\nQuid, mulier?"
  },
  {
    "id": "p-d18015",
    "offset": 889,
    "text": "Syra:\nMulier meretrix."
  },
  {
    "id": "p-6dfd80",
    "offset": 913,
    "text": "Dorippa:\nVeron serio?"
  },
  {
    "id": "p-6644c3",
    "offset": 936,
    "text": "Syra:"
  },
  {
    "id": "p-7b0bbf",
    "offset": 943,
    "text": "Nimium scis sapere, ruri quae non manseris."
  },
  {
    "id": "p-354b14",
    "offset": 988,
    "text": "quamvis insipiens poterat persentiscere illam esse amicam tui viri bellissumi."
  },
  {
    "id": "p-2e9cb2",
    "offset": 1068,
    "text": "Dorippa:\nCredo mecastor."
  },
  {
    "id": "p-df3f7c",
    "offset": 1094,
    "text": "Syra:\nEi hac mecum, ut videas semul tuam Alcumenam paelicem, Iuno mea.—"
  },
  {
    "id": "p-b2f29c",
    "offset": 1167,
    "text": "Dorippa:\nEcastor vero istuc eo quantum potest.—"
  },
  {
    "id": "p-147100",
    "offset": 1216,
    "text": "Lysimachvs:\nParumne ést malai rei, quod amat Demipho, ni sumptuosus insuper etiam siet?"
  },
  {
    "id": "p-12437b",
    "offset": 1305,
    "text": "decem sí vocasset summos ad cenam viros, nimium obsonavit. sed coquos, quasi in mari solét hortator remiges hortarier, ita hortabatur. egomet conduxi coquom."
  },
  {
    "id": "p-20550d",
    "offset": 1464,
    "text": "sed eum demiror non venire, ut iusseram."
  },
  {
    "id": "p-98c8b7",
    "offset": 1506,
    "text": "sed quinam hinc a nobis exit? aperitur foris."
  },
  {
    "id": "p-ed3d28",
    "offset": 1553,
    "text": "Dorippa:\nMiserior mulier me nec fiet, nec fuit, tali viro quae nupserim. heu miserae mihi."
  },
  {
    "id": "p-cab517",
    "offset": 1645,
    "text": "em quoi te et tua, quae tu habeas, commendes viro, em quoi decem talenta dotis detuli, haec ut viderem, ut ferrem has contumelias."
  },
  {
    "id": "p-18ca93",
    "offset": 1777,
    "text": "Lysimachvs:\nPerii hercle, rure iam rediit uxor mea:"
  },
  {
    "id": "p-c03d63",
    "offset": 1830,
    "text": "vidisse credo mulierem in aedibus."
  },
  {
    "id": "p-568ad4",
    "offset": 1866,
    "text": "sed quae loquatur exaudire hinc non queo."
  },
  {
    "id": "p-d57a4e",
    "offset": 1909,
    "text": "accedam propius."
  },
  {
    "id": "p-b7a6cc",
    "offset": 1927,
    "text": "Dorippa:\nVae miserae mi."
  },
  {
    "id": "p-17e235",
    "offset": 1953,
    "text": "Lysimachvs:\nImmo mihi."
  },
  {
    "id": "p-c0a7cc",
    "offset": 1977,
    "text": "Dorippa:"
  },
  {
    "id": "p-31becd",
    "offset": 1987,
    "text": "Disperii."
  },
  {
    "id": "p-9837aa",
    "offset": 1998,
    "text": "Lysimachvs:\nEquidem hercle oppido perii miser."
  },
  {
    "id": "p-b6a2ce",
    "offset": 2046,
    "text": "vidit. ut te omnes, Demipho, di perduint."
  },
  {
    "id": "p-c6e9a9",
    "offset": 2089,
    "text": "Dorippa:\nPol hoc est, ire quod rus meus vir noluit."
  },
  {
    "id": "p-c5649e",
    "offset": 2142,
    "text": "Lysimachvs:\nQuid nunc ego faciam nisi uti ádeam atque adloquar?"
  },
  {
    "id": "p-7a6ff2",
    "offset": 2207,
    "text": "iubet salvere suos vir uxorem suam."
  },
  {
    "id": "p-d6e6df",
    "offset": 2244,
    "text": "urbani fiunt rustici?"
  },
  {
    "id": "p-4818e7",
    "offset": 2267,
    "text": "Dorippa:\nPudicius faciunt, quam ílli qui non fiunt rustici."
  },
  {
    "id": "p-ed964c",
    "offset": 2328,
    "text": "Lysimachvs:\nNum quid delinquont rustici?"
  },
  {
    "id": "p-4357ca",
    "offset": 2370,
    "text": "Dorippa:\nEcastor minus quam urbani, et multo minus mali quaerunt sibi."
  },
  {
    "id": "p-f660b1",
    "offset": 2442,
    "text": "Lysimachvs:\nQuid autem urbani deliquerunt? dic mihi, cupio hercle scire."
  },
  {
    "id": "p-0eff01",
    "offset": 2516,
    "text": "Dorippa:\nSed tu me temptas sciens."
  },
  {
    "id": "p-1d8bec",
    "offset": 2552,
    "text": "quoia illa mulier intust?"
  },
  {
    "id": "p-b730a1",
    "offset": 2579,
    "text": "Lysimachvs:\nVidistine eam?"
  },
  {
    "id": "p-95e00d",
    "offset": 2607,
    "text": "Dorippa:\nVidi."
  },
  {
    "id": "p-e96f59",
    "offset": 2623,
    "text": "Lysimachvs:\nQuoia ea sit rogitas?"
  },
  {
    "id": "p-2a4ebf",
    "offset": 2658,
    "text": "Dorippa:\nResciscam tamen."
  },
  {
    "id": "p-b32def",
    "offset": 2685,
    "text": "Lysimachvs:\nVin dicam quoiast? illa—illa edepol—vae mihi, nescio quid dicam."
  },
  {
    "id": "p-0b5808",
    "offset": 2763,
    "text": "Dorippa:\nHaeres."
  },
  {
    "id": "p-aa16d9",
    "offset": 2781,
    "text": "Lysimachvs:\nHaud vidi magis."
  },
  {
    "id": "p-c0a7cc",
    "offset": 2811,
    "text": "Dorippa:"
  },
  {
    "id": "p-00ebb3",
    "offset": 2821,
    "text": "Quin dicis?"
  },
  {
    "id": "p-7618d9",
    "offset": 2834,
    "text": "Lysimachvs:\nQuin si liceat—"
  },
  {
    "id": "p-eb0106",
    "offset": 2863,
    "text": "Dorippa:\nDictum oportuit."
  },
  {
    "id": "p-afed6b",
    "offset": 2890,
    "text": "Lysimachvs:\nNon possum, ita instas; urges quasi pro noxio."
  },
  {
    "id": "p-3342cc",
    "offset": 2950,
    "text": "Dorippa:\nScio, innóxiu's innoxius es."
  },
  {
    "id": "p-bb9919",
    "offset": 2989,
    "text": "Lysimachvs:\nAudacter quam vis dicito."
  },
  {
    "id": "p-3de0d2",
    "offset": 3028,
    "text": "Dorippa:\nDic igitur."
  },
  {
    "id": "p-52f4ef",
    "offset": 3050,
    "text": "Lysimachvs:\nDicam."
  },
  {
    "id": "p-4f7bea",
    "offset": 3070,
    "text": "Dorippa:\nAt qui dicundum est tamen."
  },
  {
    "id": "p-14491f",
    "offset": 3107,
    "text": "Lysimachvs:\nIllast—etiam vis nomen dicam?"
  },
  {
    "id": "p-4fe554",
    "offset": 3150,
    "text": "Dorippa:\nNihil agis, manufesto teneo in noxia."
  },
  {
    "id": "p-27a631",
    "offset": 3198,
    "text": "Lysimachvs:\nQua noxia?"
  },
  {
    "id": "p-edc6b7",
    "offset": 3222,
    "text": "ista quidem illa est."
  },
  {
    "id": "p-01563f",
    "offset": 3245,
    "text": "Dorippa:\nQuae illa est?"
  },
  {
    "id": "p-4068df",
    "offset": 3270,
    "text": "Lysimachvs:\nIlla—"
  },
  {
    "id": "p-a952ad",
    "offset": 3289,
    "text": "Dorippa:\n†Iohia"
  },
  {
    "id": "p-c708f4",
    "offset": 3306,
    "text": "Lysimachvs:\nIam—si nihil usus esset, iam non dicerem."
  },
  {
    "id": "p-9a2321",
    "offset": 3361,
    "text": "Dorippa:\nNon tu scis quae sit illa?"
  },
  {
    "id": "p-0aa76a",
    "offset": 3398,
    "text": "Lysimachvs:\nImmo iam scio:"
  },
  {
    "id": "p-76a7d3",
    "offset": 3426,
    "text": "de istac sum iudex captus."
  },
  {
    "id": "p-2decc8",
    "offset": 3454,
    "text": "Dorippa:\nIudex? iam scio:"
  },
  {
    "id": "p-e6480e",
    "offset": 3481,
    "text": "nunc tu in consilium istam advocavisti tibi."
  },
  {
    "id": "p-8c0e49",
    "offset": 3527,
    "text": "Lysimachvs:\nImmo sic: séquestro mihi datast."
  },
  {
    "id": "p-e30d15",
    "offset": 3573,
    "text": "Dorippa:\nIntellego."
  },
  {
    "id": "p-31d6a9",
    "offset": 3594,
    "text": "Lysimachvs:\nNihil hercle istius quicquam est."
  },
  {
    "id": "p-92f4c4",
    "offset": 3641,
    "text": "Dorippa:\nNumero purigas."
  },
  {
    "id": "p-ecb22c",
    "offset": 3667,
    "text": "Lysimachvs:\nNimium negoti repperi. enim vero haereo."
  },
  {
    "id": "p-aacae1",
    "offset": 3721,
    "text": "Cocvs:\nAgite ite actutum, nam mi amatori seni coquendast cena. átque, quom recogito, nobis coquendast, non quoi con ducti sumus."
  },
  {
    "id": "p-c71547",
    "offset": 3851,
    "text": "nam quí amat quod amat sí habet, id habet pro cibo:"
  },
  {
    "id": "p-a7760c",
    "offset": 3904,
    "text": "videre, amplecti, ósculari, álloqui;"
  },
  {
    "id": "p-9bbed0",
    "offset": 3942,
    "text": "sed nos confido onustos redituros domum."
  },
  {
    "id": "p-b90ed2",
    "offset": 3984,
    "text": "ite hac. sed eccum qui nos conduxit senex."
  },
  {
    "id": "p-57fae5",
    "offset": 4028,
    "text": "Lysimachvs:\nEcce autem perii, coquos adest."
  },
  {
    "id": "p-be94a3",
    "offset": 4073,
    "text": "Cocvs:\nAdvenimus."
  },
  {
    "id": "p-d4ef3b",
    "offset": 4092,
    "text": "Lysimachvs:\nAbi."
  },
  {
    "id": "p-ea3c1a",
    "offset": 4110,
    "text": "Cocvs:\nQuid, abeam?"
  },
  {
    "id": "p-1a7644",
    "offset": 4131,
    "text": "Lysimachvs:\nSt, abi."
  },
  {
    "id": "p-95302e",
    "offset": 4153,
    "text": "Cocvs:\nAbeam?"
  },
  {
    "id": "p-d4ef3b",
    "offset": 4168,
    "text": "Lysimachvs:\nAbi."
  },
  {
    "id": "p-bdfc45",
    "offset": 4186,
    "text": "Cocvs:"
  },
  {
    "id": "p-b5d674",
    "offset": 4194,
    "text": "Non estis cenaturi?"
  },
  {
    "id": "p-43fc01",
    "offset": 4215,
    "text": "Lysimachvs:\nIam saturi sumus."
  },
  {
    "id": "p-fa529b",
    "offset": 4246,
    "text": "Cocvs:\nSed—"
  },
  {
    "id": "p-be96c3",
    "offset": 4259,
    "text": "Lysimachvs:\nIntérii."
  },
  {
    "id": "p-e77234",
    "offset": 4281,
    "text": "Dorippa:\nQuid ais tu? etiamne haec illi tibi iusserunt ferri, quos inter iudex datu's datus es?"
  },
  {
    "id": "p-46a809",
    "offset": 4378,
    "text": "Cocvs:\nHaecin tua est amica, quam dudum mihi te amare dixti, quom obsonabas?"
  },
  {
    "id": "p-868a2a",
    "offset": 4456,
    "text": "Lysimachvs:\nNon taces?"
  },
  {
    "id": "p-bdfc45",
    "offset": 4480,
    "text": "Cocvs:"
  },
  {
    "id": "p-f01ae3",
    "offset": 4488,
    "text": "Satis scítum filum mulieris. verum hercle anet."
  },
  {
    "id": "p-63eb22",
    "offset": 4537,
    "text": "Lysimachvs:\nAbin díerectus?"
  },
  {
    "id": "p-26dfe4",
    "offset": 4566,
    "text": "Cocvs:\nHaud malast."
  },
  {
    "id": "p-d4044f",
    "offset": 4587,
    "text": "Lysimachvs:\nAt tu malu's malus es."
  },
  {
    "id": "p-8fe0f9",
    "offset": 4623,
    "text": "Cocvs:\nScitam hercle opinor concubinam hanc."
  },
  {
    "id": "p-6620cf",
    "offset": 4669,
    "text": "Lysimachvs:\nNon abis?"
  },
  {
    "id": "p-1cf172",
    "offset": 4692,
    "text": "non ego sum qui te dudum conduxi."
  },
  {
    "id": "p-19e160",
    "offset": 4727,
    "text": "Cocvs:\nQuid est?"
  },
  {
    "id": "p-162aff",
    "offset": 4745,
    "text": "immo hercle tu istic ipsus."
  },
  {
    "id": "p-822c51",
    "offset": 4774,
    "text": "Lysimachvs:\nVae misero mihi."
  },
  {
    "id": "p-bdfc45",
    "offset": 4804,
    "text": "Cocvs:"
  },
  {
    "id": "p-b0f11b",
    "offset": 4812,
    "text": "Nempe uxor rurist tua, quam dudum dixeras te odisse aeque atque anguis.†"
  },
  {
    "id": "p-c5feee",
    "offset": 4886,
    "text": "Lysimachvs:\nEgone istuc dixi tibi?"
  },
  {
    "id": "p-9a4e01",
    "offset": 4922,
    "text": "Cocvs:\nMihi quidem hercle."
  },
  {
    "id": "p-feb4dd",
    "offset": 4950,
    "text": "Lysimachvs:\nIta me amabit Iuppiter, uxor, ut ego illud numquam dixi."
  },
  {
    "id": "p-599961",
    "offset": 5020,
    "text": "Dorippa:\nEtiam negas?"
  },
  {
    "id": "p-08929b",
    "offset": 5043,
    "text": "palam istaec fiunt, te me odisse."
  },
  {
    "id": "p-941519",
    "offset": 5078,
    "text": "Lysimachvs:\nQuin nego."
  },
  {
    "id": "p-bdfc45",
    "offset": 5102,
    "text": "Cocvs:"
  },
  {
    "id": "p-fc2282",
    "offset": 5110,
    "text": "Non, non te odisse aiebat, sed uxorem suam;"
  },
  {
    "id": "p-6c1727",
    "offset": 5155,
    "text": "et uxórem suam ruri esse aiebat."
  },
  {
    "id": "p-cc6ee2",
    "offset": 5189,
    "text": "Lysimachvs:\nHaec east."
  },
  {
    "id": "p-25e138",
    "offset": 5213,
    "text": "quid mihi molestu's molestus es?"
  },
  {
    "id": "p-7c3be9",
    "offset": 5247,
    "text": "Cocvs:\nQuia novisse me negas;"
  },
  {
    "id": "p-adc4cb",
    "offset": 5278,
    "text": "nisi metuis tu istanc."
  },
  {
    "id": "p-1d3007",
    "offset": 5302,
    "text": "Lysimachvs:\nSapio, nam mihi unicast."
  },
  {
    "id": "p-675655",
    "offset": 5340,
    "text": "Cocvs:\nVin me experiri?"
  },
  {
    "id": "p-d0b391",
    "offset": 5365,
    "text": "Lysimachvs:\nNolo."
  },
  {
    "id": "p-50d7fd",
    "offset": 5384,
    "text": "Cocvs:\nMercedem cedo."
  },
  {
    "id": "p-b62ec2",
    "offset": 5407,
    "text": "Lysimachvs:"
  },
  {
    "id": "p-15947f",
    "offset": 5420,
    "text": "Cras petito; dabitur. nunc abi."
  },
  {
    "id": "p-3d875e",
    "offset": 5453,
    "text": "Dorippa:\nHeu miserae mihi."
  },
  {
    "id": "p-7092b1",
    "offset": 5481,
    "text": "Lysimachvs:\nNunc ego verum illud verbum esse experior vetus:"
  },
  {
    "id": "p-e76b3b",
    "offset": 5543,
    "text": "aliquid mali esse propter vicinum malum."
  },
  {
    "id": "p-996e31",
    "offset": 5585,
    "text": "Cocvs:\nCur hic astamus? quin abimus? incommodi si quid tibi evénit, id non est culpa mea."
  },
  {
    "id": "p-b62ec2",
    "offset": 5676,
    "text": "Lysimachvs:"
  },
  {
    "id": "p-047909",
    "offset": 5689,
    "text": "Quin me eradicas miserum."
  },
  {
    "id": "p-c76983",
    "offset": 5716,
    "text": "Cocvs:\nScio iam quid velis:"
  },
  {
    "id": "p-6acb0a",
    "offset": 5745,
    "text": "nempe me hínc abire vis."
  },
  {
    "id": "p-81480f",
    "offset": 5771,
    "text": "Lysimachvs:\nVolo inquam."
  },
  {
    "id": "p-5004c5",
    "offset": 5797,
    "text": "Cocvs:\nAbibitur."
  },
  {
    "id": "p-cbb24d",
    "offset": 5815,
    "text": "drachmam dato."
  },
  {
    "id": "p-c3849f",
    "offset": 5831,
    "text": "Lysimachvs:\nDabitur."
  },
  {
    "id": "p-855dbd",
    "offset": 5853,
    "text": "Cocvs:\nDari ergo sis iube."
  },
  {
    "id": "p-12093f",
    "offset": 5881,
    "text": "dari pótest interea dum illi ponunt."
  },
  {
    "id": "p-5e7e9c",
    "offset": 5919,
    "text": "Lysimachvs:\nQuin abis?"
  },
  {
    "id": "p-7defdb",
    "offset": 5943,
    "text": "potine ut molestus ne sis?"
  },
  {
    "id": "p-4ea04b",
    "offset": 5971,
    "text": "Cocvs:\nAgite apponite obsonium istuc ante pedes illi seni."
  },
  {
    "id": "p-3da0f2",
    "offset": 6031,
    "text": "haec vasa aut mox aut cras iubebo abs te peti sequimíni.—"
  },
  {
    "id": "p-25fd12",
    "offset": 6090,
    "text": "Lysimachvs:\nFortasse te illum mirari coquom, quod venit atque haec attulit. dicam quid est."
  },
  {
    "id": "p-184860",
    "offset": 6183,
    "text": "Dorippa:\nNon miror si quid damni facis aut flagiti."
  },
  {
    "id": "p-f834c1",
    "offset": 6236,
    "text": "nec pol ego patiar, sic me nuptam tam male measque in aedis sic scorta obductarier."
  },
  {
    "id": "p-b5f2b3",
    "offset": 6321,
    "text": "Syra, i, rogato meum patrem verbis meis, ut veniat ad me iam simul tecum.—"
  },
  {
    "id": "p-9fcabe",
    "offset": 6397,
    "text": "Syra:\nEo.—"
  },
  {
    "id": "p-0c37b5",
    "offset": 6409,
    "text": "Lysimachvs:\nNescis negoti quid sit, uxor, obsecro."
  },
  {
    "id": "p-77ee50",
    "offset": 6461,
    "text": "conceptis verbis iam iusiurandum dabo, me numquam quicquam cum illa—iamne abiit Syra?"
  },
  {
    "id": "p-159ff3",
    "offset": 6548,
    "text": "perii hercle. ecce autem haec abiit. vae misero mihi."
  },
  {
    "id": "p-4ea76d",
    "offset": 6603,
    "text": "at te, vicine, di deaeque perduint, cum tua amíca cumque amationibus."
  },
  {
    "id": "p-e31478",
    "offset": 6674,
    "text": "suspicione implevit me indignissime, concivit hostis dómi: uxór acerrumast."
  },
  {
    "id": "p-c06ffa",
    "offset": 6751,
    "text": "ibo ad forum atque haec Demiphoni éloquar, me istanc capillo protracturum esse in viam, nisi hinc abducit quo volt ex hisce aedibus."
  },
  {
    "id": "p-14698d",
    "offset": 6885,
    "text": "uxor, heus uxor, quamquam tu irata es mihi, iubeas, si sapias, haec intró auferrier:"
  },
  {
    "id": "p-d4e061",
    "offset": 6971,
    "text": "eadem licebit mox cenare rectius.—"
  },
  {
    "id": "p-b16330",
    "offset": 7007,
    "text": "Syra:\nEra quo me misit, ad patrem, non est domi:"
  },
  {
    "id": "p-3953e8",
    "offset": 7057,
    "text": "rus abiisse aibant. nunc domum renuntio."
  },
  {
    "id": "p-965a04",
    "offset": 7099,
    "text": "Evtychvs:\nDefessus sum urbem totam pervenarier:"
  },
  {
    "id": "p-f54570",
    "offset": 7148,
    "text": "nihil investigo quicquam de illa muliere."
  },
  {
    "id": "p-6348cd",
    "offset": 7191,
    "text": "sed mater rure rediit, nam video Syram astare ante aedis. Syra."
  },
  {
    "id": "p-c7137e",
    "offset": 7256,
    "text": "Syra:\nQuis est qui me vocat?"
  },
  {
    "id": "p-764249",
    "offset": 7286,
    "text": "Evtychvs:\nErus atque alumnus tuos sum."
  },
  {
    "id": "p-17583b",
    "offset": 7326,
    "text": "Syra:\nSalve, alumne mi."
  },
  {
    "id": "p-9b321e",
    "offset": 7351,
    "text": "Evtychvs:\nIam mater rure rediit? responde mihi."
  },
  {
    "id": "p-5631de",
    "offset": 7400,
    "text": "Syra:\nSua quidem salute ac familiai maxuma."
  },
  {
    "id": "p-47130d",
    "offset": 7445,
    "text": "Evtychvs:"
  },
  {
    "id": "p-e70128",
    "offset": 7456,
    "text": "Quid istúc negotist?"
  },
  {
    "id": "p-6c252f",
    "offset": 7478,
    "text": "Syra:\nTuos pater bellissumus amicam adduxit intro in aedis."
  },
  {
    "id": "p-3f8340",
    "offset": 7539,
    "text": "Evtychvs:\nQuo modo?"
  },
  {
    "id": "p-03626d",
    "offset": 7560,
    "text": "Syra:\nAdveniens mater rure eam offendit domi."
  },
  {
    "id": "p-cdeb03",
    "offset": 7607,
    "text": "Evtychvs:\nPol haud censebam istarum esse operarum patrem."
  },
  {
    "id": "p-f9fb33",
    "offset": 7666,
    "text": "etiam nunc mulier intust?"
  },
  {
    "id": "p-c6d002",
    "offset": 7693,
    "text": "Syra:\nEtiam."
  },
  {
    "id": "p-b9098d",
    "offset": 7707,
    "text": "Evtychvs:\nSequere me.—"
  },
  {
    "id": "p-df7243",
    "offset": 7731,
    "text": "Syra:\nEcastor lege dura vivont mulieres multoque iniquiore miserae quam viri."
  },
  {
    "id": "p-1575a5",
    "offset": 7810,
    "text": "nam si vir scortum duxit clam uxorem suam, id si rescivit uxor, impunest viro;"
  },
  {
    "id": "p-818485",
    "offset": 7890,
    "text": "uxor virum si clam domo egressa est foras, viro fit causa, exigitur matrimonio."
  },
  {
    "id": "p-9f1192",
    "offset": 7971,
    "text": "utinam lex esset eadem quae uxori est viro;"
  },
  {
    "id": "p-6ceb7a",
    "offset": 8016,
    "text": "nam uxor contenta est, quae bona est, uno viro:"
  },
  {
    "id": "p-a45ae4",
    "offset": 8065,
    "text": "qui minus vir una uxore contentus siet?"
  },
  {
    "id": "p-443232",
    "offset": 8106,
    "text": "ecastor faxim, si itidem plectantur viri, si quis clam uxorem duxerit scortum suam, ut illae éxiguntur quae in se culpam commerent, plures viri sint vidui quam nunc mulieres.—"
  }
]