[
  {
    "id": "p-aa3892",
    "offset": 0,
    "text": "14. Passio Agnetis\nAgnes sepulcrum est Romulea in domo,"
  },
  {
    "id": "p-893189",
    "offset": 57,
    "text": "fortis puellae, martyris inclytae."
  },
  {
    "id": "p-d5faa7",
    "offset": 93,
    "text": "conspectu in ipso condita turrium"
  },
  {
    "id": "p-7b2e63",
    "offset": 128,
    "text": "servat salutem virgo Quiritium,"
  },
  {
    "id": "p-652ded",
    "offset": 161,
    "text": "nec non et ipsos protegit advenas"
  },
  {
    "id": "p-0eda56",
    "offset": 196,
    "text": "puro ac fideli pectore supplices."
  },
  {
    "id": "p-278703",
    "offset": 231,
    "text": "duplex corona est praestita martyri:"
  },
  {
    "id": "p-95e7df",
    "offset": 269,
    "text": "intactum ab omni crimine virginal,"
  },
  {
    "id": "p-d72520",
    "offset": 305,
    "text": "mortis deinde gloria liberae."
  },
  {
    "id": "p-c3f3f7",
    "offset": 336,
    "text": "aiunt iugali vix habilem toro"
  },
  {
    "id": "p-6c329d",
    "offset": 367,
    "text": "primis in annis forte puellulam"
  },
  {
    "id": "p-0c4f9e",
    "offset": 400,
    "text": "Christo calentem fortiter inpiis"
  },
  {
    "id": "p-99e98d",
    "offset": 434,
    "text": "iussis renisam, quo minus idolis"
  },
  {
    "id": "p-ba61be",
    "offset": 468,
    "text": "addicta sacram desereret fidem,"
  },
  {
    "id": "p-9e545d",
    "offset": 501,
    "text": "temptata multis nam prius artibus,"
  },
  {
    "id": "p-3e9796",
    "offset": 537,
    "text": "nunc ore blandi iudicis inlice,"
  },
  {
    "id": "p-21e09c",
    "offset": 570,
    "text": "nunc saevientis carnificis minis,"
  },
  {
    "id": "p-a87817",
    "offset": 605,
    "text": "stabat feroci robore pertinax"
  },
  {
    "id": "p-0e7ad3",
    "offset": 636,
    "text": "corpusque duris excruciatibus"
  },
  {
    "id": "p-35eabe",
    "offset": 667,
    "text": "ultro offerebat non renuens mori."
  },
  {
    "id": "p-4964ea",
    "offset": 702,
    "text": "tum trux tyrannus: si facile est, ait,"
  },
  {
    "id": "p-f4ee51",
    "offset": 742,
    "text": "‘poenam subactis ferre doloribus"
  },
  {
    "id": "p-d0fb88",
    "offset": 776,
    "text": "et vita vilis spernitur, at pudor"
  },
  {
    "id": "p-328d81",
    "offset": 811,
    "text": "carus dicatae virginitatis est."
  },
  {
    "id": "p-8c176d",
    "offset": 844,
    "text": "hanc in lupanar trudere publicum"
  },
  {
    "id": "p-d3a158",
    "offset": 878,
    "text": "certum est, ad aram ni caput applicat"
  },
  {
    "id": "p-b25cb5",
    "offset": 917,
    "text": "ac de Minerva iam veniam rogat,"
  },
  {
    "id": "p-c5883a",
    "offset": 950,
    "text": "quam virgo pergit temnere virginem,"
  },
  {
    "id": "p-d448bd",
    "offset": 987,
    "text": "omnis iuventus inruet et novum"
  },
  {
    "id": "p-c4dfab",
    "offset": 1019,
    "text": "ludibriorum mancipium petet.’"
  },
  {
    "id": "p-7761e3",
    "offset": 1050,
    "text": "haud, inquit Agnes, ‘inmemor est ita"
  },
  {
    "id": "p-ea9389",
    "offset": 1088,
    "text": "Christus suorum, perdat ut aureum"
  },
  {
    "id": "p-2dc738",
    "offset": 1123,
    "text": "nobis pudorem, nos quoque deserat."
  },
  {
    "id": "p-6c9485",
    "offset": 1159,
    "text": "praesto est pudicis nec patitur sacrae"
  },
  {
    "id": "p-def0e5",
    "offset": 1199,
    "text": "integritatis munera pollui."
  },
  {
    "id": "p-e37916",
    "offset": 1228,
    "text": "ferrum inpiabis sanguine, si voles,"
  },
  {
    "id": "p-6936b7",
    "offset": 1265,
    "text": "non inquinabis membra libidine.’"
  },
  {
    "id": "p-6e8cb9",
    "offset": 1299,
    "text": "sic elocutam publicitus iubet"
  },
  {
    "id": "p-924f33",
    "offset": 1330,
    "text": "flexu in plateae sistere virginem."
  },
  {
    "id": "p-969143",
    "offset": 1366,
    "text": "stantem refugit maesta frequentia,"
  },
  {
    "id": "p-8b36ce",
    "offset": 1402,
    "text": "aversa vultus, ne petulantius"
  },
  {
    "id": "p-c5d9e0",
    "offset": 1433,
    "text": "quisquam verendum conspiceret locum."
  },
  {
    "id": "p-cd4048",
    "offset": 1471,
    "text": "intendit unus forte procaciter"
  },
  {
    "id": "p-4b56e7",
    "offset": 1503,
    "text": "os in puellam nec trepidat sacram"
  },
  {
    "id": "p-422e16",
    "offset": 1538,
    "text": "spectare formam lumine lubrico."
  },
  {
    "id": "p-82aec1",
    "offset": 1571,
    "text": "en ales ignis fulminis in modum"
  },
  {
    "id": "p-771531",
    "offset": 1604,
    "text": "vibratur ardens atque oculos ferit."
  },
  {
    "id": "p-d74770",
    "offset": 1641,
    "text": "caecus corusco lumine corruit"
  },
  {
    "id": "p-a1ebe0",
    "offset": 1672,
    "text": "atque in plateae pulvere palpitat."
  },
  {
    "id": "p-25227e",
    "offset": 1708,
    "text": "tollunt sodales seminecem solo"
  },
  {
    "id": "p-94b093",
    "offset": 1740,
    "text": "verbisque deflent exequialibus."
  },
  {
    "id": "p-e4e3f3",
    "offset": 1773,
    "text": "ibat triumphans virgo Deum Patrem"
  },
  {
    "id": "p-1958c1",
    "offset": 1808,
    "text": "Christumque sacro carmine concinens,"
  },
  {
    "id": "p-3c3c5c",
    "offset": 1846,
    "text": "quod sub profani labe periculi"
  },
  {
    "id": "p-b3f2db",
    "offset": 1878,
    "text": "castum lupanar nec violabile"
  },
  {
    "id": "p-7ab2c2",
    "offset": 1908,
    "text": "experta victrix virginitas foret."
  },
  {
    "id": "p-eb8f57",
    "offset": 1943,
    "text": "sunt qui rogatam rettulerint preces"
  },
  {
    "id": "p-3fa26d",
    "offset": 1980,
    "text": "fudisse Christo, redderet ut reo"
  },
  {
    "id": "p-871943",
    "offset": 2014,
    "text": "lucem iacenti: tunc iuveni halitum"
  },
  {
    "id": "p-bfc169",
    "offset": 2050,
    "text": "vitae innovatum visibus integris."
  },
  {
    "id": "p-9aaa7b",
    "offset": 2085,
    "text": "primum sed Agnes hunc habuit gradum"
  },
  {
    "id": "p-63eb4d",
    "offset": 2122,
    "text": "caelestis aulae, mox alius datur"
  },
  {
    "id": "p-7c816b",
    "offset": 2156,
    "text": "ascensus; iram nam furor incitat"
  },
  {
    "id": "p-c00169",
    "offset": 2190,
    "text": "hostis cruenti: vincor, ait gemens,"
  },
  {
    "id": "p-4024ed",
    "offset": 2227,
    "text": "‘i, stringe ferrum, miles, et exere"
  },
  {
    "id": "p-d54ee8",
    "offset": 2264,
    "text": "praecepta summi regia principis.’"
  },
  {
    "id": "p-736735",
    "offset": 2299,
    "text": "ut vidit Agnes stare trucem virum"
  },
  {
    "id": "p-e14bd8",
    "offset": 2334,
    "text": "mucrone nudo, laetior haec ait:"
  },
  {
    "id": "p-d70bfe",
    "offset": 2367,
    "text": "‘exulto talis quod potius venit"
  },
  {
    "id": "p-3502bd",
    "offset": 2400,
    "text": "vesanus, atrox, turbidus armiger,"
  },
  {
    "id": "p-fba8c3",
    "offset": 2435,
    "text": "quam si veniret languidus ac tener"
  },
  {
    "id": "p-d34226",
    "offset": 2471,
    "text": "mollisque ephebus tinctus aromate,"
  },
  {
    "id": "p-cb0b0b",
    "offset": 2507,
    "text": "qui me pudoris funere perderet."
  },
  {
    "id": "p-6a58e5",
    "offset": 2540,
    "text": "hic, hic amator iam, fateor, placet:"
  },
  {
    "id": "p-accf1b",
    "offset": 2578,
    "text": "ibo inruentis gressibus obviam,"
  },
  {
    "id": "p-79068e",
    "offset": 2611,
    "text": "nec demorabor vota calentia:"
  },
  {
    "id": "p-244706",
    "offset": 2641,
    "text": "ferrum in papillas omne recepero"
  },
  {
    "id": "p-8e20dd",
    "offset": 2675,
    "text": "pectusque ad imum vim gladii traham."
  },
  {
    "id": "p-4a0dd9",
    "offset": 2713,
    "text": "sic nupta Christo transiliam poli"
  },
  {
    "id": "p-62ddc4",
    "offset": 2748,
    "text": "omnes tenebras aethere celsior."
  },
  {
    "id": "p-c9a6c7",
    "offset": 2781,
    "text": "aeterne rector, divide ianuas"
  },
  {
    "id": "p-87e5d0",
    "offset": 2812,
    "text": "caeli obseratas terrigenis prius,"
  },
  {
    "id": "p-32df4e",
    "offset": 2847,
    "text": "ac te sequentem, Christe, animam voca,"
  },
  {
    "id": "p-b77843",
    "offset": 2887,
    "text": "cum virginalem, tum Patris hostiam.’"
  },
  {
    "id": "p-672b0c",
    "offset": 2925,
    "text": "sic fata Christum vertice cernuo"
  },
  {
    "id": "p-5848f7",
    "offset": 2959,
    "text": "supplex adorat, vulnus ut inminens"
  },
  {
    "id": "p-3c7f3c",
    "offset": 2995,
    "text": "cervix subiret prona paratius."
  },
  {
    "id": "p-2bfd72",
    "offset": 3027,
    "text": "ast ille tantam spem peragit manu,"
  },
  {
    "id": "p-31d954",
    "offset": 3063,
    "text": "uno sub ictu nam caput amputat;"
  },
  {
    "id": "p-ef894d",
    "offset": 3096,
    "text": "sensum doloris mors cita praevenit."
  },
  {
    "id": "p-52f9bb",
    "offset": 3133,
    "text": "exutus inde spiritus emicat"
  },
  {
    "id": "p-8ba831",
    "offset": 3162,
    "text": "liberque in auras exilit. angeli"
  },
  {
    "id": "p-b8f292",
    "offset": 3196,
    "text": "saepsere euntem tramite candido."
  },
  {
    "id": "p-ac231b",
    "offset": 3230,
    "text": "miratur orbem sub pedibus situm,"
  },
  {
    "id": "p-026f7a",
    "offset": 3264,
    "text": "spectat tenebras ardua subditas"
  },
  {
    "id": "p-062ff8",
    "offset": 3297,
    "text": "ridetquc solis quod rota circuit,"
  },
  {
    "id": "p-ba05f0",
    "offset": 3332,
    "text": "quod mundus omnis volvit et inplicat,"
  },
  {
    "id": "p-35b9ed",
    "offset": 3371,
    "text": "rerum quod atro turbine vivitur,"
  },
  {
    "id": "p-59d7c2",
    "offset": 3405,
    "text": "quod vana saecli mobilitas rapit:"
  },
  {
    "id": "p-d7bc2a",
    "offset": 3440,
    "text": "reges, tyrannos, imperia et gradus"
  },
  {
    "id": "p-0b76ce",
    "offset": 3476,
    "text": "pompasque honorum stulta tumentium,"
  },
  {
    "id": "p-88c41f",
    "offset": 3513,
    "text": "argenti et auri vim rabida siti"
  },
  {
    "id": "p-3d4a2f",
    "offset": 3546,
    "text": "cunctis petitam per varium nefas,"
  },
  {
    "id": "p-f72229",
    "offset": 3581,
    "text": "splendore multo structa habitacula,"
  },
  {
    "id": "p-721664",
    "offset": 3618,
    "text": "inlusa pictae vestis inania,"
  },
  {
    "id": "p-de27a6",
    "offset": 3648,
    "text": "iram, timorem, vota, pericula,"
  },
  {
    "id": "p-a73eeb",
    "offset": 3680,
    "text": "nunc triste longum, nunc breve gaudium,"
  },
  {
    "id": "p-a57c31",
    "offset": 3721,
    "text": "livoris atri fumificas faces,"
  },
  {
    "id": "p-c5a1fd",
    "offset": 3752,
    "text": "nigrescit unde spes hominum et decus,"
  },
  {
    "id": "p-bd1659",
    "offset": 3791,
    "text": "et, quod malorum taetrius omnium est,"
  },
  {
    "id": "p-1a5ea3",
    "offset": 3830,
    "text": "gentilitatis sordida nubila."
  },
  {
    "id": "p-c702e5",
    "offset": 3860,
    "text": "haec calcat Agnes ac pede proterit"
  },
  {
    "id": "p-c984db",
    "offset": 3896,
    "text": "stans et draconis calce premens caput,"
  },
  {
    "id": "p-99c1fa",
    "offset": 3936,
    "text": "terrena mundi qui ferus omnia"
  },
  {
    "id": "p-72ee66",
    "offset": 3967,
    "text": "spargit venenis mergit et inferis;"
  },
  {
    "id": "p-41ac24",
    "offset": 4003,
    "text": "nunc virginali perdomitus solo"
  },
  {
    "id": "p-fd332d",
    "offset": 4035,
    "text": "cristas cerebri deprimit ignei"
  },
  {
    "id": "p-71a0ee",
    "offset": 4067,
    "text": "nec victus audet tollere verticem."
  },
  {
    "id": "p-c632cf",
    "offset": 4103,
    "text": "cingit coronis interea Deus"
  },
  {
    "id": "p-43e401",
    "offset": 4132,
    "text": "frontem duabus martyris innubae:"
  },
  {
    "id": "p-9ec843",
    "offset": 4166,
    "text": "unam decemplex edita sexies"
  },
  {
    "id": "p-421df3",
    "offset": 4195,
    "text": "merces perenni lumine conficit,"
  },
  {
    "id": "p-8dfa74",
    "offset": 4228,
    "text": "centenus extat fructus in altera."
  },
  {
    "id": "p-59ccdd",
    "offset": 4263,
    "text": "o virgo felix, o nova gloria,"
  },
  {
    "id": "p-6eaad1",
    "offset": 4294,
    "text": "caelestis arcis nobilis incola,"
  },
  {
    "id": "p-840710",
    "offset": 4327,
    "text": "intende nostris conluvionibus"
  },
  {
    "id": "p-a86d97",
    "offset": 4358,
    "text": "vultum gemello cum diademate,"
  },
  {
    "id": "p-d550dd",
    "offset": 4389,
    "text": "cui posse soli cunctiparens dedit"
  },
  {
    "id": "p-24a84c",
    "offset": 4424,
    "text": "castum vel ipsum reddere fornicem,"
  },
  {
    "id": "p-e8b201",
    "offset": 4460,
    "text": "purgabor oris propitiabilis"
  },
  {
    "id": "p-45e504",
    "offset": 4489,
    "text": "fulgore, nostrum si iecur inpleas."
  },
  {
    "id": "p-ca9b6e",
    "offset": 4525,
    "text": "nil non pudicum est quod pia visere"
  },
  {
    "id": "p-67e5bf",
    "offset": 4562,
    "text": "dignaris almo vel pede tangere."
  }
]