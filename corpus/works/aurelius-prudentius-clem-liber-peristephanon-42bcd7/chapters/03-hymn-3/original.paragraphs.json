[
  {
    "id": "p-923cc1",
    "offset": 0,
    "text": "3. Hymnus in honorem Passionis Eulaliae Beatissimae Martyris.\nGERMINE nobilis Eulalia"
  },
  {
    "id": "p-517503",
    "offset": 87,
    "text": "mortis et indole nobilior"
  },
  {
    "id": "p-c6a4fa",
    "offset": 114,
    "text": "Emeritam sacra virgo suam,"
  },
  {
    "id": "p-fbcb33",
    "offset": 142,
    "text": "cuius ab ubere progenita est,"
  },
  {
    "id": "p-ff4abe",
    "offset": 173,
    "text": "ossibus ornat, amore colit."
  },
  {
    "id": "p-acc47d",
    "offset": 202,
    "text": "proximus occiduo locus est"
  },
  {
    "id": "p-9af891",
    "offset": 230,
    "text": "qui tulit hoc decus egregium,"
  },
  {
    "id": "p-3929e9",
    "offset": 261,
    "text": "urbe potens, populis locuples,"
  },
  {
    "id": "p-bd4be5",
    "offset": 293,
    "text": "sed mage sanguine martyrii"
  },
  {
    "id": "p-7e0cac",
    "offset": 321,
    "text": "virgineoque potens titulo."
  },
  {
    "id": "p-6cd121",
    "offset": 349,
    "text": "curriculis tribus atque novem"
  },
  {
    "id": "p-17555b",
    "offset": 380,
    "text": "tres hiemes quater adtigerat,"
  },
  {
    "id": "p-8f7e59",
    "offset": 411,
    "text": "cum crepitante pyra trepidos"
  },
  {
    "id": "p-8da159",
    "offset": 441,
    "text": "terruit aspera carnifices,"
  },
  {
    "id": "p-12038b",
    "offset": 469,
    "text": "supplicium sibi dulce rata."
  },
  {
    "id": "p-45eb76",
    "offset": 498,
    "text": "iam dederat prius indicium"
  },
  {
    "id": "p-43d01a",
    "offset": 526,
    "text": "tendere se Patris ad solium"
  },
  {
    "id": "p-2f93da",
    "offset": 555,
    "text": "nec sua membra dicata toro:"
  },
  {
    "id": "p-a5459a",
    "offset": 584,
    "text": "ipsa crepundia reppulerat,"
  },
  {
    "id": "p-5b9878",
    "offset": 612,
    "text": "ludere nescia pusiola;"
  },
  {
    "id": "p-55f4f1",
    "offset": 636,
    "text": "spernere sucina, flare 1 rosas,"
  },
  {
    "id": "p-323e79",
    "offset": 669,
    "text": "fulva monilia respuere,"
  },
  {
    "id": "p-bb3bba",
    "offset": 694,
    "text": "ore severa, modesta gradu,"
  },
  {
    "id": "p-09e173",
    "offset": 722,
    "text": "moribus et nimium teneris"
  },
  {
    "id": "p-a8ac9a",
    "offset": 749,
    "text": "canitiem meditata senum."
  },
  {
    "id": "p-e6dc30",
    "offset": 775,
    "text": "ast ubi se furiata luis"
  },
  {
    "id": "p-521029",
    "offset": 800,
    "text": "excitat in famulos Domini"
  },
  {
    "id": "p-05da30",
    "offset": 827,
    "text": "Christicolasque cruenta iubet"
  },
  {
    "id": "p-d7a564",
    "offset": 858,
    "text": "tura cremare, iecur pecudis"
  },
  {
    "id": "p-8761f4",
    "offset": 887,
    "text": "mortiferis adolere deis,"
  },
  {
    "id": "p-e6932e",
    "offset": 913,
    "text": "infremuit sacer Eulaliae"
  },
  {
    "id": "p-78b8af",
    "offset": 939,
    "text": "spiritus, ingeniique ferox"
  },
  {
    "id": "p-c62d78",
    "offset": 967,
    "text": "turbida frangere bella parat,"
  },
  {
    "id": "p-0b2bc2",
    "offset": 998,
    "text": "et rude pectus anhela Deo"
  },
  {
    "id": "p-3985f2",
    "offset": 1025,
    "text": "femina provocat arma virum."
  },
  {
    "id": "p-cdd296",
    "offset": 1054,
    "text": "sed pia cura parentis agit"
  },
  {
    "id": "p-dbba40",
    "offset": 1082,
    "text": "virgo animosa domi ut lateat"
  },
  {
    "id": "p-e8551d",
    "offset": 1112,
    "text": "abdita rure et ab urbe procul,"
  },
  {
    "id": "p-ca1a72",
    "offset": 1144,
    "text": "ne fera sanguinis in pretium"
  },
  {
    "id": "p-293464",
    "offset": 1174,
    "text": "mortis amore puella ruat."
  },
  {
    "id": "p-4fb22d",
    "offset": 1201,
    "text": "illa perosa quietis opem"
  },
  {
    "id": "p-c7ee58",
    "offset": 1227,
    "text": "degeneri tolerare mora"
  },
  {
    "id": "p-19ecd8",
    "offset": 1251,
    "text": "nocte fores sine teste movet"
  },
  {
    "id": "p-b59d81",
    "offset": 1281,
    "text": "saeptaque claustra fugax aperit,"
  },
  {
    "id": "p-9b5445",
    "offset": 1315,
    "text": "inde per invia carpit iter."
  },
  {
    "id": "p-047cf0",
    "offset": 1344,
    "text": "ingreditur pedibus laceris"
  },
  {
    "id": "p-a59ea9",
    "offset": 1372,
    "text": "per loca senta situ et vepribus"
  },
  {
    "id": "p-e309f6",
    "offset": 1405,
    "text": "angelico comitata choro,"
  },
  {
    "id": "p-a08bf3",
    "offset": 1431,
    "text": "et licet horrida nox sileat,"
  },
  {
    "id": "p-18d5cf",
    "offset": 1461,
    "text": "lucis habet tamen illa ducem."
  },
  {
    "id": "p-adaef0",
    "offset": 1492,
    "text": "sic habuit generosa patrum"
  },
  {
    "id": "p-274ee0",
    "offset": 1520,
    "text": "turba columniferum radium,"
  },
  {
    "id": "p-1197ab",
    "offset": 1548,
    "text": "scindere qui tenebrosa potens"
  },
  {
    "id": "p-e1f369",
    "offset": 1579,
    "text": "nocte viam face perspicua"
  },
  {
    "id": "p-c7a24c",
    "offset": 1606,
    "text": "praestitit intereunte chao."
  },
  {
    "id": "p-35464e",
    "offset": 1635,
    "text": "non aliter pia virgo viam"
  },
  {
    "id": "p-062d92",
    "offset": 1662,
    "text": "nocte secuta diem meruit"
  },
  {
    "id": "p-f232ae",
    "offset": 1688,
    "text": "nec tenebris adoperta fuit,"
  },
  {
    "id": "p-89fd23",
    "offset": 1717,
    "text": "regna Canopica cum fugeret"
  },
  {
    "id": "p-0aadc8",
    "offset": 1745,
    "text": "et super astra pararet iter."
  },
  {
    "id": "p-a65d84",
    "offset": 1775,
    "text": "illa gradu cita pervigili"
  },
  {
    "id": "p-22ea1c",
    "offset": 1802,
    "text": "milia multa prius peragit"
  },
  {
    "id": "p-021580",
    "offset": 1829,
    "text": "quam plaga pandat Eoa polum;"
  },
  {
    "id": "p-9fd9a2",
    "offset": 1859,
    "text": "mane superba tribunal adit"
  },
  {
    "id": "p-c39765",
    "offset": 1887,
    "text": "fascibus adstat et in mediis"
  },
  {
    "id": "p-7a67b1",
    "offset": 1917,
    "text": "vociferans: ‘rogo, quis furor est"
  },
  {
    "id": "p-80092d",
    "offset": 1952,
    "text": "perdere praecipites animas"
  },
  {
    "id": "p-daa5d9",
    "offset": 1980,
    "text": "et male prodiga corda sui"
  },
  {
    "id": "p-4a3fbc",
    "offset": 2007,
    "text": "sternere rasilibus scopulis,"
  },
  {
    "id": "p-e0024b",
    "offset": 2037,
    "text": "omnipatremque negare Deum?"
  },
  {
    "id": "p-d319ac",
    "offset": 2065,
    "text": "quaeritis, o miseranda manus,"
  },
  {
    "id": "p-8ff6b3",
    "offset": 2096,
    "text": "Christicolum genus? en ego sum"
  },
  {
    "id": "p-13e8ac",
    "offset": 2128,
    "text": "daemonicis inimica sacris,"
  },
  {
    "id": "p-719514",
    "offset": 2156,
    "text": "idola protero sub pedibus,"
  },
  {
    "id": "p-f75379",
    "offset": 2184,
    "text": "pectore et ore Deum fateor."
  },
  {
    "id": "p-22de70",
    "offset": 2213,
    "text": "Isis, Apollo, venus nihil est,"
  },
  {
    "id": "p-defb5b",
    "offset": 2245,
    "text": "Maximianus et ipse nihil:"
  },
  {
    "id": "p-227b1d",
    "offset": 2272,
    "text": "illa nihil, quia facta manu,"
  },
  {
    "id": "p-24efeb",
    "offset": 2302,
    "text": "hic manuum quia facta colit,"
  },
  {
    "id": "p-3434d0",
    "offset": 2332,
    "text": "frivola utraque et utraque nihil."
  },
  {
    "id": "p-815a56",
    "offset": 2367,
    "text": "Maximianus, opum dominus"
  },
  {
    "id": "p-9a9399",
    "offset": 2393,
    "text": "et tamen ipse cliens lapidum,"
  },
  {
    "id": "p-a5f6a7",
    "offset": 2424,
    "text": "prostituat voveatque suis"
  },
  {
    "id": "p-7ec4cd",
    "offset": 2451,
    "text": "numinibus caput ipse suum:"
  },
  {
    "id": "p-ec725b",
    "offset": 2479,
    "text": "pectora cur generosa quatit?"
  },
  {
    "id": "p-8c1a78",
    "offset": 2509,
    "text": "dux bonus, arbiter egregius,"
  },
  {
    "id": "p-ecbaf1",
    "offset": 2539,
    "text": "sanguine pascitur innocuo,"
  },
  {
    "id": "p-1beee9",
    "offset": 2567,
    "text": "corporibusque piis inhians"
  },
  {
    "id": "p-3a985d",
    "offset": 2595,
    "text": "viscera sobria dilacerat,"
  },
  {
    "id": "p-26149d",
    "offset": 2622,
    "text": "gaudet et excruciare fidem."
  },
  {
    "id": "p-0fbf80",
    "offset": 2651,
    "text": "ergo age, tortor, adure, seca,"
  },
  {
    "id": "p-d87fdd",
    "offset": 2683,
    "text": "divide membra coacta luto."
  },
  {
    "id": "p-6e8ca2",
    "offset": 2711,
    "text": "solvere rem fragilem facile est:"
  },
  {
    "id": "p-30b2a4",
    "offset": 2745,
    "text": "non penetrabitur interior"
  },
  {
    "id": "p-d6a5a8",
    "offset": 2772,
    "text": "exagitante dolore animus.’"
  },
  {
    "id": "p-723d71",
    "offset": 2800,
    "text": "talibus excitus in furias"
  },
  {
    "id": "p-7dda51",
    "offset": 2827,
    "text": "praetor ait: ‘rape praecipitem,"
  },
  {
    "id": "p-dc942d",
    "offset": 2860,
    "text": "lictor, et obrue suppliciis,"
  },
  {
    "id": "p-5fda03",
    "offset": 2890,
    "text": "sentiat esse deos patrios"
  },
  {
    "id": "p-210c08",
    "offset": 2917,
    "text": "nec leve principis imperium."
  },
  {
    "id": "p-8f6aeb",
    "offset": 2947,
    "text": "quam cuperem tamen ante necem,"
  },
  {
    "id": "p-11881e",
    "offset": 2979,
    "text": "si potis est, revocare tuam,"
  },
  {
    "id": "p-38be2c",
    "offset": 3009,
    "text": "torva puellula, nequitiam,"
  },
  {
    "id": "p-cd641d",
    "offset": 3037,
    "text": "respice gaudia quanta metas,"
  },
  {
    "id": "p-b3362b",
    "offset": 3067,
    "text": "quae tibi fert genialis honor."
  },
  {
    "id": "p-81baf3",
    "offset": 3099,
    "text": "te lacrimis labefacta domus"
  },
  {
    "id": "p-9d0c43",
    "offset": 3128,
    "text": "prosequitur generisque tui"
  },
  {
    "id": "p-e1ce03",
    "offset": 3156,
    "text": "ingemit anxia nobilitas,"
  },
  {
    "id": "p-660126",
    "offset": 3182,
    "text": "flore 1 quod occidis in tenero,"
  },
  {
    "id": "p-be798e",
    "offset": 3215,
    "text": "proxima dotibus et thalamis."
  },
  {
    "id": "p-d9644e",
    "offset": 3245,
    "text": "non movet aurea pompa tori,"
  },
  {
    "id": "p-f6a2a3",
    "offset": 3274,
    "text": "non pietas veneranda senum,"
  },
  {
    "id": "p-5baefe",
    "offset": 3303,
    "text": "quos temeraria debilitas?"
  },
  {
    "id": "p-0d3f4f",
    "offset": 3330,
    "text": "ecce parata ministeria"
  },
  {
    "id": "p-c2d378",
    "offset": 3354,
    "text": "excruciabilis exitii:"
  },
  {
    "id": "p-3c7996",
    "offset": 3377,
    "text": "aut gladio feriere caput,"
  },
  {
    "id": "p-65b574",
    "offset": 3404,
    "text": "aut laniabere membra feris,"
  },
  {
    "id": "p-46c8c3",
    "offset": 3433,
    "text": "aut facibus data fumificis"
  },
  {
    "id": "p-a77420",
    "offset": 3461,
    "text": "flebiliterque ululanda tuis"
  },
  {
    "id": "p-f0ac80",
    "offset": 3490,
    "text": "in cineres resoluta flues."
  },
  {
    "id": "p-0338bb",
    "offset": 3518,
    "text": "haec, rogo, quis labor est fugere?"
  },
  {
    "id": "p-fbd7a9",
    "offset": 3554,
    "text": "si modicum salis eminulis"
  },
  {
    "id": "p-c3a71a",
    "offset": 3581,
    "text": "turis et exiguum digitis"
  },
  {
    "id": "p-a5027c",
    "offset": 3607,
    "text": "tangere, virgo, benigna velis,"
  },
  {
    "id": "p-aba4a8",
    "offset": 3639,
    "text": "poena gravis procul afuerit.’"
  },
  {
    "id": "p-27d3bd",
    "offset": 3670,
    "text": "martyr ad ista nihil; sed enim"
  },
  {
    "id": "p-7eb5aa",
    "offset": 3702,
    "text": "infremit inque tyranni oculos"
  },
  {
    "id": "p-fd09ad",
    "offset": 3733,
    "text": "sputa iacit, simulacra dehinc"
  },
  {
    "id": "p-bd2586",
    "offset": 3764,
    "text": "dissipat inpositamque molam"
  },
  {
    "id": "p-59a927",
    "offset": 3793,
    "text": "turibulis pede prosubigit."
  },
  {
    "id": "p-c5a01c",
    "offset": 3821,
    "text": "nec mora, carnifices gemini"
  },
  {
    "id": "p-15823a",
    "offset": 3850,
    "text": "iuncea pectora dilacerant"
  },
  {
    "id": "p-2fda51",
    "offset": 3877,
    "text": "et latus ungula virgineum"
  },
  {
    "id": "p-54e44c",
    "offset": 3904,
    "text": "pulsat utrimque et ad ossa secat"
  },
  {
    "id": "p-1be6c2",
    "offset": 3938,
    "text": "Eulalia numerante notas."
  },
  {
    "id": "p-dc2025",
    "offset": 3964,
    "text": "‘scribens ecce mihi, Domine,"
  },
  {
    "id": "p-e54b40",
    "offset": 3994,
    "text": "quam iuvat hos apices legere"
  },
  {
    "id": "p-ab88a1",
    "offset": 4024,
    "text": "qui tua, Christe, tropaea notant!"
  },
  {
    "id": "p-cb0817",
    "offset": 4059,
    "text": "nomen et ipsa sacrum loquitur"
  },
  {
    "id": "p-8e792e",
    "offset": 4090,
    "text": "purpura sanguinis eliciti.’"
  },
  {
    "id": "p-740ca0",
    "offset": 4119,
    "text": "haec sine fletibus et gemitu"
  },
  {
    "id": "p-ab5336",
    "offset": 4149,
    "text": "laeta canebat et intrepida;"
  },
  {
    "id": "p-d885a3",
    "offset": 4178,
    "text": "dirus abest dolor ex animo,"
  },
  {
    "id": "p-e6ed3b",
    "offset": 4207,
    "text": "membraque picta cruore novo"
  },
  {
    "id": "p-a8446d",
    "offset": 4236,
    "text": "fonte cutem recalente lavant."
  },
  {
    "id": "p-62e5ac",
    "offset": 4267,
    "text": "ultima carnificina dehinc,"
  },
  {
    "id": "p-1135a6",
    "offset": 4295,
    "text": "non laceratio vulnifica,"
  },
  {
    "id": "p-369cb2",
    "offset": 4321,
    "text": "crate tenus nec arata cutis,"
  },
  {
    "id": "p-49d49a",
    "offset": 4351,
    "text": "flamma sed undique lampadibus"
  },
  {
    "id": "p-ee1c8b",
    "offset": 4382,
    "text": "in latera stomachumque furit."
  },
  {
    "id": "p-08765e",
    "offset": 4413,
    "text": "crinis odorus ut in iugulos"
  },
  {
    "id": "p-ea0902",
    "offset": 4442,
    "text": "fluxerat involitans umeris,"
  },
  {
    "id": "p-cb47e6",
    "offset": 4471,
    "text": "quo pudibunda pudicitia"
  },
  {
    "id": "p-551316",
    "offset": 4496,
    "text": "virgineusque lateret honos,"
  },
  {
    "id": "p-d44f40",
    "offset": 4525,
    "text": "tegmine verticis opposito,"
  },
  {
    "id": "p-c188ad",
    "offset": 4553,
    "text": "flamma crepans volat in faciem"
  },
  {
    "id": "p-875914",
    "offset": 4585,
    "text": "perque comas vegetata caput"
  },
  {
    "id": "p-0bcf61",
    "offset": 4614,
    "text": "occupat exsuperatque apicem;"
  },
  {
    "id": "p-3cbb29",
    "offset": 4644,
    "text": "virgo citum cupiens obitum"
  },
  {
    "id": "p-50c9bf",
    "offset": 4672,
    "text": "appetit et bibit ore rogum."
  },
  {
    "id": "p-18a8fe",
    "offset": 4701,
    "text": "emicat inde columba repens"
  },
  {
    "id": "p-57d564",
    "offset": 4729,
    "text": "martyris os nive candidior"
  },
  {
    "id": "p-a45d83",
    "offset": 4757,
    "text": "visa relinquere et astra sequi;"
  },
  {
    "id": "p-2501be",
    "offset": 4790,
    "text": "spiritus hic erat Eulaliae"
  },
  {
    "id": "p-d8658e",
    "offset": 4818,
    "text": "lacteolus, celer, innocuus."
  },
  {
    "id": "p-2ef7e0",
    "offset": 4847,
    "text": "colla fluunt abeunte anima"
  },
  {
    "id": "p-486e66",
    "offset": 4875,
    "text": "et rogus igneus emoritur;"
  },
  {
    "id": "p-72a0fa",
    "offset": 4902,
    "text": "pax datur artubus exanimis,"
  },
  {
    "id": "p-41a8b9",
    "offset": 4931,
    "text": "flatus in aethere plaudit ovans"
  },
  {
    "id": "p-9cd11b",
    "offset": 4964,
    "text": "templaque celsa petit volucer."
  },
  {
    "id": "p-0031b0",
    "offset": 4996,
    "text": "vidit et ipse satelles avem"
  },
  {
    "id": "p-77788d",
    "offset": 5025,
    "text": "feminae ab ore meare palam,"
  },
  {
    "id": "p-ace118",
    "offset": 5054,
    "text": "obstupefactus et adtonitus"
  },
  {
    "id": "p-7c11c2",
    "offset": 5082,
    "text": "prosilit et sua gesta fugit,"
  },
  {
    "id": "p-66bdfa",
    "offset": 5112,
    "text": "lictor et ipse fugit pavidus."
  },
  {
    "id": "p-9c2543",
    "offset": 5143,
    "text": "ecce nivem glacialis hiems"
  },
  {
    "id": "p-211e60",
    "offset": 5171,
    "text": "ingerit et tegit omne forum,"
  },
  {
    "id": "p-4cc650",
    "offset": 5201,
    "text": "membra tegit simul Eulaliae"
  },
  {
    "id": "p-53da93",
    "offset": 5230,
    "text": "axe iacentia sub gelido"
  },
  {
    "id": "p-d17fc8",
    "offset": 5255,
    "text": "pallioli vice linteoli."
  },
  {
    "id": "p-3a8c35",
    "offset": 5280,
    "text": "cedat amor lacrimantum hominum,"
  },
  {
    "id": "p-f4c94f",
    "offset": 5313,
    "text": "qui celebrare suprema solent,"
  },
  {
    "id": "p-85c298",
    "offset": 5344,
    "text": "flebile cedat et officium:"
  },
  {
    "id": "p-0404f5",
    "offset": 5372,
    "text": "ipsa elementa iubente Deo"
  },
  {
    "id": "p-d61742",
    "offset": 5399,
    "text": "exequias tibi, virgo, ferunt."
  },
  {
    "id": "p-1458e0",
    "offset": 5430,
    "text": "nunc locus Emerita est tumulo,"
  },
  {
    "id": "p-c2e196",
    "offset": 5462,
    "text": "clara colonia Vettoniae,"
  },
  {
    "id": "p-0d7ecf",
    "offset": 5488,
    "text": "quam memorabilis amnis Ana"
  },
  {
    "id": "p-d2bf96",
    "offset": 5516,
    "text": "praeterit et viridante rapax"
  },
  {
    "id": "p-324798",
    "offset": 5546,
    "text": "gurgite moenia pulchra lavit."
  },
  {
    "id": "p-7a2a63",
    "offset": 5577,
    "text": "hic, ubi marmore perspicuo"
  },
  {
    "id": "p-7d7d52",
    "offset": 5605,
    "text": "atria luminat alma nitor"
  },
  {
    "id": "p-d9c949",
    "offset": 5631,
    "text": "et peregrinus et indigena,"
  },
  {
    "id": "p-ace783",
    "offset": 5659,
    "text": "relliquias cineresque sacros"
  },
  {
    "id": "p-358dd4",
    "offset": 5689,
    "text": "servat humus veneranda sinu."
  },
  {
    "id": "p-6268b4",
    "offset": 5719,
    "text": "tecta corusca super rutilant"
  },
  {
    "id": "p-56cf1d",
    "offset": 5749,
    "text": "de laquearibus aureolis"
  },
  {
    "id": "p-ec41af",
    "offset": 5774,
    "text": "saxaque caesa solum variant,"
  },
  {
    "id": "p-778fae",
    "offset": 5804,
    "text": "floribus ut rosulenta putes"
  },
  {
    "id": "p-9b090c",
    "offset": 5833,
    "text": "prata rubescere multimodis."
  },
  {
    "id": "p-a65aba",
    "offset": 5862,
    "text": "carpite purpureas violas"
  },
  {
    "id": "p-00695c",
    "offset": 5888,
    "text": "sanguineosque crocos metite,"
  },
  {
    "id": "p-157f64",
    "offset": 5918,
    "text": "non caret his genialis hiems,"
  },
  {
    "id": "p-1474d2",
    "offset": 5949,
    "text": "laxat et arva tepens glacies,"
  },
  {
    "id": "p-284ca4",
    "offset": 5980,
    "text": "floribus ut cumulet calathos."
  },
  {
    "id": "p-572e4d",
    "offset": 6011,
    "text": "ista comantibus e foliis"
  },
  {
    "id": "p-8e1baf",
    "offset": 6037,
    "text": "munera, virgo puerque, date."
  },
  {
    "id": "p-aeb219",
    "offset": 6067,
    "text": "ast ego serta choro in medio"
  },
  {
    "id": "p-5d445a",
    "offset": 6097,
    "text": "texta feram pede dactylico,"
  },
  {
    "id": "p-b50292",
    "offset": 6126,
    "text": "vilia, marcida, festa tamen."
  },
  {
    "id": "p-e6ed3a",
    "offset": 6156,
    "text": "sic venerarier ossa libet"
  },
  {
    "id": "p-260f69",
    "offset": 6183,
    "text": "ossibus altar et inpositum:"
  },
  {
    "id": "p-aa9824",
    "offset": 6212,
    "text": "illa Dei sita sub pedibus"
  },
  {
    "id": "p-c2391b",
    "offset": 6239,
    "text": "prospicit haec populosque suos"
  },
  {
    "id": "p-cf1a59",
    "offset": 6271,
    "text": "carmine propitiata fovet."
  }
]