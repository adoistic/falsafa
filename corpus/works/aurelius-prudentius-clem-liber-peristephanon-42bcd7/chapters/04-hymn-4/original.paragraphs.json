[
  {
    "id": "p-6f1c06",
    "offset": 0,
    "text": "4. Hymnus in honorem Sanctorum Decem et Octo Martyrum Caesaraugustanorum.\nBis novem noster populus sub uno"
  },
  {
    "id": "p-3170d3",
    "offset": 108,
    "text": "martyrum servat cineres sepulcro:"
  },
  {
    "id": "p-df1eff",
    "offset": 143,
    "text": "Caesaraugustam vocitamus urbem"
  },
  {
    "id": "p-dfdbf5",
    "offset": 175,
    "text": "res cui tanta est."
  },
  {
    "id": "p-6f600e",
    "offset": 195,
    "text": "plena magnorum domus angelorum"
  },
  {
    "id": "p-420fc1",
    "offset": 227,
    "text": "non timet mundi fragilis ruinam,"
  },
  {
    "id": "p-ca597d",
    "offset": 261,
    "text": "tot sinu gestans simul offerenda"
  },
  {
    "id": "p-3db081",
    "offset": 295,
    "text": "munera Christo,"
  },
  {
    "id": "p-83c863",
    "offset": 312,
    "text": "cum Deus dextram quatiens coruscam"
  },
  {
    "id": "p-f1cbae",
    "offset": 348,
    "text": "nube subnixus veniet rubente"
  },
  {
    "id": "p-2090fd",
    "offset": 378,
    "text": "gentibus iustam positurus aequo"
  },
  {
    "id": "p-401c65",
    "offset": 411,
    "text": "pondere libram,"
  },
  {
    "id": "p-952b40",
    "offset": 428,
    "text": "orbe de magno caput excitata"
  },
  {
    "id": "p-c6e8a8",
    "offset": 458,
    "text": "obviam Christo properanter ibit"
  },
  {
    "id": "p-f14158",
    "offset": 491,
    "text": "civitas quaeque pretiosa portans"
  },
  {
    "id": "p-87f3f3",
    "offset": 525,
    "text": "dona canistris."
  },
  {
    "id": "p-789eee",
    "offset": 542,
    "text": "Afra Carthago tua promet ossa,"
  },
  {
    "id": "p-de272b",
    "offset": 574,
    "text": "ore facundo Cypriane doctor,"
  },
  {
    "id": "p-49472b",
    "offset": 604,
    "text": "Corduba Acisclum dabit et Zoellum,"
  },
  {
    "id": "p-a3e1af",
    "offset": 640,
    "text": "tresque coronas."
  },
  {
    "id": "p-008171",
    "offset": 658,
    "text": "tu tribus gemmis diadema pulchrum"
  },
  {
    "id": "p-b290f9",
    "offset": 693,
    "text": "offeres Christo, genetrix piorum"
  },
  {
    "id": "p-646612",
    "offset": 727,
    "text": "Tarraco, intexit cui Fructuosus"
  },
  {
    "id": "p-e7031d",
    "offset": 760,
    "text": "sutile vinclum,"
  },
  {
    "id": "p-3b3f0a",
    "offset": 777,
    "text": "nomen hoc gemmae strophio inligatae est;"
  },
  {
    "id": "p-f7b0c2",
    "offset": 819,
    "text": "emicant iuxta lapides gemelli"
  },
  {
    "id": "p-f5d223",
    "offset": 850,
    "text": "ardet et splendor parilis duorum"
  },
  {
    "id": "p-6c2578",
    "offset": 884,
    "text": "igne corusco."
  },
  {
    "id": "p-a736e3",
    "offset": 899,
    "text": "parva Felicis decus exhibebit"
  },
  {
    "id": "p-a7e444",
    "offset": 930,
    "text": "artubus sanctis locuples Gerunda;"
  },
  {
    "id": "p-c628ae",
    "offset": 965,
    "text": "nostra gestabit Calagurris ambos"
  },
  {
    "id": "p-e974c2",
    "offset": 999,
    "text": "quos veneramur."
  },
  {
    "id": "p-9a0e21",
    "offset": 1016,
    "text": "Barchinon claro Cucufate freta"
  },
  {
    "id": "p-f298d9",
    "offset": 1048,
    "text": "surget, et Paulo speciosa Narbo,"
  },
  {
    "id": "p-d912ba",
    "offset": 1082,
    "text": "teque praepollens Arelas habebit,"
  },
  {
    "id": "p-1aedaf",
    "offset": 1117,
    "text": "sancte Genesi."
  },
  {
    "id": "p-cd83b7",
    "offset": 1133,
    "text": "Lusitanorum caput oppidorum"
  },
  {
    "id": "p-35a010",
    "offset": 1162,
    "text": "urbs adoratae cineres puellae"
  },
  {
    "id": "p-667a72",
    "offset": 1193,
    "text": "obviam Christo rapiens ad aram"
  },
  {
    "id": "p-f8ef31",
    "offset": 1225,
    "text": "porriget ipsam."
  },
  {
    "id": "p-fbb57d",
    "offset": 1242,
    "text": "sanguinem Iusti, cui Pastor haeret,"
  },
  {
    "id": "p-7332e8",
    "offset": 1279,
    "text": "ferculum duplex geminumque donum"
  },
  {
    "id": "p-8fc07c",
    "offset": 1313,
    "text": "ferre Complutum gremio iuvabit"
  },
  {
    "id": "p-5a1a43",
    "offset": 1345,
    "text": "membra duorum,"
  },
  {
    "id": "p-48f0a6",
    "offset": 1361,
    "text": "ingeret Tingis sua Cassianum,"
  },
  {
    "id": "p-1c27a2",
    "offset": 1392,
    "text": "festa Massylum monumenta regum,"
  },
  {
    "id": "p-8f05f4",
    "offset": 1425,
    "text": "qui cinis gentes domitas coegit"
  },
  {
    "id": "p-713ae1",
    "offset": 1458,
    "text": "ad iuga Christi."
  },
  {
    "id": "p-9a91b3",
    "offset": 1476,
    "text": "singulis paucae, tribus aut duobus,"
  },
  {
    "id": "p-a3bae9",
    "offset": 1513,
    "text": "forsan et quinis aliquae placebunt"
  },
  {
    "id": "p-79743a",
    "offset": 1549,
    "text": "testibus Christi prius hostiarum"
  },
  {
    "id": "p-398185",
    "offset": 1583,
    "text": "pignere functae:"
  },
  {
    "id": "p-ae25e5",
    "offset": 1601,
    "text": "tu decem sanctos revehes et octo,"
  },
  {
    "id": "p-53690e",
    "offset": 1636,
    "text": "Caesaraugusta studiosa Christo,"
  },
  {
    "id": "p-9c2408",
    "offset": 1669,
    "text": "verticem flavis oleis revincta,"
  },
  {
    "id": "p-b3459c",
    "offset": 1702,
    "text": "pacis honore,"
  },
  {
    "id": "p-7111be",
    "offset": 1717,
    "text": "sola in occursum numerosiores"
  },
  {
    "id": "p-257158",
    "offset": 1748,
    "text": "martyrum turbas Domino parasti,"
  },
  {
    "id": "p-8ac0cd",
    "offset": 1781,
    "text": "sola praedives pietate multa"
  },
  {
    "id": "p-e2ecb7",
    "offset": 1811,
    "text": "luce frueris."
  },
  {
    "id": "p-992405",
    "offset": 1826,
    "text": "vix parens orbis populosa Poeni,"
  },
  {
    "id": "p-60527f",
    "offset": 1860,
    "text": "ipsa vix Roma in solio locata"
  },
  {
    "id": "p-804ec7",
    "offset": 1891,
    "text": "te, decus nostrum, superare in isto"
  },
  {
    "id": "p-1c74f9",
    "offset": 1928,
    "text": "munere digna est."
  },
  {
    "id": "p-b1683c",
    "offset": 1947,
    "text": "omnibus portis sacer immolatus"
  },
  {
    "id": "p-786668",
    "offset": 1979,
    "text": "sanguis exclusit genus invidorum"
  },
  {
    "id": "p-669d03",
    "offset": 2013,
    "text": "daemonum et nigras pepulit tenebras"
  },
  {
    "id": "p-0ada3f",
    "offset": 2050,
    "text": "urbe piata."
  },
  {
    "id": "p-25f1c4",
    "offset": 2063,
    "text": "nullus umbrarum latet intus horror,"
  },
  {
    "id": "p-679de9",
    "offset": 2100,
    "text": "pulsa nam pestis populum refugit;"
  },
  {
    "id": "p-18c096",
    "offset": 2135,
    "text": "Christus in totis habitat plateis,"
  },
  {
    "id": "p-3abe1c",
    "offset": 2171,
    "text": "Christus ubique est."
  },
  {
    "id": "p-c75fc4",
    "offset": 2193,
    "text": "martyrum credas patriam coronis"
  },
  {
    "id": "p-713489",
    "offset": 2226,
    "text": "debitam sacris, chorus unde surgens"
  },
  {
    "id": "p-082844",
    "offset": 2263,
    "text": "tendit in caelum niveus togatae"
  },
  {
    "id": "p-e754b6",
    "offset": 2296,
    "text": "nobilitatis,"
  },
  {
    "id": "p-213c8b",
    "offset": 2310,
    "text": "inde, vincenti, tua palma nata est,"
  },
  {
    "id": "p-7e9743",
    "offset": 2347,
    "text": "clerus hic tantum peperit triumphum,"
  },
  {
    "id": "p-3d90c4",
    "offset": 2385,
    "text": "hic sacerdotum domus infulata"
  },
  {
    "id": "p-e092b6",
    "offset": 2416,
    "text": "Valeriorum."
  },
  {
    "id": "p-6c3f1e",
    "offset": 2429,
    "text": "saevus antiquis quotiens procellis"
  },
  {
    "id": "p-0cb4f6",
    "offset": 2465,
    "text": "turbo vexatum tremefecit orbem,"
  },
  {
    "id": "p-6cdb10",
    "offset": 2498,
    "text": "tristior templum rabies in istud"
  },
  {
    "id": "p-a1adfc",
    "offset": 2532,
    "text": "intulit iras,"
  },
  {
    "id": "p-f7663e",
    "offset": 2547,
    "text": "nec furor quisquam sine laude nostrum"
  },
  {
    "id": "p-a3e707",
    "offset": 2586,
    "text": "cessit aut clari vacuus cruoris;"
  },
  {
    "id": "p-a0ee9d",
    "offset": 2620,
    "text": "martyrum semper numerus sub omni"
  },
  {
    "id": "p-f4d895",
    "offset": 2654,
    "text": "grandine crevit,"
  },
  {
    "id": "p-827f9f",
    "offset": 2672,
    "text": "nonne, vincenti, peregri necandus"
  },
  {
    "id": "p-dc7fca",
    "offset": 2707,
    "text": "martyr his terris tenui notasti"
  },
  {
    "id": "p-e1213a",
    "offset": 2740,
    "text": "sanguinis rore speciem futuri"
  },
  {
    "id": "p-871b74",
    "offset": 2771,
    "text": "morte propinqua?"
  },
  {
    "id": "p-799006",
    "offset": 2789,
    "text": "hoc colunt cives, velut ipsa membra"
  },
  {
    "id": "p-6eb9cb",
    "offset": 2826,
    "text": "caespes includat suus et paterno"
  },
  {
    "id": "p-39ef00",
    "offset": 2860,
    "text": "servet amplectens tumulo beati"
  },
  {
    "id": "p-9d790b",
    "offset": 2892,
    "text": "martyris ossa."
  },
  {
    "id": "p-3ace45",
    "offset": 2908,
    "text": "noster est, quamvis procul hinc in urbe"
  },
  {
    "id": "p-f17746",
    "offset": 2949,
    "text": "passus ignota dederit sepulcri"
  },
  {
    "id": "p-de6b25",
    "offset": 2981,
    "text": "gloriam victor prope litus altae"
  },
  {
    "id": "p-054e8d",
    "offset": 3015,
    "text": "forte Sagunti."
  },
  {
    "id": "p-863041",
    "offset": 3031,
    "text": "noster et nostra puer in palaestra"
  },
  {
    "id": "p-2e964e",
    "offset": 3067,
    "text": "arte virtutis fideique olivo"
  },
  {
    "id": "p-39cd9c",
    "offset": 3097,
    "text": "unctus horrendum didicit domare"
  },
  {
    "id": "p-e14f37",
    "offset": 3130,
    "text": "viribus hostem,"
  },
  {
    "id": "p-e7e914",
    "offset": 3147,
    "text": "noverat templo celebres in isto"
  },
  {
    "id": "p-cca9ac",
    "offset": 3180,
    "text": "octies partas deciesque palmas;"
  },
  {
    "id": "p-6ec459",
    "offset": 3213,
    "text": "laureis doctus patriis eadem"
  },
  {
    "id": "p-613749",
    "offset": 3243,
    "text": "laude cucurrit,"
  },
  {
    "id": "p-11d6e2",
    "offset": 3260,
    "text": "hic et, Encrati, recubant tuarum"
  },
  {
    "id": "p-0f3ef0",
    "offset": 3294,
    "text": "ossa virtutum, quibus efferati"
  },
  {
    "id": "p-b493d8",
    "offset": 3326,
    "text": "spiritum mundi, violenta virgo,"
  },
  {
    "id": "p-65d81a",
    "offset": 3359,
    "text": "dedecorasti."
  },
  {
    "id": "p-be1f74",
    "offset": 3373,
    "text": "martyrum nulli remanente vita"
  },
  {
    "id": "p-659e09",
    "offset": 3404,
    "text": "contigit terris habitare nostris;"
  },
  {
    "id": "p-a96062",
    "offset": 3439,
    "text": "sola tu morti propriae superstes"
  },
  {
    "id": "p-770bb6",
    "offset": 3473,
    "text": "vivis in orbe."
  },
  {
    "id": "p-3b8414",
    "offset": 3489,
    "text": "vivis, ac poenae seriem retexis,"
  },
  {
    "id": "p-591595",
    "offset": 3523,
    "text": "carnis et caesae spolium retentans"
  },
  {
    "id": "p-cfba88",
    "offset": 3559,
    "text": "taetra quam sulcos habeant amaros"
  },
  {
    "id": "p-401aeb",
    "offset": 3594,
    "text": "vulnera narras."
  },
  {
    "id": "p-505bf8",
    "offset": 3611,
    "text": "barbarus tortor latus omne carpsit,"
  },
  {
    "id": "p-a23c7d",
    "offset": 3648,
    "text": "sanguis inpensus, lacerata membra,"
  },
  {
    "id": "p-c00873",
    "offset": 3684,
    "text": "pectus abscisa patuit papilla"
  },
  {
    "id": "p-6b966a",
    "offset": 3715,
    "text": "corde sub ipso."
  },
  {
    "id": "p-99ce3b",
    "offset": 3732,
    "text": "iam minus mortis pretium peractae est,"
  },
  {
    "id": "p-721779",
    "offset": 3772,
    "text": "quae venenatos abolens dolores"
  },
  {
    "id": "p-b84110",
    "offset": 3804,
    "text": "concitam membris tribuit quietem"
  },
  {
    "id": "p-5f3e4e",
    "offset": 3838,
    "text": "fine soporo."
  },
  {
    "id": "p-9c9539",
    "offset": 3852,
    "text": "cruda te longum tenuit cicatrix"
  },
  {
    "id": "p-4a2877",
    "offset": 3885,
    "text": "et diu venis dolor haesit ardens,"
  },
  {
    "id": "p-50c41f",
    "offset": 3920,
    "text": "dum putrescentes tenuat medullas"
  },
  {
    "id": "p-6a5bde",
    "offset": 3954,
    "text": "tabidus umor."
  },
  {
    "id": "p-fce0ff",
    "offset": 3969,
    "text": "invidus quamvis obitum supremum"
  },
  {
    "id": "p-c08849",
    "offset": 4002,
    "text": "persecutoris gladius negarit,"
  },
  {
    "id": "p-af445a",
    "offset": 4033,
    "text": "plena te, martyr, tamen ut peremptam,"
  },
  {
    "id": "p-9d3c3b",
    "offset": 4072,
    "text": "poena coronat,"
  },
  {
    "id": "p-ad538b",
    "offset": 4088,
    "text": "vidimus partem iecoris revulsam"
  },
  {
    "id": "p-9814d7",
    "offset": 4121,
    "text": "ungulis longe iacuisse pressis:"
  },
  {
    "id": "p-9fc87b",
    "offset": 4154,
    "text": "mors habet pallens aliquid tuorum"
  },
  {
    "id": "p-8f0288",
    "offset": 4189,
    "text": "te quoque viva."
  },
  {
    "id": "p-32ab9b",
    "offset": 4206,
    "text": "hunc novum nostrae titulum fruendum"
  },
  {
    "id": "p-3d399e",
    "offset": 4243,
    "text": "Caesaraugustae dedit ipse Christus,"
  },
  {
    "id": "p-d2e2f5",
    "offset": 4280,
    "text": "iuge viventis domus ut dicata"
  },
  {
    "id": "p-24c529",
    "offset": 4311,
    "text": "martyris esset,"
  },
  {
    "id": "p-e9ba96",
    "offset": 4328,
    "text": "ergo ter senis sacra candidatis,"
  },
  {
    "id": "p-261bab",
    "offset": 4362,
    "text": "dives Optato, simul et Luperco,"
  },
  {
    "id": "p-0d59f8",
    "offset": 4395,
    "text": "perge conscriptum tibimet senatum"
  },
  {
    "id": "p-f42cc4",
    "offset": 4430,
    "text": "pangere psalmis,"
  },
  {
    "id": "p-422023",
    "offset": 4448,
    "text": "ede Successum, cane Martialem,"
  },
  {
    "id": "p-ab0ffd",
    "offset": 4480,
    "text": "mors et Urbani tibi concinatur,"
  },
  {
    "id": "p-54ff25",
    "offset": 4513,
    "text": "Iuliam cantus resonet simulque"
  },
  {
    "id": "p-c33ab8",
    "offset": 4545,
    "text": "Quintilianum."
  },
  {
    "id": "p-a6f43a",
    "offset": 4560,
    "text": "Publium pangat chorus et revolvat"
  },
  {
    "id": "p-d6882e",
    "offset": 4595,
    "text": "quale Frontonis fuerit tropaeum,"
  },
  {
    "id": "p-55cdac",
    "offset": 4629,
    "text": "quid bonus Felix tulerit, quid acer"
  },
  {
    "id": "p-278a07",
    "offset": 4666,
    "text": "Caecilianus,"
  },
  {
    "id": "p-2fe1ba",
    "offset": 4680,
    "text": "quantus, Evoti, tua bella sanguis"
  },
  {
    "id": "p-d57068",
    "offset": 4715,
    "text": "tinxerit, quantus tua, Primitive,"
  },
  {
    "id": "p-5468c5",
    "offset": 4750,
    "text": "tum tuos vivax recolat triumphos"
  },
  {
    "id": "p-fb5078",
    "offset": 4784,
    "text": "laus, Apodemi."
  },
  {
    "id": "p-537175",
    "offset": 4800,
    "text": "quattuor posthinc superest virorum"
  },
  {
    "id": "p-6ee8c7",
    "offset": 4836,
    "text": "nomen extolli renuente metro,"
  },
  {
    "id": "p-b64577",
    "offset": 4867,
    "text": "quos Saturninos memorat vocatos"
  },
  {
    "id": "p-13d0dc",
    "offset": 4900,
    "text": "prisca vetustas,"
  },
  {
    "id": "p-5fb623",
    "offset": 4918,
    "text": "carminis leges amor aureorum"
  },
  {
    "id": "p-bb37e2",
    "offset": 4948,
    "text": "nominum parvi facit, et loquendi"
  },
  {
    "id": "p-33c9d8",
    "offset": 4982,
    "text": "cura de sanctis vitiosa non est"
  },
  {
    "id": "p-6494da",
    "offset": 5015,
    "text": "nec rudis umquam,"
  },
  {
    "id": "p-bd808b",
    "offset": 5034,
    "text": "plenus est artis modus adnotatas"
  },
  {
    "id": "p-58102c",
    "offset": 5068,
    "text": "nominum formas recitare Christo,"
  },
  {
    "id": "p-742059",
    "offset": 5102,
    "text": "quas tenet caeli liber explicandus"
  },
  {
    "id": "p-33f327",
    "offset": 5138,
    "text": "tempore iusto,"
  },
  {
    "id": "p-347e58",
    "offset": 5154,
    "text": "octo tunc sanctos recolet decemque"
  },
  {
    "id": "p-8ff22b",
    "offset": 5190,
    "text": "angelus coram Patre Filioque"
  },
  {
    "id": "p-818446",
    "offset": 5220,
    "text": "urbis unius regimen tenentes"
  },
  {
    "id": "p-6ab3b1",
    "offset": 5250,
    "text": "iure sepulcri."
  },
  {
    "id": "p-b147a0",
    "offset": 5266,
    "text": "quin ad antiquum numerum trahetur"
  },
  {
    "id": "p-3c9ea0",
    "offset": 5301,
    "text": "viva post poenae specimen puella,"
  },
  {
    "id": "p-b10324",
    "offset": 5336,
    "text": "morsque 1 vincenti, cui sanguis hinc est"
  },
  {
    "id": "p-4a730e",
    "offset": 5378,
    "text": "fons et honoris,"
  },
  {
    "id": "p-d596c1",
    "offset": 5396,
    "text": "additis 2 Gaio (nec enim silendi)"
  },
  {
    "id": "p-96203f",
    "offset": 5431,
    "text": "teque, Crementi, quibus incruentum"
  },
  {
    "id": "p-f2bcd1",
    "offset": 5467,
    "text": "ferre provenit decus ex secundo"
  },
  {
    "id": "p-59c59f",
    "offset": 5500,
    "text": "laudis agone,"
  },
  {
    "id": "p-6f3726",
    "offset": 5515,
    "text": "ambo confessi Dominum steterunt"
  },
  {
    "id": "p-62158b",
    "offset": 5548,
    "text": "acriter contra fremitum latronum,"
  },
  {
    "id": "p-9f8da0",
    "offset": 5583,
    "text": "ambo gustarunt leviter saporem"
  },
  {
    "id": "p-100cdf",
    "offset": 5615,
    "text": "martyriorum,"
  },
  {
    "id": "p-34ca7a",
    "offset": 5629,
    "text": "haec sub altari sita sempiterno"
  },
  {
    "id": "p-2b5cdd",
    "offset": 5662,
    "text": "lapsibus nostris veniam precatur"
  },
  {
    "id": "p-719c69",
    "offset": 5696,
    "text": "turba, quam servat procerum creatrix"
  },
  {
    "id": "p-11fa8c",
    "offset": 5734,
    "text": "purpureorum"
  },
  {
    "id": "p-894a4c",
    "offset": 5747,
    "text": "nos pio fletu, date, perluamus"
  },
  {
    "id": "p-8ceb82",
    "offset": 5779,
    "text": "marmorum sulcos, quibus est. operta"
  },
  {
    "id": "p-dd4de6",
    "offset": 5816,
    "text": "spes ut absolvam retinaculorum"
  },
  {
    "id": "p-0c84b5",
    "offset": 5848,
    "text": "vincla meorum,"
  },
  {
    "id": "p-3ceb35",
    "offset": 5864,
    "text": "sterne te totam generosa sanctis"
  },
  {
    "id": "p-b74b9a",
    "offset": 5898,
    "text": "civitas mecum tumulis; deinde"
  },
  {
    "id": "p-a8397c",
    "offset": 5929,
    "text": "mox resurgentes animas et artus"
  },
  {
    "id": "p-2e740e",
    "offset": 5962,
    "text": "tota sequeris."
  }
]