[
  {
    "id": "p-2c23ae",
    "offset": 0,
    "text": "6. Hymnus in honorem Beatissimorum Martyrum Fructuosi Episcopi Ecclesiae Tarraconensis, et Augurii et Eulogii Diaconorum.\nFelix Tarraco, Fructuose, vestris"
  },
  {
    "id": "p-5b16d2",
    "offset": 157,
    "text": "attollit caput ignibus coruscum"
  },
  {
    "id": "p-eeaeea",
    "offset": 190,
    "text": "Levitis geminis procul relucens."
  },
  {
    "id": "p-65f0b8",
    "offset": 224,
    "text": "Hispanos Deus aspicit benignus,"
  },
  {
    "id": "p-48f3c4",
    "offset": 257,
    "text": "arcem quandoquidem potens Hiberam"
  },
  {
    "id": "p-ff0fc5",
    "offset": 292,
    "text": "trino martyre Trinitas coronat."
  },
  {
    "id": "p-da39f9",
    "offset": 325,
    "text": "ardens Augurius capessit aethram,"
  },
  {
    "id": "p-5da6bc",
    "offset": 360,
    "text": "nec non Eulogius simul supernum 1"
  },
  {
    "id": "p-cd4b8d",
    "offset": 395,
    "text": "Christi lucidus ad sedile tendit."
  },
  {
    "id": "p-fb454e",
    "offset": 430,
    "text": "dux et praevius et magister illis"
  },
  {
    "id": "p-c4a85b",
    "offset": 465,
    "text": "ad tantum decus ex episcopali"
  },
  {
    "id": "p-ddbb51",
    "offset": 496,
    "text": "clarus nomine Fructuosus ibat,"
  },
  {
    "id": "p-a75daf",
    "offset": 528,
    "text": "accitus quia praesidis repente"
  },
  {
    "id": "p-c3e11c",
    "offset": 560,
    "text": "iussu venerat ad forum sacerdos"
  },
  {
    "id": "p-29c5fc",
    "offset": 593,
    "text": "Levitis comitantibus duobus."
  },
  {
    "id": "p-94a430",
    "offset": 623,
    "text": "inde ad carceream viros catenam"
  },
  {
    "id": "p-64b5e0",
    "offset": 656,
    "text": "pastus sanguine carnifex trahebat;"
  },
  {
    "id": "p-569031",
    "offset": 692,
    "text": "gaudet currere Fructuosus ultro."
  },
  {
    "id": "p-f7190a",
    "offset": 726,
    "text": "ac, ne quis socios timor feriret,"
  },
  {
    "id": "p-5c6c15",
    "offset": 761,
    "text": "praeceptor vehemens eundo firmat"
  },
  {
    "id": "p-466b0b",
    "offset": 795,
    "text": "incenditque fidem calore Christi."
  },
  {
    "id": "p-5c0349",
    "offset": 830,
    "text": "‘mecum state, viri. vocat cruentus"
  },
  {
    "id": "p-c356fd",
    "offset": 866,
    "text": "ad poenam coluber Dei ministros;"
  },
  {
    "id": "p-281f27",
    "offset": 900,
    "text": "ne mors terreat; est parata palma."
  },
  {
    "id": "p-538fb8",
    "offset": 936,
    "text": "carcer Christicolis gradus coronae est,"
  },
  {
    "id": "p-08b3ff",
    "offset": 977,
    "text": "carcer provehit ad superna caeli,"
  },
  {
    "id": "p-89253e",
    "offset": 1012,
    "text": "carcer conciliat Deum beatis.’"
  },
  {
    "id": "p-ae9c2b",
    "offset": 1044,
    "text": "his dictis adeunt specum reorum,"
  },
  {
    "id": "p-607e4d",
    "offset": 1078,
    "text": "exercent ibi mysticum lavacrum,"
  },
  {
    "id": "p-b1fa53",
    "offset": 1111,
    "text": "et purgamen aquae stupent tenebrae."
  },
  {
    "id": "p-fa64a2",
    "offset": 1148,
    "text": "sex hic continuis latent diebus,"
  },
  {
    "id": "p-7cb366",
    "offset": 1182,
    "text": "tandem stant trucis ad tribunal hostis:"
  },
  {
    "id": "p-f6f769",
    "offset": 1223,
    "text": "fratres tergeminos tremunt catastae."
  },
  {
    "id": "p-b7eca1",
    "offset": 1261,
    "text": "iudex Aemilianus inminebat"
  },
  {
    "id": "p-e6a5d1",
    "offset": 1289,
    "text": "atrox, turbidus, insolens, profanus;"
  },
  {
    "id": "p-790115",
    "offset": 1327,
    "text": "aras daemonicas coli iubebat."
  },
  {
    "id": "p-a07896",
    "offset": 1358,
    "text": "tu, qui doctor, ait, ‘seris novellum"
  },
  {
    "id": "p-278e81",
    "offset": 1396,
    "text": "commenti genus, ut leves puellae"
  },
  {
    "id": "p-badeb5",
    "offset": 1430,
    "text": "lucos destituant, Iovem relinquant,"
  },
  {
    "id": "p-13afc9",
    "offset": 1467,
    "text": "damnes, si sapias, anile dogma."
  },
  {
    "id": "p-f8360d",
    "offset": 1500,
    "text": "iussum est Caesaris ore Gallieni,"
  },
  {
    "id": "p-fc793c",
    "offset": 1535,
    "text": "quod princeps colit, ut colamus omnes.’"
  },
  {
    "id": "p-57b81a",
    "offset": 1576,
    "text": "haec fanti placidus refert sacerdos:"
  },
  {
    "id": "p-474615",
    "offset": 1614,
    "text": "‘aeternum colo principem dierum,"
  },
  {
    "id": "p-231027",
    "offset": 1648,
    "text": "factorem dominumque Gallieni,"
  },
  {
    "id": "p-889d7a",
    "offset": 1679,
    "text": "et Christum Patre prosatum perenni,"
  },
  {
    "id": "p-e388a0",
    "offset": 1716,
    "text": "cuius sum famulus gregisque pastor.’"
  },
  {
    "id": "p-a93ea3",
    "offset": 1754,
    "text": "subridens ait ille: iam fuisti."
  },
  {
    "id": "p-b660a2",
    "offset": 1787,
    "text": "nec differt furor aut refrenat iram,"
  },
  {
    "id": "p-9f6f79",
    "offset": 1825,
    "text": "saevis destinat ignibus cremandos."
  },
  {
    "id": "p-0a6206",
    "offset": 1861,
    "text": "exultant prohibentque flere vulgum."
  },
  {
    "id": "p-67207c",
    "offset": 1898,
    "text": "quosdam de populo videt sacerdos"
  },
  {
    "id": "p-bb7fbe",
    "offset": 1932,
    "text": "libandum sibi poculum offerentes:"
  },
  {
    "id": "p-18b7a0",
    "offset": 1967,
    "text": "ieiunamus, ait; ‘recuso potum:"
  },
  {
    "id": "p-133018",
    "offset": 1999,
    "text": "nondum nona diem resignat hora;"
  },
  {
    "id": "p-be6a36",
    "offset": 2032,
    "text": "numquam eonviolabo ius dicatum,"
  },
  {
    "id": "p-a91d75",
    "offset": 2065,
    "text": "nec mors ipsa meum sacrum resolvet."
  },
  {
    "id": "p-06eecc",
    "offset": 2102,
    "text": "sic Christus sitiens crucis sub hora"
  },
  {
    "id": "p-0a4ec9",
    "offset": 2140,
    "text": "oblatum sibi poculum recusans"
  },
  {
    "id": "p-df4885",
    "offset": 2171,
    "text": "nec libare volens sitim peregit.’"
  },
  {
    "id": "p-703df1",
    "offset": 2206,
    "text": "intrant interea locum rotunda"
  },
  {
    "id": "p-533fad",
    "offset": 2237,
    "text": "conclusum cavea, madens ferarum"
  },
  {
    "id": "p-4c5dd2",
    "offset": 2270,
    "text": "multo sanguine quem furor frequentat,"
  },
  {
    "id": "p-3b1579",
    "offset": 2309,
    "text": "cum spectacula perstrepunt cruenta"
  },
  {
    "id": "p-8a3f41",
    "offset": 2345,
    "text": "ac vilis gladiator ense duro"
  },
  {
    "id": "p-ee6cfd",
    "offset": 2375,
    "text": "percussus cadit et fremit voluptas."
  },
  {
    "id": "p-5cd7a0",
    "offset": 2412,
    "text": "hic flammante pyra niger minister"
  },
  {
    "id": "p-a5a28e",
    "offset": 2447,
    "text": "ardens supplicium parare iussus"
  },
  {
    "id": "p-e27b32",
    "offset": 2480,
    "text": "construxit facibus rogum supremis,"
  },
  {
    "id": "p-bf63d1",
    "offset": 2516,
    "text": "qui, dum corpora concremanda 1 solvit,"
  },
  {
    "id": "p-2373fe",
    "offset": 2556,
    "text": "ferventes animas amore lucis"
  },
  {
    "id": "p-430d74",
    "offset": 2586,
    "text": "fracto carceris expediret antro."
  },
  {
    "id": "p-63fef7",
    "offset": 2620,
    "text": "certant officiis pii sodales:"
  },
  {
    "id": "p-fb66b3",
    "offset": 2651,
    "text": "plantis calciamenta dissolutis"
  },
  {
    "id": "p-6b1c94",
    "offset": 2683,
    "text": "pronus detrahere studebat unus,"
  },
  {
    "id": "p-93007a",
    "offset": 2716,
    "text": "sed sanctus vetat ora Fructuosus"
  },
  {
    "id": "p-17fac8",
    "offset": 2750,
    "text": "inclinata premi: facessite, inquit,"
  },
  {
    "id": "p-9f51e8",
    "offset": 2787,
    "text": "‘nec nostram gravet obsequella mortem."
  },
  {
    "id": "p-8c7869",
    "offset": 2827,
    "text": "atquin ipse meos pedes resolvam,"
  },
  {
    "id": "p-cbb875",
    "offset": 2861,
    "text": "ne vestigia praepedita vinclis"
  },
  {
    "id": "p-07513b",
    "offset": 2893,
    "text": "tardis gressibus inruant in ignem."
  },
  {
    "id": "p-644afc",
    "offset": 2929,
    "text": "cur lamenta rigant genas madentes?"
  },
  {
    "id": "p-8a110d",
    "offset": 2965,
    "text": "cur vestri memor ut fiam rogatis?"
  },
  {
    "id": "p-787451",
    "offset": 3000,
    "text": "cunctis pro populis rogabo Christum.’"
  },
  {
    "id": "p-a2a815",
    "offset": 3039,
    "text": "vix haec ediderat, relaxat ipse"
  },
  {
    "id": "p-bde36e",
    "offset": 3072,
    "text": "indumenta pedum, velut Moyses"
  },
  {
    "id": "p-e2b07d",
    "offset": 3103,
    "text": "quondam fecerat ad rubum propinquans."
  },
  {
    "id": "p-f08ce0",
    "offset": 3142,
    "text": "non calcare sacram cremationem"
  },
  {
    "id": "p-4f8a2e",
    "offset": 3174,
    "text": "aut adstare Deo prius licebat"
  },
  {
    "id": "p-2a8bdb",
    "offset": 3205,
    "text": "quam vestigia pura Agerentur."
  },
  {
    "id": "p-05f3f9",
    "offset": 3236,
    "text": "stabat calce mera: resultat ecce"
  },
  {
    "id": "p-779f53",
    "offset": 3270,
    "text": "caelo spiritus et serit loquellam,"
  },
  {
    "id": "p-aa9e7f",
    "offset": 3306,
    "text": "quae cunctos tremefecit audientes:"
  },
  {
    "id": "p-d3fda3",
    "offset": 3342,
    "text": "‘non est, credite, poena quam videtis,"
  },
  {
    "id": "p-8bfad2",
    "offset": 3382,
    "text": "quae puncto tenui citata transit,"
  },
  {
    "id": "p-e87b9b",
    "offset": 3417,
    "text": "nec vitam rapit illa, sed reformat."
  },
  {
    "id": "p-8f79d3",
    "offset": 3454,
    "text": "felices animae, quibus per ignem"
  },
  {
    "id": "p-fee5ca",
    "offset": 3488,
    "text": "celsa scandere contigit Tonantis,"
  },
  {
    "id": "p-86c0c7",
    "offset": 3523,
    "text": "quas olim fugiet perennis ignis.’"
  },
  {
    "id": "p-5e5960",
    "offset": 3558,
    "text": "haec inter rapidis focos crepantes"
  },
  {
    "id": "p-c44456",
    "offset": 3594,
    "text": "intrant passibus et minantur ipsis"
  },
  {
    "id": "p-b76161",
    "offset": 3630,
    "text": "flammarum trepidantibus caminis."
  },
  {
    "id": "p-d3380d",
    "offset": 3664,
    "text": "nexus denique, qui manus retrorsus"
  },
  {
    "id": "p-a55a05",
    "offset": 3700,
    "text": "in tergum revocaverant revinctas,"
  },
  {
    "id": "p-e7922a",
    "offset": 3735,
    "text": "intacta cute decidunt adusti."
  },
  {
    "id": "p-cb144e",
    "offset": 3766,
    "text": "non ausa est cohibere poena palmas"
  },
  {
    "id": "p-9adfef",
    "offset": 3802,
    "text": "in morem crucis ad Patrem levandas;"
  },
  {
    "id": "p-452d31",
    "offset": 3839,
    "text": "solvit bracchia, quae Deum precentur."
  },
  {
    "id": "p-ab6c94",
    "offset": 3878,
    "text": "priscorum specimen trium putares,"
  },
  {
    "id": "p-e3d6b2",
    "offset": 3913,
    "text": "quos olim Babylonicum per ignem"
  },
  {
    "id": "p-33e127",
    "offset": 3946,
    "text": "cantantes stupuit tremens tyrannus."
  },
  {
    "id": "p-b21df3",
    "offset": 3983,
    "text": "illis sed pia flamma tunc pepercit"
  },
  {
    "id": "p-9703bd",
    "offset": 4019,
    "text": "nondum tempore passionis apto,"
  },
  {
    "id": "p-f45d7c",
    "offset": 4051,
    "text": "nec mortis decus inchoante Christo."
  },
  {
    "id": "p-04fde2",
    "offset": 4088,
    "text": "hos cum defugeret vaporus ardor,"
  },
  {
    "id": "p-191324",
    "offset": 4122,
    "text": "orant ut celer ignis advolaret"
  },
  {
    "id": "p-7e0f7f",
    "offset": 4154,
    "text": "et finem daret anxiis periclis."
  },
  {
    "id": "p-50f776",
    "offset": 4187,
    "text": "exorata suos obire tandem"
  },
  {
    "id": "p-1308ed",
    "offset": 4214,
    "text": "maiestas famulos iubet caducis"
  },
  {
    "id": "p-eeb2f6",
    "offset": 4246,
    "text": "missos corporibus sibique reddi."
  },
  {
    "id": "p-d9ef57",
    "offset": 4280,
    "text": "vidit praesidis ex domo satelles"
  },
  {
    "id": "p-db8462",
    "offset": 4314,
    "text": "caelum martyribus patere apertum"
  },
  {
    "id": "p-915b4f",
    "offset": 4348,
    "text": "insignesque viros per astra ferri."
  },
  {
    "id": "p-6b0fe7",
    "offset": 4384,
    "text": "quin et filiolae monens erili"
  },
  {
    "id": "p-f1727e",
    "offset": 4415,
    "text": "ostendit sceleris notam paterni,"
  },
  {
    "id": "p-854fcf",
    "offset": 4449,
    "text": "caelo vivere quos forum peremit."
  },
  {
    "id": "p-86bf36",
    "offset": 4483,
    "text": "haec tum virginitas palam videre"
  },
  {
    "id": "p-cafcbf",
    "offset": 4517,
    "text": "per sudum meruit parente caeco,"
  },
  {
    "id": "p-ad8172",
    "offset": 4550,
    "text": "ut crimen domini domus timeret."
  },
  {
    "id": "p-b8bedc",
    "offset": 4583,
    "text": "tum de corporibus sacris favillae"
  },
  {
    "id": "p-8c9d47",
    "offset": 4618,
    "text": "et perfusa mero leguntur ossa,"
  },
  {
    "id": "p-581d13",
    "offset": 4650,
    "text": "quae raptim sibi quisque vindicabat."
  },
  {
    "id": "p-6545a1",
    "offset": 4688,
    "text": "fratrum tantus amor domum referre"
  },
  {
    "id": "p-1727b0",
    "offset": 4723,
    "text": "sanctorum cinerum dicata dona"
  },
  {
    "id": "p-c70dda",
    "offset": 4754,
    "text": "aut gestare sinu fidele pignus."
  },
  {
    "id": "p-d91058",
    "offset": 4787,
    "text": "sed ne reliquias resuscitandas"
  },
  {
    "id": "p-62c9d6",
    "offset": 4819,
    "text": "et mox cum domino simul futuras"
  },
  {
    "id": "p-b5fa60",
    "offset": 4852,
    "text": "discretis loca dividant sepulcris,"
  },
  {
    "id": "p-3e772b",
    "offset": 4888,
    "text": "cernuntur niveis stolis amicti,"
  },
  {
    "id": "p-171ec0",
    "offset": 4921,
    "text": "mandant restitui cavoque claudi"
  },
  {
    "id": "p-55cd70",
    "offset": 4954,
    "text": "mixtim marmore pulverem sacrandum."
  },
  {
    "id": "p-ef52c7",
    "offset": 4990,
    "text": "o triplex honor, o triforme culmen,"
  },
  {
    "id": "p-da619f",
    "offset": 5027,
    "text": "quo nostrae caput excitatur urbis,"
  },
  {
    "id": "p-b512bd",
    "offset": 5063,
    "text": "cunctis urbibus eminens Hiberis!"
  },
  {
    "id": "p-497ea8",
    "offset": 5097,
    "text": "exultare tribus libet patronis,"
  },
  {
    "id": "p-94c3a4",
    "offset": 5130,
    "text": "quorum praesidio fovemur omnes"
  },
  {
    "id": "p-12ec83",
    "offset": 5162,
    "text": "terrarum populi Pyrenearum."
  },
  {
    "id": "p-1af0de",
    "offset": 5191,
    "text": "circumstet chorus ex utroque sexu;"
  },
  {
    "id": "p-cc7cbc",
    "offset": 5227,
    "text": "heros, virgo, puer, senex, anulla,"
  },
  {
    "id": "p-6165bf",
    "offset": 5263,
    "text": "vestrum psallite rite Fructuosum."
  },
  {
    "id": "p-207527",
    "offset": 5298,
    "text": "laudans Augurium resultet hymnus"
  },
  {
    "id": "p-f538ae",
    "offset": 5332,
    "text": "mixtis Eulogium modis coaequans;"
  },
  {
    "id": "p-772cf4",
    "offset": 5366,
    "text": "reddamus paribus pares camenas."
  },
  {
    "id": "p-09a215",
    "offset": 5399,
    "text": "hinc aurata sonent in arce tecta,"
  },
  {
    "id": "p-be4af0",
    "offset": 5434,
    "text": "blandum litoris extet inde murmur,"
  },
  {
    "id": "p-40879a",
    "offset": 5470,
    "text": "et carmen freta feriata pangant."
  },
  {
    "id": "p-5623d2",
    "offset": 5504,
    "text": "olim tempus erit ruente mundo,"
  },
  {
    "id": "p-531d7d",
    "offset": 5536,
    "text": "cum te, Tarraco, Fructuosus acri"
  },
  {
    "id": "p-cec753",
    "offset": 5570,
    "text": "solvet supplicio tegens ab igni."
  },
  {
    "id": "p-3bc571",
    "offset": 5604,
    "text": "fors dignabitur et meis medellam"
  },
  {
    "id": "p-6acb70",
    "offset": 5638,
    "text": "tormentis dare prosperante Christo,"
  },
  {
    "id": "p-21fe10",
    "offset": 5675,
    "text": "dulces hendecasyllabos revolvens."
  }
]