[
  {
    "id": "p-de1c41",
    "offset": 0,
    "text": "7. Hymnus in honorem Quirini Martyris, Episcopi Ecclesiae Siscianae.\nInsignem meriti virum"
  },
  {
    "id": "p-fbb35b",
    "offset": 92,
    "text": "Quirinum, placitum Deo,"
  },
  {
    "id": "p-dcf8b2",
    "offset": 117,
    "text": "urbis moenia Sisciae"
  },
  {
    "id": "p-a00be8",
    "offset": 139,
    "text": "concessum sibi martyrem"
  },
  {
    "id": "p-6859b8",
    "offset": 164,
    "text": "conplexu patrio fovent."
  },
  {
    "id": "p-e2200a",
    "offset": 189,
    "text": "hic sub Galerio duce,"
  },
  {
    "id": "p-54f629",
    "offset": 212,
    "text": "qui tunc Illyricos sinus"
  },
  {
    "id": "p-48cf8f",
    "offset": 238,
    "text": "urgebat dicionibus,"
  },
  {
    "id": "p-022378",
    "offset": 259,
    "text": "fertur catholicam fidem"
  },
  {
    "id": "p-e51b42",
    "offset": 284,
    "text": "inlustrasse per exitum."
  },
  {
    "id": "p-50eb48",
    "offset": 309,
    "text": "non illum gladii rigor,"
  },
  {
    "id": "p-2a3fce",
    "offset": 334,
    "text": "non incendia, non ferae"
  },
  {
    "id": "p-5ef044",
    "offset": 359,
    "text": "crudeli interitu necant,"
  },
  {
    "id": "p-9076fc",
    "offset": 385,
    "text": "sed lymphis fluvialibus"
  },
  {
    "id": "p-cfb009",
    "offset": 410,
    "text": "gurges, dum rapit, abluit."
  },
  {
    "id": "p-0b42b3",
    "offset": 438,
    "text": "nil refert vitreo aequore"
  },
  {
    "id": "p-7da203",
    "offset": 465,
    "text": "an de flumine sanguinis"
  },
  {
    "id": "p-e652f0",
    "offset": 490,
    "text": "tinguat passio martyrem;"
  },
  {
    "id": "p-f1077b",
    "offset": 516,
    "text": "aeque gloria provenit"
  },
  {
    "id": "p-783879",
    "offset": 539,
    "text": "fluctu quolibet uvida."
  },
  {
    "id": "p-e1288d",
    "offset": 563,
    "text": "summo pontis ab ardui"
  },
  {
    "id": "p-3aa7af",
    "offset": 586,
    "text": "sanctae plebis episcopus"
  },
  {
    "id": "p-a1a048",
    "offset": 612,
    "text": "in praeceps fluvio datur"
  },
  {
    "id": "p-fa23a3",
    "offset": 638,
    "text": "suspensum laqueo gerens"
  },
  {
    "id": "p-dc51dc",
    "offset": 663,
    "text": "ingentis lapidem molae."
  },
  {
    "id": "p-0c31d9",
    "offset": 688,
    "text": "deiectum placidissimo"
  },
  {
    "id": "p-43afe0",
    "offset": 711,
    "text": "amnis vertice suscipit"
  },
  {
    "id": "p-2cbbc6",
    "offset": 735,
    "text": "nec mergi patitur sibi,"
  },
  {
    "id": "p-d574b0",
    "offset": 760,
    "text": "miris vasta natatibus"
  },
  {
    "id": "p-91d9ba",
    "offset": 783,
    "text": "saxi pondera sustinens."
  },
  {
    "id": "p-45415d",
    "offset": 808,
    "text": "spectant eminus e solo"
  },
  {
    "id": "p-838d58",
    "offset": 832,
    "text": "doctorem pavidi greges;"
  },
  {
    "id": "p-4a6842",
    "offset": 857,
    "text": "nam Christi populus frequens"
  },
  {
    "id": "p-cfd56b",
    "offset": 887,
    "text": "riparum sinuamina"
  },
  {
    "id": "p-986fe3",
    "offset": 906,
    "text": "stipato agmine saepserat."
  },
  {
    "id": "p-1e925d",
    "offset": 933,
    "text": "sed Quirinus, ut eminens"
  },
  {
    "id": "p-77a0c0",
    "offset": 959,
    "text": "os circumtulit, heu, suos"
  },
  {
    "id": "p-c14263",
    "offset": 986,
    "text": "exemplo trepidos videt,"
  },
  {
    "id": "p-cb3bd4",
    "offset": 1011,
    "text": "nil ipse proprii memor"
  },
  {
    "id": "p-64cefc",
    "offset": 1035,
    "text": "inter stagna periculi."
  },
  {
    "id": "p-70ce65",
    "offset": 1059,
    "text": "confirmat pia pectora,"
  },
  {
    "id": "p-85767e",
    "offset": 1083,
    "text": "verbis mitificis rogans"
  },
  {
    "id": "p-b0a07e",
    "offset": 1108,
    "text": "ne quem talia terreant,"
  },
  {
    "id": "p-c87497",
    "offset": 1133,
    "text": "neu constans titubet fides"
  },
  {
    "id": "p-ed97b7",
    "offset": 1161,
    "text": "aut poenam putet emori."
  },
  {
    "id": "p-4f2988",
    "offset": 1186,
    "text": "dicentem Agitantibus"
  },
  {
    "id": "p-358849",
    "offset": 1208,
    "text": "amnis terga vehunt vadis,"
  },
  {
    "id": "p-f75ba9",
    "offset": 1235,
    "text": "nec substrata profunditas"
  },
  {
    "id": "p-40864a",
    "offset": 1262,
    "text": "saxoque et laqueo et viro"
  },
  {
    "id": "p-378b12",
    "offset": 1289,
    "text": "audet sponte dehiscere."
  },
  {
    "id": "p-e8497b",
    "offset": 1314,
    "text": "sensit martyr episcopus"
  },
  {
    "id": "p-9b5861",
    "offset": 1339,
    "text": "iam partam sibi praeripi"
  },
  {
    "id": "p-434a42",
    "offset": 1365,
    "text": "palmam mortis et exitus,"
  },
  {
    "id": "p-4b7d59",
    "offset": 1391,
    "text": "ascensumque negarier"
  },
  {
    "id": "p-eaf67e",
    "offset": 1413,
    "text": "aeterni ad solium Patris."
  },
  {
    "id": "p-242623",
    "offset": 1440,
    "text": "Iesu cunctipotens, ait,"
  },
  {
    "id": "p-914df1",
    "offset": 1465,
    "text": "‘haudquaquam tibi gloria"
  },
  {
    "id": "p-3b8b50",
    "offset": 1491,
    "text": "haec est insolita aut nova,"
  },
  {
    "id": "p-862afe",
    "offset": 1520,
    "text": "calcare fremitum maris"
  },
  {
    "id": "p-e2a812",
    "offset": 1544,
    "text": "prona et flumina sistere."
  },
  {
    "id": "p-d80839",
    "offset": 1571,
    "text": "scimus discipulum Petrum,"
  },
  {
    "id": "p-1988a0",
    "offset": 1598,
    "text": "cum vestigia tingueret"
  },
  {
    "id": "p-cfcd7b",
    "offset": 1622,
    "text": "mortali trepidus pede,"
  },
  {
    "id": "p-3d5632",
    "offset": 1646,
    "text": "dextrae subsidio tuae"
  },
  {
    "id": "p-52ef2d",
    "offset": 1669,
    "text": "subiecisse salum solo."
  },
  {
    "id": "p-00f741",
    "offset": 1693,
    "text": "Iordanem quoque novimus"
  },
  {
    "id": "p-bfed36",
    "offset": 1718,
    "text": "tortis verticibus vagum,"
  },
  {
    "id": "p-bac7b9",
    "offset": 1744,
    "text": "dum fertur rapido impetu,"
  },
  {
    "id": "p-a46217",
    "offset": 1771,
    "text": "ad fontem refluis retro"
  },
  {
    "id": "p-5629b5",
    "offset": 1796,
    "text": "confugisse meatibus."
  },
  {
    "id": "p-2e6cc6",
    "offset": 1818,
    "text": "haec miracula sunt tuae"
  },
  {
    "id": "p-71908e",
    "offset": 1843,
    "text": "virtutis, Domine, ut modo"
  },
  {
    "id": "p-761f0c",
    "offset": 1870,
    "text": "suspendar leve praenatans"
  },
  {
    "id": "p-a97398",
    "offset": 1897,
    "text": "summo gurgite fluminis,"
  },
  {
    "id": "p-a3ada9",
    "offset": 1922,
    "text": "cum collo scopulum traham."
  },
  {
    "id": "p-6a4b8e",
    "offset": 1950,
    "text": "iam plenus titulus tui est"
  },
  {
    "id": "p-f0e663",
    "offset": 1978,
    "text": "et vis prodita nominis,"
  },
  {
    "id": "p-7d0269",
    "offset": 2003,
    "text": "quam gentilis hebet stupor:"
  },
  {
    "id": "p-d8d998",
    "offset": 2032,
    "text": "absolvas, precor, optime,"
  },
  {
    "id": "p-6e3fd2",
    "offset": 2059,
    "text": "huius nunc animae moras."
  },
  {
    "id": "p-c9d281",
    "offset": 2085,
    "text": "quid possis probat amnicus,"
  },
  {
    "id": "p-d2ee9f",
    "offset": 2114,
    "text": "qui vectat silicem, liquor,"
  },
  {
    "id": "p-0e6026",
    "offset": 2143,
    "text": "hoc iam quod superest cedo,"
  },
  {
    "id": "p-422842",
    "offset": 2172,
    "text": "quo nil est pretiosius"
  },
  {
    "id": "p-be780e",
    "offset": 2196,
    "text": "pro te, Christe Deus, mori.’"
  },
  {
    "id": "p-a3b010",
    "offset": 2226,
    "text": "orantem simul halitus"
  },
  {
    "id": "p-f01401",
    "offset": 2249,
    "text": "et vox deserit et calor;"
  },
  {
    "id": "p-dfa692",
    "offset": 2275,
    "text": "scandit spiritus ardua,"
  },
  {
    "id": "p-1dd92f",
    "offset": 2300,
    "text": "fit pondus grave saxeum,"
  },
  {
    "id": "p-d80161",
    "offset": 2326,
    "text": "corpus suscipiunt aquae."
  }
]