[
  {
    "id": "p-e21b0e",
    "offset": 0,
    "text": "**Tats_13**"
  },
  {
    "id": "p-c73125",
    "offset": 13,
    "text": "aṣṭāviṃśatidhāśaktiḥ ||"
  },
  {
    "id": "p-3a6438",
    "offset": 38,
    "text": "**Tats_13.c1**"
  },
  {
    "id": "p-fd28e2",
    "offset": 54,
    "text": "jaḍatvakuṣṭikubjatvarūpatāghrāṇatvamūkatvasupaṅgutāśca / kuṇirgudāvartti ca ṣaṇḍhatā ca unmāda ityeṣa nirūpito 'yam //"
  },
  {
    "id": "p-481bcd",
    "offset": 174,
    "text": "**Tats_13.c2**"
  },
  {
    "id": "p-7acc7b",
    "offset": 190,
    "text": "ekādaśendriyavadho bādhiryādisvarūpataḥ / buddhervadhaḥ saptadaśa tuṣṭisiddhiviparyayaḥ //"
  },
  {
    "id": "p-e13f68",
    "offset": 282,
    "text": "**Tats_13.c3**"
  },
  {
    "id": "p-25cb43",
    "offset": 298,
    "text": "nāsti pradhānamiti yā pratipattirajambhikā / na mahānityasalilā nāyācchā cānahaṃkṛtau //"
  },
  {
    "id": "p-5d8df1",
    "offset": 388,
    "text": "**Tats_13.c4**"
  },
  {
    "id": "p-c7cc71",
    "offset": 404,
    "text": "na vā 'styadṛṣṭistanmātrapañcakaṃ bhūtakāraṇam / sarvamevedaṃ brahmeti brahmaiva san brahmāpyeti / yathā vedāntināṃ tadvat sāṃkhyānāmīdṛśī matiḥ //"
  },
  {
    "id": "p-05feba",
    "offset": 553,
    "text": "**Tats_13.c5**"
  },
  {
    "id": "p-21b179",
    "offset": 569,
    "text": "asutā viṣayārjane pravṛttiḥ sutarā parirakṣaṇe pravṛttiḥ / krayadoṣamapaśyato dhane pravṛttiḥ asunetrā parikīrttyate hi sāṃkhyaiḥ //"
  },
  {
    "id": "p-233fa7",
    "offset": 703,
    "text": "**Tats_13.c6**"
  },
  {
    "id": "p-962029",
    "offset": 719,
    "text": "akurmarīcikābhogaśaktirhiṃsādyapaśyataḥ / anuttambhāmbhasikā doṣabhogādambhaḥ pravarttanam //"
  },
  {
    "id": "p-2d01c3",
    "offset": 814,
    "text": "**Tats_13.c7**"
  },
  {
    "id": "p-8c9926",
    "offset": 830,
    "text": "navadhā kathitā hyete tatra tuṣṭirviparyayāḥ / kathyante siddhayo hyaṣṭau te 'mī siddhiviparyayāḥ //"
  },
  {
    "id": "p-da1ed6",
    "offset": 932,
    "text": "**Tats_13.c8**"
  },
  {
    "id": "p-249618",
    "offset": 948,
    "text": "nānātvamūhamānasya siddhamekamatārakam / viparītagrahaḥ śabdaśravaṇādasutārakam //"
  },
  {
    "id": "p-f3f493",
    "offset": 1032,
    "text": "**Tats_13.c9**"
  },
  {
    "id": "p-0a9b5c",
    "offset": 1048,
    "text": "nānātvajño mukta iti śrutvaikajño na muktibhāk / atārayantamajñānāsadacchāstraniveśataḥ / duḥkhitasyāpyanudvegādapramodā hi saṃsṛtau //"
  },
  {
    "id": "p-b28a9c",
    "offset": 1185,
    "text": "**Tats_13.c10**"
  },
  {
    "id": "p-efc96c",
    "offset": 1202,
    "text": "apramudaṃ tadajñānapramuditamapramodamānaṃ vā / asamyagvacanādapyuparodhena vā gurau //"
  },
  {
    "id": "p-0a19d4",
    "offset": 1291,
    "text": "**Tats_13.c11**"
  },
  {
    "id": "p-aa313d",
    "offset": 1308,
    "text": "abhāgyasya na siddhiḥ syāt jñāne tat samudīritam / snigdhasaṃsargato jñānottarājñānamaramyakam //"
  },
  {
    "id": "p-d98da6",
    "offset": 1407,
    "text": "**Tats_13.c12**"
  },
  {
    "id": "p-e7aac3",
    "offset": 1424,
    "text": "vyākhyātāḥ pūrvarītyāṣṭāvete siddhiviparyayāḥ / aṣṭāviṃśatidhā 'śaktirvyākhyātobhayayogataḥ //"
  }
]