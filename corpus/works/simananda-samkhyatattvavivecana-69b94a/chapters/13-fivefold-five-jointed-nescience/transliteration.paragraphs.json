[
  {
    "id": "p-48f773",
    "offset": 0,
    "text": "**Tats_12**"
  },
  {
    "id": "p-eedec0",
    "offset": 13,
    "text": "pañcaparvāvidyā ||"
  },
  {
    "id": "p-1aa98a",
    "offset": 33,
    "text": "**Tats_12.c1**"
  },
  {
    "id": "p-d46094",
    "offset": 49,
    "text": "tamo moho mahāmohastāmisraścāndhatāmisraḥ //"
  },
  {
    "id": "p-fd689d",
    "offset": 95,
    "text": "**Tats_12.c2**"
  },
  {
    "id": "p-ea2019",
    "offset": 111,
    "text": "aṣṭakau tau tamau mohau prakṛtyaṣṭakaniṣṭhitau / ātmajñānābhimānyeyaṃ prāptyādyaiśvaryamānitā //"
  },
  {
    "id": "p-54f7d4",
    "offset": 209,
    "text": "**Tats_12.c3**"
  },
  {
    "id": "p-76ec6b",
    "offset": 225,
    "text": "nirvṛtte viṣaye dṛṣṭe pañcānuśravike tathā / moho 'hamabhimāno yo mahāmoho daśātmakaḥ //"
  },
  {
    "id": "p-d8a94c",
    "offset": 315,
    "text": "**Tats_12.c4**"
  },
  {
    "id": "p-9a62f5",
    "offset": 331,
    "text": "aṣṭaiśvarye daśaviṣaye siddhatāmisra ucyate / viṣādaḥ so 'ndhatāmisro maraṇe pratipadyate //"
  },
  {
    "id": "p-3f85b0",
    "offset": 425,
    "text": "**Tats_12.c5**"
  },
  {
    "id": "p-7a7a0c",
    "offset": 441,
    "text": "avidyā pañcaparvaiṣā bhinnā dvāṣaṣṭibhedataḥ /"
  }
]