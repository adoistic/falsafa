[
  {
    "id": "p-46dac4",
    "offset": 0,
    "text": "**Tats_15**"
  },
  {
    "id": "p-03801a",
    "offset": 13,
    "text": "aṣṭadhā siddhiḥ ||"
  },
  {
    "id": "p-ec99ba",
    "offset": 33,
    "text": "**Tats_15.c1**"
  },
  {
    "id": "p-a0585b",
    "offset": 49,
    "text": "jñānaṃ yaddūramutpannaṃ tārākhyā prathamā hi sā / śabdamātreṇa bhūteṣu sutārā jñānamiṣyate //"
  },
  {
    "id": "p-3d75cc",
    "offset": 144,
    "text": "**Tats_15.c2**"
  },
  {
    "id": "p-d395eb",
    "offset": 160,
    "text": "jñānamadhyayanenaiva tārayantī tṛtīyakā / adhyātmaduḥkhāpanayāt pramodetyabhidhīyate //"
  },
  {
    "id": "p-a72365",
    "offset": 249,
    "text": "**Tats_15.c3**"
  },
  {
    "id": "p-ece462",
    "offset": 265,
    "text": "bhautikakleśaharaṇāt pramudā siddhirucyate / ādhidaivakleśaharaṇāt jñānamutpadyate nṛṇām //"
  },
  {
    "id": "p-2803a8",
    "offset": 358,
    "text": "**Tats_15.c4**"
  },
  {
    "id": "p-cee5d6",
    "offset": 374,
    "text": "pramodamānetyākhyātā ṣaṣṭhī siddhiḥ svayaṃ satām / snigdhasaṃsarganāśāttu ramyakā saptamī smṛtā //"
  },
  {
    "id": "p-41267a",
    "offset": 474,
    "text": "**Tats_15.c5**"
  },
  {
    "id": "p-c9bdb4",
    "offset": 490,
    "text": "pramudā cāṣṭamī siddhiḥ paricaryādinā guroḥ / ityetāḥ siddhayo hyaṣṭau vyākhyātāḥ jñānasādhikāḥ //"
  }
]