    "text": "saṃcaraḥ ||"
  },
  {
    "id": "p-be5dd4",
    "offset": 25,
    "text": "**Tats_5.c1**"
  },
  {
    "id": "p-d5557a",
    "offset": 40,
    "text": "sāmyāvasthā guṇānāṃ yā prakṛtiḥ sā svabhāvataḥ / kālakṣobheṇa vaiṣamyāt kṣetre parayute purā //"
  },
  {
    "id": "p-d14442",
    "offset": 137,
    "text": "**Tats_5.c2**"
  },
  {
    "id": "p-3c2e07",
    "offset": 152,
    "text": "buddhistataścāhaṅkārastrividho 'pi vyajāyata / tanmātrāṇīndriyāṇi mahābhūtāni ca kramāt //"
  },
  {
    "id": "p-b76e85",
    "offset": 244,
    "text": "**Tats_5.c3**"
  },
  {
    "id": "p-683488",
    "offset": 259,
    "text": "evaṃ krameṇaivotpattiḥ sañcaraḥ parikīrttitaḥ /"
  }
]