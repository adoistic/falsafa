[
  {
    "id": "p-b789af",
    "offset": 0,
    "text": "**Tats_22**"
  },
  {
    "id": "p-f33557",
    "offset": 13,
    "text": "trividhaṃ duḥkham ||"
  },
  {
    "id": "p-9fc9ce",
    "offset": 35,
    "text": "**Tats_22.c1**"
  },
  {
    "id": "p-4365cd",
    "offset": 51,
    "text": "duḥkhaṃ tu trividhaṃ proktamadhyātmamadhibhūtakam / ādhidaivaṃ ca tatrāpi prathamaṃ dvividhaṃ smṛtam //"
  },
  {
    "id": "p-bd0abb",
    "offset": 156,
    "text": "**Tats_22.c2**"
  },
  {
    "id": "p-eb8db7",
    "offset": 172,
    "text": "śārīraṃ mānasaṃ ceti vātakāmādidoṣajam / bhūtebhyo mānuṣādibhyo jātaṃ syādādhibhautikam //"
  },
  {
    "id": "p-458ed9",
    "offset": 264,
    "text": "**Tats_22.c3**"
  },
  {
    "id": "p-e48f1f",
    "offset": 280,
    "text": "devebhyaḥ śītavātādibhavaṃ syādādhidaivikam / etat samāsataḥ proktā sūtravyākhyā yathāmati //"
  },
  {
    "id": "p-5aa8aa",
    "offset": 375,
    "text": "**Tats_22.c4**"
  },
  {
    "id": "p-1d9435",
    "offset": 391,
    "text": "prakriyāṃ ca pravakṣyāmi paurāṇikahitāya vai //"
  }
]