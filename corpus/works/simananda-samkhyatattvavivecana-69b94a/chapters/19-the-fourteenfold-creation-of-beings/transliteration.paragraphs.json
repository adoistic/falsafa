[
  {
    "id": "p-6a047d",
    "offset": 0,
    "text": "**Tats_18**"
  },
  {
    "id": "p-69aeb3",
    "offset": 13,
    "text": "caturdaśavidho bhūtasargaḥ ||"
  },
  {
    "id": "p-f21a41",
    "offset": 44,
    "text": "**Tats_18.c1**"
  },
  {
    "id": "p-d1cc40",
    "offset": 60,
    "text": "aṣṭavikalpaṃ daivaṃ paiśācaṃ rākṣasaṃ tadvat / gāndharvamaindraṃ brāhmaṃ ca saumyaṃ brāhmyamathāṣṭakam //"
  },
  {
    "id": "p-913e15",
    "offset": 167,
    "text": "**Tats_18.c2**"
  },
  {
    "id": "p-a690b9",
    "offset": 183,
    "text": "devayonaya evaite tiryagyonistu pañcadhā / mṛgapaśupakṣisarīsṛpasthāvaramiti bhedasambhinā //"
  },
  {
    "id": "p-781b44",
    "offset": 278,
    "text": "**Tats_18.c3**"
  },
  {
    "id": "p-c95162",
    "offset": 294,
    "text": "mānuṣyakaṃ caikavidhaṃ brāhmaṇādicāṇḍālāntam / paśavo gavādimūṣāntāḥ pakṣiṇo garūḍādikāḥ //"
  },
  {
    "id": "p-373b65",
    "offset": 387,
    "text": "**Tats_18.c4**"
  },
  {
    "id": "p-5a5f31",
    "offset": 403,
    "text": "maśakāntā mṛgāścāpi siṃhādi ca śivāntikāḥ / śeṣādi alagardāntāḥ sarpāḥ parvatabhūtṛṇāḥ //"
  },
  {
    "id": "p-8d8d67",
    "offset": 494,
    "text": "**Tats_18.c5**"
  },
  {
    "id": "p-5368b5",
    "offset": 510,
    "text": "sthāvarā bhautikaḥ sarga etatsaṃsāramaṇḍalam //"
  }
]