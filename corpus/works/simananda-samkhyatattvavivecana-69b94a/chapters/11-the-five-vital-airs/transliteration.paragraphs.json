    "text": "pañca vāyavaḥ ||"
  },
  {
    "id": "p-7b2f94",
    "offset": 31,
    "text": "**Tats_10.c1**"
  },
  {
    "id": "p-0c1e45",
    "offset": 47,
    "text": "prāṇo 'pānaḥ samānaśca udāno vyāna eva ca / ityete vāyavaḥ pañca śarīreṣu śarīriṇām //"
  },
  {
    "id": "p-1aa31b",
    "offset": 135,
    "text": "**Tats_10.c2**"
  },
  {
    "id": "p-0255b0",
    "offset": 151,
    "text": "mukhanāsādhicārī yaḥ prāṇanāt prāṇa ucyate / nābheradhicaratyevopānaye 'pāna iṣyate //"
  },
  {
    "id": "p-821ee3",
    "offset": 239,
    "text": "**Tats_10.c3**"
  },
  {
    "id": "p-d31576",
    "offset": 255,
    "text": "hṛdyadhiṣṭhānanayanāt samāna iti kīrtitaḥ / kaṇṭhādūrdhvāvagamanādudāna iti ca smṛtaḥ //"
  },
  {
    "id": "p-4001d0",
    "offset": 345,
    "text": "**Tats_10.c4**"
  },
  {
    "id": "p-86c396",
    "offset": 361,
    "text": "sandhyadhiṣṭhānato vyāno vikṣepaṇavijṛmbhaṇāt /"
  }
