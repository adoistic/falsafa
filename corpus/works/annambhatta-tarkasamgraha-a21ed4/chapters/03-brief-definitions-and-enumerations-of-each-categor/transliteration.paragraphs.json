[
  {
    "id": "p-385691",
    "offset": 0,
    "text": "**AnTs_3**"
  },
  {
    "id": "p-c97afc",
    "offset": 12,
    "text": "tatra dravyāṇi pṛthivyaptejovāyvākāśakāladigātmamanāṃsi navaiva //"
  },
  {
    "id": "p-c29e58",
    "offset": 80,
    "text": "**AnTs_4**"
  },
  {
    "id": "p-e7dad5",
    "offset": 92,
    "text": "rūparasagandhasparśasaṃkhyāparimāṇapṛthaktvasaṃyogavibhāgaparatvāparatvagurutvadravatvasnehaśabdabuddhisukhaduḥkhecchādveṣaprayatnadharmādharmasaṃskārāś caturviṃśati guṇāḥ //"
  },
  {
    "id": "p-997b6d",
    "offset": 268,
    "text": "**AnTs_5**"
  },
  {
    "id": "p-eecf46",
    "offset": 280,
    "text": "utkṣepaṇāvakṣepaṇākuñcanaprasāraṇagamanāni pañca karmāṇi //"
  },
  {
    "id": "p-7d2803",
    "offset": 341,
    "text": "**AnTs_6**"
  },
  {
    "id": "p-22f17e",
    "offset": 353,
    "text": "param aparaṃ ceti dvividhaṃ sāmānyam //"
  },
  {
    "id": "p-137a6b",
    "offset": 394,
    "text": "**AnTs_7**"
  },
  {
    "id": "p-2e41d8",
    "offset": 406,
    "text": "nityadravyavṛttayo viśeṣās tv anantā eva //"
  },
  {
    "id": "p-fe398a",
    "offset": 451,
    "text": "**AnTs_8**"
  },
  {
    "id": "p-670a87",
    "offset": 463,
    "text": "samavāyas tv eka eva //"
  },
  {
    "id": "p-e5b489",
    "offset": 488,
    "text": "**AnTs_9**"
  },
  {
    "id": "p-f9c676",
    "offset": 500,
    "text": "abhāvaś caturvidhaḥ / prāgabhāvaḥ pradhvaṃsābhāvo 'tyantābhāvo 'nyonyābhāvaś ceti //"
  }
]