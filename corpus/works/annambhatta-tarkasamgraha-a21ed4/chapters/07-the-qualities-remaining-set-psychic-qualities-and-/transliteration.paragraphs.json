[
  {
    "id": "p-a7f793",
    "offset": 0,
    "text": "**AnTs_66**"
  },
  {
    "id": "p-97e3e5",
    "offset": 13,
    "text": "sarveśām anukūlatayā vedanīyaṃ sukham //"
  },
  {
    "id": "p-7ed4a8",
    "offset": 55,
    "text": "**AnTs_67**"
  },
  {
    "id": "p-ccb5b5",
    "offset": 68,
    "text": "sarveśāṃ pratikūlatayā vedanīyaṃ duḥkham //"
  },
  {
    "id": "p-3df4c9",
    "offset": 113,
    "text": "**AnTs_68**"
  },
  {
    "id": "p-8a71a2",
    "offset": 126,
    "text": "icchā kāmaḥ //"
  },
  {
    "id": "p-046e8c",
    "offset": 142,
    "text": "**AnTs_69**"
  },
  {
    "id": "p-b5369d",
    "offset": 155,
    "text": "krodho dveṣaḥ //"
  },
  {
    "id": "p-76149a",
    "offset": 173,
    "text": "**AnTs_70**"
  },
  {
    "id": "p-61abc8",
    "offset": 186,
    "text": "kṛtiḥ prayatnaḥ //"
  },
  {
    "id": "p-5e994f",
    "offset": 206,
    "text": "**AnTs_71**"
  },
  {
    "id": "p-c89cdc",
    "offset": 219,
    "text": "vihitakarmajanyo dharmaḥ //"
  },
  {
    "id": "p-af7561",
    "offset": 248,
    "text": "**AnTs_72**"
  },
  {
    "id": "p-321e9d",
    "offset": 261,
    "text": "niṣiddhakarmajanyas tv adharmaḥ //"
  },
  {
    "id": "p-d884c4",
    "offset": 297,
    "text": "**AnTs_73**"
  },
  {
    "id": "p-cbbc1b",
    "offset": 310,
    "text": "buddhyādayo'ṣṭāv ātmamātraviśeṣaguṇāḥ //"
  },
  {
    "id": "p-1aa1d8",
    "offset": 352,
    "text": "**AnTs_74**"
  },
  {
    "id": "p-ceb8fd",
    "offset": 365,
    "text": "buddhīcchāprayatnā dvividhāḥ / nityā anityāś ca / nityā īśvarasya / anityā jīvasya //"
  },
  {
    "id": "p-b3260f",
    "offset": 452,
    "text": "**AnTs_75**"
  },
  {
    "id": "p-b3999c",
    "offset": 465,
    "text": "saṃskāras trividhaḥ / vego bhāvanā sthitisthāpakaś ceti / vegaḥ pṛthivyādicatuṣṭayamanovṛttiḥ / anubhavajanyā smṛtihetur bhāvanātmamātravṛttiḥ / anyathā kṛtasya punas tadavasthāpādakaḥ sthitisthāpakaḥ kaṭādipṛthivīvṛttiḥ //"
  }
]