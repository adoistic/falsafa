[
  {
    "id": "p-6b79a4",
    "offset": 0,
    "text": "μᾶτερ Ἁλίου πολυώνυμε Θεία,"
  },
  {
    "id": "p-98a5e3",
    "offset": 29,
    "text": "σέο ἕκατι καὶ μεγασθενῆ νόμισαν"
  },
  {
    "id": "p-368b0a",
    "offset": 62,
    "text": "χρυσὸν ἄνθρωποι περιώσιον ἄλλων·"
  },
  {
    "id": "p-bdca39",
    "offset": 96,
    "text": "καὶ γὰρ ἐριζόμεναι"
  },
  {
    "id": "p-0370d4",
    "offset": 116,
    "text": "νᾶες ἐν πόντῳ καὶ ὑφʼ ἅρμασιν ἵπποι"
  },
  {
    "id": "p-bfe8d8",
    "offset": 153,
    "text": "διὰ τεάν, ὤνασσα, τιμὰν ὠκυδινάτοις ἐν ἁμίλλαισι θαυμασταὶ πέλονται·"
  },
  {
    "id": "p-f2d4ea",
    "offset": 223,
    "text": "ἔν τʼ ἀγωνίοις ἀέθλοισι ποθεινὸν"
  },
  {
    "id": "p-79b138",
    "offset": 257,
    "text": "κλέος ἔπραξεν, ὅντινʼ ἀθρόοι στέφανοι"
  },
  {
    "id": "p-042e57",
    "offset": 296,
    "text": "χερσὶ νικάσαντʼ ἀνέδησαν ἔθειραν"
  },
  {
    "id": "p-654112",
    "offset": 330,
    "text": "ἢ ταχυτᾶτι ποδῶν."
  },
  {
    "id": "p-b9928c",
    "offset": 349,
    "text": "κρίνεται δʼ ἀλκὰ διὰ δαίμονας ἀνδρῶν."
  },
  {
    "id": "p-dad43b",
    "offset": 388,
    "text": "δύο δέ τοι ζωᾶς ἄωτον μοῦνα ποιμαίνοντι τὸν ἄλπνιστον εὐανθεῖ σὺν ὄλβῳ,"
  },
  {
    "id": "p-cca872",
    "offset": 461,
    "text": "εἴ τις εὖ πάσχων λόγον ἐσλὸν ἀκούῃ."
  },
  {
    "id": "p-6dc908",
    "offset": 498,
    "text": "μὴ μάτευε Ζεὺς γενέσθαι· πάντʼ ἔχεις,"
  },
  {
    "id": "p-65c123",
    "offset": 537,
    "text": "εἴ σε τούτων μοῖρʼ ἐφίκοιτο καλῶν."
  },
  {
    "id": "p-dd6f65",
    "offset": 573,
    "text": "θνατὰ θνατοῖσι πρέπει."
  },
  {
    "id": "p-fea5c9",
    "offset": 597,
    "text": "τὶν δʼ ἐν Ἰσθμῷ διπλόα θάλλοισʼ ἀρετά,"
  },
  {
    "id": "p-12a912",
    "offset": 637,
    "text": "Φυλακίδα, κεῖται, Νεμέα δὲ καὶ ἀμφοῖν,"
  },
  {
    "id": "p-fd2d1c",
    "offset": 677,
    "text": "Πυθέᾳ τε παγκρατίου. τὸ δʼ ἐμὸν"
  },
  {
    "id": "p-2f833f",
    "offset": 710,
    "text": "οὐκ ἄτερ Αἰακιδᾶν κέαρ ὕμνων γεύεται·"
  },
  {
    "id": "p-ce829b",
    "offset": 749,
    "text": "σὺν Χάρισιν δʼ ἔμολον Λάμπωνος υἱοῖς"
  },
  {
    "id": "p-adf5e1",
    "offset": 787,
    "text": "τάνδʼ ἐς εὔνομον πόλιν. εἰ δὲ τέτραπται"
  },
  {
    "id": "p-930e2c",
    "offset": 828,
    "text": "θεοδότων ἔργων κέλευθον ἂν καθαράν,"
  },
  {
    "id": "p-b439e3",
    "offset": 865,
    "text": "μὴ φθόνει κόμπον τὸν ἐοικότʼ ἀοιδᾷ"
  },
  {
    "id": "p-1c3d95",
    "offset": 901,
    "text": "κιρνάμεν ἀντὶ πόνων."
  },
  {
    "id": "p-548961",
    "offset": 923,
    "text": "καὶ γὰρ ἡρώων ἀγαθοὶ πολεμισταὶ"
  },
  {
    "id": "p-407890",
    "offset": 956,
    "text": "λόγον ἐκέρδαναν, κλέονται δʼ ἔν τε φορμίγγεσσιν ἐν αὐλῶν τε παμφώνοις ὁμοκλαῖς"
  },
  {
    "id": "p-1f0696",
    "offset": 1036,
    "text": "μυρίον χρόνον· μελέταν δὲ σοφισταῖς"
  },
  {
    "id": "p-6d30ab",
    "offset": 1073,
    "text": "Διὸς ἕκατι πρόσβαλον σεβιζόμενοι·"
  },
  {
    "id": "p-5829d4",
    "offset": 1108,
    "text": "ἐν μὲν Αἰτωλῶν θυσίαισι φαενναῖς"
  },
  {
    "id": "p-6c547b",
    "offset": 1142,
    "text": "Οἰνεΐδαι κρατεροί,"
  },
  {
    "id": "p-cf7a7b",
    "offset": 1162,
    "text": "ἐν δὲ Θήβαις ἱπποσόας Ἰόλαος"
  },
  {
    "id": "p-5c1d75",
    "offset": 1192,
    "text": "γέρας ἔχει, Περσεὺς δʼ ἐν Ἄργει, Κάστορος δʼ αἰχμὰ Πολυδεύκ εο ς τʼ ἐπʼ Εὐρώτα ῥεέθροις."
  },
  {
    "id": "p-535dde",
    "offset": 1282,
    "text": "ἀλλʼ ἐν Οἰνώνᾳ μεγαλήτορες ὀργαὶ"
  },
  {
    "id": "p-6d0903",
    "offset": 1316,
    "text": "Αἰακοῦ παίδων τε· τοὶ καὶ σὺν μάχαις"
  },
  {
    "id": "p-bd3c58",
    "offset": 1354,
    "text": "δὶς πόλιν Τρώων πράθον ἑσπόμενοι"
  },
  {
    "id": "p-5e1e96",
    "offset": 1388,
    "text": "Ἡρακλῆϊ πρότερον,"
  },
  {
    "id": "p-48ab74",
    "offset": 1407,
    "text": "καὶ σὺν Ἀτρείδαις. ἔλα νῦν μοι πεδόθεν·"
  },
  {
    "id": "p-417417",
    "offset": 1448,
    "text": "λέγε, τίνες Κύκνον, τίνες Ἕκτορα πέφνον,"
  },
  {
    "id": "p-cb36c8",
    "offset": 1490,
    "text": "καὶ στράταρχον Αἰθιόπων ἄφοβον"
  },
  {
    "id": "p-ae434e",
    "offset": 1522,
    "text": "Μέμνονα χαλκοάραν· τίς ἄρʼ ἐσλὸν Τήλεφον"
  },
  {
    "id": "p-d0bbe8",
    "offset": 1564,
    "text": "τρῶσεν ἑῷ δορὶ Καΐκου παρʼ ὄχθαις;"
  },
  {
    "id": "p-bfc99a",
    "offset": 1600,
    "text": "τοῖσιν Αἴγιναν προφέρει στόμα πάτραν"
  },
  {
    "id": "p-f2b64d",
    "offset": 1638,
    "text": "διαπρεπέα νᾶσον· τετείχισται δὲ πάλαι"
  },
  {
    "id": "p-e8090b",
    "offset": 1677,
    "text": "πύργος ὑψηλαῖς ἀρεταῖς ἀναβαίνειν."
  },
  {
    "id": "p-57bcff",
    "offset": 1713,
    "text": "πολλὰ μὲν ἀρτιεπὴς"
  },
  {
    "id": "p-635f13",
    "offset": 1733,
    "text": "γλῶσσά μοι τοξεύματʼ ἔχει περὶ κείνων"
  },
  {
    "id": "p-02dd1f",
    "offset": 1772,
    "text": "κελαδέσαι· καὶ νῦν ἐν Ἄρει μαρτυρήσαι κεν πόλις Αἴαντος ὀρθωθεῖσα ναύταις"
  },
  {
    "id": "p-c0b86a",
    "offset": 1847,
    "text": "ἐν πολυφθόρῳ Σαλαμὶς Διὸς ὄμβρῳ"
  },
  {
    "id": "p-8b628c",
    "offset": 1880,
    "text": "ἀναρίθμων ἀνδρῶν χαλαζάεντι φόνῳ."
  },
  {
    "id": "p-84551f",
    "offset": 1915,
    "text": "ἀλλʼ ὅμως καύχημα κατάβρεχε σιγᾷ·"
  },
  {
    "id": "p-b72e92",
    "offset": 1950,
    "text": "Ζεὺς τά τε καὶ τὰ νέμει,"
  },
  {
    "id": "p-88890a",
    "offset": 1976,
    "text": "Ζεὺς ὁ πάντων κύριος. ἐν δʼ ἐρατεινῷ"
  },
  {
    "id": "p-134ab2",
    "offset": 2014,
    "text": "μέλιτι καὶ τοιαίδε τιμαὶ καλλίνικον χάρμʼ ἀγαπάζοντι. μαρνάσθω τις ἔρδων"
  },
  {
    "id": "p-d2ca06",
    "offset": 2088,
    "text": "ἀμφʼ ἀέθλοισιν γενεὰν Κλεονίκου"
  },
  {
    "id": "p-ddbb97",
    "offset": 2121,
    "text": "ἐκμαθών· οὔτοι τετύφλωται μακρὸς"
  },
  {
    "id": "p-1b7368",
    "offset": 2155,
    "text": "μόχθος ἀνδρῶν· οὐδʼ ὁπόσαι δαπάναι"
  },
  {
    "id": "p-677d49",
    "offset": 2191,
    "text": "ἐλπίδων ἔκνισʼ ὄπιν."
  },
  {
    "id": "p-56e03d",
    "offset": 2213,
    "text": "αἰνέω καὶ Πυθέαν ἐν γυιοδάμαις"
  },
  {
    "id": "p-dc644e",
    "offset": 2245,
    "text": "Φυλακίδᾳ πλαγᾶν δρόμον εὐθυπορῆσαι"
  },
  {
    "id": "p-d7799e",
    "offset": 2281,
    "text": "χερσὶ δεξιόν, νόῳ ἀντίπαλον."
  },
  {
    "id": "p-d54760",
    "offset": 2311,
    "text": "λάμβανέ οἱ στέφανον, φέρε δʼ εὔμαλλον μίτραν,"
  },
  {
    "id": "p-6e551b",
    "offset": 2358,
    "text": "καὶ πτερόεντα νέον σύμπεμψον ὕμνον."
  }
]