[
  {
    "id": "p-87c818",
    "offset": 0,
    "text": "τίνι τῶν πάρος, ὦ μάκαιρα Θήβα,"
  },
  {
    "id": "p-56cf53",
    "offset": 33,
    "text": "καλῶν ἐπιχωρίων μάλιστα θυμὸν τεὸν"
  },
  {
    "id": "p-eeb5a8",
    "offset": 69,
    "text": "εὔφρανας; ἦ ῥα χαλκοκρότου πάρεδρον"
  },
  {
    "id": "p-2d6f1a",
    "offset": 106,
    "text": "Δαμάτερος ἁνίκʼ εὐρυχαίταν"
  },
  {
    "id": "p-77d70a",
    "offset": 134,
    "text": "ἄντειλας Διόνυσον; ἢ χρυσῷ μεσονύκτιον νίφοντα δεξαμένα τὸν φέρτατον θεῶν,"
  },
  {
    "id": "p-dbce88",
    "offset": 210,
    "text": "ὁπότʼ Ἀμφιτρύωνος ἐν θυρέτροις"
  },
  {
    "id": "p-b7c8df",
    "offset": 242,
    "text": "σταθεὶς ἄλοχον μετῆλθεν Ἡρακλείοις γοναῖς;"
  },
  {
    "id": "p-861919",
    "offset": 286,
    "text": "ἢ ὅτʼ ἀμφὶ πυκναῖς Τειρεσίαο βουλαῖς;"
  },
  {
    "id": "p-b09cb4",
    "offset": 325,
    "text": "ἢ ὅτʼ ἀμφʼ Ἰόλαον ἱππόμητιν;"
  },
  {
    "id": "p-13cee5",
    "offset": 355,
    "text": "ἢ Σπαρτῶν ἀκαμαντολογχᾶν; ἢ ὅτε καρτερᾶς Ἄδραστον ἐξ ἀλαλᾶς ἄμπεμψας ὀρφανὸν"
  },
  {
    "id": "p-65349b",
    "offset": 433,
    "text": "μυρίων ἑτάρων ἐς Ἄργος ἵππιον;"
  },
  {
    "id": "p-103c29",
    "offset": 465,
    "text": "ἢ Δωρίδʼ ἀποικίαν οὕνεκεν ὀρθῷ"
  },
  {
    "id": "p-88c3a4",
    "offset": 497,
    "text": "ἔστασας ἐπὶ σφυρῷ"
  },
  {
    "id": "p-f83e76",
    "offset": 516,
    "text": "Λακεδαιμονίων, ἕλον δʼ Ἀμύκλας"
  },
  {
    "id": "p-f5c1e3",
    "offset": 548,
    "text": "Αἰγεῖδαι σέθεν ἔκγονοι, μαντεύμασι Πυθίοις;"
  },
  {
    "id": "p-b15204",
    "offset": 593,
    "text": "ἀλλὰ παλαιὰ γὰρ"
  },
  {
    "id": "p-2c556b",
    "offset": 610,
    "text": "εὕδει χάρις, ἀμνάμονες δὲ βροτοί,"
  },
  {
    "id": "p-6f73eb",
    "offset": 645,
    "text": "ὅ τι μὴ σοφίας ἄωτον ἄκρον"
  },
  {
    "id": "p-8bd0d9",
    "offset": 673,
    "text": "κλυταῖς ἐπέων ῥοαῖσιν ἐξίκηται ζυγέν."
  },
  {
    "id": "p-bbb6bd",
    "offset": 712,
    "text": "κώμαζʼ ἔπειτεν ἁδυμελεῖ σὺν ὕμνῳ"
  },
  {
    "id": "p-818d90",
    "offset": 746,
    "text": "καὶ Στρεψιάδᾳ· φέρει γὰρ Ἰσθμοῖ"
  },
  {
    "id": "p-2871f7",
    "offset": 779,
    "text": "νίκαν παγκρατίου· σθένει τʼ ἔκπαγλος ἰδεῖν τε μορφάεις· ἄγει τʼ ἀρετὰν οὐκ αἴσχιον φυᾶς."
  },
  {
    "id": "p-2a8032",
    "offset": 869,
    "text": "φλέγεται δὲ ἰοπλόκοισι Μοίσαις,"
  },
  {
    "id": "p-05364a",
    "offset": 902,
    "text": "μάτρωΐ θʼ ὁμωνύμῳ δέδωκε κοινὸν θάλος,"
  },
  {
    "id": "p-675def",
    "offset": 942,
    "text": "χάλκασπις ᾧ πότμον μὲν Ἄρης ἔμιξεν,"
  },
  {
    "id": "p-810ed1",
    "offset": 979,
    "text": "τιμὰ δʼ ἀγαθοῖσιν ἀντίκειται."
  },
  {
    "id": "p-a3bef4",
    "offset": 1010,
    "text": "ἴστω γὰρ σαφὲς ὅστις ἐν ταύτᾳ νεφέλᾳ χάλαζαν αἵματος πρὸ φίλας πάτρας ἀμύνεται,"
  },
  {
    "id": "p-ae7e97",
    "offset": 1091,
    "text": "λοιγὸν ἄντα φέρων ἐναντίῳ στρατῷ,"
  },
  {
    "id": "p-63d13d",
    "offset": 1126,
    "text": "ἀστῶν γενεᾷ μέγιστον κλέος αὔξων"
  },
  {
    "id": "p-f7e73e",
    "offset": 1160,
    "text": "ζώων τʼ ἀπὸ καὶ θανών."
  },
  {
    "id": "p-355bc8",
    "offset": 1184,
    "text": "τὺ δέ, Διοδότοιο παῖ, μαχατὰν"
  },
  {
    "id": "p-9ffca6",
    "offset": 1215,
    "text": "αἰνέων Μελέαγρον, αἰνέων δὲ καὶ Ἕκτορα"
  },
  {
    "id": "p-f25650",
    "offset": 1255,
    "text": "Ἀμφιάρηόν τε,"
  },
  {
    "id": "p-45ddd1",
    "offset": 1270,
    "text": "εὐανθέʼ ἀπέπνευσας ἁλικίαν"
  },
  {
    "id": "p-547172",
    "offset": 1298,
    "text": "προμάχων ἀνʼ ὅμιλον, ἔνθʼ ἄριστοι"
  },
  {
    "id": "p-4a0ad3",
    "offset": 1333,
    "text": "ἔσχον πολέμοιο νεῖκος ἐσχάταις ἐλπίσιν."
  },
  {
    "id": "p-dea05a",
    "offset": 1374,
    "text": "ἔτλαν δὲ πένθος οὐ φατόν· ἀλλὰ νῦν μοι"
  },
  {
    "id": "p-8e341b",
    "offset": 1414,
    "text": "Γαιάοχος εὐδίαν ὄπασσεν"
  },
  {
    "id": "p-28e8e4",
    "offset": 1439,
    "text": "ἐκ χειμῶνος. ἀείσομαι χαίταν στεφάνοισιν ἁρμόσαις. ὁ δʼ ἀθανάτων μὴ θρασσέτω φθόνος,"
  },
  {
    "id": "p-db5212",
    "offset": 1525,
    "text": "ὅ τι τερπνὸν ἐφάμερον διώκων"
  },
  {
    "id": "p-2c56c1",
    "offset": 1555,
    "text": "ἕκαλος ἔπειμι γῆρας ἔς τε τὸν μόρσιμον"
  },
  {
    "id": "p-263be3",
    "offset": 1595,
    "text": "αἰῶνα. θνᾴσκομεν γὰρ ὁμῶς ἅπαντες·"
  },
  {
    "id": "p-388581",
    "offset": 1631,
    "text": "δαίμων δʼ ἄϊσος· τὰ μακρὰ δʼ εἴ τις"
  },
  {
    "id": "p-35402e",
    "offset": 1668,
    "text": "παπταίνει, βραχὺς ἐξικέσθαι χαλκόπεδον θεῶν ἕδραν· ὅτι πτερόεις ἔρριψε Πάγασος"
  },
  {
    "id": "p-eb155e",
    "offset": 1748,
    "text": "δεσπόταν ἐθέλοντʼ ἐς οὐρανοῦ σταθμοὺς"
  },
  {
    "id": "p-e712a2",
    "offset": 1787,
    "text": "ἐλθεῖν μεθʼ ὁμάγυριν Βελλεροφόνταν"
  },
  {
    "id": "p-cd7ee0",
    "offset": 1823,
    "text": "Ζηνός· τὸ δὲ πὰρ δίκαν"
  },
  {
    "id": "p-f170bb",
    "offset": 1847,
    "text": "γλυκὺ πικροτάτα μένει τελευτά."
  },
  {
    "id": "p-d79fb8",
    "offset": 1879,
    "text": "ἄμμι δʼ, ὦ χρυσέᾳ κόμᾳ θάλλων, πόρε, Λοξία,"
  },
  {
    "id": "p-76ae9e",
    "offset": 1924,
    "text": "τεαῖσιν ἁμίλλαισιν"
  },
  {
    "id": "p-d09ed4",
    "offset": 1944,
    "text": "εὐανθέα καὶ Πυθόϊ στέφανον."
  }
]