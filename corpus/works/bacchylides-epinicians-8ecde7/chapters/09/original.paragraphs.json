[
  {
    "id": "p-2521c3",
    "offset": 0,
    "text": "Νίκα [γλυκύδωρε, μεγίσταν"
  },
  {
    "id": "p-3811bf",
    "offset": 27,
    "text": "σοὶ πατ[ὴρ ὤπασσε τιμὰν"
  },
  {
    "id": "p-b05b25",
    "offset": 52,
    "text": "ὑψίζυγ[ος Οὐρανιδᾶν"
  },
  {
    "id": "p-0ae3e3",
    "offset": 73,
    "text": "ἐν πολυχρύσῳ δʼ Ὀλύμπῳ"
  },
  {
    "id": "p-3f01ff",
    "offset": 97,
    "text": "Ζηνὶ παρισταμένα"
  },
  {
    "id": "p-3da3bb",
    "offset": 115,
    "text": "κρίνεις τέλος ἀθανάτοι-"
  },
  {
    "id": "p-f58582",
    "offset": 140,
    "text": "σίν τε καὶ θνατοῖς ἀρετᾶς."
  },
  {
    "id": "p-00b600",
    "offset": 168,
    "text": "ἔλλαθι, [βαθυ]πλοκάμου"
  },
  {
    "id": "p-f2a3aa",
    "offset": 192,
    "text": "κούρα [Στυγὸς ὀρ]θοδίκου· σέθεν δʼ ἕκατι"
  },
  {
    "id": "p-ca75a5",
    "offset": 234,
    "text": "καὶ νῦν Μεταπόντιον εὐ-"
  },
  {
    "id": "p-7914e4",
    "offset": 259,
    "text": "γυίων [κατέχ]ουσι νέων"
  },
  {
    "id": "p-1a81aa",
    "offset": 283,
    "text": "κῶμοί τε καὶ εὐφροσύναι θ εό τιμον ἄστυ·"
  },
  {
    "id": "p-813e68",
    "offset": 325,
    "text": "ὑμνεῦσι δὲ Πυθιόνικον"
  },
  {
    "id": "p-bf19a1",
    "offset": 348,
    "text": "παῖδα θαητὸν Φαΐσκου."
  },
  {
    "id": "p-a340b3",
    "offset": 371,
    "text": "ἵλ εῳ νιν ὁ Δαλογενὴς υἱ-"
  },
  {
    "id": "p-d3a812",
    "offset": 398,
    "text": "ὸς βαθυζώνοιο Λατοῦς"
  },
  {
    "id": "p-e1e0e1",
    "offset": 420,
    "text": "δέκτο βλεφάρῳ· πολέες"
  },
  {
    "id": "p-c383dc",
    "offset": 443,
    "text": "δʼ ἀμφʼ Ἀλεξίδαμον ἀνθ έω ν"
  },
  {
    "id": "p-71abc3",
    "offset": 472,
    "text": "ἐν πεδίῳ στέφανοι"
  },
  {
    "id": "p-53b1ff",
    "offset": 491,
    "text": "Κίρρας ἔπεσον κρατερᾶς"
  },
  {
    "id": "p-a9f0ae",
    "offset": 515,
    "text": "ἦρα παννίκοιο πάλας·"
  },
  {
    "id": "p-a9c8ea",
    "offset": 537,
    "text": "οὐκ εἶδέ νιν ἀέλιος"
  },
  {
    "id": "p-4c77c0",
    "offset": 558,
    "text": "κείνῳ γε σὺν ἄματι πρὸς γαίᾳ πεσόντα."
  },
  {
    "id": "p-309c1b",
    "offset": 597,
    "text": "φάσω δὲ καὶ ἐν ζαθέοις"
  },
  {
    "id": "p-4dc0a2",
    "offset": 621,
    "text": "ἁγνοῦ Πέλοπος δαπέδοις"
  },
  {
    "id": "p-897342",
    "offset": 645,
    "text": "Ἀλφ εὸ ν παρὰ καλλιρόαν, δίκας κέλευθον"
  },
  {
    "id": "p-db8c5c",
    "offset": 686,
    "text": "εἰ μή τις ἀπέτραπεν ὀρθᾶς,"
  },
  {
    "id": "p-d43f55",
    "offset": 714,
    "text": "παγξένῳ χαίταν ἐλαίᾳ"
  },
  {
    "id": "p-deee12",
    "offset": 736,
    "text": "γλαυκᾷ στεφανωσάμενον"
  },
  {
    "id": "p-0ea0fd",
    "offset": 759,
    "text": "πορτιτρόφ[ον ἂν πεδίον πάτ]ραν θʼ ἱκέσθαι."
  },
  {
    "id": "p-cde26f",
    "offset": 803,
    "text": "[οὔ τι δόλος κακόφρων]"
  },
  {
    "id": "p-081a8f",
    "offset": 827,
    "text": "παῖδʼ ἐν χθονὶ καλλιχόρῳ"
  },
  {
    "id": "p-109c5a",
    "offset": 853,
    "text": "ποικίλαις τέχναις πέλασσεν·"
  },
  {
    "id": "p-351629",
    "offset": 882,
    "text": "ἀλλʼ ἢ θεὸς αἴτιος, ἢ"
  },
  {
    "id": "p-4c2f29",
    "offset": 905,
    "text": "γνῶμαι πολύπλαγκτοι βροτῶν"
  },
  {
    "id": "p-4bf0a6",
    "offset": 933,
    "text": "ἄ]μερσαν ὑπέρτατον ἐκ χειρῶν γέρας."
  },
  {
    "id": "p-b49ba0",
    "offset": 970,
    "text": "νῦν δʼ Ἄρτεμις ἀγροτέρα"
  },
  {
    "id": "p-405d00",
    "offset": 995,
    "text": "χρυσαλάκατος λιπαρὰν"
  },
  {
    "id": "p-b3abaf",
    "offset": 1017,
    "text": "ἡμέ]ρα τοξόκλυτος νίκαν ἔδωκε."
  },
  {
    "id": "p-3372be",
    "offset": 1049,
    "text": "τᾷ ποτʼ Ἀβαντιάδας"
  },
  {
    "id": "p-ba9cb7",
    "offset": 1069,
    "text": "βωμὸν κατένασσε πολύλ-"
  },
  {
    "id": "p-a71d14",
    "offset": 1093,
    "text": "λιστον εὔπεπλοί τε κοῦραι·"
  },
  {
    "id": "p-00c603",
    "offset": 1121,
    "text": "τὰς ἐξ ἐρατῶν ἐφόβησεν"
  },
  {
    "id": "p-2754aa",
    "offset": 1145,
    "text": "παγκρατὴς Ἥρα μελάθρων"
  },
  {
    "id": "p-47bea3",
    "offset": 1169,
    "text": "Προίτου, παραπλῆγι φρένας"
  },
  {
    "id": "p-ec2180",
    "offset": 1196,
    "text": "καρτερᾷ ζεύξασʼ ἀνάγκᾳ·"
  },
  {
    "id": "p-c33425",
    "offset": 1221,
    "text": "παρθενίᾳ γὰρ ἔτι"
  },
  {
    "id": "p-9ce0f3",
    "offset": 1239,
    "text": "ψυχᾷ κίον ἐς τέμενος"
  },
  {
    "id": "p-f1c91e",
    "offset": 1261,
    "text": "πορφυροζώνοιο θεᾶς·"
  },
  {
    "id": "p-f14e27",
    "offset": 1282,
    "text": "φάσκον δὲ πολὺ σφέτερον"
  },
  {
    "id": "p-db1f38",
    "offset": 1307,
    "text": "πλούτῳ προφέρειν πατέρα ξανθᾶς παρέδρου"
  },
  {
    "id": "p-3a7980",
    "offset": 1348,
    "text": "σεμνοῦ Διὸς εὐρυβία."
  },
  {
    "id": "p-1ac9af",
    "offset": 1370,
    "text": "ταῖσιν δὲ χολωσαμένα"
  },
  {
    "id": "p-f2fedc",
    "offset": 1392,
    "text": "στήθεσσι παλίντροπον ἔμβαλεν νόημα·"
  },
  {
    "id": "p-781aac",
    "offset": 1429,
    "text": "φεῦγον δʼ ὄρος ἐς τανίφυλλον,"
  },
  {
    "id": "p-ebd9e1",
    "offset": 1460,
    "text": "σμερδαλ έα ν φωνὰν ἱεῖσαι,"
  },
  {
    "id": "p-97d00c",
    "offset": 1488,
    "text": "Τιρύνθιον ἄστυ λιποῦσαι"
  },
  {
    "id": "p-25b223",
    "offset": 1513,
    "text": "καὶ θεοδμάτους ἀγυιάς,"
  },
  {
    "id": "p-a9456e",
    "offset": 1537,
    "text": "ἤδη γὰρ ἔτος δέκατον"
  },
  {
    "id": "p-a1948b",
    "offset": 1559,
    "text": "θ εο φιλὲς λιπόντες Ἄργος"
  },
  {
    "id": "p-96f51c",
    "offset": 1586,
    "text": "ναῖον ἀδεισιβόαι"
  },
  {
    "id": "p-19fe5f",
    "offset": 1604,
    "text": "χαλκάσπιδες ἡμίθεοι"
  },
  {
    "id": "p-c940c7",
    "offset": 1625,
    "text": "σὺν πολυζήλῳ βασιλεῖ."
  },
  {
    "id": "p-20d5ab",
    "offset": 1648,
    "text": "νεῖκος γὰρ ἀμαιμάκετον"
  },
  {
    "id": "p-c0e910",
    "offset": 1672,
    "text": "βληχρᾶς ἀνέπαλτο κασιγνητοῖς ἀπʼ ἀρχᾶς"
  },
  {
    "id": "p-e1461d",
    "offset": 1712,
    "text": "Προίτῳ τε καὶ Ἀκρισίῳ·"
  },
  {
    "id": "p-836208",
    "offset": 1736,
    "text": "λαούς τε διχοστασίαις"
  },
  {
    "id": "p-fdf8da",
    "offset": 1759,
    "text": "ἤρειπον ἀμετροδίκοις μάχαις τε λυγραῖς."
  },
  {
    "id": "p-252dc7",
    "offset": 1800,
    "text": "λίσσοντο δὲ παῖδας Ἄβαντος"
  },
  {
    "id": "p-7168ca",
    "offset": 1828,
    "text": "γᾶν πολύκριθον λαχόντας"
  },
  {
    "id": "p-754b2b",
    "offset": 1853,
    "text": "Τίρυνθα τὸν ὁπλότερον"
  },
  {
    "id": "p-2cb127",
    "offset": 1876,
    "text": "κτίζειν, πρὶν ἐς ἀργαλέαν πεσεῖν ἀνάγκαν·"
  },
  {
    "id": "p-6c1cec",
    "offset": 1919,
    "text": "Ζεύς τʼ ἔθελεν Κρονίδας,"
  },
  {
    "id": "p-9c431e",
    "offset": 1945,
    "text": "τιμῶν Δαναοῦ γενεὰν"
  },
  {
    "id": "p-2fb010",
    "offset": 1966,
    "text": "καὶ διωξίπποιο Λυγκ έο ς,"
  },
  {
    "id": "p-4d41dd",
    "offset": 1993,
    "text": "παῦσαι στυγερῶν ἀχέων."
  },
  {
    "id": "p-d13194",
    "offset": 2017,
    "text": "τεῖχος δὲ Κύκλωπες κάμον"
  },
  {
    "id": "p-1a972b",
    "offset": 2043,
    "text": "ἐλθόντες ὑπερφίαλοι κλεινᾷ πόλει"
  },
  {
    "id": "p-0c7745",
    "offset": 2077,
    "text": "κάλλιστον, ἵνʼ ἀντίθεοι"
  },
  {
    "id": "p-0711eb",
    "offset": 2102,
    "text": "ναῖον κλυτὸν ἱππόβοτον"
  },
  {
    "id": "p-ad3ace",
    "offset": 2126,
    "text": "Ἄργος ἥρωες περικλειτοὶ λιπόντες."
  },
  {
    "id": "p-38fe73",
    "offset": 2161,
    "text": "ἔνθεν ἀπεσσύμεναι"
  },
  {
    "id": "p-2962b3",
    "offset": 2180,
    "text": "Προίτου κυανοπλόκαμοι"
  },
  {
    "id": "p-ff0646",
    "offset": 2203,
    "text": "φεῦγον ἄδματοι θύγατρες,"
  },
  {
    "id": "p-25306e",
    "offset": 2229,
    "text": "τὸν δʼ εἷλεν ἄχος κραδίαν, ξεί-"
  },
  {
    "id": "p-90d8f0",
    "offset": 2262,
    "text": "να τέ νιν πλᾶξεν μέριμνα·"
  },
  {
    "id": "p-cc8024",
    "offset": 2289,
    "text": "δοίαξε δὲ φάσγανον ἄμ-"
  },
  {
    "id": "p-245323",
    "offset": 2313,
    "text": "φακες ἐν στέρνοισι πᾶξαι."
  },
  {
    "id": "p-fda6a4",
    "offset": 2340,
    "text": "ἀλλά νιν αἰχμοφόροι"
  },
  {
    "id": "p-41bae7",
    "offset": 2361,
    "text": "μύθοισί τε μειλιχίοις"
  },
  {
    "id": "p-be3fb3",
    "offset": 2384,
    "text": "καὶ βίᾳ χειρῶν κάτεχον."
  },
  {
    "id": "p-ad854d",
    "offset": 2409,
    "text": "τρισκαίδεκα μὲν τελέους"
  },
  {
    "id": "p-c4466d",
    "offset": 2434,
    "text": "μῆνας κατὰ δάσκιον ἠλύκταζον ὕλαν"
  },
  {
    "id": "p-ef646e",
    "offset": 2469,
    "text": "φεῦγόν τε κατʼ Ἀρκαδίαν"
  },
  {
    "id": "p-0e1fe3",
    "offset": 2494,
    "text": "μηλοτρόφον· ἀλλʼ ὅτε δὴ"
  },
  {
    "id": "p-01aa0d",
    "offset": 2519,
    "text": "Λοῦσον ποτὶ καλλιρόαν πατὴρ ἵκανεν,"
  },
  {
    "id": "p-2e1e75",
    "offset": 2556,
    "text": "ἔνθεν χρόα νιψάμενος φοι-"
  },
  {
    "id": "p-7d0b52",
    "offset": 2583,
    "text": "νικο[κραδέμνοι]ο Λατοῦς"
  },
  {
    "id": "p-3e2baf",
    "offset": 2608,
    "text": "κίκλ[ῃσκε θύγατρα] βοῶπιν,"
  },
  {
    "id": "p-f9ffbc",
    "offset": 2636,
    "text": "χεῖρας ἀντείνων πρὸς αὐγὰς"
  },
  {
    "id": "p-8fed02",
    "offset": 2664,
    "text": "ἱππώκεος ἀελίου,"
  },
  {
    "id": "p-40a8aa",
    "offset": 2682,
    "text": "τέκνα δυστάνοιο λύσσας"
  },
  {
    "id": "p-b4bc86",
    "offset": 2706,
    "text": "πάρφρονος ἐξαγαγεῖν·"
  },
  {
    "id": "p-66d95c",
    "offset": 2728,
    "text": "θύσω δέ τοι εἴκοσι βοῦς"
  },
  {
    "id": "p-9a4f8d",
    "offset": 2753,
    "text": "ἄζυγας φοινικότριχας."
  },
  {
    "id": "p-645a58",
    "offset": 2776,
    "text": "τοῦ δʼ ἔκλυʼ ἀριστοπάτρα"
  },
  {
    "id": "p-e448aa",
    "offset": 2802,
    "text": "θηροσκόπος εὐχομένου· πιθοῦσα δʼ Ἥραν"
  },
  {
    "id": "p-501c09",
    "offset": 2841,
    "text": "παῦσεν καλυκοστεφάνους"
  },
  {
    "id": "p-853760",
    "offset": 2865,
    "text": "κούρας μανιᾶν ἀθέων·"
  },
  {
    "id": "p-f59206",
    "offset": 2887,
    "text": "ταὶ δʼ αὐτίκα ϝοι τέμενος βωμόν τε τεῦχον,"
  },
  {
    "id": "p-7bf743",
    "offset": 2931,
    "text": "χραῖνόν τέ μιν αἵματι μήλων"
  },
  {
    "id": "p-0e3ada",
    "offset": 2960,
    "text": "καὶ χοροὺς ἵσταν γυναικῶν."
  },
  {
    "id": "p-5ae70f",
    "offset": 2988,
    "text": "ἔνθεν καὶ ἀρηϊφίλοις"
  },
  {
    "id": "p-e4046d",
    "offset": 3010,
    "text": "ἄνδρεσσιν ἐς ἱπποτρόφον πόλιν τʼ Ἀχαιοῖς"
  },
  {
    "id": "p-c3d49d",
    "offset": 3052,
    "text": "ἕσπεο, σὺν δὲ τύχᾳ"
  },
  {
    "id": "p-cbe9eb",
    "offset": 3072,
    "text": "ναίεις Μεταπόντιον, ὦ"
  },
  {
    "id": "p-059b6b",
    "offset": 3095,
    "text": "χρυσέα δέσποινα λαῶν·"
  },
  {
    "id": "p-e3c4a9",
    "offset": 3118,
    "text": "ἄλσος τέ τοι ἱμερόεν"
  },
  {
    "id": "p-307dd7",
    "offset": 3140,
    "text": "Κάσαν παρʼ εὔυδρον πρὸ να-"
  },
  {
    "id": "p-ebb7d9",
    "offset": 3168,
    "text": "οῖʼ ἑσσαμένων, Πριάμοιʼ ἐπεὶ χρόνῳ"
  },
  {
    "id": "p-21c85e",
    "offset": 3204,
    "text": "βουλαῖσι θεῶν μακάρων"
  },
  {
    "id": "p-33c195",
    "offset": 3227,
    "text": "πέρσαν πόλιν εὐκτιμέναν"
  },
  {
    "id": "p-226cbf",
    "offset": 3252,
    "text": "χαλκοθωράκων μετʼ Ἀτρειδᾶν. δικαίας"
  },
  {
    "id": "p-4e0a1b",
    "offset": 3289,
    "text": "ὅστις ἔχει φρένας, εὑ-"
  },
  {
    "id": "p-7748d4",
    "offset": 3313,
    "text": "ρήσει σὺν ἅπαντι χρόνῳ"
  },
  {
    "id": "p-e5191e",
    "offset": 3337,
    "text": "μυρίας ἀλκὰς Ἀχαιῶν."
  }
]