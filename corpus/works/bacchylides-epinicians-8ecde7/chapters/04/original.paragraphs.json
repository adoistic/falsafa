[
  {
    "id": "p-2b8eef",
    "offset": 0,
    "text": "εὔμοιρε Συρακοσίων"
  },
  {
    "id": "p-a19537",
    "offset": 20,
    "text": "ἱπποδινήτων στραταγέ,"
  },
  {
    "id": "p-28a70b",
    "offset": 43,
    "text": "γνώσει μὲν ἰοστεφάνων"
  },
  {
    "id": "p-6ec514",
    "offset": 66,
    "text": "Μοισᾶν γλυκύδωρον ἄγαλμα, τῶν γε νῦν"
  },
  {
    "id": "p-121989",
    "offset": 104,
    "text": "αἴ τις ἐπιχθονίων,"
  },
  {
    "id": "p-41f3c0",
    "offset": 124,
    "text": "ὀρθῶς· φρένα δʼ εὐθύδικον"
  },
  {
    "id": "p-69e45a",
    "offset": 151,
    "text": "ἀτρέμʼ ἀμπαύσας μεριμνᾶν"
  },
  {
    "id": "p-751386",
    "offset": 177,
    "text": "δεῦρʼ ἐπάθρησον νόῳ,"
  },
  {
    "id": "p-07cff6",
    "offset": 199,
    "text": "ᾗ σὺν Χαρίτεσσι βαθυζώνοις ὑφάνας"
  },
  {
    "id": "p-818660",
    "offset": 234,
    "text": "ὕμνον ἀπὸ ζαθέας"
  },
  {
    "id": "p-0b5e28",
    "offset": 252,
    "text": "νάσου ξένος ὑμετέραν πέμ-"
  },
  {
    "id": "p-e4e657",
    "offset": 279,
    "text": "πει κλεεννὰν ἐς πόλιν,"
  },
  {
    "id": "p-d0027e",
    "offset": 303,
    "text": "χρυσάμπυκος Οὐρανίας κλει-"
  },
  {
    "id": "p-440f6e",
    "offset": 331,
    "text": "νὸς θεράπων· ἐθέλει δὲ"
  },
  {
    "id": "p-f43ec3",
    "offset": 355,
    "text": "γᾶρυν ἐκ στηθ έω ν χέων"
  },
  {
    "id": "p-4721c1",
    "offset": 380,
    "text": "αἰνεῖν Ἱέρωνα. βαθὺν"
  },
  {
    "id": "p-4fb035",
    "offset": 402,
    "text": "δʼ αἰθέρα ξουθαῖσι τάμνων"
  },
  {
    "id": "p-c900bc",
    "offset": 429,
    "text": "ὑψοῦ πτερύγεσσι ταχεί-"
  },
  {
    "id": "p-e05e97",
    "offset": 453,
    "text": "αις αἰετὸς εὐρυάνακτος ἄγγελος"
  },
  {
    "id": "p-1ee4f2",
    "offset": 485,
    "text": "Ζηνὸς ἐρισφαράγου"
  },
  {
    "id": "p-3bc585",
    "offset": 504,
    "text": "θαρσεῖ κρατερᾷ πίσυνος"
  },
  {
    "id": "p-b7d6d3",
    "offset": 528,
    "text": "ἰσχύϊ, πτάσσοντι δʼ ὄρνι-"
  },
  {
    "id": "p-fb0870",
    "offset": 555,
    "text": "χες λιγύφθογγοι φόβῳ·"
  },
  {
    "id": "p-a2475c",
    "offset": 578,
    "text": "οὔ νιν κορυφαὶ μεγάλας ἴσχουσι γαίας,"
  },
  {
    "id": "p-c835f8",
    "offset": 617,
    "text": "οὐδʼ ἁλὸς ἀκαμάτας"
  },
  {
    "id": "p-ab725b",
    "offset": 637,
    "text": "δυσπαίπαλα κύματα· νωμᾶ-"
  },
  {
    "id": "p-83e909",
    "offset": 663,
    "text": "ται δʼ ἐν ἀτρύτῳ χάει"
  },
  {
    "id": "p-7e343c",
    "offset": 686,
    "text": "λεπτότριχα σὺν ζεφύρου πνοι-"
  },
  {
    "id": "p-b1df55",
    "offset": 716,
    "text": "αῖσιν ἔθειραν ἀρίγνω-"
  },
  {
    "id": "p-08949d",
    "offset": 739,
    "text": "τος μετʼ ἀνθρώποις ἰδεῖν·"
  },
  {
    "id": "p-a67375",
    "offset": 766,
    "text": "τὼς νῦν καὶ ἐμοὶ μυρία πάντᾳ κέλευθος"
  },
  {
    "id": "p-025185",
    "offset": 805,
    "text": "ὑμετέραν ἀρετὰν"
  },
  {
    "id": "p-294613",
    "offset": 822,
    "text": "ὑμνεῖν, κυανοπλοκάμου θʼ ἕκατι Νίκας"
  },
  {
    "id": "p-a75913",
    "offset": 860,
    "text": "χαλκεοστέρνου τʼ Ἄρηος,"
  },
  {
    "id": "p-95a65a",
    "offset": 885,
    "text": "Δεινομένευς ἀγέρω-"
  },
  {
    "id": "p-724e74",
    "offset": 905,
    "text": "χοι παῖδες· εὖ ἔρδων δὲ μὴ κάμοι θεός."
  },
  {
    "id": "p-0569d2",
    "offset": 945,
    "text": "ξανθότριχα μὲν Φερένικον"
  },
  {
    "id": "p-ccde18",
    "offset": 971,
    "text": "Ἀλφεὸν παρʼ εὐρυδίναν"
  },
  {
    "id": "p-4e10c9",
    "offset": 994,
    "text": "πῶλον ἀελλοδρόμαν"
  },
  {
    "id": "p-c49edf",
    "offset": 1013,
    "text": "εἶδε νικάσαντα χρυσόπαχυς Ἀώς,"
  },
  {
    "id": "p-ab5ebe",
    "offset": 1045,
    "text": "Πυθῶνί τʼ ἐν ἀγαθέᾳ·"
  },
  {
    "id": "p-ab2611",
    "offset": 1067,
    "text": "γᾷ δʼ ἐπισκήπτων πιφαύσκω·"
  },
  {
    "id": "p-b979d6",
    "offset": 1095,
    "text": "οὔπω νιν ὑπὸ προτέρων"
  },
  {
    "id": "p-cc51e2",
    "offset": 1118,
    "text": "ἵππων ἐν ἀγῶνι κατέχρανεν κόνις"
  },
  {
    "id": "p-025c84",
    "offset": 1151,
    "text": "πρὸς τέλος ὀρνύμενον·"
  },
  {
    "id": "p-fbe5f6",
    "offset": 1174,
    "text": "ῥιπᾷ γὰρ ἴσος βορέα"
  },
  {
    "id": "p-885deb",
    "offset": 1195,
    "text": "ὃν κυβερνήταν φυλάσσων"
  },
  {
    "id": "p-6e2e68",
    "offset": 1219,
    "text": "ἵεται νεόκροτον"
  },
  {
    "id": "p-56584b",
    "offset": 1236,
    "text": "νίκαν Ἱέρωνι φιλοξείνῳ τιτύσκων."
  },
  {
    "id": "p-ab102e",
    "offset": 1270,
    "text": "ὄλβιος ᾧτινι θ εὸ ς"
  },
  {
    "id": "p-42d90d",
    "offset": 1291,
    "text": "μοῖράν τε καλῶν ἔπορεν"
  },
  {
    "id": "p-8d29a6",
    "offset": 1315,
    "text": "σύν τʼ ἐπιζήλῳ τύχᾳ"
  },
  {
    "id": "p-e1aad6",
    "offset": 1336,
    "text": "ἀφν εὸ ν βιοτὰν διάγειν· οὐ"
  },
  {
    "id": "p-9fd401",
    "offset": 1365,
    "text": "γάρ τις ἐπιχθονίων"
  },
  {
    "id": "p-221103",
    "offset": 1385,
    "text": "πάντα γʼ εὐδαίμων ἔφυ."
  },
  {
    "id": "p-2277fa",
    "offset": 1409,
    "text": "καὶ μάν π]οτʼ ἐρειψιπύλαν"
  },
  {
    "id": "p-e2ddcb",
    "offset": 1436,
    "text": "παῖδʼ ἀνίκ]ατον λέγουσιν"
  },
  {
    "id": "p-fea756",
    "offset": 1462,
    "text": "δῦναι Διὸς] ἀργικεραύ-"
  },
  {
    "id": "p-721372",
    "offset": 1486,
    "text": "νου δώματα Φερσεφόνας τανισφύρου,"
  },
  {
    "id": "p-62c458",
    "offset": 1521,
    "text": "καρχαρόδοντα κύνʼ ἄ-"
  },
  {
    "id": "p-a2dd4a",
    "offset": 1543,
    "text": "ξοντʼ ἐς φάος ἐξ Ἀΐδα,"
  },
  {
    "id": "p-52204b",
    "offset": 1567,
    "text": "υἱὸν ἀπλάτοιʼ Ἐχίδνας·"
  },
  {
    "id": "p-1f4f59",
    "offset": 1591,
    "text": "ἔνθα δυστάνων βροτῶν"
  },
  {
    "id": "p-86c8d9",
    "offset": 1613,
    "text": "ψυχὰς ἐδάη παρὰ Κωκυτοῦ ῥεέθροις,"
  },
  {
    "id": "p-0199bf",
    "offset": 1648,
    "text": "οἷά τε φύλλʼ ἄνεμος"
  },
  {
    "id": "p-83c4af",
    "offset": 1669,
    "text": "Ἴδας ἀνὰ μηλοβότους"
  },
  {
    "id": "p-a99b34",
    "offset": 1690,
    "text": "πρῶνας ἀργηστὰς δονεῖ."
  },
  {
    "id": "p-1ff173",
    "offset": 1714,
    "text": "ταῖσιν δὲ μετέπρεπεν εἴδω-"
  },
  {
    "id": "p-9e902d",
    "offset": 1742,
    "text": "λον θρασυμέμνονος ἐγ-"
  },
  {
    "id": "p-5dab66",
    "offset": 1765,
    "text": "χεσπάλου Πορθανίδα·"
  },
  {
    "id": "p-9c15a5",
    "offset": 1786,
    "text": "τὸν δʼ ὡς ἴδεν Ἀλκμήνιος θαυμαστὸς ἥρως"
  },
  {
    "id": "p-899a40",
    "offset": 1827,
    "text": "τεύχεσι λαμπόμενον,"
  },
  {
    "id": "p-266c0c",
    "offset": 1848,
    "text": "νευρὰν ἐπέβασε λιγυκλαγγῆ κορώνας,"
  },
  {
    "id": "p-779d5c",
    "offset": 1884,
    "text": "χαλκεόκρανον δʼ ἔπειτʼ ἐξ-"
  },
  {
    "id": "p-78d3e7",
    "offset": 1912,
    "text": "είλετο ϝιὸν ἀνα-"
  },
  {
    "id": "p-0a3205",
    "offset": 1930,
    "text": "πτύξας φαρέτρας πῶμα· τῷ δʼ ἐναντία"
  },
  {
    "id": "p-14c625",
    "offset": 1967,
    "text": "ψυχὰ προφάνη Μελεάγρου"
  },
  {
    "id": "p-03d302",
    "offset": 1991,
    "text": "καί νιν εὖ εἰδὼς προσεῖπεν·"
  },
  {
    "id": "p-51b224",
    "offset": 2020,
    "text": "υἱὲ Διὸς μεγάλου,"
  },
  {
    "id": "p-42f4f2",
    "offset": 2039,
    "text": "στᾶθί τʼ ἐν χώρᾳ, γελανώσας τε θυμόν"
  },
  {
    "id": "p-42814e",
    "offset": 2077,
    "text": "μὴ ταΰσιον προΐει"
  },
  {
    "id": "p-3a02c5",
    "offset": 2096,
    "text": "τραχὺν ἐκ χειρῶν ὀϊστὸν"
  },
  {
    "id": "p-9ada59",
    "offset": 2121,
    "text": "ψυχαῖσιν ἔπι φθιμένων·"
  },
  {
    "id": "p-d9a5c7",
    "offset": 2145,
    "text": "οὔτοι δέος. ὣς φάτο· θάμβησεν δʼ ἄναξ"
  },
  {
    "id": "p-6e2c3a",
    "offset": 2184,
    "text": "Ἀμφιτρυωνιάδας,"
  },
  {
    "id": "p-6138b4",
    "offset": 2201,
    "text": "εἶπέν τε· τίς ἀθανάτων"
  },
  {
    "id": "p-3a47d4",
    "offset": 2225,
    "text": "ἢ βροτῶν τοιοῦτον ἔρνος"
  },
  {
    "id": "p-ebbf00",
    "offset": 2250,
    "text": "θρέψεν ἐν ποίᾳ χθονί;"
  },
  {
    "id": "p-c2873e",
    "offset": 2273,
    "text": "τίς δʼ ἔκτανεν; ἦ τάχα καλλίζωνος Ἥρα"
  },
  {
    "id": "p-09c34d",
    "offset": 2312,
    "text": "κεῖνον ἐφʼ ἁμετέρᾳ"
  },
  {
    "id": "p-ed2f6a",
    "offset": 2332,
    "text": "πέμψει κεφαλᾷ· τὰ δέ που"
  },
  {
    "id": "p-76d240",
    "offset": 2358,
    "text": "Παλλάδι ξανθᾷ μέλει."
  },
  {
    "id": "p-5efbd4",
    "offset": 2380,
    "text": "τὸν δὲ προσέφα Μελέαγρος"
  },
  {
    "id": "p-5f42e0",
    "offset": 2406,
    "text": "δακρυόεις· χαλεπὸν"
  },
  {
    "id": "p-2f8d1a",
    "offset": 2426,
    "text": "θ εῶ ν παρατρέψαι νόον"
  },
  {
    "id": "p-81f127",
    "offset": 2450,
    "text": "ἄνδρεσσιν ἐπιχθονίοις."
  },
  {
    "id": "p-0fbe7b",
    "offset": 2474,
    "text": "καὶ γὰρ ἂν πλάξιππος Οἰνεὺς"
  },
  {
    "id": "p-5c40de",
    "offset": 2503,
    "text": "παῦσεν καλυκοστεφάνου"
  },
  {
    "id": "p-0d155f",
    "offset": 2526,
    "text": "σεμνᾶς χόλον Ἀρτέμιδος λευκωλένου"
  },
  {
    "id": "p-0b1665",
    "offset": 2561,
    "text": "λισσόμενος πολέων"
  },
  {
    "id": "p-f82c8c",
    "offset": 2580,
    "text": "τʼ αἰγῶν θυσίαισι πατὴρ"
  },
  {
    "id": "p-61d76b",
    "offset": 2605,
    "text": "καὶ βοῶν φοινικονώτων·"
  },
  {
    "id": "p-992140",
    "offset": 2629,
    "text": "ἀλλʼ ἀνίκατον θεὰ"
  },
  {
    "id": "p-0ec3d6",
    "offset": 2648,
    "text": "ἔσχεν χόλον· εὐρυβίαν δʼ ἔσσευε κούρα"
  },
  {
    "id": "p-47e120",
    "offset": 2687,
    "text": "κάπρον ἀναιδομάχαν"
  },
  {
    "id": "p-0c6438",
    "offset": 2707,
    "text": "ἐς καλλίχορον Καλυδῶ-"
  },
  {
    "id": "p-158582",
    "offset": 2730,
    "text": "νʼ, ἔνθα πλημύρων σθένει"
  },
  {
    "id": "p-fa61a2",
    "offset": 2756,
    "text": "ὄρχους ἐπέκειρεν ὀδόντι,"
  },
  {
    "id": "p-f01372",
    "offset": 2782,
    "text": "σφάζε τε μῆλα, βροτῶν"
  },
  {
    "id": "p-d5b751",
    "offset": 2805,
    "text": "θʼ ὅστις εἰσάνταν μόλοι."
  },
  {
    "id": "p-a1f2e6",
    "offset": 2831,
    "text": "τῷ δὲ στυγερὰν δῆριν Ἑλλάνων ἄριστοι"
  },
  {
    "id": "p-a52c91",
    "offset": 2869,
    "text": "στασάμεθʼ ἐνδυκέως"
  },
  {
    "id": "p-eaf451",
    "offset": 2889,
    "text": "ἓξ ἄματα συνεχέως· ἐπεὶ δὲ δαίμων"
  },
  {
    "id": "p-379168",
    "offset": 2924,
    "text": "κάρτος Αἰτωλοῖς ὄρεξεν,"
  },
  {
    "id": "p-76557c",
    "offset": 2949,
    "text": "θάπτομεν οὓς κατέπε-"
  },
  {
    "id": "p-217852",
    "offset": 2971,
    "text": "φνεν σῦς ἐριβρύχας ἐπαΐσσων βίᾳ,"
  },
  {
    "id": "p-33f0c2",
    "offset": 3005,
    "text": "Ἀγκαῖον ἐμῶν τʼ Ἀγέλαον"
  },
  {
    "id": "p-0cd08a",
    "offset": 3030,
    "text": "φ[έρτ]ατον κεδνῶν ἀδελφ εῶ ν,"
  },
  {
    "id": "p-0ebaae",
    "offset": 3061,
    "text": "οὓς τέ]κεν ἐν μεγάροις"
  },
  {
    "id": "p-6b5d72",
    "offset": 3085,
    "text": "πατρὸ]ς Ἀλθαία περικλειτοῖσιν Οἰνέος·"
  },
  {
    "id": "p-5b9e05",
    "offset": 3124,
    "text": "τῶν δʼ ὤ]λεσε μοῖρʼ ὀλοὰ"
  },
  {
    "id": "p-191990",
    "offset": 3150,
    "text": "πλεῦνα]ς· οὐ γάρ πω δαΐφρων"
  },
  {
    "id": "p-6cce41",
    "offset": 3179,
    "text": "παῦσεν] χόλον ἀγροτέρα"
  },
  {
    "id": "p-6729b2",
    "offset": 3203,
    "text": "Λατοῦς θυγάτηρ· περὶ δʼ αἴθωνος δορᾶς"
  },
  {
    "id": "p-88528c",
    "offset": 3242,
    "text": "μαρνάμεθʼ ἐνδυκέως"
  },
  {
    "id": "p-7990bd",
    "offset": 3262,
    "text": "Κουρῆσι μενεπτολέμοις·"
  },
  {
    "id": "p-e1377e",
    "offset": 3286,
    "text": "ἔνθʼ ἐγὼ πολλοῖς σὺν ἄλλοις"
  },
  {
    "id": "p-5c2f83",
    "offset": 3315,
    "text": "Ἴφικλον κατέκτανον"
  },
  {
    "id": "p-ac8956",
    "offset": 3335,
    "text": "ἐσθλόν τʼ Ἀφάρητα, θοοὺς μάτρωας· οὐ γὰρ"
  },
  {
    "id": "p-231c7f",
    "offset": 3377,
    "text": "καρτερόθυμος Ἄρης"
  },
  {
    "id": "p-f6bcfe",
    "offset": 3396,
    "text": "κρίνει φίλον ἐν πολέμῳ·"
  },
  {
    "id": "p-3960e6",
    "offset": 3421,
    "text": "τυφλὰ δʼ ἐκ χειρῶν βέλη"
  },
  {
    "id": "p-b16d17",
    "offset": 3446,
    "text": "ψυχαῖς ἔπι δυσμενέων φοι-"
  },
  {
    "id": "p-8dbed8",
    "offset": 3473,
    "text": "τᾷ θάνατόν τε φέρει"
  },
  {
    "id": "p-fecf0f",
    "offset": 3494,
    "text": "τοῖσιν ἂν δαίμων θέλῃ·"
  },
  {
    "id": "p-559005",
    "offset": 3518,
    "text": "ταῦτʼ οὐκ ἐπιλεξαμένα"
  },
  {
    "id": "p-d32fde",
    "offset": 3541,
    "text": "Θεστίου κούρα δαΐφρων"
  },
  {
    "id": "p-60f405",
    "offset": 3564,
    "text": "μάτηρ κακόποτμος ἐμοὶ"
  },
  {
    "id": "p-9eaf83",
    "offset": 3587,
    "text": "βούλευσεν ὄλεθρον ἀτάρβακτος γυνά·"
  },
  {
    "id": "p-650b80",
    "offset": 3623,
    "text": "καῖέ τε δαιδαλέας"
  },
  {
    "id": "p-9d1438",
    "offset": 3642,
    "text": "ἐκ λάρνακος ὠκύμορον"
  },
  {
    "id": "p-673120",
    "offset": 3664,
    "text": "φιτρὸν ἀγκλαύσασα, τὸν δὴ"
  },
  {
    "id": "p-5003c1",
    "offset": 3691,
    "text": "μοῖρʼ ἐπέκλωσεν τότε"
  },
  {
    "id": "p-9ea2c5",
    "offset": 3713,
    "text": "ζωᾶς ὅρον ἁμετέρας ἔμμεν. τύχον μὲν"
  },
  {
    "id": "p-788e7f",
    "offset": 3750,
    "text": "Δαϊπύλου Κλύμενον"
  },
  {
    "id": "p-75a479",
    "offset": 3769,
    "text": "παῖδʼ ἄλκιμον ἐξεναρί-"
  },
  {
    "id": "p-fc1712",
    "offset": 3793,
    "text": "ζων ἀμώμητον δέμας,"
  },
  {
    "id": "p-b0ef72",
    "offset": 3814,
    "text": "πύργων προπάροιθε κιχήσας·"
  },
  {
    "id": "p-fd7dec",
    "offset": 3842,
    "text": "τοὶ δὲ πρὸς εὐκτιμέναν"
  },
  {
    "id": "p-386f9f",
    "offset": 3866,
    "text": "φεῦγον ἀρχαίαν πόλιν"
  },
  {
    "id": "p-6908dd",
    "offset": 3888,
    "text": "Πλευρῶνα· μινύνθη δέ μοι ψυχὰ γλυκεῖα,"
  },
  {
    "id": "p-d382bd",
    "offset": 3928,
    "text": "γνῶν δʼ ὀλιγοσθενέων·"
  },
  {
    "id": "p-0bc289",
    "offset": 3951,
    "text": "αἰαῖ· πύματον δὲ πνέων δάκρυσα τλ[άμων"
  },
  {
    "id": "p-821221",
    "offset": 3991,
    "text": "ἀγλαὰν ἥβαν προλείπων."
  },
  {
    "id": "p-35d4c3",
    "offset": 4015,
    "text": "φασὶν ἀδεισιβόαν"
  },
  {
    "id": "p-e9d256",
    "offset": 4033,
    "text": "Ἀμφιτρύωνος παῖδα μοῦνον δὴ τότε"
  },
  {
    "id": "p-ebb8f4",
    "offset": 4067,
    "text": "τέγξαι βλέφαρον, ταλαπενθ έο ς"
  },
  {
    "id": "p-62bd8a",
    "offset": 4099,
    "text": "πότμον οἰκτίροντα φωτός·"
  },
  {
    "id": "p-e30e1a",
    "offset": 4125,
    "text": "καί νιν ἀμειβόμενος"
  },
  {
    "id": "p-498f12",
    "offset": 4146,
    "text": "τοῖʼ ἔφα· θνατοῖσι μὴ φῦναι φέριστον,"
  },
  {
    "id": "p-637a52",
    "offset": 4185,
    "text": "μηδʼ ἀελίου προσιδεῖν"
  },
  {
    "id": "p-71520c",
    "offset": 4208,
    "text": "φέγγος· ἀλλʼ οὐ γάρ τίς ἐστιν"
  },
  {
    "id": "p-5210d1",
    "offset": 4239,
    "text": "πρᾶξις τάδε μυρομένοις,"
  },
  {
    "id": "p-a846f7",
    "offset": 4264,
    "text": "χρὴ κεῖνο λέγειν ὅ,τι καὶ μέλλει τελεῖν."
  },
  {
    "id": "p-50822c",
    "offset": 4306,
    "text": "ἦ ῥα τις ἐν μεγάροις"
  },
  {
    "id": "p-c9faf7",
    "offset": 4328,
    "text": "Οἰνῆος ἀρηϊφίλου"
  },
  {
    "id": "p-1061a8",
    "offset": 4346,
    "text": "ἔστιν ἀδμήτα θυγάτρων,"
  },
  {
    "id": "p-835256",
    "offset": 4370,
    "text": "σοὶ φυὰν ἀλιγκία;"
  },
  {
    "id": "p-cbf989",
    "offset": 4389,
    "text": "τάν κεν λιπαρὰν ἐθέλων θείμαν ἄκοιτιν."
  },
  {
    "id": "p-5d7ab9",
    "offset": 4429,
    "text": "τὸν δὲ μενεπτολέμου"
  },
  {
    "id": "p-515975",
    "offset": 4450,
    "text": "ψυχὰ προσέφα Μελεά-"
  },
  {
    "id": "p-e94962",
    "offset": 4471,
    "text": "γρου· λίπον χλωραύχενα"
  },
  {
    "id": "p-23dc36",
    "offset": 4495,
    "text": "ἐν δώμασι Δαϊάνειραν,"
  },
  {
    "id": "p-f6726f",
    "offset": 4518,
    "text": "νῆϊν ἔτι χρυσέας"
  },
  {
    "id": "p-b55e66",
    "offset": 4536,
    "text": "Κύπριδος θελξιμβρότου."
  },
  {
    "id": "p-93d72d",
    "offset": 4560,
    "text": "λευκώλενε Καλλιόπα,"
  },
  {
    "id": "p-83955a",
    "offset": 4581,
    "text": "στᾶσον εὐποίητον ἅρμα"
  },
  {
    "id": "p-48afb4",
    "offset": 4604,
    "text": "αὐτοῦ· Δία τε Κρονίδαν"
  },
  {
    "id": "p-9e2a5b",
    "offset": 4628,
    "text": "ὕμνησον Ὀλύμπιον ἀρχαγὸν θεῶν,"
  },
  {
    "id": "p-aa419d",
    "offset": 4660,
    "text": "τόν τʼ ἀκαμαντορόαν"
  },
  {
    "id": "p-9c829e",
    "offset": 4681,
    "text": "Ἀλφ εό ν, Πέλοπός τε βίαν,"
  },
  {
    "id": "p-87ee17",
    "offset": 4709,
    "text": "καὶ Πίσαν, ἔνθʼ ὁ κλεεννὸς"
  },
  {
    "id": "p-f40e4a",
    "offset": 4737,
    "text": "ποσσὶ νικάσας δρόμῳ"
  },
  {
    "id": "p-72942d",
    "offset": 4758,
    "text": "ἦλθ]εν Φερένικος ἐς εὐπύργους Συρακόσ-"
  },
  {
    "id": "p-811272",
    "offset": 4798,
    "text": "σας Ἱέρωνι φέρων"
  },
  {
    "id": "p-5be2cd",
    "offset": 4816,
    "text": "εὐδ]αιμονίας πέταλον."
  },
  {
    "id": "p-622ff1",
    "offset": 4839,
    "text": "χρὴ δʼ ἀλαθείας χάριν"
  },
  {
    "id": "p-45f4c3",
    "offset": 4862,
    "text": "αἰνεῖν, φθόνον ἀμφοτέραισιν"
  },
  {
    "id": "p-332f31",
    "offset": 4891,
    "text": "χερσὶν ἀπωσάμενον,"
  },
  {
    "id": "p-07f8a0",
    "offset": 4911,
    "text": "εἴ τις εὖ πράσσοι βροτῶν."
  },
  {
    "id": "p-d0c075",
    "offset": 4938,
    "text": "Βοιωτὸς ἀνὴρ τᾷδε φών[ησεν, γλυκειᾶν"
  },
  {
    "id": "p-f6ab4b",
    "offset": 4976,
    "text": "Ἡσίοδος πρόπολος"
  },
  {
    "id": "p-82423c",
    "offset": 4994,
    "text": "Μουσᾶν, ὃν ἂν ἀθάνατοι τι[μῶσι, τούτῳ"
  },
  {
    "id": "p-55aadc",
    "offset": 5033,
    "text": "καὶ βροτῶν φήμαν ἕπ[εσθαι."
  },
  {
    "id": "p-3526c2",
    "offset": 5061,
    "text": "πείθομαι εὐμαρέως"
  },
  {
    "id": "p-a7457c",
    "offset": 5080,
    "text": "εὐκλ έα κελεύθου γλῶσσαν οὐ[κ ἐκτὸς δίκας"
  },
  {
    "id": "p-b33c05",
    "offset": 5123,
    "text": "πέμπειν Ἱέρωνι· τόθεν γὰρ"
  },
  {
    "id": "p-dd77e3",
    "offset": 5150,
    "text": "πυθμένες θάλλουσιν ἐσθλ[ῶν,"
  },
  {
    "id": "p-d46df5",
    "offset": 5179,
    "text": "τοὺς ὁ μεγιστοπάτωρ"
  },
  {
    "id": "p-44682a",
    "offset": 5200,
    "text": "Ζεὺς ἀκινήτους ἐν εἰρήν[ᾳ φυλάσσοι."
  }
]