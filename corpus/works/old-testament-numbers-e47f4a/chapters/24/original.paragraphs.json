[
  {
    "id": "p-a48448",
    "offset": 0,
    "text": "XXIVΒαλαὰμ ὅτι καλόν ἐστιν ἔναντι κυρίου εὐλογεῖν τὸν ᾿Ισραήλ, οὐκ ἐπορεύθη κατὰ τὸ εἰωθὸς εἰς συνάντησιν τοῖς οἰωνοῖς, καὶ ἀπέστρεψεν τὸ πρόσωπον εἰς τὴν ἔρημον."
  },
  {
    "id": "p-84cc47",
    "offset": 164,
    "text": "καὶ ἐξάρας Βαλαὰμ τοὺς ὀφθαλμοὺς αὐτοῦ καθορᾷ τὸν ᾿Ισραὴλ ἐστρατοπεδευκότα κατὰ φυλάς. καὶ ἐγένετο πνεῦμα θεοῦ ἐν αὐτῷ."
  },
  {
    "id": "p-a9b925",
    "offset": 285,
    "text": "καὶ ἀναλαβὼν τὴν παραβολὴν αὐτοῦ εἶπεν"
  },
  {
    "id": "p-83ea0a",
    "offset": 325,
    "text": "Φησὶν Βαλαὰμ υἱὸς Βεώρ,"
  },
  {
    "id": "p-f97835",
    "offset": 350,
    "text": "φησὶν ὁ ἄνθρωπος ὁ ἀληθινῶς ὁρῶν,"
  },
  {
    "id": "p-f46e87",
    "offset": 385,
    "text": "φησὶν ἀκούων λόγια θεοῦ,"
  },
  {
    "id": "p-fb7735",
    "offset": 411,
    "text": "ὅστις ὅρασιν θεοῦ εἶδεν,"
  },
  {
    "id": "p-56195e",
    "offset": 437,
    "text": "ἐν ὕπνῳ, ἀποκεκαλυμμένοι οἱ ὀφθαλμοὶ αὐτοῦ·"
  },
  {
    "id": "p-491f49",
    "offset": 482,
    "text": "ὡς καλοί σου οἱ οἶκοι, ᾿Ιακώβ,"
  },
  {
    "id": "p-5641c0",
    "offset": 514,
    "text": "αἱ σκηναί σου, Ἰσραήλ·"
  },
  {
    "id": "p-1cd7b3",
    "offset": 538,
    "text": "ὡς νάπαι σκιάζουσαι,"
  },
  {
    "id": "p-bedd33",
    "offset": 560,
    "text": "καὶ ὡσεὶ παράδεισος ἐπὶ ποταμῶν·"
  },
  {
    "id": "p-39f251",
    "offset": 594,
    "text": "καὶ ὡσεὶ σκηναὶ ἃς ἔπηξεν κύριος,"
  },
  {
    "id": "p-c052bf",
    "offset": 629,
    "text": "ὡσεὶ κέδροι παρ’ ὕδατα."
  },
  {
    "id": "p-c004c2",
    "offset": 654,
    "text": "ἐξελεύσεται ἄνθρωπος ἐκ τοῦ σπέρματος αὐτοῦ,"
  },
  {
    "id": "p-1d38a6",
    "offset": 700,
    "text": "καὶ κυριεύσει ἐθνῶν πολλῶν·"
  },
  {
    "id": "p-329d9d",
    "offset": 729,
    "text": "καὶ ὑψωθήσεται ἢ Γὼγ βασιλεία,"
  },
  {
    "id": "p-6f3791",
    "offset": 761,
    "text": "καὶ αὐξηθήσεται ἡ βασιλεία αὐτοῦ."
  },
  {
    "id": "p-3dee74",
    "offset": 796,
    "text": "θεὸς ὡδήγησεν αὐτὸν ἐξ Αἰγύπτου,"
  },
  {
    "id": "p-76ebf4",
    "offset": 830,
    "text": "ὡς δόξα μονοκέρωτος αὐτῶ·"
  },
  {
    "id": "p-2860c1",
    "offset": 857,
    "text": "ἔδεται ἔθνη ἐχθρῶν αὐτοῦ,"
  },
  {
    "id": "p-f2f37c",
    "offset": 884,
    "text": "καὶ τὰ πάχη αὐτῶν ἐκμυελιεῖν,"
  },
  {
    "id": "p-c83d46",
    "offset": 915,
    "text": "καὶ ταῖς βολίσιν αὐτοῦ κατατοξεύσει ἐχθρόν."
  },
  {
    "id": "p-832dca",
    "offset": 960,
    "text": "κατακλιθεὶς ἀνεπαύσατο ὡς λέων καὶ ὡς σκύμνος·"
  },
  {
    "id": "p-486938",
    "offset": 1008,
    "text": "τίς ἀναστήσει αὐτόν;"
  },
  {
    "id": "p-843b90",
    "offset": 1030,
    "text": "οἱ εὐλογοῦντές σε εὐλόγηνται,"
  },
  {
    "id": "p-3efbb8",
    "offset": 1061,
    "text": "καὶ οἱ καταρώμενοί σε κεκατήρανται."
  },
  {
    "id": "p-6aca13",
    "offset": 1098,
    "text": "καὶ ἐθυμώθη Βαλὰκ ἐπὶ Βαλαάμ, καὶ συνεκρότησεν ταῖς χερσὶν αὐτοῦ. καὶ εἶπεν Βαλὰκ πρὸς Βαλαάμ Καταρᾶσθαι τὸν ἐχθρόν μου κέκληκά σε, καὶ ἰδοὺ εὐλογῶν εὐλόγησας τρίτον τοῦτο."
  },
  {
    "id": "p-3c8375",
    "offset": 1272,
    "text": "νῦν οὖν φεῦγε εἰς τὸν τόπον σου· εἶπα τιμήσω σε, καὶ νῦν ἐστέρεσέν σε κύριος τῆς δόξης."
  },
  {
    "id": "p-12a18c",
    "offset": 1361,
    "text": "καὶ εἶπεν Βαλαὰμ πρὸς Βαλάκ οὐχὶ καὶ τοῖς ἀγγέλοις σου οὓς ἀπέστειλας πρὸς μὲ ἐλάλησα λέγων"
  },
  {
    "id": "p-cf8c6b",
    "offset": 1454,
    "text": "᾿Εάν μοι δῷ Βαλὰκ πλήρη τὸν οἶκον αὐτοῦ ἀργυρίου καὶ χρυσίου, οὐ δυνήσομαι παραβῆναι τὸ ῥῆμα κυρίου, ποιῆσαι αὐτὸ πονηρὸν ἢ καλὸν παρ’ ἐμαυτοῦ· ὃσα ἐὰν εἴπῃ ὁ θεός, ταῦτα ἐρῶ."
  },
  {
    "id": "p-1d4566",
    "offset": 1631,
    "text": "καὶ νῦν ἰδοὺ ἀποτρέχω εἰς τὸν τόπον μου· δεῦρο συμβουλεύσω σοι τί ποιήσει ὁ λαὸς οὗτος τὸν λαόν σου ἐπ’ ἐσχάτου τῶν ἡμερῶν."
  },
  {
    "id": "p-a9b925",
    "offset": 1756,
    "text": "καὶ ἀναλαβὼν τὴν παραβολὴν αὐτοῦ εἶπεν"
  },
  {
    "id": "p-83ea0a",
    "offset": 1796,
    "text": "Φησὶν Βαλαὰμ υἱὸς Βεώρ,"
  },
  {
    "id": "p-1a85e3",
    "offset": 1821,
    "text": "φησὶν ὁ ἄνθρωπος ὁ ἀληθινὸς ὁρῶν,"
  },
  {
    "id": "p-086ac4",
    "offset": 1856,
    "text": "ἀκούων λόγια θεοῦ,"
  },
  {
    "id": "p-738f96",
    "offset": 1876,
    "text": "ἐπιστάμενος ἐπιστήμην παρὰ ῾Υψίστου,"
  },
  {
    "id": "p-0595d7",
    "offset": 1914,
    "text": "καὶ ὅρασιν θεοῦ ἰδών,"
  },
  {
    "id": "p-56195e",
    "offset": 1937,
    "text": "ἐν ὕπνῳ, ἀποκεκαλυμμένοι οἱ ὀφθαλμοὶ αὐτοῦ·"
  },
  {
    "id": "p-985512",
    "offset": 1982,
    "text": "δείξω αὐτῷ, καὶ οὐχὶ νῦν·"
  },
  {
    "id": "p-75e33d",
    "offset": 2009,
    "text": "ἀνατελεῖ ἄστρον ἐξ Ἰακώβ"
  },
  {
    "id": "p-49284b",
    "offset": 2035,
    "text": "καὶ ἀναστήσεται ἄνθρωπος ἐξ Ἰσραήλ,"
  },
  {
    "id": "p-78ac05",
    "offset": 2072,
    "text": "καὶ θραύσει τοὺς ἀρχηγοὺς Μωάβ,"
  },
  {
    "id": "p-619ab9",
    "offset": 2105,
    "text": "καὶ προνομεύσει πάντας υἱοὺς Σήθ."
  },
  {
    "id": "p-202418",
    "offset": 2140,
    "text": "καὶ ἱστᾶι ᾿Εδὼμ κληρονομία,"
  },
  {
    "id": "p-8d75bc",
    "offset": 2169,
    "text": "καὶ ἔσται κληρονομία Ἠσαῦ ὁ ἐχθρὸς αὐτοῦ·"
  },
  {
    "id": "p-56a54e",
    "offset": 2212,
    "text": "καὶ Ἰσραὴλ ἐποίησεν ἐν ἰσχύι."
  },
  {
    "id": "p-a53578",
    "offset": 2243,
    "text": "καὶ έξεγερθήσεται ἐξ Ἰακώβ,"
  },
  {
    "id": "p-fa05bd",
    "offset": 2272,
    "text": "καὶ ἀπολεῖ σωζόμενον ἐκ πόλεως."
  },
  {
    "id": "p-9decad",
    "offset": 2305,
    "text": "καὶ ἰδὼν τὸν Ἀμαλὴκ καὶ ἀναλαβὼν τὴν παραβολὴν αὐτοῦ εἶπεν"
  },
  {
    "id": "p-1ad240",
    "offset": 2365,
    "text": "Ἀρχὴ ἐθνῶν ᾿Αμαλήκ,"
  },
  {
    "id": "p-b7dd6b",
    "offset": 2386,
    "text": "καὶ τὸ σπέρμα αὐτῶν ἀπολεῖται."
  },
  {
    "id": "p-670bcb",
    "offset": 2418,
    "text": "καὶ ἰδὼν τὸν Κεναῖον καὶ ἀναλαβὼν τὴν παραβολὴν αὐτοῦ εἶπεν"
  },
  {
    "id": "p-a21820",
    "offset": 2479,
    "text": "Ἰσχυρὰ ἡ κατοικία σου·"
  },
  {
    "id": "p-83f37b",
    "offset": 2503,
    "text": "καὶ ἐὰν θῇς ἐν πέτρᾳ τὴν νοσσιάν σου,"
  },
  {
    "id": "p-f5092d",
    "offset": 2542,
    "text": "καὶ ἐὰν γένηται τῷ Βεὼρ νεοσσιὰ πανουργίας,"
  },
  {
    "id": "p-a786b4",
    "offset": 2587,
    "text": "Ἀσσύριοί σε αἰχμαλωτεύσουσιν."
  },
  {
    "id": "p-37ccde",
    "offset": 2618,
    "text": "καὶ ἰδὼν Ὤγ καὶ ἀναλαβὼν τὴν παραβολὴν αὐτοῦ εἶπεν"
  },
  {
    "id": "p-7237ef",
    "offset": 2670,
    "text": "*Ὤ ὤ, τίς ζήσεται ὅταν θῇ ταῦτα ὁ θεός;"
  },
  {
    "id": "p-aa0211",
    "offset": 2711,
    "text": "καὶ ἐξελεύσεται ἐκ χειρὸς Κιτιαίων,"
  },
  {
    "id": "p-98e2a4",
    "offset": 2748,
    "text": "καὶ κακώσουσιν ᾿Ασσούρ, καὶ κακώσουσιν ᾿Εβραίους,"
  },
  {
    "id": "p-72c6af",
    "offset": 2799,
    "text": "καὶ αὐτοὶ ὁμοθυμαδὸν ἀπολοῦνται."
  },
  {
    "id": "p-a24ee9",
    "offset": 2833,
    "text": "καὶ ἀναστὰς Βαλαὰμ ἀπῆλθεν, ἀποστραφεὶς εἰς τὸν τόπον αὐτοῦ· καὶ Βαλὰκ ἀπῆλθεν πρὸς ἑαυτόν."
  }
]