[
  {
    "id": "p-051c2a",
    "offset": 0,
    "text": "Solitas galea fulgere comas,"
  },
  {
    "id": "p-a9762f",
    "offset": 30,
    "text": "Stilicho, molli necte corona, cessent litui saevumque procul"
  },
  {
    "id": "p-8cc982",
    "offset": 92,
    "text": "Martem felix taeda releget."
  },
  {
    "id": "p-c0df5e",
    "offset": 121,
    "text": "tractus ab aula rursus in aulam redeat sanguis, patris officiis iunge potenti pignora dextra."
  },
  {
    "id": "p-691767",
    "offset": 216,
    "text": "gener Augusti pridem fueras, nunc rursus eris socer Augusti."
  },
  {
    "id": "p-b4a996",
    "offset": 278,
    "text": "quae iam rabies livoris erit?"
  },
  {
    "id": "p-92fc30",
    "offset": 309,
    "text": "vel quis dabitur color invidiae?"
  },
  {
    "id": "p-fdc9fd",
    "offset": 343,
    "text": "Stilicho socer est, pater est Stilicho."
  }
]