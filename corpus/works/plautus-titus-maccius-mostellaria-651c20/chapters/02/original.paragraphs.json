[
  {
    "id": "p-588153",
    "offset": 0,
    "text": "Tranio:\nIúppiter supremus summis opibus atque industriis me periisse et Philolachetem cupit erilem filium."
  },
  {
    "id": "p-c95789",
    "offset": 108,
    "text": "occidit Spes nostra, nusquam stabulum est Confidentiae, nec Salus nobis saluti iam esse, si cupiat, potest:"
  },
  {
    "id": "p-2d8cfd",
    "offset": 217,
    "text": "ita mali, maeroris montem maximum ad portum modo conspicatus sum: erus advenit peregre, periit Tranio."
  },
  {
    "id": "p-0a04c0",
    "offset": 321,
    "text": "ecquis homo est, qui facere argenti cupiat aliquantum lucri, quí hodie sese excruciari meam vicem possit pati?"
  },
  {
    "id": "p-2319c5",
    "offset": 433,
    "text": "ubi sunt isti plagipatidae, ferritribaces viri, vel isti qui hosticas trium númmum causa subeunt sub falas, ubi quinis aut denis hastis corpus transfigi solet?"
  },
  {
    "id": "p-3202ef",
    "offset": 594,
    "text": "ego dabo ei talentum, primus qui in crucem excucurrerit;"
  },
  {
    "id": "p-bf3b5d",
    "offset": 652,
    "text": "sed ea lege, ut offigantur bis pedes, bis bracchia."
  },
  {
    "id": "p-8b760b",
    "offset": 705,
    "text": "ubi id erit factum, a me argentum petito praesentarium."
  },
  {
    "id": "p-527e6d",
    "offset": 762,
    "text": "sed ego—sumne infelix, qui non curro curriculo domum?"
  },
  {
    "id": "p-1641a5",
    "offset": 817,
    "text": "Philolaches:\nAdest adest opsonium. eccum Tranio a portu redit."
  },
  {
    "id": "p-6d2e1d",
    "offset": 881,
    "text": "Tranio:\nPhilolaches."
  },
  {
    "id": "p-5f07b9",
    "offset": 903,
    "text": "Philolaches:\nQuid est?"
  },
  {
    "id": "p-69933f",
    "offset": 927,
    "text": "Tranio:\nEt ego et tu—"
  },
  {
    "id": "p-08b7cc",
    "offset": 950,
    "text": "Philolaches:\nQuid et ego et tu?"
  },
  {
    "id": "p-9db66c",
    "offset": 983,
    "text": "Tranio:\nPeriimus."
  },
  {
    "id": "p-ca3549",
    "offset": 1002,
    "text": "Philolaches:\nQuid ita?"
  },
  {
    "id": "p-92abf2",
    "offset": 1026,
    "text": "Tranio:\nPater adest."
  },
  {
    "id": "p-f94994",
    "offset": 1048,
    "text": "Philolaches:\nQuid ego ex te aúdio?"
  },
  {
    "id": "p-3aca59",
    "offset": 1084,
    "text": "Tranio:\nAbsumpti sumus."
  },
  {
    "id": "p-286cd0",
    "offset": 1109,
    "text": "pater inquam tuos venit."
  },
  {
    "id": "p-b168a2",
    "offset": 1135,
    "text": "Philolaches:\nVbi is est, obsecro?"
  },
  {
    "id": "p-fbd0bb",
    "offset": 1170,
    "text": "Tranio:\nadest."
  },
  {
    "id": "p-f9ddf0",
    "offset": 1186,
    "text": "Philolaches:"
  },
  {
    "id": "p-791674",
    "offset": 1200,
    "text": "Quis id ait? quis vidit?"
  },
  {
    "id": "p-17f2b1",
    "offset": 1226,
    "text": "Tranio:\nEgomet inquam vidi."
  },
  {
    "id": "p-725c75",
    "offset": 1255,
    "text": "Philolaches:\nVae mihi."
  },
  {
    "id": "p-4d37ed",
    "offset": 1279,
    "text": "quid ego ago?"
  },
  {
    "id": "p-634ce6",
    "offset": 1294,
    "text": "Tranio:\nNam quid tu, malum, me rogitas quid agas? accubas."
  },
  {
    "id": "p-7d1cd7",
    "offset": 1354,
    "text": "Philolaches:\nTutin vidisti?"
  },
  {
    "id": "p-ac4809",
    "offset": 1383,
    "text": "Tranio:\nEgomet, inquam."
  },
  {
    "id": "p-c65038",
    "offset": 1408,
    "text": "Philolaches:\nCerte?"
  },
  {
    "id": "p-49a73b",
    "offset": 1429,
    "text": "Tranio:\nCerte inquam."
  },
  {
    "id": "p-03bbce",
    "offset": 1452,
    "text": "Philolaches:\nOccidi, si tu vera memoras."
  },
  {
    "id": "p-48d629",
    "offset": 1494,
    "text": "Tranio:\nQuid mihi sit boni, si mentiar?"
  },
  {
    "id": "p-989aee",
    "offset": 1535,
    "text": "Philolaches:\nQuid ego nunc faciam?"
  },
  {
    "id": "p-92583c",
    "offset": 1571,
    "text": "Tranio:\nIube haec hinc omnia amolirier."
  },
  {
    "id": "p-05a0a8",
    "offset": 1612,
    "text": "quis istic dormit?"
  },
  {
    "id": "p-604ff8",
    "offset": 1632,
    "text": "Philolaches:\nCallidamates."
  },
  {
    "id": "p-116251",
    "offset": 1660,
    "text": "Tranio:\nSuscita istum, Delphium."
  },
  {
    "id": "p-cf66b7",
    "offset": 1694,
    "text": "Delphivm:\nCallidamates, Callidamates, vigila."
  },
  {
    "id": "p-2cb562",
    "offset": 1741,
    "text": "Callidamates:\nVigilo, cedo bibam."
  },
  {
    "id": "p-cc2bb9",
    "offset": 1776,
    "text": "Delphivm:\nVigila. pater advenit peregre Philolachis."
  },
  {
    "id": "p-fb2a64",
    "offset": 1830,
    "text": "Callidamates:\nValeat pater."
  },
  {
    "id": "p-5c404d",
    "offset": 1859,
    "text": "Philolaches:\nValet ille quidem, atque ego disperii."
  },
  {
    "id": "p-f8d661",
    "offset": 1912,
    "text": "Callidamates:\nBis periisti? qui potest?"
  },
  {
    "id": "p-0eed5a",
    "offset": 1953,
    "text": "Philolaches:\nQuaeso edepol, exsurge; pater advenit."
  },
  {
    "id": "p-054033",
    "offset": 2006,
    "text": "Callidamates:\nTuos venit pater?"
  },
  {
    "id": "p-1c8ab4",
    "offset": 2039,
    "text": "iube abíre rursum. quíd illi reditio etiam húc fuit?"
  },
  {
    "id": "p-e2ab80",
    "offset": 2093,
    "text": "Philolaches:\nQuid ego agam? pater iam híc me offendet miserum adveniens ebrium, aedis plenas convivarum et mulierum. miserum est opus, igitur demum fodere puteum, úbi sitis fauces tenet;"
  },
  {
    "id": "p-84a216",
    "offset": 2281,
    "text": "sicut ego adventu patris nunc quaero quid faciam miser."
  },
  {
    "id": "p-f22763",
    "offset": 2338,
    "text": "Tranio:"
  },
  {
    "id": "p-e24bdc",
    "offset": 2347,
    "text": "Ecce autem iterum hic deposivit caput et dormit. suscita."
  },
  {
    "id": "p-b49fd2",
    "offset": 2406,
    "text": "Philolaches:\nEtiam vigilas? pater, inquam, aderit iam hic meus."
  },
  {
    "id": "p-741fa4",
    "offset": 2471,
    "text": "Callidamates:\nAin tu, pater?"
  },
  {
    "id": "p-9ec2d6",
    "offset": 2501,
    "text": "cedo soleas mihi, ut arma capiam. iam pol ego occidam patrem."
  },
  {
    "id": "p-d2add1",
    "offset": 2564,
    "text": "Philolaches:\nPerdis rem."
  },
  {
    "id": "p-56654d",
    "offset": 2590,
    "text": "Delphivm:\nTace, amabo."
  },
  {
    "id": "p-7cc85d",
    "offset": 2614,
    "text": "Tranio:\nAbripite hunc intro actutum inter manus."
  },
  {
    "id": "p-8953b6",
    "offset": 2664,
    "text": "Callidamates:\nIam hercle ego vos pro matula habebo, nisi mihi matulam datis."
  },
  {
    "id": "p-f9ddf0",
    "offset": 2742,
    "text": "Philolaches:"
  },
  {
    "id": "p-613352",
    "offset": 2756,
    "text": "Perii."
  },
  {
    "id": "p-482ce4",
    "offset": 2764,
    "text": "Tranio:\nHabe bonum animum: ego istum lepide medicabo metum."
  },
  {
    "id": "p-1f7c77",
    "offset": 2825,
    "text": "Philolaches:\nNullus sum."
  },
  {
    "id": "p-54d28d",
    "offset": 2851,
    "text": "Tranio:\nTaceas: ego qui istaec sedem meditabor tibi."
  },
  {
    "id": "p-e79533",
    "offset": 2905,
    "text": "satin habes, si ego advenientem íta patrem faciam tuom, non modo ne intro eat, verum etiam ut fugiat longe ab aedibus?"
  },
  {
    "id": "p-6fe3dc",
    "offset": 3025,
    "text": "vos modo hinc abite intro atque haec hinc propere amolimini."
  },
  {
    "id": "p-f9ddf0",
    "offset": 3087,
    "text": "Philolaches:"
  },
  {
    "id": "p-13b75e",
    "offset": 3101,
    "text": "Vbi ego ero?"
  },
  {
    "id": "p-f2fe95",
    "offset": 3115,
    "text": "Tranio:\nVbi maxime esse vis: cum hác, cum istac eris."
  },
  {
    "id": "p-ed7715",
    "offset": 3170,
    "text": "Delphivm:\nQuid si igitur abeamus hinc nos?"
  },
  {
    "id": "p-fd33f7",
    "offset": 3214,
    "text": "Tranio:\nNon hoc longe, Delphium."
  },
  {
    "id": "p-3ebf2c",
    "offset": 3248,
    "text": "nam intus potate hau tantillo hác quidem causa minus."
  },
  {
    "id": "p-ec6640",
    "offset": 3303,
    "text": "Philolaches:\nEi mihi, quam ístaec blanda dicta quo evenant madeo metu."
  },
  {
    "id": "p-ad6841",
    "offset": 3375,
    "text": "Tranio:\nPotin animó ut sis quieto et facias quod iubeo?"
  },
  {
    "id": "p-aa2d81",
    "offset": 3432,
    "text": "Philolaches:\nPotest."
  },
  {
    "id": "p-f22763",
    "offset": 3454,
    "text": "Tranio:"
  },
  {
    "id": "p-f68a92",
    "offset": 3463,
    "text": "Omnium primum, Philematium, intro abi, et tu, Delphium."
  },
  {
    "id": "p-ba4702",
    "offset": 3520,
    "text": "Delphivm:\nMorigerae tibi erimus ambae.—"
  },
  {
    "id": "p-2c7cbe",
    "offset": 3561,
    "text": "Tranio:\nIta ille faxit Iuppiter."
  },
  {
    "id": "p-b2c988",
    "offset": 3595,
    "text": "animum advorte nunciam tu quae volo accurarier."
  },
  {
    "id": "p-537a71",
    "offset": 3644,
    "text": "omnium primumdum aédes iam face occlusae sient;"
  },
  {
    "id": "p-c80856",
    "offset": 3693,
    "text": "intus cave muttire quemquam siveris."
  },
  {
    "id": "p-644958",
    "offset": 3731,
    "text": "Philolaches:\nCurabitur."
  },
  {
    "id": "p-f22763",
    "offset": 3756,
    "text": "Tranio:"
  },
  {
    "id": "p-336c5c",
    "offset": 3765,
    "text": "Tamquam si intus natus nemo in aedibus habitet."
  },
  {
    "id": "p-3f7c60",
    "offset": 3814,
    "text": "Philolaches:\nLicet."
  },
  {
    "id": "p-d4f309",
    "offset": 3835,
    "text": "Tranio:\nNeu quisquam responset, quando hasce aedis pultabit senex."
  },
  {
    "id": "p-426a3e",
    "offset": 3903,
    "text": "Philolaches:\nNumquid aliud?"
  },
  {
    "id": "p-2e7a92",
    "offset": 3932,
    "text": "Tranio:\nClavem mi harunc aedium Laconicam iam iube efferri intus: hasce ego aedis occludam hinc foris."
  },
  {
    "id": "p-5698ec",
    "offset": 4036,
    "text": "Philolaches:\nIn tuam cústodelam meque et meas spes trado, Tranio.—"
  },
  {
    "id": "p-f22763",
    "offset": 4104,
    "text": "Tranio:"
  },
  {
    "id": "p-f90651",
    "offset": 4113,
    "text": "Pluma haud interest, patronus an cliens probior siet."
  },
  {
    "id": "p-a5e41e",
    "offset": 4168,
    "text": "Homini, cui nulla in pectore est audacia, quamvis desubito facile est facere nequiter:"
  },
  {
    "id": "p-d4e1e2",
    "offset": 4256,
    "text": "verum id videndum est, id viri docti est opus, quae designata sint et facta nequiter, tranquille cuncta et ut proveniant sine malo, ne quid potiatur, quam ob rem pigeat vivere."
  },
  {
    "id": "p-05e62e",
    "offset": 4434,
    "text": "sicut ego efficiam, quae facta hic turbavimus, profecto ut liqueant omnia et tranquilla sint neque quicquam nobis pariant ex se incommodi."
  },
  {
    "id": "p-ce7983",
    "offset": 4574,
    "text": "sed quid tu egredere, Sphaerio?"
  },
  {
    "id": "p-ba678e",
    "offset": 4607,
    "text": "Pver:\nIamiam"
  },
  {
    "id": "p-59cffe",
    "offset": 4621,
    "text": "Tranio:\nOptime."
  },
  {
    "id": "p-81c2c7",
    "offset": 4638,
    "text": "praeceptis paruisti."
  },
  {
    "id": "p-b87a99",
    "offset": 4660,
    "text": "Pver:\nIussit maximo opere orare, ut patrem aliquo absterreres modo, ne intro iret ad se."
  },
  {
    "id": "p-f9a58f",
    "offset": 4750,
    "text": "Tranio:\nQuin etiam illi hoc dicito, facturum me, ut ne etiam aspicere aedis audeat, capite obvoluto ut fugiat cum summo metu."
  },
  {
    "id": "p-84343b",
    "offset": 4877,
    "text": "clavem cedo atque abi intro atque occlude ostium, et ego hinc occludam.—iube venire nunciam."
  },
  {
    "id": "p-63635c",
    "offset": 4971,
    "text": "ludos ego hodie vivo praesenti hic seni faciam, quod credo mortuo numquam fore."
  },
  {
    "id": "p-ca7bbc",
    "offset": 5052,
    "text": "concedam a foribus huc, hinc speculabor procul, unde advenienti sarcinam imponam seni."
  },
  {
    "id": "p-27059f",
    "offset": 5140,
    "text": "Theopropides:\nHabeo, Neptune, gratiam magnam tibi, quom med amisisti abs te vix vivom domum."
  },
  {
    "id": "p-297fd8",
    "offset": 5234,
    "text": "verum si posthac me pedem latum modo scies ímposisse in undam, hau causast, ilico quod nunc voluisti facere quin facias mihi."
  },
  {
    "id": "p-0bfa33",
    "offset": 5361,
    "text": "apage, apage te a me nunciam post hunc diem:"
  },
  {
    "id": "p-e06e22",
    "offset": 5407,
    "text": "quod crediturus tibi fui, omne credidi."
  },
  {
    "id": "p-313ec9",
    "offset": 5448,
    "text": "Tranio:\nEdepol, Neptune, peccavisti largiter, qui occasionem hanc amisisti tam bonam."
  },
  {
    "id": "p-bd33be",
    "offset": 5535,
    "text": "Theopropides:"
  },
  {
    "id": "p-a5f3fa",
    "offset": 5550,
    "text": "Triennio post Aegypto advenio domum;"
  },
  {
    "id": "p-201345",
    "offset": 5588,
    "text": "credo exspectatus veniam familiaribus."
  },
  {
    "id": "p-e80e93",
    "offset": 5628,
    "text": "Tranio:\nNimio edepol ille potuit exspectatior venire, qui te nuntiaret mortuom."
  },
  {
    "id": "p-400e3b",
    "offset": 5709,
    "text": "Theopropides:\nSed quid hoc? occlusa ianua est interdius."
  },
  {
    "id": "p-7eb360",
    "offset": 5767,
    "text": "pultabo. heus, ecquis intust? aperitin fores?"
  },
  {
    "id": "p-62b55e",
    "offset": 5814,
    "text": "Tranio:\nQuis homo est, qui nostras aedes accessit prope?"
  },
  {
    "id": "p-a57830",
    "offset": 5872,
    "text": "Theopropides:\nMeus sérvos hic quidem est Tranio."
  },
  {
    "id": "p-f85f20",
    "offset": 5922,
    "text": "Tranio:\nO Theopropides, ere, salve, salvom te advenisse gaudeo."
  },
  {
    "id": "p-77806d",
    "offset": 5987,
    "text": "usquin valuisti?"
  },
  {
    "id": "p-e5f64e",
    "offset": 6005,
    "text": "Theopropides:\nVsque ut vides."
  },
  {
    "id": "p-4997c3",
    "offset": 6036,
    "text": "Tranio:\nFactum optime."
  },
  {
    "id": "p-bd33be",
    "offset": 6060,
    "text": "Theopropides:"
  },
  {
    "id": "p-204e7e",
    "offset": 6075,
    "text": "Quid vos? insanin estis?"
  },
  {
    "id": "p-05a331",
    "offset": 6101,
    "text": "Tranio:\nQuidum?"
  },
  {
    "id": "p-9c5916",
    "offset": 6118,
    "text": "Theopropides:\nSic, quia foris ámbulatis, natus nemo in aedibus servat, neque qui recludat neque † quis respondeat."
  },
  {
    "id": "p-9a22b3",
    "offset": 6234,
    "text": "pultando paene confregi hasce ambas foris."
  },
  {
    "id": "p-adff03",
    "offset": 6278,
    "text": "Tranio:\nEho an tú tetigisti has aedis?"
  },
  {
    "id": "p-f62da1",
    "offset": 6318,
    "text": "Theopropides:\nCur non tangerem?"
  },
  {
    "id": "p-a4182a",
    "offset": 6351,
    "text": "quin pultando, inquam, paene confregi foris."
  },
  {
    "id": "p-758419",
    "offset": 6397,
    "text": "Tranio:\nTetigistin?"
  },
  {
    "id": "p-d3e8af",
    "offset": 6418,
    "text": "Theopropides:\nTetigi, inquam, et pultavi."
  },
  {
    "id": "p-66e073",
    "offset": 6461,
    "text": "Tranio:\nVah."
  },
  {
    "id": "p-c8e832",
    "offset": 6475,
    "text": "Theopropides:\nQuid est?"
  },
  {
    "id": "p-196d49",
    "offset": 6500,
    "text": "Tranio:\nMale hercle factum."
  },
  {
    "id": "p-1a300d",
    "offset": 6529,
    "text": "Theopropides:\nQuid est negoti?"
  },
  {
    "id": "p-372261",
    "offset": 6561,
    "text": "Tranio:\nNon potest dici, quam indignum facinus fecisti et malum."
  },
  {
    "id": "p-f96e69",
    "offset": 6627,
    "text": "Theopropides:\nQuid iam?"
  },
  {
    "id": "p-9ed060",
    "offset": 6652,
    "text": "Tranio:\nFuge, obsecro, atque abscede ab aedibus."
  },
  {
    "id": "p-957a3b",
    "offset": 6702,
    "text": "fuge huc, fuge ad me propius. tetigistin foris?"
  },
  {
    "id": "p-2815e3",
    "offset": 6751,
    "text": "Theopropides:\nQuo modo pultare potui, si non tangerem?"
  },
  {
    "id": "p-6a6a57",
    "offset": 6807,
    "text": "Tranio:\nOccidisti hercle—"
  },
  {
    "id": "p-fa9694",
    "offset": 6834,
    "text": "Theopropides:\nQuem mortalem?"
  },
  {
    "id": "p-07e34b",
    "offset": 6864,
    "text": "Tranio:\nOmnis tuos."
  },
  {
    "id": "p-17ee15",
    "offset": 6885,
    "text": "Theopropides:\nDi te deaeque ómnes faxint cum istoc omine—"
  },
  {
    "id": "p-ccc2ff",
    "offset": 6944,
    "text": "Tranio:\nMetuo, te atque istos expiare ut possies."
  },
  {
    "id": "p-bd33be",
    "offset": 6995,
    "text": "Theopropides:"
  },
  {
    "id": "p-8c25f9",
    "offset": 7010,
    "text": "Quam ob rem? aut quam subito rem mihi adportas novam?"
  },
  {
    "id": "p-1fa859",
    "offset": 7065,
    "text": "Tranio:\nEt heus, iube illos illinc ambo abscedere."
  },
  {
    "id": "p-61d127",
    "offset": 7117,
    "text": "Theopropides:\nApscedite."
  },
  {
    "id": "p-4e7ff4",
    "offset": 7143,
    "text": "Tranio:\nAedes ne attigatis. tangite vos quoque terram."
  },
  {
    "id": "p-331b75",
    "offset": 7199,
    "text": "Theopropides:\nObsecro hercle, quin eloquere"
  },
  {
    "id": "p-9a56cd",
    "offset": 7244,
    "text": "Tranio:\nQuia septem menses sunt, quom in hasce aedis pedem nemo intro tetulit, semel ut emigravimus."
  },
  {
    "id": "p-78e034",
    "offset": 7346,
    "text": "Theopropides:\nEloquere, quid ita?"
  },
  {
    "id": "p-5ff128",
    "offset": 7381,
    "text": "Tranio:\nCircumspicedum, numquis est, sermonem nostrum qui aucupet?"
  },
  {
    "id": "p-0ea877",
    "offset": 7449,
    "text": "Theopropides:\nTutum probest."
  },
  {
    "id": "p-f22763",
    "offset": 7479,
    "text": "Tranio:"
  },
  {
    "id": "p-ebd31e",
    "offset": 7488,
    "text": "Circumspice etiam."
  },
  {
    "id": "p-84c96b",
    "offset": 7508,
    "text": "Theopropides:\nNemo est. loquere nunciam."
  },
  {
    "id": "p-fd2350",
    "offset": 7550,
    "text": "Tranio:\nCapitale scelus est."
  },
  {
    "id": "p-ee8725",
    "offset": 7580,
    "text": "Theopropides:\nQuid est? non satis intellego."
  },
  {
    "id": "p-4acc36",
    "offset": 7626,
    "text": "Tranio:\nScelus, inquam, factum est iam diu, antiquom et vetus."
  },
  {
    "id": "p-bce401",
    "offset": 7690,
    "text": "Theopropides:\nAntiquom?"
  },
  {
    "id": "p-175b78",
    "offset": 7715,
    "text": "Tranio:\nId adeo nos nunc factum invenimus."
  },
  {
    "id": "p-20744a",
    "offset": 7759,
    "text": "Theopropides:\nQuid istúc est sceleris? aut quis id fecit? cedo."
  },
  {
    "id": "p-f22763",
    "offset": 7824,
    "text": "Tranio:"
  },
  {
    "id": "p-29fd20",
    "offset": 7833,
    "text": "Hospes necavit hospitem captum manu;"
  },
  {
    "id": "p-0e725d",
    "offset": 7871,
    "text": "iste, ut ego opinor, qui has tibi aedis vendidit."
  },
  {
    "id": "p-27ee2d",
    "offset": 7922,
    "text": "Theopropides:\nNecavit?"
  },
  {
    "id": "p-1406a8",
    "offset": 7946,
    "text": "Tranio:\nAurumque ei ademit hospiti eumque híc defodit hospitem íbidem in aedibus."
  },
  {
    "id": "p-3f702a",
    "offset": 8029,
    "text": "Theopropides:\nQuapropter id vos factum suspicamini?"
  },
  {
    "id": "p-f22763",
    "offset": 8082,
    "text": "Tranio:"
  },
  {
    "id": "p-99c952",
    "offset": 8091,
    "text": "Ego dicam, ausculta. út foris cenaverat tuos gnátus, postquam rediit a cena domum, abimus omnes cubitum; condormivimus:"
  },
  {
    "id": "p-8bb010",
    "offset": 8212,
    "text": "lucernam forte oblitus fueram exstinguere;"
  },
  {
    "id": "p-2a079c",
    "offset": 8256,
    "text": "atque ille exclamat derepente maximum."
  },
  {
    "id": "p-bd33be",
    "offset": 8296,
    "text": "Theopropides:"
  },
  {
    "id": "p-b546ac",
    "offset": 8311,
    "text": "Quis homo? án gnatus meus?"
  },
  {
    "id": "p-d4e6f4",
    "offset": 8339,
    "text": "Tranio:\nSt, tace, ausculta modo."
  },
  {
    "id": "p-57f9a7",
    "offset": 8373,
    "text": "ait vénisse illum in somnis ad se mortuom."
  },
  {
    "id": "p-257a11",
    "offset": 8417,
    "text": "Theopropides:\nNempe ergo in somnis?"
  },
  {
    "id": "p-8d28e4",
    "offset": 8454,
    "text": "Tranio:\nIta. sed ausculta modo."
  },
  {
    "id": "p-62bc4f",
    "offset": 8487,
    "text": "ait illum hoc pacto sibi dixisse mortuom."
  },
  {
    "id": "p-b8db7c",
    "offset": 8530,
    "text": "Theopropides:\nIn somnis?"
  },
  {
    "id": "p-985866",
    "offset": 8556,
    "text": "Tranio:\nMirum quin vigilanti diceret, qui abhinc sexaginta annos occisus foret."
  },
  {
    "id": "p-a1f223",
    "offset": 8637,
    "text": "interdum inepte stultus es, Theopropides."
  },
  {
    "id": "p-63f2cd",
    "offset": 8680,
    "text": "Theopropides:\nTaceo."
  },
  {
    "id": "p-c9ac27",
    "offset": 8702,
    "text": "Tranio:\nSed ecce quae illi in"
  },
  {
    "id": "p-0fa7e4",
    "offset": 8733,
    "text": "“ego transmarinus hospes sum Diapontius."
  },
  {
    "id": "p-5e548e",
    "offset": 8775,
    "text": "hic habito, haéc mihi dedita est habitatio."
  },
  {
    "id": "p-071ff4",
    "offset": 8820,
    "text": "nam me Acheruntem recipere Orcus noluit, quia praemature vita careo. per fidem deceptus sum: hospes me necavit isque me defodit insepultum clám in hisce aedibus, scelestus, auri causa. nunc tu hinc emigra."
  },
  {
    "id": "p-078908",
    "offset": 9027,
    "text": "scelestae haé sunt aedes, impia est habitatio”."
  },
  {
    "id": "p-25f705",
    "offset": 9076,
    "text": "quae hic monstra fiunt, anno vix possum eloqui."
  },
  {
    "id": "p-afd553",
    "offset": 9125,
    "text": "Theopropides:\nSt, st."
  },
  {
    "id": "p-6c17f6",
    "offset": 9148,
    "text": "Tranio:\nQuid, obsecro hercle, factum est?"
  },
  {
    "id": "p-570b36",
    "offset": 9191,
    "text": "Theopropides:\nConcrepuit foris."
  },
  {
    "id": "p-cb05f4",
    "offset": 9224,
    "text": "Tranio:\nHicin percussit!"
  },
  {
    "id": "p-f49956",
    "offset": 9250,
    "text": "Theopropides:\nGuttam haud habeo sanguinis, vivom me accersunt Acheruntem mortui."
  },
  {
    "id": "p-5ae2f3",
    "offset": 9332,
    "text": "Tranio:\nPerii, illisce hodie hanc conturbabunt fabulam."
  },
  {
    "id": "p-ee95ba",
    "offset": 9389,
    "text": "nimis quám formido, ne manifesto hic me opprimat."
  },
  {
    "id": "p-238015",
    "offset": 9440,
    "text": "Theopropides:\nQuid tute tecum loquere?"
  },
  {
    "id": "p-cfcf37",
    "offset": 9480,
    "text": "Tranio:\nAbscede ab ianua."
  },
  {
    "id": "p-b2640b",
    "offset": 9507,
    "text": "fuge, obsecro hercle."
  },
  {
    "id": "p-6b8364",
    "offset": 9530,
    "text": "Theopropides:\nQuo fugiam? etiam tu fuge."
  },
  {
    "id": "p-f22763",
    "offset": 9572,
    "text": "Tranio:"
  },
  {
    "id": "p-697f50",
    "offset": 9581,
    "text": "Nihil ego formido, pax mihi est cum mortuis."
  },
  {
    "id": "p-7897af",
    "offset": 9627,
    "text": "Intvs:\nHeus, Tranio."
  },
  {
    "id": "p-159a54",
    "offset": 9649,
    "text": "Tranio:\nNon me appellabis, si sapis."
  },
  {
    "id": "p-05e59c",
    "offset": 9687,
    "text": "nihil ego commerui, neque istas percussi fores."
  },
  {
    "id": "p-7de4f9",
    "offset": 9736,
    "text": "Intvs:\nQuaeso—"
  },
  {
    "id": "p-832dbb",
    "offset": 9752,
    "text": "Tranio:\nCave verbum faxis."
  },
  {
    "id": "p-64faf3",
    "offset": 9780,
    "text": "Theopropides:\nDic quid segreges sermonem."
  },
  {
    "id": "p-441a25",
    "offset": 9823,
    "text": "Tranio:\nApage hinc te."
  },
  {
    "id": "p-a3cf9c",
    "offset": 9847,
    "text": "Theopropides:\nQuae r es te agitat, Tranio?"
  },
  {
    "id": "p-e9f298",
    "offset": 9891,
    "text": "quicum istaec loquere?"
  },
  {
    "id": "p-e8896a",
    "offset": 9915,
    "text": "Tranio:\nAn quaeso tu appellaveras?"
  },
  {
    "id": "p-ffd3b3",
    "offset": 9951,
    "text": "ita me di amabunt, mortuom illum credidi expostulare quia percussisses fores."
  },
  {
    "id": "p-e0e18b",
    "offset": 10030,
    "text": "sed tu, etiamne astas nec quae dico optemperas?"
  },
  {
    "id": "p-81b3a1",
    "offset": 10079,
    "text": "Theopropides:\nQuid faciam?"
  },
  {
    "id": "p-28384e",
    "offset": 10107,
    "text": "Tranio:\nCave respexis, fuge, operi caput."
  },
  {
    "id": "p-bd33be",
    "offset": 10150,
    "text": "Theopropides:"
  },
  {
    "id": "p-08dace",
    "offset": 10165,
    "text": "Cur non fugis tu?"
  },
  {
    "id": "p-cb00d6",
    "offset": 10184,
    "text": "Tranio:\nPax mihi est cum mortuis."
  },
  {
    "id": "p-1ffe9a",
    "offset": 10219,
    "text": "Theopropides:\nScio. quíd modo igitur? cur tanto opere extimueras?"
  },
  {
    "id": "p-a9a1ff",
    "offset": 10286,
    "text": "Tranio:\nNil me curassis, inquam, ego mihi providero:"
  },
  {
    "id": "p-3bfdca",
    "offset": 10340,
    "text": "tu, ut occepisti, tantum quantum quis fuge, atque Herculem invoca."
  },
  {
    "id": "p-ca0eb3",
    "offset": 10408,
    "text": "Theopropides:\nHercules, ted invoco.—"
  },
  {
    "id": "p-f22763",
    "offset": 10446,
    "text": "Tranio:"
  },
  {
    "id": "p-84fdc0",
    "offset": 10455,
    "text": "Et ego—tibi hodie ut det, senex, magnum malum."
  },
  {
    "id": "p-6e3c50",
    "offset": 10503,
    "text": "pro di immortales, obsecro vestram fidem, quid ego hodie negoti confeci mali."
  }
]